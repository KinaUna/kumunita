<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 (Microsoft.Testing.Platform). Microsoft.NET.Test.Sdk + VSTest bridge
         register the project with VS Test Explorer; `dotnet test` continues to work via MTP. -->
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
      <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" Version="2.4.0" />
      <PackageReference Include="Npgsql" Version="10.0.3" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
      <PackageReference Include="Testcontainers" Version="4.14.0" />
      <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
      <PackageReference Include="xunit.v3" Version="4.0.0" />
    </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kumunita.Core\Kumunita.Core.csproj" />
  </ItemGroup>

</Project>
