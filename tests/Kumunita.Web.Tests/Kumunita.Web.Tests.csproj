<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 (Microsoft.Testing.Platform). Microsoft.NET.Test.Sdk + VSTest bridge
         register the project with VS Test Explorer; `dotnet test` continues to work via MTP. -->
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
      <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" Version="2.4.0" />
      <PackageReference Include="NSubstitute" Version="5.3.0" />
      <PackageReference Include="xunit.v3" Version="4.0.0" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />      <!-- GA U06 (ADR 0038): the 5 Assign Web tests are <b>integration</b> tests —
           the Assign action's standing gate (ActiveLinkAsync) + the happy-path
           CreateGuardianLinkAsync seam both run real Marten SQL (Marten 9's
           FirstOrDefaultAsync/ToListAsync cannot be NSubstituted — they cast to
           the internal MartenLinqQueryable and execute a live query), and the
           pinned tests assert REAL GuardianLink + guardian.create audit rows.
           That needs a live Postgres, so this project carries its own
           PostgresFixture (a byte-for-byte copy of the one in
           Kumunita.Core.Tests — the repo's documented "Web.Tests is
           NSubstitute-only, Testcontainers lives in Core.Tests" convention is
           the seam gap U06 records as a drift pause; the 5 pinned names cannot
           be driven against the NSubstitute-only shape). Same versions as
           Core.Tests to keep the two containers in lockstep. -->
      <PackageReference Include="Npgsql" Version="10.0.3" />
      <PackageReference Include="Testcontainers" Version="4.14.0" />
      <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />    </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kumunita.Web\Kumunita.Web.csproj" />
  </ItemGroup>

  <!-- e2e-m2.spec.ts (U13) is authored but the `kumunita` Playwright
       fixture still throws per the M3 runtime contract: see the
       "Not yet runnable" header in the spec itself and
       m2-handoff-notes.md § U13.

       The C# build classifies it as None so the xUnit pipeline
       doesn't pick it up. The spec is independently type-checkable
       and Playwright-listable from this folder:
         npm install           # devDeps in ./package.json
         npm run typecheck     # tsc noEmit against the spec
         npx playwright test   # list or run the specs (see playwright.config.ts)
       When the M3 Playwright unit lands the kumunita fixture
       implementation, `npx playwright test` will run the three
       specs against `dotnet run` (see playwright.config.ts). -->
  <ItemGroup>
    <None Include="e2e-m2.spec.ts" />
    <None Include="e2e-tags.spec.ts" />
    <None Include="playwright.config.ts" />
    <None Include="package.json" />
    <None Include="package-lock.json" Condition="Exists('package-lock.json')" />
    <None Include="tsconfig.json" />
  </ItemGroup>

</Project>
