<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 (Microsoft.Testing.Platform). Microsoft.NET.Test.Sdk + VSTest bridge
         register the project with VS Test Explorer; `dotnet test` continues to work via MTP. -->
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
      <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" Version="2.5.2" />
      <PackageReference Include="NSubstitute" Version="6.2.0" />
      <PackageReference Include="xunit.v3" Version="4.0.3" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />      <!-- DX09 (IMPROVE-DEVX, ADR 0307 §D2): the Web integration tests (the 5 GA U06 /
           ADR 0038 Assign tests + the ~36 Postgres-backed controller/handler
           tests) run real Marten SQL, so they need a live Postgres. Rather than
           carry a second PostgresFixture, this project <b>links Core.Tests'</b>
           (one shared container per assembly, D2) — the Core fixture already
           carries the max_connections + sysv shared-memory settings the shared
           server needs. The global <Using Include="Kumunita.Core.Tests" /> below
           lets every Web test file reference PostgresFixture unqualified. -->
      <PackageReference Include="Npgsql" Version="10.0.3" />
      <PackageReference Include="Testcontainers" Version="4.16.0" />
      <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    </ItemGroup>

  <!-- DX09 (ADR 0307 §D2): one shared container per assembly. Link Core.Tests'
       PostgresFixture (the source of truth, one fact one place) instead of
       keeping a byte-for-byte copy; the <Using> below resolves it unqualified
       in the Web test files. -->
  <ItemGroup>
    <Compile Include="..\Kumunita.Core.Tests\PostgresFixture.cs" Link="PostgresFixture.cs" />
    <Using Include="Xunit" />
    <Using Include="Kumunita.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kumunita.Web\Kumunita.Web.csproj" />
  </ItemGroup>

  <!-- R02 (IMPROVE-UX): the status-page gate integration tests boot a minimal
       Kestrel host via WebApplication.CreateBuilder(). The Web SDK project
       (Kumunita.Web) uses Microsoft.NET.Sdk.Web and has the shared framework
       as a FrameworkReference, but that does not flow transitively to a
       non-Web SDK test project — add it here so UseUrls, ClearProviders,
       MapGet and the hosting/Kestrel types are available in tests. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- e2e-m2.spec.ts (U13) is authored but the `kumunita` Playwright
       fixture still throws per the M3 runtime contract: see the
       "Not yet runnable" header in the spec itself and
       m2-handoff-notes.md § U13.

       The C# build classifies it as None so the xUnit pipeline
       doesn't pick it up. The spec is independently type-checkable
       and Playwright-listable from this folder:
         npm install           # devDeps in ./package.json
         npm run typecheck     # tsc noEmit against the spec
         npx playwright test   # list or run the specs (see playwright.config.ts)
       When the M3 Playwright unit lands the kumunita fixture
       implementation, `npx playwright test` will run the three
       specs against `dotnet run` (see playwright.config.ts). -->
  <ItemGroup>
    <None Include="e2e-m2.spec.ts" />
    <None Include="e2e-tags.spec.ts" />
    <None Include="playwright.config.ts" />
    <None Include="package.json" />
    <None Include="package-lock.json" Condition="Exists('package-lock.json')" />
    <None Include="tsconfig.json" />
  </ItemGroup>

</Project>
