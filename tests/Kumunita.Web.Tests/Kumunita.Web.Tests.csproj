<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 (Microsoft.Testing.Platform). Microsoft.NET.Test.Sdk + VSTest bridge
         register the project with VS Test Explorer; `dotnet test` continues to work via MTP. -->
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
      <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" Version="2.4.0" />
      <PackageReference Include="NSubstitute" Version="5.3.0" />
      <PackageReference Include="xunit.v3" Version="4.0.0" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kumunita.Web\Kumunita.Web.csproj" />
  </ItemGroup>

  <!-- e2e-m2.spec.ts is paused (U13 — no Playwright runtime in the repo yet).
       Classified as None so it does not participate in any C# or T4 build path
       and the VS TypeScript service cannot pick it up as a project file.
       When M3 lands the Playwright runtime, move it to a dedicated
       tests/Kumunita.E2E/ project with its own package.json. -->
  <ItemGroup>
    <None Include="e2e-m2.spec.ts" />
  </ItemGroup>

</Project>
