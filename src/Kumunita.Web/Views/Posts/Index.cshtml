@model Kumunita.Web.Models.FeedViewModel
@{
    ViewData["Title"] = $"{Model.ComponentName}";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 style="display:inline;">@Model.ComponentName</h1>
                <span class="text-muted ms-3">(feed)</span>
            </div>
            <a class="btn btn-primary"
               href="@Url.Action("New","Posts")">
                Write a post
            </a>
        </div>

        @if (TempData["info"] is string info)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-info">
                No posts yet here. Write the first one — it will be visible only to
                the audience you choose in the composer below the title.
            </div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var p in Model.Items)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="pe-3">
                            <a href="@Url.Action("Detail","Posts", new { id = p.Id })"
                               class="text-decoration-none fw-semibold">
                                @(!string.IsNullOrWhiteSpace(p.Title) ? p.Title : (p.BodyPreview.Length <= 60 ? p.BodyPreview : p.BodyPreview[..60] + "…"))
                            </a>
                            @if (!string.IsNullOrEmpty(p.ComponentName))
                            {
                                <span class="badge text-bg-light ms-2" title="@p.ComponentName">@p.ComponentName</span>
                            }
                            <p class="mb-0 text-muted small mt-1">@p.BodyPreview</p>
                        </div>
                        <div class="text-end text-muted small">
                            <div>@p.AuthorDisplayName</div>
                            <div>@p.Created.LocalDateTime.ToString("d")</div>
                        </div>
                    </li>
                }
            </ul>

            @if (Model.Total > Model.Items.Count)
            {
                // The feed is intentionally small (a neighborhood, not a
                // firehose), but a hidden-count hint is still useful — it
                // tells the viewer *something* is in this component that
                // they (or their community's rules) can't currently see.
                <p class="text-muted small mt-3">
                    @Model.Total post@(Model.Total == 1 ? "" : "s") in this community;
                    @Model.Items.Count shown to you.
                </p>
            }
        }
    </div>
</div>
