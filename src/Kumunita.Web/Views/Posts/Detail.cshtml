@model Kumunita.Web.Models.PostDetailViewModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = Model.Post.Title ?? "Post";
    string postId = Model.Post.Id;
    // Render-time localization of the report-reason placeholder (the <kw-l>
    // TagHelper always emits a <kw-l> element, so it can't sit inside a
    // placeholder="..." attribute — resolve server-side, the _GrantPickers / Profile/Edit
    // pattern). Same chain the <kw-l> TagHelper uses (M·5/M·8, ADR 0049).
    var _kwL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    var reportReasonPlaceholder = await Translation.GetAsync("posts.report_reason_placeholder", _kwL);
    // Author avatar monogram fallback (the Directory pattern — avatar.ts hides
    // the <img> on the 404 the serving lane fails closed to; see site.css).
    string authorAvatarInitial = !string.IsNullOrWhiteSpace(Model.AuthorDisplayName)
        ? char.ToUpperInvariant(Model.AuthorDisplayName.TrimStart()[0]).ToString()
        : string.Empty;

    // ADR 0022 — translation helpers (in scope for both the post block and the
    // per-reply block below): the enabled-catalog language set with its
    // HasTranslation flag, the set the "add a translation" form offers, and a
    // code→native-name resolver for the chips (never blank — falls back to the
    // code itself).
    var langNames = Model.Languages.ToDictionary(l => l.Code, l => l.NativeName);
    // TD (ADR 0027) — the authored-in language (TD·1) is a first-class variant,
    // so the post's "Add a …" candidate list excludes it (TD·4 / TD2).
    var originalCode = Model.OriginalLanguageCode;
    var missingLanguages = Model.Languages.Where(l => !l.HasTranslation && l.Code != originalCode).ToList();
    string LangName(string code) => langNames.TryGetValue(code, out var n) ? n : code;

    // ADR 0049 — the post's **default-visible** variant is the viewer's current
    // language when a translation exists in it, else the authored-in language
    // (the ADR 0027 floor). One computation, shared by the post block and every
    // reply block below (in scope for both). The ADR 0027 click-to-swap +
    // return path are untouched — only *which* variant shows first changes.
    var defaultVariant = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
    bool originalHidden = Model.PostTranslations.Any(t => String.Equals(t.LanguageCode, defaultVariant, StringComparison.OrdinalIgnoreCase));
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <a href="@Url.Action("Index","Posts", new { componentId = Model.Post.ComponentId })" class="text-muted small">
            &larr; <kw-l key="posts.back_to">back to</kw-l> @Model.CommunityDisplayName
        </a>

        <div class="card mt-2 mb-4">
            <div class="card-body">
                @* Author-only edit + delete entry points (both lanes are
                   author-only at the Web layer — the non-author never sees the
                   buttons, so there is no 403 surface to reach from the
                   detail page). Delete (ADR 0024) is offered only while the
                   post is live — once deleted there is nothing left to edit. *@
                @if (Model.IsAuthor)
                {
                    @* ADR 0037 — the draft banner: only the author ever sees a
                       draft (the draft gate returns the post to the author
                       only), so this block is author-only by construction. The
                       Publish button is the sole lever that clears the draft
                       flag (the author-only publish lane). *@
                    @if (Model.Post.IsDraft)
                    {
                        <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2" role="alert">
                            <span>
                                <span class="badge bg-warning text-dark me-2"><kw-l key="posts.draft_badge">Draft</kw-l></span>
                                <kw-l key="posts.draft_note">This post is a draft — only you can see it. Publish it to make it visible under its audience.</kw-l>
                            </span>
                            <form class="d-inline" method="post" action="@($"/posts/{postId}/publish")">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success">
                                    <kw-l key="posts.publish">Publish</kw-l>
                                </button>
                            </form>
                        </div>
                    }
                }
                @* ADR 0082 — the post's action surface: one ⋮ dropdown (the
                   ADR 0069 / 0071 todo/board idiom). Edit is a link; Report
                   opens a Bootstrap modal; translation add / edit each open
                   a modal; translation remove is a confirm form in the menu;
                   Delete is a confirm form in the menu. The Report is always
                   available (resident-facing intake, C-M3b·1) — it is not
                   gated on IsAuthor. The service's write-lane re-check at
                   POST is the real gate. The dropdown itself is rendered
                   unconditionally so a non-author can still file a report. *@
                <div class="d-flex justify-content-end mb-2">
                        <div class="dropdown">
                            <button class="btn btn-sm action-glyph-btn dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false"
                                    aria-label="@($"Actions for {Model.Post.Title ?? "post"}")">⋮</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (Model.IsAuthor && Model.Post.DeletedAt is null)
                                {
                                    <li>
                                        <a class="dropdown-item text-dark" href="@($"/posts/{postId}/edit")">
                                            <kw-l key="posts.detail_edit">Edit</kw-l>
                                        </a>
                                    </li>
                                }
                                <li>
                                    <button type="button" class="dropdown-item text-dark"
                                            data-bs-toggle="modal" data-bs-target="#report-modal">
                                        <kw-l key="posts.report_button">Report this post</kw-l>
                                    </button>
                                </li>

                                @if (Model.CanTranslate)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    @foreach (var existing in Model.PostTranslations.OrderBy(x => x.LanguageCode))
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item text-dark"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="@($"#post-trans-edit-{existing.LanguageCode}")">
                                                <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                            </button>
                                        </li>
                                    }
                                    @foreach (var lang in missingLanguages)
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item text-dark"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="@($"#post-trans-add-{lang.Code}")">
                                                <kw-l key="posts.translation_add">Add</kw-l> — <b>@LangName(lang.Code)</b>
                                            </button>
                                        </li>
                                    }
                                    @if (Model.PostTranslations.Count > 0)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        @foreach (var existing in Model.PostTranslations.OrderBy(x => x.LanguageCode))
                                        {
                                            <li>
                                                <form method="post" action="@($"/posts/{postId}/translations/remove")"
                                                      data-confirm="Remove this translation?" style="margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <kw-l key="posts.translation_remove">Remove</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    }
                                }

                                @if (Model.IsAuthor && Model.Post.DeletedAt is null)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" action="@($"/posts/{postId}/delete")"
                                              data-confirm="Delete this post? Your replies will remain visible." style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <kw-l key="posts.delete">Delete</kw-l>
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                @if (Model.Post.DeletedAt is null)
                {
                    <div class="d-flex align-items-center gap-2 text-muted small mb-3">
                        <span class="d-inline-flex align-items-center">
                            <img class="avatar" src="/profile/avatar/@Model.AuthorSubjectId" alt=""
                                 data-avatar-fallback>
                            <span class="avatar-mono" style="display:none;">@authorAvatarInitial</span>
                        </span>
                        <span>
                            @Model.AuthorDisplayName &middot; <kw-dt dt="@Model.Post.Created" format="g"></kw-dt>
                            @if (Model.Post.Modified is not null)
                            {
                                <span> — <kw-l key="posts.edited">edited</kw-l> <kw-dt dt="@Model.Post.Modified.Value" format="g"></kw-dt></span>
                            }
                        </span>
                    </div>

                    @* ADR 0044 (TG lane) — the post's tags (display names in the
                       viewer's language, resolved by the controller from the
                       access-scoped read seam). A label, never a gate (C-TG·1):
                       each badge links to the by-tag view (/tags/{slug}); a
                       broken reference is dropped upstream, never an error. *@
                    @if (Model.Tags.Count > 0)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            @foreach (var tag in Model.Tags)
                            {
                                <a class="badge rounded-pill text-bg-light text-decoration-none border"
                                   href="/tags/@tag.Slug">@tag.DisplayedName</a>
                            }
                        </div>
                    }

                    @* TD (ADR 0027) — the authored-in language is the first,
                       default-visible variant; each added translation is a
                       hidden variant; the chip row is a selector that swaps
                       them. This group wrapper is the post's toggle scope. *@
                    <div data-td-group="post">
                        @* Original variant — default-visible unless ADR 0049
                           auto-selects a translation of it into the viewer's
                           language (originalHidden); the swap + return path
                           (ADR 0027) are unchanged either way. *@
                        <div class="td-variant" data-td-variant="@Model.OriginalLanguageCode"
                             @(originalHidden ? Html.Raw(" style=\"display:none\"") : Html.Raw(""))>
                            <h4>
                                @(!string.IsNullOrWhiteSpace(Model.Post.Title)
                                    ? Model.Post.Title
                                    : MarkdownRenderer.PlainTextPreview(Model.Post.Body, 80))
                            </h4>
                            <div class="mb-3 rc-body">
                                @Html.Raw(MarkdownRenderer.RenderHtml(Model.Post.Body))
                            </div>
                        </div>

                        @* One variant per user-added translation — hidden by
                           default, EXCEPT the one matching the viewer's current
                           language, which ADR 0049 shows first (in place of the
                           original); the rest stay hidden behind their chip. *@
                        @foreach (var t in Model.PostTranslations)
                        {
                            bool tDefault = String.Equals(t.LanguageCode, defaultVariant, StringComparison.OrdinalIgnoreCase);
                            <div class="td-variant" data-td-variant="@t.LanguageCode"
                                 @(tDefault ? Html.Raw("") : Html.Raw(" style=\"display:none\""))>
                                @if (!string.IsNullOrWhiteSpace(t.Title))
                                {
                                    <h4>@t.Title</h4>
                                }
                                <div class="mb-3 rc-body">
                                    @Html.Raw(MarkdownRenderer.RenderHtml(t.Body))
                                </div>
                            </div>
                        }

                        @* The chip row — a selector. The original chip is always
                           present (TD·1); one chip per added translation (TD·2).
                           No "None yet" (TD1). *@
                        <div class="mb-3 border-top pt-3">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="text-muted small fw-semibold">
                                    <kw-l key="posts.translations_label">Translations</kw-l>
                                </span>
                                <button type="button" class="badge text-bg-light border"
                                        data-translation-chip data-td-group="post"
                                        data-td-variant="@Model.OriginalLanguageCode">
                                    @LangName(Model.OriginalLanguageCode)
                                </button>
                                @foreach (var t in Model.PostTranslations.OrderBy(x => x.LanguageCode))
                                {
                                    <button type="button" class="badge text-bg-light border"
                                            data-translation-chip data-td-group="post"
                                            data-td-variant="@t.LanguageCode">
                                        @LangName(t.LanguageCode)
                                    </button>
                                }
                            </div>

                            @* ADR 0082 — the translation add / edit / remove lanes
                               are now in the ⋮ dropdown above (modals for add/edit,
                               confirm form for remove). The chip row above is the
                               *selector* — it stays. *@
                        </div>
                    </div>
                }
                else
                {
                    @* ADR 0024 — the post is soft-deleted: the record is kept
                       (replies below remain visible), but the body is
                       replaced by a placeholder (author sees the same thing).
                       No chip row / swap on a deleted post (TD7). *@
                    <div class="mb-3">
                        <div class="alert alert-secondary mb-2" role="alert">
                            <kw-l key="posts.deleted_placeholder">This post has been deleted by its author.</kw-l>
                        </div>
                        <span class="text-muted small">
                            @Model.AuthorDisplayName &middot; <kw-dt dt="@Model.Post.Created" format="g"></kw-dt>
                        </span>
                    </div>
                }

                <div class="text-muted small mb-0">
                    <kw-l key="posts.detail_why">You can see this post because you matched its audience (a grant of yours, or you are the author — the "owner branch" of the C1 empty-audience deny rule).</kw-l>
                </div>
            </div>
        </div>

        @* ADR 0082 — the "Report this" modal (C-M3b·1, F1). The form is
           inside a Bootstrap modal (the ADR 0071 idiom) opened from the ⋮
           dropdown above. The #report-form id is preserved on the form so
           the e2e helper (e2e-m3.spec.ts expandReportForm) can still
           locate it. *@
        <div class="modal fade" id="report-modal" tabindex="-1"
             aria-labelledby="report-modal-label" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form class="mb-0" method="post" id="report-form"
                          action="@($"/posts/{postId}/report")">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="report-modal-label">
                                <kw-l key="posts.report_button">Report this post</kw-l>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label" for="report-reason" style="font-weight:600;">
                                <kw-l key="posts.report_reason_label">What's wrong?</kw-l> <span class="text-muted small">(<kw-l key="posts.report_optional">optional</kw-l>)</span>
                            </label>
                            <textarea class="form-control mb-3" id="report-reason" name="reason" rows="3"
                                      placeholder="@reportReasonPlaceholder"></textarea>
                            <div class="text-muted small">
                                <kw-l key="posts.report_note">Filing a report is an intake action — it doesn't change what you can see, and a moderator may follow up.</kw-l>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <kw-l key="common.cancel">Cancel</kw-l>
                            </button>
                            <button type="submit" class="btn btn-outline-danger" form="report-form">
                                <kw-l key="posts.report_submit">Report</kw-l>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* ADR 0082 — the post's translation modals (referenced by the ⋮
           dropdown above). Each is scoped by language code, so they coexist
           on the same page. *@
        @if (Model.CanTranslate)
        {
            @foreach (var existing in Model.PostTranslations.OrderBy(x => x.LanguageCode))
            {
                <div class="modal fade" id="@($"post-trans-edit-{existing.LanguageCode}")" tabindex="-1"
                     aria-labelledby="@($"post-trans-edit-label-{existing.LanguageCode}")" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form method="post" action="@($"/posts/{postId}/translations/update")"
                                  id="@($"post-trans-edit-form-{existing.LanguageCode}")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                <div class="modal-header">
                                    <h5 class="modal-title" id="@($"post-trans-edit-label-{existing.LanguageCode}")">
                                        <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <label class="form-label mb-1">
                                        <kw-l key="posts.translation_title_label">Title</kw-l> <span class="text-muted small">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                    </label>
                                    <input type="text" class="form-control mb-2" name="title" value="@existing.Title" />
                                    <label class="form-label">
                                        <kw-l key="posts.translation_body_label">Body</kw-l>
                                    </label>
                                    @* RE U06 — image OFF (same RC gap as the
                                       original inline lane). *@
                                    <div class="rc-editor">
                                        <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                            <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                                            <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                                            <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                                            <partial name="_RichEditorToggle" />
                                        </div>
                                        <textarea class="form-control" name="body" rows="4" required placeholder="…" data-rich-editor>@existing.Body</textarea>
                                        <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        <kw-l key="common.cancel">Cancel</kw-l>
                                    </button>
                                    <button type="submit" class="btn btn-primary" form="@($"post-trans-edit-form-{existing.LanguageCode}")">
                                        <kw-l key="posts.translation_save">Save translation</kw-l>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @foreach (var lang in missingLanguages)
            {
                <div class="modal fade" id="@($"post-trans-add-{lang.Code}")" tabindex="-1"
                     aria-labelledby="@($"post-trans-add-label-{lang.Code}")" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form method="post" action="@($"/posts/{postId}/translations")"
                                  id="@($"post-trans-add-form-{lang.Code}")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="languageCode" value="@lang.Code" />
                                <div class="modal-header">
                                    <h5 class="modal-title" id="@($"post-trans-add-label-{lang.Code}")">
                                        <kw-l key="posts.translation_add">Add</kw-l> — <b>@LangName(lang.Code)</b>
                                    </h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <label class="form-label mb-1">
                                        <kw-l key="posts.translation_title_label">Title</kw-l> <span class="text-muted small">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                    </label>
                                    <input type="text" class="form-control mb-2" name="title" value="@Model.Post.Title" />
                                    <label class="form-label">
                                        <kw-l key="posts.translation_body_label">Body</kw-l>
                                    </label>
                                    <div class="rc-editor">
                                        <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                            <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                            <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                                            <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                                            <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                                            <partial name="_RichEditorToggle" />
                                        </div>
                                        <textarea class="form-control" name="body" rows="4" required placeholder="…" data-rich-editor></textarea>
                                        <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        <kw-l key="common.cancel">Cancel</kw-l>
                                    </button>
                                    <button type="submit" class="btn btn-primary" form="@($"post-trans-add-form-{lang.Code}")">
                                        <kw-l key="posts.translation_save">Save translation</kw-l>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }

        <h5 class="mt-4 mb-2" style="font-weight:600;">
            <kw-l key="posts.replies_heading">Replies</kw-l> <span class="text-muted">(@Model.Replies.Count)</span>
        </h5>

        @if (Model.Replies.Count == 0)
        {
            <p class="text-muted"><kw-l key="posts.replies_empty">No replies yet. If you can see this post, you can reply to it.</kw-l></p>
        }
        else
        {
            <ul class="list-group mb-4">
                @foreach (var r in Model.Replies)
                {
                    // Replier avatar — same pattern as the author's above.
                    string replyAvatarInitial = !string.IsNullOrWhiteSpace(r.AuthorDisplayName)
                        ? char.ToUpperInvariant(r.AuthorDisplayName.TrimStart()[0]).ToString()
                        : string.Empty;
                    @* ADR 0085 — the reply-anchor id (the /posts/{id}#reply-{id}
                       fragment a notification link carries). The @section Scripts
                       script below reads location.hash, matches #reply-{id},
                       scrolls that reply into view, and highlights it. *@
                    <li class="list-group-item" id="reply-@r.Id">
                        @* TD (ADR 0027) — the reply's authored-in language is the
                           first, default-visible variant; each added translation
                           is a hidden variant; the chip row is a selector that
                           swaps them. Scope: this reply (data-td-group). *@
                        <div class="d-flex justify-content-between align-items-start">
                            @if (r.DeletedAt is null)
                            {
                                @* ADR 0049 — the reply's default-visible variant
                                   is its translation into the viewer's current
                                   language (when one exists), else the authored-in
                                   original (the ADR 0027 floor). Declared at the
                                   top of this block (before any markup) so it is in
                                   scope for the variant below. *@
                                bool replyOriginalHidden = r.Translations.Any(t => String.Equals(t.LanguageCode, defaultVariant, StringComparison.OrdinalIgnoreCase));
                                <div data-td-group="reply-@r.Id" class="pe-3">
                                    @* Original variant (default-visible unless ADR 0049
                                       auto-selects a translation of it). *@
                                    <div class="td-variant" data-td-variant="@r.OriginalLanguageCode"
                                         @(replyOriginalHidden ? Html.Raw(" style=\"display:none\"") : Html.Raw(""))>
                                        <div class="rc-body">@Html.Raw(MarkdownRenderer.RenderHtml(r.Body))</div>
                                    </div>

                                    @* One variant per user-added translation — hidden by
                                       default, EXCEPT the one matching the viewer's
                                       current language, which ADR 0049 shows first. *@
                                    @foreach (var t in r.Translations)
                                    {
                                        bool tDefault = String.Equals(t.LanguageCode, defaultVariant, StringComparison.OrdinalIgnoreCase);
                                        <div class="td-variant" data-td-variant="@t.LanguageCode"
                                             @(tDefault ? Html.Raw("") : Html.Raw(" style=\"display:none\""))>
                                            <div class="rc-body">@Html.Raw(MarkdownRenderer.RenderHtml(t.Body))</div>
                                        </div>
                                    }

                                    @* Chip row — a selector. Original chip always
                                       present (TD·1); one chip per added
                                       translation (TD·2); no "none yet" (TD4). *@
                                    <div class="d-flex flex-wrap align-items-center gap-1 mt-1">
                                        <span class="text-muted small">
                                            <kw-l key="posts.translations_label">Translations</kw-l>:
                                        </span>
                                        <button type="button" class="badge text-bg-light border"
                                                data-translation-chip data-td-group="reply-@r.Id"
                                                data-td-variant="@r.OriginalLanguageCode">
                                            @LangName(r.OriginalLanguageCode)
                                        </button>
                                        @foreach (var t in r.Translations.OrderBy(x => x.LanguageCode))
                                        {
                                            <button type="button" class="badge text-bg-light border"
                                                    data-translation-chip data-td-group="reply-@r.Id"
                                                    data-td-variant="@t.LanguageCode">
                                                @LangName(t.LanguageCode)
                                            </button>
                                        }
                                    </div>

                                    @* ADR 0082 — the reply's translation add / edit / remove
                                       lanes are now in the ⋮ dropdown below (modals for
                                       add/edit, confirm form for remove). The chip row above
                                       is the *selector* — it stays. *@
                                </div>
                            }
                            else
                            {
                                @* ADR 0024 — the reply is soft-deleted: the
                                   record is kept (it still counts toward the
                                   parent's reply count), but the body is
                                   replaced by a placeholder (no swap, TD7). *@
                                <div class="pe-3">
                                    <span class="text-muted fst-italic">
                                        <kw-l key="posts.reply_deleted_placeholder">This reply has been deleted by its author.</kw-l>
                                    </span>
                                </div>
                            }
                            <div class="text-end text-muted small">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <span class="d-inline-flex align-items-center">
                                        <img class="avatar" src="/profile/avatar/@r.AuthorSubjectId" alt=""
                                             data-avatar-fallback>
                                        <span class="avatar-mono" style="display:none;">@replyAvatarInitial</span>
                                    </span>
                                    <span>@r.AuthorDisplayName</span>
                                    @* ADR 0082 — the reply's action surface: one ⋮ dropdown
                                       (the ADR 0069 / 0071 todo/board idiom). Edit opens a
                                       modal (the rich editor is heavy); Report opens a modal;
                                       translation add / edit open modals; translation remove
                                       + Delete are confirm forms in the menu. Report is always
                                       available (resident-facing intake, ADR 0023) — it is not
                                       gated on IsAuthor. The service's write-lane re-check at
                                       POST is the real gate. *@
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-sm action-glyph-btn dropdown-toggle" type="button"
                                                data-bs-toggle="dropdown" aria-expanded="false"
                                                aria-label="@($"Actions for reply by {r.AuthorDisplayName}")">⋮</button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            @if (r.IsAuthor && r.DeletedAt is null)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item text-dark"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="@($"#reply-edit-modal-{r.Id}")">
                                                        <kw-l key="posts.reply_edit">Edit</kw-l>
                                                    </button>
                                                </li>
                                            }
                                            <li>
                                                <button type="button" class="dropdown-item text-dark"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="@($"#reply-report-modal-{r.Id}")">
                                                    <kw-l key="posts.reply_report_button">Report this reply</kw-l>
                                                </button>
                                            </li>

                                            @if (r.CanTranslate)
                                            {
                                                <li><hr class="dropdown-divider" /></li>
                                                @foreach (var existing in r.Translations.OrderBy(x => x.LanguageCode))
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item text-dark"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="@($"#reply-trans-edit-{r.Id}-{existing.LanguageCode}")">
                                                            <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                                        </button>
                                                    </li>
                                                }
                                                @foreach (var lang in Model.Languages.Where(l => l.Code != r.OriginalLanguageCode && !r.Translations.Any(t => t.LanguageCode == l.Code)))
                                                {
                                                    <li>
                                                        <button type="button" class="dropdown-item text-dark"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="@($"#reply-trans-add-{r.Id}-{lang.Code}")">
                                                            <kw-l key="posts.translation_add">Add</kw-l> — <b>@LangName(lang.Code)</b>
                                                        </button>
                                                    </li>
                                                }
                                                @if (r.Translations.Count > 0)
                                                {
                                                    <li><hr class="dropdown-divider" /></li>
                                                    @foreach (var existing in r.Translations.OrderBy(x => x.LanguageCode))
                                                    {
                                                        <li>
                                                            <form method="post" action="@($"/posts/{postId}/replies/{r.Id}/translations/remove")"
                                                                  data-confirm="Remove this translation?" style="margin:0;">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                                                <button type="submit" class="dropdown-item text-danger">
                                                                    <kw-l key="posts.translation_remove">Remove</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                                                </button>
                                                            </form>
                                                        </li>
                                                    }
                                                }
                                            }

                                            @if (r.IsAuthor && r.DeletedAt is null)
                                            {
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <form method="post" action="@($"/posts/{postId}/replies/{r.Id}/delete")"
                                                          data-confirm="Delete this reply? It will be replaced by a note. The record is kept." style="margin:0;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <kw-l key="posts.reply_delete">Delete</kw-l>
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                                <div>
                                    <kw-dt dt="@r.Created" format="g"></kw-dt>
                                    @if (r.Modified is not null)
                                    {
                                        <span> — <kw-l key="posts.reply_edited">edited</kw-l> <kw-dt dt="@r.Modified.Value" format="g"></kw-dt></span>
                                    }
                                </div>
                            </div>
                        </div>

                        @* ADR 0082 — the reply's modals (one per reply, ids scoped by
                           reply id so multiple replies on the page do not collide).
                           The reply-edit modal carries the full rich editor (the
                           ADR 0016 surface). The reply-report modal is the ADR 0023
                           intake. The translation modals are the ADR 0048 / 0029
                           lanes. *@
                        @if (r.IsAuthor && r.DeletedAt is null)
                        {
                            <div class="modal fade" id="@($"reply-edit-modal-{r.Id}")" tabindex="-1"
                                 aria-labelledby="@($"reply-edit-modal-label-{r.Id}")" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">
                                        <form method="post" action="@($"/posts/{postId}/replies/{r.Id}/edit")"
                                              id="@($"reply-edit-form-{r.Id}")">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="@($"reply-edit-modal-label-{r.Id}")">
                                                    <kw-l key="posts.reply_edit">Edit</kw-l> — <kw-l key="posts.reply_heading">reply</kw-l>
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                @* RE U06 — image OFF (same RC reply-image gap). *@
                                                <div class="rc-editor">
                                                    <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                                        <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                                                        <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                                                        <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                                                        <partial name="_RichEditorToggle" />
                                                    </div>
                                                    <textarea class="form-control" name="body" rows="4"
                                                              required placeholder="…" data-rich-editor>@r.Body</textarea>
                                                    <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    <kw-l key="common.cancel">Cancel</kw-l>
                                                </button>
                                                <button type="submit" class="btn btn-primary" form="@($"reply-edit-form-{r.Id}")">
                                                    <kw-l key="posts.reply_save">Save</kw-l>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="modal fade" id="@($"reply-report-modal-{r.Id}")" tabindex="-1"
                             aria-labelledby="@($"reply-report-modal-label-{r.Id}")" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <form method="post" action="@($"/posts/{postId}/replies/{r.Id}/report")"
                                          id="@($"reply-report-form-{r.Id}")">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="@($"reply-report-modal-label-{r.Id}")">
                                                <kw-l key="posts.reply_report_button">Report this reply</kw-l>
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <label class="form-label" for="@($"reply-report-reason-{r.Id}")" style="font-weight:600;">
                                                <kw-l key="posts.report_reason_label">What's wrong?</kw-l> <span class="text-muted small">(<kw-l key="posts.report_optional">optional</kw-l>)</span>
                                            </label>
                                            <textarea class="form-control mb-2" name="reason" rows="3"
                                                      id="@($"reply-report-reason-{r.Id}")"
                                                      placeholder="@reportReasonPlaceholder"></textarea>
                                            <div class="text-muted small">
                                                <kw-l key="posts.report_note">Filing a report is an intake action — it doesn't change what you can see, and a moderator may follow up.</kw-l>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                <kw-l key="common.cancel">Cancel</kw-l>
                                            </button>
                                            <button type="submit" class="btn btn-outline-danger" form="@($"reply-report-form-{r.Id}")">
                                                <kw-l key="posts.report_submit">Report</kw-l>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        @if (r.CanTranslate)
                        {
                            @foreach (var existing in r.Translations.OrderBy(x => x.LanguageCode))
                            {
                                <div class="modal fade" id="@($"reply-trans-edit-{r.Id}-{existing.LanguageCode}")" tabindex="-1"
                                     aria-labelledby="@($"reply-trans-edit-label-{r.Id}-{existing.LanguageCode}")" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form method="post" action="@($"/posts/{postId}/replies/{r.Id}/translations/update")"
                                                  id="@($"reply-trans-edit-form-{r.Id}-{existing.LanguageCode}")">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="@($"reply-trans-edit-label-{r.Id}-{existing.LanguageCode}")">
                                                        <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <label class="form-label" for="@($"reply-trans-edit-body-{r.Id}-{existing.LanguageCode}")">
                                                        <kw-l key="posts.translation_body_label">Body</kw-l>
                                                    </label>
                                                    @* The original inline reply-translation edit lane was a
                                                       plain textarea (no rc-editor) — preserve that verbatim. *@
                                                    <textarea class="form-control" id="@($"reply-trans-edit-body-{r.Id}-{existing.LanguageCode}")"
                                                              name="body" rows="4" required>@existing.Body</textarea>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                        <kw-l key="common.cancel">Cancel</kw-l>
                                                    </button>
                                                    <button type="submit" class="btn btn-primary" form="@($"reply-trans-edit-form-{r.Id}-{existing.LanguageCode}")">
                                                        <kw-l key="posts.translation_save">Save translation</kw-l>
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }

                            @foreach (var lang in Model.Languages.Where(l => l.Code != r.OriginalLanguageCode && !r.Translations.Any(t => t.LanguageCode == l.Code)))
                            {
                                <div class="modal fade" id="@($"reply-trans-add-{r.Id}-{lang.Code}")" tabindex="-1"
                                     aria-labelledby="@($"reply-trans-add-label-{r.Id}-{lang.Code}")" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form method="post" action="@($"/posts/{postId}/replies/{r.Id}/translations")"
                                                  id="@($"reply-trans-add-form-{r.Id}-{lang.Code}")">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="languageCode" value="@lang.Code" />
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="@($"reply-trans-add-label-{r.Id}-{lang.Code}")">
                                                        <kw-l key="posts.translation_add">Add</kw-l> — <b>@LangName(lang.Code)</b>
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <label class="form-label" for="@($"reply-trans-add-body-{r.Id}-{lang.Code}")">
                                                        <kw-l key="posts.translation_body_label">Body</kw-l>
                                                    </label>
                                                    <div class="rc-editor">
                                                        <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                                            <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                                            <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                                            <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                                            <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                                            <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                                            <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                                                            <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                                            <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                                            <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                                                            <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                                                            <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                                                            <partial name="_RichEditorToggle" />
                                                        </div>
                                                        <textarea class="form-control" id="@($"reply-trans-add-body-{r.Id}-{lang.Code}")"
                                                                  name="body" rows="4" required placeholder="…" data-rich-editor></textarea>
                                                        <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                        <kw-l key="common.cancel">Cancel</kw-l>
                                                    </button>
                                                    <button type="submit" class="btn btn-primary" form="@($"reply-trans-add-form-{r.Id}-{lang.Code}")">
                                                        <kw-l key="posts.translation_save">Save translation</kw-l>
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </li>
                }
            </ul>
        }

        <h5 class="mt-4 mb-2" style="font-weight:600;">
            @if (Model.IsAuthor)
            {
                <text><kw-l key="posts.reply_heading_author">Reply (you are the author of this post)</kw-l></text>
            }
            else
            {
                <text><kw-l key="posts.reply_heading">Reply</kw-l></text>
            }
        </h5>

        <div class="card">
            <div class="card-body">
                <form class="mb-0" method="post"
                      action="@($"/posts/{postId}/replies")">
                    @Html.AntiForgeryToken()
                    <label class="form-label" for="reply-body" style="font-weight:600;">
                        <kw-l key="posts.reply_label">Reply</kw-l>
                    </label>
                    @* RE U06 — image OFF (same RC reply-image gap). *@
                    <div class="rc-editor">
                        <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                            <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                            <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                            <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                            <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                            <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                            <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                            <partial name="_RichEditorToggle" />
                        </div>
                        <textarea class="form-control mb-3" id="reply-body" name="body" rows="3"
                                  required placeholder="…" data-rich-editor></textarea>
                        <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                    </div>
                    @{
                        var replyLanguages =
                            (ViewData["Reply_Languages"] as IReadOnlyList<(string Code, string NativeName)>)
                            ?? new List<(string Code, string NativeName)>();
                    }
                    <div class="mb-3">
                        <label class="form-label" for="reply-language" style="font-weight:600;">
                            <kw-l key="posts.reply_language_label">Language</kw-l>
                        </label>
                        <select class="form-control" id="reply-language" name="languageCode">
                            @foreach (var (languageCode, nativeName) in replyLanguages)
                            {
                                @* ADR 0049 — default to the language the resident is reading in *@
                                <option value="@languageCode" selected="@(String.Equals(languageCode, defaultVariant, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@nativeName</option>
                            }
                        </select>
                        <div class="text-muted small mt-1">
                            <kw-l key="posts.reply_language_note">The language you're replying in — a tag, not a translation.</kw-l>
                        </div>
                    </div>
                    <div class="text-muted small mb-3">
                        <kw-l key="posts.reply_audience_note">Replies have no own audience — they are visible under this post's single audience decision (the C-M3·1 "reply-inherits" rule). You are replying only where the post itself is visible.</kw-l>
                    </div>
                    <button type="submit" class="btn btn-primary"><kw-l key="posts.reply_submit">Reply</kw-l></button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* RE U06 — the rich editor (client/lib/rich-editor.ts, tsc-built).
       Self-wires every .rc-editor block on this page (the four
       name="body" reply textareas); the image button is omitted on all
       of them (data-rich-editor-no-image — RC's reply-image lane is
       unshipped; RE·3). RE·3: no editor dependency. One include covers
       every .rc-editor root the module finds on the page. *@
    <script type="module" src="~/js/lib/rich-editor.js"></script>

    @* ADR 0085 — the reply-highlight (the /posts/{id}#reply-{id} fragment a
       content/reply notification link carries). On load, if the URL hash is a
       reply anchor (#reply-{id}), scroll that reply into view and flash the
       .reply-highlight CSS (a tinted background + a soft outline that fades).
       No module import needed — a plain inline script reading location.hash
       and the DOM. *@
    <script type="module">
        (function highlightReplyFromHash() {
            var hash = window.location.hash || "";
            if (!hash.startsWith("#reply-")) return;
            var el = document.getElementById(hash.slice(1));
            if (!el) return;
            el.scrollIntoView({ behavior: "smooth", block: "center" });
            el.classList.add("reply-highlight");
            // Auto-clear after the flash (the CSS animation owns the fade;
            // the class removal is the belt-and-suspenders reset so a
            // re-click can re-trigger it).
            window.setTimeout(function () { el.classList.remove("reply-highlight"); }, 4000);
        })();
    </script>
}
