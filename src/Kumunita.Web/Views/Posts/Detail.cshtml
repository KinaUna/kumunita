@model Kumunita.Web.Models.PostDetailViewModel
@{
    ViewData["Title"] = Model.Post.Title ?? "Post";
    string postId = Model.Post.Id;
    // Author avatar monogram fallback (the Directory pattern — avatar.ts hides
    // the <img> on the 404 the serving lane fails closed to; see site.css).
    string authorAvatarInitial = !string.IsNullOrWhiteSpace(Model.AuthorDisplayName)
        ? char.ToUpperInvariant(Model.AuthorDisplayName.TrimStart()[0]).ToString()
        : string.Empty;

    // ADR 0022 — translation helpers (in scope for both the post block and the
    // per-reply block below): the enabled-catalog language set with its
    // HasTranslation flag, the set the "add a translation" form offers, and a
    // code→native-name resolver for the chips (never blank — falls back to the
    // code itself).
    var langNames = Model.Languages.ToDictionary(l => l.Code, l => l.NativeName);
    var missingLanguages = Model.Languages.Where(l => !l.HasTranslation).ToList();
    string LangName(string code) => langNames.TryGetValue(code, out var n) ? n : code;
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <a href="@Url.Action("Index","Posts", new { componentId = Model.Post.ComponentId })" class="text-muted small">
            &larr; <kw-l key="posts.back_to">back to</kw-l> @Model.Post.ComponentId
        </a>

        @if (TempData["info"] is string info)
        {
            <div class="alert alert-success mt-2" role="alert">@info</div>
        }
        @if (TempData["error"] is string err)
        {
            <div class="alert alert-danger mt-2" role="alert">@err</div>
        }

        <div class="card mt-2 mb-4">
            <div class="card-body">
                @* Author-only edit entry point (the edit lane is author-only at
                   the Web layer — the non-author never sees the button, so there
                   is no 403 surface to reach from the detail page). *@
                @if (Model.IsAuthor)
                {
                    <div class="d-flex justify-content-end mb-2">
                        <a class="btn btn-sm btn-outline-secondary"
                           href="@($"/posts/{postId}/edit")">
                            <kw-l key="posts.detail_edit">Edit</kw-l>
                        </a>
                    </div>
                }
                <h4>
                    @(!string.IsNullOrWhiteSpace(Model.Post.Title)
                        ? Model.Post.Title
                        : (Model.Post.Body.Length <= 80 ? Model.Post.Body : Model.Post.Body[..80] + "…"))
                </h4>
                <div class="d-flex align-items-center gap-2 text-muted small mb-3">
                    <span class="d-inline-flex align-items-center">
                        <img class="avatar" src="/profile/avatar/@Model.AuthorSubjectId" alt=""
                             data-avatar-fallback>
                        <span class="avatar-mono" style="display:none;">@authorAvatarInitial</span>
                    </span>
                    <span>
                        @Model.AuthorDisplayName &middot; <kw-dt dt="@Model.Post.Created" format="g"></kw-dt>
                        @if (Model.Post.Modified is not null)
                        {
                            <span> — <kw-l key="posts.edited">edited</kw-l> <kw-dt dt="@Model.Post.Modified.Value" format="g"></kw-dt></span>
                        }
                    </span>
                </div>

                <div class="mb-3">
                    @Model.Post.Body
                </div>

                @* ADR 0022 — available translations (chips) + the "add a
                   translation" lane (offered only when CanTranslate). The
                   native <details> disclosure needs no JS (the reply-edit
                   precedent); selecting a language's chip expands its
                   title/body. *@
                @if (Model.PostTranslations.Count > 0 || Model.CanTranslate)
                {
                    <div class="mb-3 border-top pt-3">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="text-muted small fw-semibold">
                                <kw-l key="posts.translations_label">Translations</kw-l>
                            </span>
                            @if (Model.PostTranslations.Count == 0)
                            {
                                <span class="text-muted small"><kw-l key="posts.translations_none">None yet</kw-l></span>
                            }
                            else
                            {
                                @foreach (var t in Model.PostTranslations.OrderBy(x => x.LanguageCode))
                                {
                                    <span class="badge text-bg-light border">@LangName(t.LanguageCode)</span>
                                }
                            }
                        </div>

                        @* Each available translation, expandable. *@
                        @foreach (var t in Model.PostTranslations)
                        {
                            <details class="mb-1">
                                <summary class="btn btn-sm btn-link p-0 text-decoration-none">@LangName(t.LanguageCode)</summary>
                                <div class="ms-2">
                                    @if (!string.IsNullOrWhiteSpace(t.Title))
                                    {
                                        <h5 class="mt-1">@t.Title</h5>
                                    }
                                    <div style="white-space:pre-wrap;">@t.Body</div>
                                </div>
                            </details>
                        }

                        @* The "add a translation" lane — one form per supported
                           language that has no translation yet. *@
                        @if (Model.CanTranslate)
                        {
                            @foreach (var lang in missingLanguages)
                            {
                                <details class="mb-1">
                                    <summary class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <kw-l key="posts.translation_add">Add a</kw-l> <b>@LangName(lang.Code)</b>
                                    </summary>
                                    <form class="ms-2" method="post"
                                          action="@($"/posts/{postId}/translations")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="languageCode" value="@lang.Code" />
                                        <label class="form-label small" for="post-t-title">
                                            @LangName(lang.Code) <kw-l key="posts.translation_title_label">title</kw-l>
                                            <span class="text-muted">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                        </label>
                                        <input class="form-control form-control-sm mb-2" id="post-t-title"
                                               name="title" value="@Model.Post.Title" />
                                        <label class="form-label small" for="post-t-body">
                                            <kw-l key="posts.translation_body_label">Body</kw-l>
                                        </label>
                                        <textarea class="form-control form-control-sm mb-2" id="post-t-body"
                                                  name="body" rows="3" required placeholder="…"></textarea>
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            <kw-l key="posts.translation_save">Save translation</kw-l>
                                        </button>
                                    </form>
                                </details>
                            }
                        }
                    </div>
                }

                <div class="text-muted small mb-0">
                    <kw-l key="posts.detail_why">You can see this post because you matched its audience (a grant of yours, or you are the author — the "owner branch" of the C1 empty-audience deny rule).</kw-l>
                </div>
            </div>
        </div>

        @* M3b U8 — resident-facing "Report this" intake (C-M3b·1, F1).
           The form body stays collapsed; the button expands it. *@
        <form class="card mb-3" method="post"
              action="@($"/posts/{postId}/report")">
            <div class="card-body py-2">
                <button type="button" class="btn btn-sm btn-link text-muted text-decoration-none p-0"
                        data-bs-toggle="collapse" data-bs-target="#report-form"
                        aria-expanded="false" aria-controls="report-form">
                    <kw-l key="posts.report_button">Report this post</kw-l>
                </button>
                <div class="collapse" id="report-form">
                    <label class="form-label mt-3" for="report-reason" style="font-weight:600;">
                        <kw-l key="posts.report_reason_label">What's wrong?</kw-l> <span class="text-muted small">(<kw-l key="posts.report_optional">optional</kw-l>)</span>
                    </label>
                    <textarea class="form-control mb-3" id="report-reason" name="reason" rows="2"
                              placeholder="Optionally add a reason for a moderator…"></textarea>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-muted small">
                            <kw-l key="posts.report_note">Filing a report is an intake action — it doesn't change what you can see, and a moderator may follow up.</kw-l>
                        </div>
                        <button type="submit" class="btn btn-outline-danger ms-2"><kw-l key="posts.report_submit">Report</kw-l></button>
                    </div>
                    @Html.AntiForgeryToken()
                </div>
            </div>
        </form>

        <h5 class="mt-4 mb-2" style="font-weight:600;">
            <kw-l key="posts.replies_heading">Replies</kw-l> <span class="text-muted">(@Model.Replies.Count)</span>
        </h5>

        @if (Model.Replies.Count == 0)
        {
            <p class="text-muted"><kw-l key="posts.replies_empty">No replies yet. If you can see this post, you can reply to it.</kw-l></p>
        }
        else
        {
            <ul class="list-group mb-4">
                @foreach (var r in Model.Replies)
                {
                    // Replier avatar — same pattern as the author's above.
                    string replyAvatarInitial = !string.IsNullOrWhiteSpace(r.AuthorDisplayName)
                        ? char.ToUpperInvariant(r.AuthorDisplayName.TrimStart()[0]).ToString()
                        : string.Empty;
                    <li class="list-group-item">
                        @* ADR 0022 — the reply's available translations + the
                           "add a translation" lane (offered only when r.CanTranslate). *@
                        @if (r.Translations.Count > 0 || r.CanTranslate)
                        {
                            <div class="mb-2 pe-3">
                                <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                                    @if (r.Translations.Count == 0)
                                    {
                                        <span class="text-muted small">
                                            <kw-l key="posts.translations_label">Translations</kw-l>: <kw-l key="posts.translations_none">none yet</kw-l>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <kw-l key="posts.translations_label">Translations</kw-l>:
                                        </span>
                                        @foreach (var t in r.Translations.OrderBy(x => x.LanguageCode))
                                        {
                                            <span class="badge text-bg-light border">@LangName(t.LanguageCode)</span>
                                        }
                                    }
                                </div>
                                @foreach (var t in r.Translations)
                                {
                                    <details class="mb-1">
                                        <summary class="btn btn-sm btn-link p-0 text-decoration-none">@LangName(t.LanguageCode)</summary>
                                        <div class="ms-2" style="white-space:pre-wrap;">@t.Body</div>
                                    </details>
                                }
                                @if (r.CanTranslate)
                                {
                                    @foreach (var lang in missingLanguages)
                                    {
                                        <details class="mb-1">
                                            <summary class="btn btn-sm btn-link p-0 text-decoration-none">
                                                <kw-l key="posts.translation_add">Add a</kw-l> <b>@LangName(lang.Code)</b>
                                            </summary>
                                            <form class="ms-2" method="post"
                                                  action="@($"/posts/{postId}/replies/{r.Id}/translations")">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="languageCode" value="@lang.Code" />
                                                <label class="form-label small" for="reply-t-body">
                                                    <kw-l key="posts.translation_body_label">Body</kw-l>
                                                </label>
                                                <textarea class="form-control form-control-sm mb-2" id="reply-t-body"
                                                          name="body" rows="3" required placeholder="…"></textarea>
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    <kw-l key="posts.translation_save">Save translation</kw-l>
                                                </button>
                                            </form>
                                        </details>
                                    }
                                }
                            </div>
                        }
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="pe-3" style="white-space:pre-wrap;">@r.Body</div>
                            <div class="text-end text-muted small">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <span class="d-inline-flex align-items-center">
                                        <img class="avatar" src="/profile/avatar/@r.AuthorSubjectId" alt=""
                                             data-avatar-fallback>
                                        <span class="avatar-mono" style="display:none;">@replyAvatarInitial</span>
                                    </span>
                                    <span>@r.AuthorDisplayName</span>
                                    @* Author-only reply edit (ADR 0016) — the
                                       native <details> disclosure needs no JS;
                                       a non-author never sees it (r.IsAuthor). *@
                                    @if (r.IsAuthor)
                                    {
                                        <details class="d-inline-block">
                                            <summary class="btn btn-sm btn-link p-0 text-decoration-none"><kw-l key="posts.reply_edit">Edit</kw-l></summary>
                                            <form class="mt-2 text-start" method="post"
                                                  action="@($"/posts/{postId}/replies/{r.Id}/edit")">
                                                @Html.AntiForgeryToken()
                                                <textarea class="form-control mb-2" name="body" rows="3"
                                                          required placeholder="…">@r.Body</textarea>
                                                <button type="submit" class="btn btn-sm btn-primary"><kw-l key="posts.reply_save">Save</kw-l></button>
                                            </form>
                                        </details>
                                    }
                                </div>
                                <div>
                                    <kw-dt dt="@r.Created" format="g"></kw-dt>
                                    @if (r.Modified is not null)
                                    {
                                        <span> — <kw-l key="posts.reply_edited">edited</kw-l> <kw-dt dt="@r.Modified.Value" format="g"></kw-dt></span>
                                    }
                                </div>
                            </div>
                        </div>
                        @* ADR 0023 — the reply-report-target lane (resident-facing
                           intake, mirroring the post-report form above). A native
                           <details> (the ADR 0016 per-reply-edit precedent) — one
                           per reply, no JS dependency, no id collision. *@
                        <details class="mt-2">
                            <summary class="btn btn-sm btn-link p-0 text-decoration-none">
                                <kw-l key="posts.reply_report_button">Report this reply</kw-l>
                            </summary>
                            <form class="mt-2 text-start" method="post"
                                  action="@($"/posts/{postId}/replies/{r.Id}/report")">
                                @Html.AntiForgeryToken()
                                <label class="form-label small mb-1" style="font-weight:600;">
                                    <kw-l key="posts.report_reason_label">What's wrong?</kw-l> <span class="text-muted">(<kw-l key="posts.report_optional">optional</kw-l>)</span>
                                </label>
                                <textarea class="form-control mb-2" name="reason" rows="2"
                                          placeholder="Optionally add a reason for a moderator…"></textarea>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="text-muted small">
                                        <kw-l key="posts.report_note">Filing a report is an intake action — it doesn't change what you can see, and a moderator may follow up.</kw-l>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-2"><kw-l key="posts.report_submit">Report</kw-l></button>
                                </div>
                            </form>
                        </details>
                    </li>
                }
            </ul>
        }

        <h5 class="mt-4 mb-2" style="font-weight:600;">
            @if (Model.IsAuthor)
            {
                <text><kw-l key="posts.reply_heading_author">Reply (you are the author of this post)</kw-l></text>
            }
            else
            {
                <text><kw-l key="posts.reply_heading">Reply</kw-l></text>
            }
        </h5>

        <div class="card">
            <div class="card-body">
                <form class="mb-0" method="post"
                      action="@($"/posts/{postId}/replies")">
                    @Html.AntiForgeryToken()
                    <label class="form-label" for="reply-body" style="font-weight:600;">
                        <kw-l key="posts.reply_label">Reply</kw-l>
                    </label>
                    <textarea class="form-control mb-3" id="reply-body" name="body" rows="3"
                              required
                              placeholder="…"></textarea>
                    @{
                        var replyLanguages =
                            (ViewData["Reply_Languages"] as IReadOnlyList<(string Code, string NativeName)>)
                            ?? new List<(string Code, string NativeName)>();
                    }
                    <div class="mb-3">
                        <label class="form-label" for="reply-language" style="font-weight:600;">
                            <kw-l key="posts.reply_language_label">Language</kw-l>
                        </label>
                        <select class="form-control" id="reply-language" name="languageCode">
                            @foreach (var (languageCode, nativeName) in replyLanguages)
                            {
                                <option value="@languageCode">@nativeName</option>
                            }
                        </select>
                        <div class="text-muted small mt-1">
                            <kw-l key="posts.reply_language_note">The language you're replying in — a tag, not a translation.</kw-l>
                        </div>
                    </div>
                    <div class="text-muted small mb-3">
                        <kw-l key="posts.reply_audience_note">Replies have no own audience — they are visible under this post's single audience decision (the C-M3·1 "reply-inherits" rule). You are replying only where the post itself is visible.</kw-l>
                    </div>
                    <button type="submit" class="btn btn-primary"><kw-l key="posts.reply_submit">Reply</kw-l></button>
                </form>
            </div>
        </div>
    </div>
</div>
