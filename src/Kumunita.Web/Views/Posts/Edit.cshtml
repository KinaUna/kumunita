@model Kumunita.Web.Models.PostComposeViewModel
@{
    ViewData["Title"] = "Edit post";
    string[] modes = { "Any", "All" };
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <a href="@($"/posts/{ViewContext.RouteData.Values["id"]}")" class="btn btn-link p-0">
            &larr; Back to the post
        </a>

        <h1 class="mt-2"><kw-l key="posts.edit_title">Edit post</kw-l></h1>
        <p class="text-muted">
            You are editing your own post. Only you can edit it. The
            <b>community</b> this post appears in is fixed — it cannot be
            changed after you post; only the title, body, language, and
            audience below are editable.
        </p>

        @if (TempData["info"] is string info)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model.Components.Count == 0)
        {
            <div class="alert alert-warning">
                This post's community feed is no longer available. You can
                still edit the title, body, and audience below.
            </div>
        }

        <form id="edit-post-form" method="post"
              action="@($"/posts/{ViewContext.RouteData.Values["id"]}/edit")">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="component" style="font-weight:600;">
                        Community (the feed this post appears in — fixed)
                    </label>
                    <select class="form-control" id="component" name="ComponentId" disabled>
                        @foreach (var (id, name) in Model.Components)
                        {
                            <option value="@id" selected="@(id == Model.ComponentId ? "selected" : null)">
                                @name
                            </option>
                        }
                    </select>
                    <input type="hidden" name="ComponentId" value="@Model.ComponentId" />
                    <div class="text-muted small mt-2">
                        The community only decides which feed your post appears
                        in — it does not decide who can see it, and it is fixed
                        once posted.
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label class="form-label" for="title" style="font-weight:600;">
                                <kw-l key="common.title">Title</kw-l>
                            </label>
                            <input class="form-control" type="text" id="title" name="Title"
                                   maxlength="120" value="@Model.Title"
                                   placeholder="optional" />
                            <div class="text-muted small mt-1">
                                <kw-l key="posts.title_hint">A short headline (up to 120 characters). Leave blank for a body-only post — the list will show your first line of the body instead.</kw-l>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col">
                            <label class="form-label" for="body" style="font-weight:600;">
                                <kw-l key="common.body">Body</kw-l>
                            </label>
                            <div class="rc-editor">
                                <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                    <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                                    <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                                    <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                                    <partial name="_RichEditorToggle" />
                                </div>
                                <textarea class="form-control" id="body" name="Body" rows="6" required
                                          placeholder="…" data-rich-editor>@Model.Body</textarea>
                                <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="language" style="font-weight:600;">
                        <kw-l key="common.language">Language</kw-l>
                    </label>
                    <select class="form-control" id="language" name="LanguageCode">
                        @foreach (var (languageCode, nativeName) in Model.Languages)
                        {
                            <option value="@languageCode" selected="@(languageCode == Model.LanguageCode ? "selected" : null)">
                                @nativeName
                            </option>
                        }
                    </select>
                    <div class="text-muted small mt-2">
                        <kw-l key="posts.language_hint">The language you're writing this post in. This is only a tag — it is not translated — and it keeps the text findable later and lets a reader add their own language version if they want.</kw-l>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">                    <label class="form-label" for="tags" style="font-weight:600;">Tags</label>
                    @* TG U8 — the composer tag input (a free-text field +
                       autocomplete dropdown). `data-tag-suggest` is the
                       self-wire selector for client/lib/tag-suggest.ts
                       (tsc-only, no editor dependency — RE·3); the module
                       creates the chips, the dropdown, and the hidden
                       `TagIds` submission field around this input. The
                       filter (starts_with(displayName) OR starts_with(slug),
                       ≤ 10) is **server-side** via POST /api/tags/suggest
                       (the SuggestAsync seam, C-TG·2 / C-TG·4); this input
                       only commits the author's typed text. The label +
                       placeholder are plain text (the `_PageForm`
                       field-label convention — a `placeholder` is an HTML
                       attribute, and the kw-l TagHelper renders an element,
                       so it cannot wrap an attribute). *@
                    @* ADR 0044 (TG lane) — the edit lane pre-seeds the post's
                       existing tag slugs as starting chips (each removable;
                       re-saving with fewer chips detaches). Slugs are
                       charset-safe (lowercase letters/digits/hyphen/underscore),
                       so the JSON array has no single quotes and is safe to
                       inline in a single-quoted HTML attribute. Empty list ⇒
                       "[]" ⇒ no chips (new/untagged post behaves as before). *@
                    <input class="form-control" type="text" id="tags"
                           data-tag-suggest
                           data-tag-suggest-initial='@System.Text.Json.JsonSerializer.Serialize(Model.ExistingTagSlugs)'
                           maxlength="64"
                           placeholder="e.g. sanitation, budget, maple-street" />
                    <div class="text-muted small mt-1">
                        <kw-l key="tag.input.hint">Type to search existing tags, or start a new one — it attaches to this post.</kw-l>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">                    <h6 class="card-title" style="font-weight:600;">
                        Audience — who can see this post
                    </h6>

                    @* ADR 0036 — the "Everyone in this community" checkbox
                       is bound (Audience.CommunityVisible) and seeded from
                       the post's stored audience (FromAudience). The
                       granular picker block below stays hidden until the
                       checkbox is turned off (the page script in
                       @section Scripts drives the show/hide). Without
                       this checkbox the edit POST would bind
                       CommunityVisible to <c>false</c> (field absent) and
                       silently flip a community-visible post back to
                       owner-only. *@
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               name="Audience.CommunityVisible"
                               id="aud-community" data-audience-toggle
                               value="true"
                               @(Model.Audience?.CommunityVisible ?? false ? "checked" : null) />
                        <label class="form-check-label fw-semibold" for="aud-community">
                            <kw-l key="posts.audience_all_members">Everyone in this community</kw-l>
                        </label>
                        <div class="text-muted small ms-4">
                            <kw-l key="posts.audience_all_members_hint_edit">When on, every member of this community can see the post. Turn it off to narrow the audience to specific people or groups.</kw-l>
                        </div>
                    </div>

                    <hr class="my-3" />

                    @* The granular audience block — hidden by default
                       (ADR 0036) unless the post already carries an
                       explicit grant list (seeded visible by
                       <c>AudienceEditorModel.FromAudience</c>). The
                       hidden <c>Grants</c> textarea inside _GrantPickers
                       stays the ONLY form-bound grant field (the
                       U11 / F13 single-source pin) regardless of
                       visibility. *@
                    <div id="audience-restricted" data-audience-panel
                         class="audience-restricted"
                         @(Model.Audience is { IsEmpty: false } ? null : "d-none")>
                        <div class="form-label mt-2" style="font-weight:600;">
                            <kw-l key="posts.audience_combine">How the picks combine</kw-l>
                        </div>
                        @foreach (var m in modes)
                        {
                            var checkedMark =
                                string.Equals(Model.Audience?.Mode, m, StringComparison.OrdinalIgnoreCase)
                                    ? "checked"
                                    : null;
                            <div class="form-check" style="margin-left:0.5rem;">
                                <input class="form-check-input" type="radio"
                                       name="Audience.Mode" id="@($"aud-mode-{m}")"
                                       value="@m" @checkedMark required />
                                <label class="form-check-label" for="@($"aud-mode-{m}")">
                                    @m @(" — " + (m == "Any"
                                        ? "a viewer matches if they're on any of the picks"
                                        : "a viewer must be on every pick — an empty list denies everyone"))
                                </label>
                            </div>
                        }

                        <div class="text-muted small mt-2">
                            <kw-l key="posts.audience_restrict_hint">These picks are ADDITIONAL — “Everyone in this community” stays on unless you turn it off, so the post is visible to the whole community and the picks you make here.</kw-l>
                        </div>

                        @* "Who to grant to" — the shared picker partial
                           (Views/Shared/_GrantPickers.cshtml). Checkboxes
                           are display-only (no name=) — the hidden
                           <c>Grants</c> textarea the partial renders is
                           the only form-bound grant field, posting as
                           <c>Audience.Grants</c>; the
                           <c>_GrantPickerScripts</c> partial keeps the
                           textarea in two-way sync with the selection.
                           The picker pre-checks the post's current grants
                           (seeded by <c>AudienceEditorModel.FromAudience</c>). *@
                        <partial name="_GrantPickers" model="@(new GrantPickersModel
                        {
                            EditorName = "Audience",
                            Editor     = Model.Audience
                                        ?? new AudienceEditorModel { Mode = "Any", Grants = string.Empty },
                            Users      = (ViewData["Audience_Users"]  as List<GrantOption>) ?? new List<GrantOption>(),
                            Groups     = (ViewData["Audience_Groups"] as List<GrantOption>) ?? new List<GrantOption>(),
                        })" />

                        @if (Model.Audience is not null
                            && Model.Audience.IsEmpty)
                        {
                            <div class="alert alert-warning mt-2 mb-0">
                                <b>Empty audience.</b>
                                <text>With no picks, no one
                                matches, so no one else can see your post — only
                                you (the author) can.
                                </text>
                            </div>
                        }

                        <small class="text-muted d-block mt-2">
                            <kw-l key="posts.audience_only_picks">Whatever you pick here becomes the post's audience — nothing above or below this form is added to it. An empty pick (with “Everyone in this community” off) means only you can see the post.</kw-l>
                        </small>
                    </div><!-- /#audience-restricted -->
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><kw-l key="posts.edit_save">Save changes</kw-l></button>
                <a href="@($"/posts/{ViewContext.RouteData.Values["id"]}")"
                   class="btn btn-outline-secondary"><kw-l key="common.cancel">Cancel</kw-l></a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @* The rich editor (RE U03, client/lib/rich-editor.ts, tsc-built —
       the toolbar + live preview pane. Self-wires the .rc-editor surface.
       RE·3: no editor dependency. *@
    <script type="module" src="~/js/lib/rich-editor.js"></script>

    @* TG U8 — the composer tag-input autocomplete (client/lib/tag-suggest.ts,
       tsc-built, no editor dependency — the RE·3 idiom). Self-wires any
       input[data-tag-suggest] (the Tags field above); the filter + ≤ 10 cap
       are server-side via POST /api/tags/suggest (the SuggestAsync seam,
       C-TG·2 / C-TG·4; the privacy-pin holds because the server returns only
       the actor-readable set). *@
    <script type="module" src="~/js/lib/tag-suggest.js"></script>

    @* The grant-picker sync (shared with Profile/Edit — the
       <c>_GrantPickerScripts</c> partial): keeps the hidden
       <c>Audience.Grants</c> textarea in two-way sync with the
       checkbox pickers above; the textarea is the only element
       posted. *@
    <partial name="_GrantPickerScripts" />

    @* ADR 0036 — hide/show the granular audience block based on the
       "Everyone in this community" checkbox: checked (the default for
       community-visible posts) keeps the picker out of sight;
       unchecking reveals it. Server-rendered state is authoritative
       on load (already-correct class); this only reacts to user
       changes. *@
    @* Audience-toggle handled by client/lib/audience-toggle.js (loaded in
       _Layout.cshtml — SECURITY.md §6). *@
}
