@model Kumunita.Web.Models.GuestAdminViewModel
@{
    ViewData["Title"] = "Admin — Guests";
}

<div class="mb-2"><a href="/admin" class="btn btn-link p-0">&larr; <kw-l key="nav.admin">Admin</kw-l></a></div>

<h1 class="mt-2"><kw-l key="admin.guests_title">Guest accounts</kw-l></h1>

<p class="text-muted">
    <kw-l key="admin.guests.lede">The limited, time-bounded standing an admin settles for a guest (a consultant, coach, teacher, speaker, or similar outside-the-resident-circle account). A guest is never a full member: they see only the surfaces you allow, for the window you set.</kw-l></p>

@if (!Model.HasStanding)
{
    <div class="alert alert-light border text-muted small">
        <kw-l key="admin.guests_empty">No guest accounts yet.</kw-l>
    </div>
}

<form method="post" action="/admin/guests">
    @Html.AntiForgeryToken()

    <div class="row g-3 mb-3">
        <div class="col-sm-12">
            <label for="subjectId" class="form-label"><kw-l key="admin.guests.subject_label">Guest subject id</kw-l></label>
            <input type="text" class="form-control" name="subjectId" id="subjectId"
                   value="@Model.SubjectId" required />
            <div class="form-text">
                <kw-l key="admin.guests.subject_hint">The guest account's subject id (the SubjectId of the Profile / User row for the account the guest signs in with). One allowance document per guest account.</kw-l></div>
        </div>
    </div>

    <fieldset class="mb-3">
        <legend class="form-label h6 mb-2">
            <kw-l key="admin.guests_window_label">Access window</kw-l>
        </legend>
        <div class="row g-3">
            <div class="col-sm-6">
                <label for="validFrom" class="form-label small"><kw-l key="admin.guests.from">From (inclusive)</kw-l></label>
                <input type="datetime-local" class="form-control" name="validFrom" id="validFrom"
                       value="@Model.ValidFrom.ToString("yyyy-MM-ddTHH:mm")" required />
            </div>
            <div class="col-sm-6">
                <label for="validUntil" class="form-label small"><kw-l key="admin.guests.until">Until (exclusive)</kw-l></label>
                <input type="datetime-local" class="form-control" name="validUntil" id="validUntil"
                       value="@Model.ValidUntil.ToString("yyyy-MM-ddTHH:mm")" required />
                <div class="form-text">
                    <kw-l key="admin.guests.window_hint">The standing is live from the From time up to, but not including, the Until time — a guest outside that window has no standing.</kw-l>
                </div>
            </div>
        </div>
    </fieldset>

    <fieldset class="mb-3">
        <legend class="form-label h6 mb-2">
            <kw-l key="admin.guests_surfaces_label">Allowed surfaces</kw-l>
        </legend>
        <div class="row g-2">
            <div class="col-sm-4 col-md-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="surface-announcements" name="announcements" value="true"
                           @(Model.Announcements ? "checked" : null) />
                    <label class="form-check-label" for="surface-announcements">
                        <kw-l key="admin.guests_surface_announcements">Announcements</kw-l>
                    </label>
                </div>
            </div>
            <div class="col-sm-4 col-md-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="surface-events" name="events" value="true"
                           @(Model.Events ? "checked" : null) />
                    <label class="form-check-label" for="surface-events">
                        <kw-l key="admin.guests_surface_events">Events</kw-l>
                    </label>
                </div>
            </div>
            <div class="col-sm-4 col-md-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="surface-directory" name="directory" value="true"
                           @(Model.Directory ? "checked" : null) />
                    <label class="form-check-label" for="surface-directory">
                        <kw-l key="admin.guests_surface_directory">Directory</kw-l>
                    </label>
                </div>
            </div>
        </div>
        @if (!Model.HasSurfaces)
        {
            <div class="form-text">
                <kw-l key="admin.guests.no_surfaces">No surfaces selected — the guest signs in to a shell with no gated content (the least-privileged floor, not an error).</kw-l>
            </div>
        }
    </fieldset>

    <button type="submit" class="btn btn-primary">
        <kw-l key="admin.guests_create">Create guest</kw-l>
    </button>
</form>
