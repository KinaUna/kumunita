@model Kumunita.Web.Models.AnalyticsViewModel
@{
    ViewData["Title"] = "Admin — Analytics";
}
@functions {
    @* M34 Trend sparkline (M34·9 — server-rendered, no JS / chart lib).
       Maps the window's daily-total points (ascending) to a <polyline>
       points string in a 100×40 viewBox, normalised to the window's
       min/max (a flat window renders a flat mid line). One point per day
       present — gaps are simply not plotted (the M34·7 / M33-9 FACE). *@
    static string TrendPoints(IReadOnlyList<Kumunita.Core.Usage.UsageDailyTotal> pts)
    {
        if (pts.Count == 0) return "";
        if (pts.Count == 1) return "0,20 100,20";
        double[] vals = new double[pts.Count];
        double max = double.MinValue, min = double.MaxValue;
        for (int i = 0; i < pts.Count; i++)
        {
            double d = pts[i].Total;
            vals[i] = d;
            if (d > max) max = d;
            if (d < min) min = d;
        }
        const double W = 100, H = 40, pad = 2;
        double range = max - min;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < vals.Length; i++)
        {
            double x = W * i / (vals.Length - 1);
            double norm = range > 0 ? (vals[i] - min) / range : 0.5;
            double y = H - pad - norm * (H - 2 * pad);
            if (i > 0) sb.Append(' ');
            sb.Append($"{x:0.##} {y:0.##}");
        }
        return sb.ToString();
    }
}

@* The /admin section sub-nav (the ADR 0062 nav-tabs idiom): the "Analytics"
   tab is the strip's sixth entry (the ADR 0114 D4 surface). The partial
   lives in Views/Admin/ (the AdminController's own section), so this view
   — sitting in Views/AdminAnalytics/ — must reference it absolutely. *@
@await Html.PartialAsync("~/Views/Admin/_AdminNav.cshtml")

<h1><kw-l key="admin.analytics_title">Usage analytics</kw-l></h1>
<p class="text-muted">
    <kw-l key="admin.analytics_lede">A local summary of how the platform is used — a request count, the signed-in / anonymous split, the number of distinct accounts, and the per-surface ranking, over a fixed window. No per-account detail is shown; the raw rows are the operator's psql surface.</kw-l>
</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="visually-hidden" for="window"><kw-l key="admin.analytics_window">Window</kw-l></label>
        <select id="window" name="window" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="7"  selected="@(Model.WindowDays == 7  ? "selected" : null)">7</option>
            <option value="30" selected="@(Model.WindowDays == 30 ? "selected" : null)">30</option>
            <option value="90" selected="@(Model.WindowDays == 90 ? "selected" : null)">90</option>
        </select>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th><kw-l key="admin.analytics_window">Window</kw-l></th>
                <th class="text-end"><kw-l key="admin.analytics_total">Total requests</kw-l></th>
                <th class="text-end"><kw-l key="admin.analytics_authenticated">Signed-in</kw-l></th>
                <th class="text-end"><kw-l key="admin.analytics_anonymous">Anonymous</kw-l></th>
                <th class="text-end"><kw-l key="admin.analytics_distinct">Distinct accounts</kw-l></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.WindowDays d</td>
                <td class="text-end">@Model.Total</td>
                <td class="text-end">@Model.AuthenticatedTotal</td>
                <td class="text-end">@Model.AnonymousTotal</td>
                <td class="text-end">@Model.DistinctActors</td>
            </tr>
        </tbody>
    </table>
</div>

<h2 class="mt-4"><kw-l key="admin.analytics_surface">Surface</kw-l></h2>
<div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th><kw-l key="admin.analytics_surface">Surface</kw-l></th>
                <th class="text-end"><kw-l key="admin.analytics_count">Count</kw-l></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.SurfaceRanking)
            {
                <tr>
                    <td>@r.Surface</td>
                    <td class="text-end">@r.Total</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="mt-3">
    <a class="btn btn-outline-primary btn-sm"
       href="/admin/analytics/export?window=@Model.WindowDays">
        <kw-l key="admin.analytics_export">Export CSV</kw-l>
    </a>
</p>

@* ── M34 analytics-history Trend section (M34·8 additive-only, M34·9) ──
   The over-time half the M13 point-in-time surface defers (ADR 0114 §"deferred
   lanes" item 1 — the "Charts" deferral M34 settles). A per-day table
   (date · total, ascending) + an inline <svg> sparkline (the daily total over
   the window) + a window selector (7/30/90/180/365, the active one marked).
   No JS, no chart library — server-rendered (M34·9). The labels are the closed
   analytics.trend.* kw-l set (U05 authors the values; this view references
   them, the kw-l TagHelper resolves them per request, the inner English text
   is the ADR 0015 D1 provider floor). The M13 surface-rank table + the
   distinct-actor header above are **unchanged** (M34·1 additive-only). *@
<h2 class="h5 mt-5"><kw-l key="analytics.trend.title">Trend</kw-l></h2>

@* The window selector — five links (7/30/90/180/365, the M34·7 pinned set),
   the active one (Model.TrendWindowDays) marked via the btn-primary style
   rather than btn-outline (a plain class toggle, no kw-l dependency on the
   state). **Option-B seam (ADR 0162 close resolution):** the links point at
   the Trend section's **own** <c>?trendwindow=</c> param (pinned
   {7, 30, 90, 180, 365}), preserving the M13 <c>?window=</c> value — so
   180/365 render the Trend end-to-end without tripping the frozen M13
   <c>GetWindowAsync</c> window guard (the red pin the U06/U07 gate recorded
   is resolved by this decoupling). A plain class toggle + ?trendwindow=
   link (the M33 selector idiom); no kw-l tag inside a quoted attribute value
   (the Razor attribute trap). *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    @{ int tw = Model.TrendWindowDays; }
    @for (int w = 0; w < 5; w++)
    {
        int win = new[] { 7, 30, 90, 180, 365 }[w];
        string key = "analytics.trend.window." + win;
        string cls = (win == tw) ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";
        <a class="@cls" href="/admin/analytics?window=@Model.WindowDays&trendwindow=@win"><kw-l key="@key">@win days</kw-l></a>
    }
</div>

@if (Model.History.Count == 0)
{
    @* M34-3 FACE — an empty history (a fresh instance, no UsageEvent rows in
       the window yet) renders the empty message, not a blank and not an
       error (M34·11 — the closed analytics.trend.* kw-l set). *@
    <p class="text-muted"><kw-l key="analytics.trend.empty">No usage recorded in this window yet.</kw-l></p>
}
else
{
    @* The sparkline — an inline <svg> <polyline> over the window's daily-total
       points (TrendPoints normalises to a 100×40 viewBox).
       preserveAspectRatio="none" lets it stretch to its container width.
       No JS, no chart library (M34·9). *@
    <div class="mb-3">
        <svg viewBox="0 0 100 40" preserveAspectRatio="none"
             class="d-block" style="width:100%;height:80px;background:#f8f9fa;">
            <polyline points="@TrendPoints(Model.History)"
                      fill="none" stroke="#0d6efd" stroke-width="1"
                      vector-effect="non-scaling-stroke" />
        </svg>
        <div class="text-muted small mt-1"><kw-l key="analytics.trend.legend.total">Total requests per day</kw-l></div>
    </div>

    @* The per-day table — one row per present day, ascending (the seam orders
       it). The Date column via the kw-dt TagHelper (the request's locale);
       the Total column is the per-day aggregate — never a per-account row
       (C-M13·3 / M34·9 — the ActorId / RouteTemplate are never shown). *@
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th><kw-l key="analytics.trend.col.date">Date</kw-l></th>
                    <th class="text-end"><kw-l key="analytics.trend.col.total">Total requests</kw-l></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.History)
                {
                    <tr>
                        <td><kw-dt dt="@p.Date" format="d"></kw-dt></td>
                        <td class="text-end">@p.Total</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
