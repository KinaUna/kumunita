@model Kumunita.Web.Models.TodoDetailViewModel
@using Kumunita.Web.Security
@using Kumunita.Web.Views.Shared
@using Kumunita.Core.Projects
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Todo.Title) ? "To-do" : Model.Todo.Title;
    // ADR 0049 — the resident's current effective language (the comment
    // form's language picker default: "write in the language you're reading
    // in"), resolved through the same chain the <c>&lt;kw-l&gt;</c>
    // TagHelper resolves UI strings in.
    var defaultVariant = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);

    // The remove-translation form's data-confirm (the ADR 0072 attribute
    // idiom — the confirm.js seam reads the attribute verbatim; the kw-l
    // TagHelper can't wrap an attribute). The en floor is the server fallback
    // (a null provider — a non-HTTP render — degrades to en).
    string confirmRemoveTrans = "Remove this translation?";
    // The action menu + modal close buttons carry accessible names the kw-l
    // TagHelper can't wrap (an attribute) — server-resolved, same idiom (the
    // a11y.* closed set is the floor). The en floor is the server fallback
    // (a null provider — a non-HTTP render — degrades to en).
    string ariaClose      = "Close";
    string ariaActionsFor = "Actions for {0}";
    if (Translation is not null)
    {
        confirmRemoveTrans = await Translation.GetAsync("common.remove_translation_confirm", defaultVariant);
        ariaClose          = await Translation.GetAsync("a11y.close", defaultVariant);
        ariaActionsFor     = await Translation.GetAsync("a11y.actions_for", defaultVariant);
    }
    // ADR 0069 — the fixed status vocabulary's label keys (the same closed
    // set the Kanban lane's Set-status select offers: None + the four codes).
    static string StatusLabelKey(string code) => code switch
    {
        KanbanStatuses.NotStarted => "projects.board.status.not_started",
        KanbanStatuses.InProgress => "projects.board.status.in_progress",
        KanbanStatuses.Done => "projects.board.status.done",
        KanbanStatuses.Cancelled => "projects.board.status.cancelled",
        _ => "projects.board.status.none",
    };
    // ADR 0082 — the LangName helper: resolve a language code to its native
    // name from Model.Languages (the ADR 0082 idiom; the fallback is the raw
    // code). Used by the ⋮ dropdown's translation add / edit / remove items.
    var langNames = (Model.Languages ?? []).ToDictionary(l => l.Code, l => l.NativeName);
    string LangName(string code) => langNames.TryGetValue(code, out var n) ? n : code;
    // Author monogram for the author footer band at the bottom of the card
    // (the fail-closed avatar sibling — the Directory pattern's initial).
    string todoAuthorInitial = !string.IsNullOrWhiteSpace(Model.Todo.AuthorDisplayName)
        ? char.ToUpperInvariant(Model.Todo.AuthorDisplayName.TrimStart()[0]).ToString()
        : string.Empty;

    // IMPROVE-CODE C11 — the translation add / edit modals' model (extracted
    // into the _TodoTranslationModals partial; the served markup is unchanged).
    // Built here (not in the <partial model="…"> attribute) so the string
    // interpolations don't fight Razor's attribute parser.
    var todoTransModals = new Kumunita.Web.Models.TodoTranslationModalsModel(
        Model.CanTranslate,
        Model.Translations,
        Model.Languages,
        Model.Todo.Title,
        $"/projects/todos/{Model.Todo.Id}/translations/update",
        $"/projects/todos/{Model.Todo.Id}/translations",
        ariaClose,
        LangName);

    // IMPROVE-CODE C11 — the status / assign + event-picker region's model
    // (extracted into the _TodoStatusAssignEvent partial; the served markup
    // is unchanged). Built here (not in the <partial model="…"> attribute) so
    // the string interpolations don't fight Razor's attribute parser.
    var todoStatusEvent = new Kumunita.Web.Models.TodoStatusAssignEventModel(
        Model.CanUpdate,
        Model.Todo.Id,
        Model.Todo.Status,
        Model.Todo.AssigneeId,
        Model.Todo.AssigneeDisplayName,
        StatusLabelKey,
        Model.EventPicker,
        ariaClose);

    // IMPROVE-CODE C11 — the comments + replies + composer region's model
    // (extracted into the _TodoComments partial; the served markup is
    // unchanged). <c>DefaultVariant</c> is threaded in because the composer's
    // language-picker default is a view-local (the ADR 0049 chain), not a
    // model field.
    var todoComments = new Kumunita.Web.Models.TodoCommentsModel(
        Model.Comments,
        Model.Todo.Id,
        defaultVariant);
}

<div class="row justify-content-center">
    <div class="col-md-12 col-lg-12">
        @* M17 (ADR 0118) + M37 (ADR 0167) — the bookmark toggle and the
           personal-note button, on ONE right-aligned row at the TOP of the
           parent column (just below the nav bar, to the right), OUTSIDE the
           main card. Each partial still carries its own d-flex wrapper + the
           bootstrap modal, so they only need to be side-by-side here. D2 /
           C-M17·2 pin holds: the label is static per render — this view does
           not load the owner's bookmark list to decide it. *@
        <div class="d-flex justify-content-end gap-2 mb-2">
            @{ var _bm = ("todo", Model.Todo.Id, $"/projects/todos/{Model.Todo.Id}"); }
            <partial name="_BookmarkButton" model="@_bm" />
            @{ var _pn = ("todo", Model.Todo.Id, $"/projects/todos/{Model.Todo.Id}"); }
            <partial name="_NoteButton" model="@_pn" />
        </div>
        <p>
            <a href="/projects/todos" class="btn btn-link p-0"><kw-l key="projects.todo.back">← Back to to-dos</kw-l></a>
        </p>

        @* The action dropdown (the _AccountNav.cshtml Bootstrap dropdown shape,
           the M2/M3/M4 shared nav-dropdown idiom): assign / add-subtask /
           delete — plain POST forms to the U07 routes, CSRF-tokenized,
           redirect-after-POST. Standing + cascade are the service's (F7/F8/
           F9); the view only renders what the service returns (C3). The
           assign-to-user picker draws on the seeded grant-picker option lists
           (the _GrantPickers partial's option source, the M2/M3/M4 shared
           shape); "Unassign" clears the assignee. *@
        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            @if (!string.IsNullOrWhiteSpace(Model.Todo.Status))
            {
                <partial name="_StatusChip" model="@(Model.Todo.Status ?? string.Empty)" />
            }
            @if (Model.Todo.ComponentDisplayName is not null)
            {
                <span class="kmb-chip">@Model.Todo.ComponentDisplayName</span>
            }
            @if (Model.Todo.GroupNames is { Count: > 0 })
            {
                <span class="kmb-chip">
                    <kw-l key="projects.todo.addressed_to">Addressed to</kw-l>: @string.Join(", ", Model.Todo.GroupNames)
                </span>
            }
        </div>

        @* The to-do's ⋮ action surface now sits inside the card's title row
           (below) — the community-posts idiom. The Add-subtask modal + the
           translation add / edit modals (opened from that dropdown) are the
           siblings rendered below; their ids are the data-bs-target references
           its items use. *@

        @* ADR 0071 — the Add-subtask modal (same convention as the Kanban
           board card; the inline Title input is replaced). *@
        <div class="modal fade" id="subtask-modal" tabindex="-1"
                 aria-labelledby="subtask-modal-label" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/subtasks")" id="subtask-modal-form">
                            @Html.AntiForgeryToken()
                            <div class="modal-header">
                                <h5 class="modal-title" id="subtask-modal-label">
                                    <kw-l key="projects.todo.add_subtask">Add subtask</kw-l>
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="@ariaClose"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label" for="subtask-modal-title">
                                        <kw-l key="common.title">Title</kw-l>
                                    </label>
                                    <input class="form-control" type="text" name="Title"
                                           id="subtask-modal-title" maxlength="120" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="subtask-modal-status">
                                        <kw-l key="projects.todo.status">Status</kw-l>
                                    </label>
                                    @* ADR 0069 — the fixed status vocabulary
                                       (the same <c>KanbanStatuses.Known</c> set
                                       the Kanban lane's Set-status select offers:
                                       None + the four codes). A new subtask
                                       starts with no status, so "None" is the
                                       selected default. *@
                                    <select class="form-select" name="Status" id="subtask-modal-status">
                                        <option value="" selected><kw-l key="projects.board.status.none">None</kw-l></option>
                                        @foreach (var statusCode in KanbanStatuses.Known)
                                        {
                                            <option value="@statusCode">
                                                <kw-l key="@StatusLabelKey(statusCode)">@statusCode</kw-l>
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" for="subtask-modal-assignee">
                                        <kw-l key="projects.todo.assignee">Assignee</kw-l>
                                    </label>
                                    @{ var _opts = (ViewData["Audience_Users"] as List<GrantOption>) ?? new List<GrantOption>(); }
                                    <select class="form-control" name="AssigneeId" id="subtask-modal-assignee">
                                        <option value=""><kw-l key="projects.todo.unassigned">Unassigned</kw-l></option>
                                        @foreach (var o in _opts)
                                        {
                                            <option value="@o.Id">@o.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <kw-l key="common.cancel">Cancel</kw-l>
                                </button>
                                <button type="submit" class="btn btn-primary" form="subtask-modal-form">
                                    <kw-l key="common.add">Add</kw-l>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @* ADR 0082 — the translation add / edit modals (siblings of the
               Add-subtask modal, opened from the ⋮ dropdown above).
               IMPROVE-CODE C11 — extracted into the _TodoTranslationModals
               partial (the served markup is unchanged; the ~110-line block
               now lives in one file). *@
            <partial name="_TodoTranslationModals" model="todoTransModals" />

        <div class="card kmb-detail-card mb-4">
            <div class="card-body">
                @* The to-do's ⋮ action surface (ADR 0082), now INSIDE the card
                   (the community-posts idiom): a right-aligned row at the top of
                   the card body. Assign / add-subtask / delete are plain POST
                   forms; translation add / edit open the modals above; remove is
                   a confirm form in the menu. The service's write-lane re-check
                   at POST is the real gate (CanClaim / CanTranslate /
                   CanUpdate / the self-assign allowance) — the same standing
                   rules as before, only the presentation moved into the card. *@
                <div class="d-flex justify-content-end">
                    <div class="dropdown">
                        <button class="btn btn-sm action-glyph-btn dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false"
                                aria-label="@(ariaActionsFor.Replace("{0}", Model.Todo.Title))">⋮</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @* not extracted: the claim / assign / assign-to-me action forms are the
                               to-do's single-use permission surface (tied to this todo's id + role),
                               not repeated across views or independently touched — left inline. *@
                            @if (Model.Todo.CanClaim)
                            {
                                <li>
                                    <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/claim")" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-dark"><kw-l key="projects.todo.claim">Claim</kw-l></button>
                                    </form>
                                </li>
                            }
                            @* ADR 0106 — "Assign to me" (the self-assign pick-up
                               lane, the claim generalized): visible only when the
                               to-do is **unassigned** and the actor is authenticated.
                               Posts the assign route with the actor's own subject id.
                               The service's self-assign allowance (Read-allowed +
                               unassigned) is the server-side gate. *@
                            @if (string.IsNullOrWhiteSpace(Model.Todo.AssigneeId) && User?.Identity?.IsAuthenticated == true)
                            {
                                <li>
                                    <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/assign")" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="assigneeId" value="@KumunitaPrincipal.SubjectId(User)" />
                                        <button type="submit" class="dropdown-item text-dark"><kw-l key="projects.todo.assign_to_me">Assign to me</kw-l></button>
                                    </form>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item text-dark" href="@($"/projects/todos/{Model.Todo.Id}/edit")"><kw-l key="projects.todo.edit">Edit</kw-l></a>
                            </li>
                            <li>
                                <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/assign")"
                                      data-confirm="@("Remove the assignee from this to-do?")" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-dark"><kw-l key="projects.todo.unassign">Unassign</kw-l></button>
                                </form>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item text-dark"
                                        data-bs-toggle="modal"
                                        data-bs-target="#subtask-modal">
                                    <kw-l key="projects.todo.add_subtask">Add subtask</kw-l>
                                </button>
                            </li>
                            @* ADR 0082 — the translation add / edit / remove as
                               dropdown items opening the modals above (replacing the
                               prior inline <details> blocks): one "Edit" per existing
                               translation + one "Add" per enabled-but-missing language
                               (both open modals), then a "Remove" per existing.
                               Server-side gate on CanTranslate (the ADR 0088
                               translator lane); the items are localized (the ADR 0015
                               kw-l tags — the same posts.translation_* keys the
                               Community-post and Project surfaces use). *@
                            @if (Model.CanTranslate)
                            {
                                @foreach (var existing in (Model.Translations ?? []).OrderBy(x => x.LanguageCode))
                                {
                                    <li>
                                        <button type="button" class="dropdown-item text-dark"
                                                data-bs-toggle="modal"
                                                data-bs-target="@($"#todo-trans-edit-{existing.LanguageCode}")">
                                            <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                        </button>
                                    </li>
                                }
                                @foreach (var lang in (Model.Languages ?? []).Where(l => (Model.Translations ?? []).All(x => !string.Equals(x.LanguageCode, l.Code, StringComparison.OrdinalIgnoreCase))))
                                {
                                    <li>
                                        <button type="button" class="dropdown-item text-dark"
                                                data-bs-toggle="modal"
                                                data-bs-target="@($"#todo-trans-add-{lang.Code}")">
                                            <kw-l key="posts.translation_add">Add</kw-l> — <b>@LangName(lang.Code)</b>
                                        </button>
                                    </li>
                                }
                                @if (Model.Translations is { Count: > 0 })
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    @foreach (var existing in (Model.Translations ?? []).OrderBy(x => x.LanguageCode))
                                    {
                                        <li>
                                            <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/translations/remove")"
                                                  data-confirm="@confirmRemoveTrans" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <kw-l key="posts.translation_remove">Remove</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                                </button>
                                            </form>
                                        </li>
                                    }
                                }
                            }
                            @* ADR 0173 — the "Report this to-do" lane: any
                               resident who can see the to-do may file a
                               report (the C-M3b·1 standing). The dropdown
                               item opens the shared _ReportModal below. *@
                            <li>
                                <button type="button" class="dropdown-item text-dark"
                                        data-bs-toggle="modal"
                                        data-bs-target="#todo-report-modal">
                                    <kw-l key="posts.todo_report_button">Report this to-do</kw-l>
                                </button>
                            </li>
                            <li>
                                <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/delete")"
                                      data-confirm="@("Delete this to-do and its subtasks? This cannot be undone.")" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger"><kw-l key="projects.todo.delete">Delete</kw-l></button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>

                @* ADR 0173 — the "Report this to-do" modal (the shared
                   _ReportModal partial — the ADR 0082 modal idiom). Rendered
                   unconditionally: any resident who can see the to-do (the
                   detail's own Read decision already ran) may file a report
                   (C-M3b·1, the post-report lane's standing). *@
                @{ var _repTd = (ActionUrl: "/projects/todos/" + Model.Todo.Id + "/report", ModalId: "todo-report-modal", TitleKey: "posts.todo_report_button"); }
                <partial name="_ReportModal" model="@_repTd" />

                @* IMPROVE-CODE C11 — the read-surface display block (the ADR
                   0088 chip-swap + Project / Linked-event / Parent /
                   Waiting-on links + start / due dates + tags) extracted into
                   the _TodoDisplay partial (the served markup is unchanged). *@
                <partial name="_TodoDisplay" model="Model" />

                @* The body (the ADR 0025 shape — the BoardDetail / ProjectDetail
                   detail idiom): a read surface renders the Markdown as plain
                   text through the one MarkdownRenderer; editing lives in its
                   own view (GET /projects/todos/{id}/edit). *@
                @if (!string.IsNullOrWhiteSpace(Model.Todo.Body))
                {
                    <div class="rc-body">@Html.Raw(MarkdownRenderer.RenderHtml(Model.Todo.Body))</div>
                }
                else
                {
                    <p class="text-body-tertiary mb-0"><kw-l key="projects.todo.no_body">No body — this to-do is title-only.</kw-l></p>
                }

                @* IMPROVE-CODE C11 — the status / assign + event-picker region
                   (extracted into the _TodoStatusAssignEvent partial; the
                   served markup is unchanged). *@
                <partial name="_TodoStatusAssignEvent" model="todoStatusEvent" />
            </div>

            @* Author footer band (the community Posts/Detail.cshtml pattern):
               the author sits at the BOTTOM of the card, below the body, as
               its own band — the <img> links the audited serving lane (GET
               /profile/avatar/{subjectId}), the monogram sibling on its
               fail-closed 404. The assignee line (previously above the
               title) moves here with the author. *@
            <div class="d-flex align-items-center gap-2 bg-white text-muted small px-3 py-2">
                <span class="d-inline-flex align-items-center">
                    <kw-avatar subject="@Model.Todo.AuthorId" mono="@todoAuthorInitial" />
                </span>
                <span>
                    @Model.Todo.AuthorDisplayName
                    @if (!string.IsNullOrWhiteSpace(Model.Todo.AssigneeDisplayName))
                    {
                        <span> · <kw-l key="projects.todo.assignee">Assignee</kw-l>: @Model.Todo.AssigneeDisplayName</span>
                    }
                    else
                    {
                        <span> · <kw-l key="projects.todo.unassigned">Unassigned</kw-l></span>
                    }
                    <span> · <kw-l key="projects.todo.created">Created</kw-l>
                    <kw-dt dt="@Model.Todo.Created" format="g"></kw-dt></span>
                    @if (Model.Todo.Modified is not null)
                    {
                        <span> · <kw-l key="projects.todo.modified">Modified</kw-l>
                        <kw-dt dt="@Model.Todo.Modified" format="g"></kw-dt></span>
                    }
                </span>
            </div>
        </div>

        @* IMPROVE-CODE C11 — the subtasks (F9) + board placements (F2)
           sections extracted into the _TodoSubtasksBoards partial (the served
           markup is unchanged). *@
        <partial name="_TodoSubtasksBoards" model="Model" />

        @* IMPROVE-CODE C11 — the comments + replies + composer section
           extracted into the _TodoComments partial (the served markup is
           unchanged). *@
        <partial name="_TodoComments" model="todoComments" />
    </div>
</div>

@section Scripts {
    @* ADR 0100 — the rich editor (self-wires every .rc-editor block on this
       page: the translation modals above + the comment composer below); the
       image button is omitted (data-rich-editor-no-image). One include covers
       every .rc-editor root the module finds. *@
    <script type="module" src="~/js/lib/rich-editor.js"></script>

    @* ADR 0115 D3 (M14 interlock) — the **"create a new event"
       affordance** on the set-event picker (the
       <c>todo.set_event.create_new</c> sentinel option → the modal
       above). The ADR 0031 tsc-only discipline applies: the JS lives
       in <c>client/lib/todo-set-event.ts</c>, compiled to
       <c>wwwroot/js/lib/todo-set-event.js</c> by <c>tsc</c> — never
       an inline script (CSP's <c>script-src 'self'</c> forbids inline
       scripts). The module intercepts the set-event form's submit when
       the <c>__new__</c> sentinel is selected and opens the Bootstrap
       modal (the ADR 0071 convention; the ADR 0081 quick-create idiom
       carried to the to-do surface). When the modal is closed without
       submitting, the select is reset to blank so a subsequent submit
       doesn't POST the sentinel. *@
    <script type="module" src="~/js/lib/todo-set-event.js"></script>
}
