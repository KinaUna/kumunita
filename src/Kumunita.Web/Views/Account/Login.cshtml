@model Kumunita.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="kmb-auth">
            <span class="kmb-auth-logo" aria-hidden="true">K</span>
        <h1><kw-l key="account.login_title">Sign in</kw-l></h1>


        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger">
                @* D6 — the code→message table (three known codes render their
                   localized kw-l message; an unknown code falls back to
                   Model.Error verbatim — forward-compatible). The controller
                   passes the code through verbatim (no server-side copy). *@
                @switch (Model.Error)
                {
                    case "blocked":
                        <kw-l key="account.login.error.blocked">Your account has been temporarily suspended. Contact an administrator.</kw-l>
                        break;
                    case "time-limit":
                        @* M28 (ADR 0151, D5) — TimeLimitMiddleware (the
                           BlockedAccountMiddleware analog): the child is outside
                           their guardian-set allowed window and has been signed
                           out. The code is DISTINCT from "blocked" — a different
                           message ("outside your allowed hours" vs "suspended").
                           The kw-l key `account.time_limit.login_message` is the
                           M28 §2.7 #14 key (U05 authors it into all four
                           KnownTranslationKeys dicts); until then the <kw-l>
                           element's en inner text is the provider floor. *@
                        <kw-l key="account.time_limit.login_message">You are outside your allowed hours. Please check back later.</kw-l>
                        break;
                    case "account-removed":
                        <kw-l key="account.login.error.removed">Your account has been removed. Contact an administrator.</kw-l>
                        break;
                    case "role-changed":
                        <kw-l key="account.login.error.role_changed">Your role has been changed. Please sign in again.</kw-l>
                        break;
                    default:
                        @Model.Error
                        break;
                }
            </div>
        }

        @* F3.U4 (AUTH-03) — the MFA challenge branch (pin §5 leg 1.5). When
           Model.MfaPending is true, the password leg succeeded but the account
           is MFA-protected, so the view renders the MFA challenge form (a TOTP
           or recovery-code field) instead of the password form. The pin §5
           leg 1.5: "Return the MFA challenge (a code/recovery-code field on
           the login view)". The form posts to the LoginMfa action (leg 2). *@
        @if (Model.MfaPending)
        {
            <div class="alert alert-info">
                <b>@(Model.Email)</b> has two-factor authentication enabled.
                Enter the code from your authenticator app, or a recovery code.
            </div>

            <form asp-action="LoginMfa" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @Html.AntiForgeryToken()
                @* Hidden fields: `Email` is set by the Login action's leg-1.5
                   branch (model.Email = user.Email ?? user.UserName); `Password`
                   is not submitted by this form (the password leg already
                   completed at leg 1). `RememberMe` carries the resident's
                   choice into LoginMfa (leg 2's isPersistent/rememberClient). *@
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="RememberMe" />

                @* asp-validation-summary="ModelOnly" shows model-level errors
                   ONLY (excludes all property errors) — this hides the
                   [Required] errors on Email/Password (not submitted by this
                   form) while still showing model-level errors (added with
                   ModelState.AddModelError(string.Empty, ...)). *@
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="MfaCode" class="form-label">Authenticator code</label>
                    <input asp-for="MfaCode" class="form-control" inputmode="numeric"
                           autocomplete="one-time-code" pattern="[0-9]{6,8}" />
                    <span asp-validation-for="MfaCode" class="text-danger"></span>
                    <div class="form-text">Enter the 6-digit code from your authenticator app.</div>
                </div>

                <hr />

                <div class="mb-3">
                    <label asp-for="MfaRecoveryCode" class="form-label">Recovery code (optional)</label>
                    <input asp-for="MfaRecoveryCode" class="form-control" autocomplete="off" />
                    <span asp-validation-for="MfaRecoveryCode" class="text-danger"></span>
                    <div class="form-text">
                        If you lost your authenticator app, enter one of your
                        recovery codes instead. A recovery code can only be used once.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Verify</button>
            </form>
        }
        else
        {
            <form asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"><kw-l key="common.email">Email</kw-l></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"><kw-l key="common.password">Password</kw-l></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label class="form-check-label mb-0">
                        <kw-l key="account.login_remember">Remember me</kw-l>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary"><kw-l key="account.login_submit">Sign in</kw-l></button>
            </form>
        }

        <p class="mt-3 text-muted">
            @* ADR 0050 — the sign-up gate: the "No account yet? Sign up." affordance
               is suppressed when the admin gate is closed (invitation-only) — a
               closed gate has no self-service signup surface to point at. *@
            @if (Model.SignupOpen)
            {
                <kw-l key="account.login_no_account">No account yet?</kw-l>
                <a asp-action="Signup"><kw-l key="account.login_signup">Sign up</kw-l></a>
            }
            @if (Model.ShowSetupLink)
            {
                if (Model.SignupOpen)
                {
                    <text> </text>
                }
                <kw-l key="account.login_setup_hint">Received a first-boot setup token?</kw-l> <a asp-controller="AdminSetup" asp-action="Setup" asp-route-returnUrl="@Model.ReturnUrl"><kw-l key="account.login_setup_link">Complete setup</kw-l></a>
            }
            else if (Model.SignupOpen)
            {
                <text>.</text>
            }
        </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
