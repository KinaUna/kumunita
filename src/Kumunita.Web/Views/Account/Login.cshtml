@model Kumunita.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1><kw-l key="account.login_title">Sign in</kw-l></h1>

        @if (TempData["info"] is string info)
        {
            <div class="alert alert-success">@info</div>
        }

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger">@Model.Error</div>
        }

        <form asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label class="form-check-label mb-0">
                    <kw-l key="account.login_remember">Remember me</kw-l>
                </label>
            </div>

            <button type="submit" class="btn btn-primary"><kw-l key="account.login_submit">Sign in</kw-l></button>
        </form>

        <p class="mt-3 text-muted">
            @* ADR 0050 — the sign-up gate: the "No account yet? Sign up." affordance
               is suppressed when the admin gate is closed (invitation-only) — a
               closed gate has no self-service signup surface to point at. *@
            @if (Model.SignupOpen)
            {
                <kw-l key="account.login_no_account">No account yet?</kw-l>
                <a asp-action="Signup"><kw-l key="account.login_signup">Sign up</kw-l></a>
            }
            @if (Model.ShowSetupLink)
            {
                if (Model.SignupOpen)
                {
                    <text> </text>
                }
                <kw-l key="account.login_setup_hint">Received a first-boot setup token?</kw-l> <a asp-controller="AdminSetup" asp-action="Setup" asp-route-returnUrl="@Model.ReturnUrl"><kw-l key="account.login_setup_link">Complete setup</kw-l></a>
            }
            else if (Model.SignupOpen)
            {
                <text>.</text>
            }
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
