@{
    ViewData["Title"] = "My data";
    // The status area (the myportability.status line) is a TempData string the
    // import action writes — outside the kw-l TagHelper's reach, rendered by
    // the _FlashToast partial (the one, uniform flash surface, the house
    // convention the M11 admin index uses for the same purpose).
}

@* The /settings section sub-nav (the ADR 0080 house pattern the
   /account/password and /account/delete pages use) — the active-tab
   detection is controller-aware in _SettingsTabs.cshtml (UserPortability +
   Index → "My data"), so the resident can jump between settings sections. *@
@await Html.PartialAsync("~/Views/Locale/_SettingsTabs.cshtml")

<h1 class="mt-2"><kw-l key="myportability.index.title">My data</kw-l></h1>

<p class="text-muted">
    Your own authored content — the posts, events, projects, documents, pages,
    messages, and media you created — as one portable <code>*.kumunita</code>
    archive. Export it as a file, or import one of your archives back into this
    community. Nothing here ever carries your password, and only your own rows
    travel.
</p>

@* Export — the resident downloads their own, resident-scoped archive
   (the loop closes out of the platform at the resident's scale — F1). A
   plain link (no form): the archive streams as a download (the ADR 0034
   attachment shape, the same serve idiom the M11 operator export uses). *@
<div class="card mb-4">
    <div class="card-body d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div>
            <div class="fw-semibold"><kw-l key="myportability.export">Export</kw-l></div>
            <small class="text-muted">
                One <code>*.kumunita</code> archive — your own authored content
                and media (never your password, and only your rows).
            </small>
        </div>
        <a class="btn btn-primary" href="~/account/portability/export">
            <kw-l key="myportability.export">Export</kw-l>
        </a>
    </div>
</div>

@* Import — the upload form (the POST /account/portability/import target, the
   ClassifyAsync delegation). The import is a classify step (read-only — the
   clean/duplicate/conflict report), so unlike the M11 destructive restore
   there is no data-confirm guard: nothing is written until the resident
   resolves each entity on the U08 resolve-review page. *@
<div class="card mb-4">
    <div class="card-body">
        <div class="fw-semibold mb-2"><kw-l key="myportability.import">Import</kw-l></div>
        <small class="text-muted d-block mb-3">
            Bring one of your <code>*.kumunita</code> archives back. We'll check
            what fits this community and what needs your call — you decide, item
            by item, where each piece goes.
        </small>
        <form method="post" action="/account/portability/import" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row g-2 align-items-end">
                <div class="col-sm-8">
                    <input type="file" name="archive" id="archive" class="form-control" accept=".kumunita" required />
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-primary"><kw-l key="myportability.import">Import</kw-l></button>
                </div>
            </div>
        </form>
    </div>
</div>

@* The status area — the success (myportability.status + the
   clean/duplicate/conflict summary) / the closed-failure-set render — the
   _FlashToast partial (rendered by _Layout) reads the TempData the import
   action writes. The keys resolve through the provider (they are TempData
   strings, outside the kw-l TagHelper's reach). *@
@* No inline markup here — the _FlashToast partial is the one, uniform
   flash surface (the house convention). *@

@* ── Delete account (ADR 0142) — folded into the "My data" tab 2026-10-17 ──
   Previously a standalone settings tab (nav.delete_account → /account/delete).
   Now rendered here as a danger-zone card at the bottom of the My data page.
   The POST still targets /account/delete (the AccountController.Delete action
   is unchanged). The ADR 0142 D5 gate (self-serve lane is GlobalAdmin-only)
   is computed server-side via KumunitaPrincipal.IsGlobalAdmin — no DB read. *@
@{
    var canDelete = Kumunita.Web.Security.KumunitaPrincipal.IsGlobalAdmin(User);
}
<div class="card border-danger mb-4">
    <div class="card-header fw-semibold text-danger">
        <kw-l key="account.delete_title">Delete account</kw-l>
    </div>
    <div class="card-body">
        @if (!canDelete)
        {
            @* ADR 0142 D5 gate — the resident is not a GlobalAdmin. The form
               is not rendered (the self-serve lane is unavailable); the
               notice tells them to contact an administrator. A crafted POST
               to /account/delete is still refused server-side by the Core
               seam (defense in depth). *@
            <div class="alert alert-warning mb-0">
                <kw-l key="account.delete_refused">The self-serve delete-account lane is only available to a GlobalAdmin. A non-GlobalAdmin resident cannot delete their own account — contact an administrator to remove the account.</kw-l>
            </div>
        }
        else
        {
            <p class="text-muted mb-3">
                <kw-l key="account.delete_lede">Deleting your account removes your sign-in, your profile, and your group and community memberships. Your past actions in the platform's audit trail are preserved with your identity replaced by a placeholder (the platform's privacy policy, OPS.md §9). This cannot be undone.</kw-l>
            </p>
            <form method="post" action="/account/delete"
                  data-confirm="Delete your account permanently? This cannot be undone.">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="delete-password" class="form-label">
                        <kw-l key="account.delete_password">Password</kw-l>
                    </label>
                    <input type="password" name="Password" id="delete-password"
                           class="form-control" autocomplete="current-password" required />
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" name="Confirmed" id="delete-confirmed" class="form-check-input" />
                    <label for="delete-confirmed" class="form-check-label">
                        <kw-l key="account.delete_confirm_checkbox">I understand my account will be permanently deleted and this cannot be undone.</kw-l>
                    </label>
                </div>
                <button type="submit" class="btn btn-danger">
                    <kw-l key="account.delete_submit">Delete account</kw-l>
                </button>
            </form>
        }
    </div>
</div>
