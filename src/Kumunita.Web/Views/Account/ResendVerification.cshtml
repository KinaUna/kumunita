@model Kumunita.Web.Models.ResendVerificationViewModel
@{
    ViewData["Title"] = "Resend confirmation email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1>Resend confirmation email</h1>
        <p class="text-muted">
            Enter the email you signed up with and we'll send a fresh verification link.
        </p>
        <form asp-action="ResendVerification" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Resend</button>
        </form>

        <p class="mt-3 text-muted">
            Just creating your account? <a asp-action="Signup">Sign up</a>.
        </p>
    </div>
</div>
