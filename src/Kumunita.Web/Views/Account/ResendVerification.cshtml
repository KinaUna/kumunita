@model Kumunita.Web.Models.ResendVerificationViewModel
@{
    ViewData["Title"] = "Resend confirmation email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1><kw-l key="account.resend_title">Resend confirmation email</kw-l></h1>
        <p class="text-muted">
            <kw-l key="account.resend_lede">Enter the email you signed up with and we'll send a fresh verification link.</kw-l>
        </p>
        <form asp-action="ResendVerification" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"><kw-l key="common.email">Email</kw-l></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary"><kw-l key="account.resend_submit">Resend</kw-l></button>
        </form>

        <p class="mt-3 text-muted">
            <kw-l key="account.resend_create">Just creating your account?</kw-l> <a asp-action="Signup"><kw-l key="account.resend_signup">Sign up</kw-l></a>.
        </p>
    </div>
</div>
