@model Kumunita.Web.Models.ChangePasswordLockedViewModel
@{
    ViewData["Title"] = "Settings — Change password";
}

@* The settings sub-nav (the ADR 0080 idiom): the locked notice is the same
   "Change password" settings tab as the form — a locked sample account sees
   this page in place of the form (the ADR 0138 surface-replaced-by-notice
   shape). The active-tab detection is controller-aware in _SettingsTabs.cshtml
   (Account + ChangePassword → "Change password"). *@
@await Html.PartialAsync("~/Views/Locale/_SettingsTabs.cshtml")

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1><kw-l key="account.change_password_locked_title">Password changes are locked</kw-l></h1>
        <p class="text-muted">
            <kw-l key="account.change_password_locked_body">This is a demo account and password changes are locked by the administrator so everyone can keep using the shared credentials. You can still use every other feature of the platform.</kw-l>
        </p>

        <p class="mt-3">
            <a href="/profile/edit" class="btn btn-outline-secondary"><kw-l key="account.change_password_back">Back to your profile</kw-l></a>
        </p>
    </div>
</div>
