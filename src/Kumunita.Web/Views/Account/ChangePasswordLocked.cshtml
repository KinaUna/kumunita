@model Kumunita.Web.Models.ChangePasswordLockedViewModel
@{
    ViewData["Title"] = "Password changes are locked";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1><kw-l key="account.change_password_locked_title">Password changes are locked</kw-l></h1>
        <p class="text-muted">
            <kw-l key="account.change_password_locked_body">This is a demo account and password changes are locked by the administrator so everyone can keep using the shared credentials. You can still use every other feature of the platform.</kw-l>
        </p>

        <p class="mt-3">
            <a href="/profile/edit" class="btn btn-outline-secondary"><kw-l key="account.change_password_back">Back to your profile</kw-l></a>
        </p>
    </div>
</div>
