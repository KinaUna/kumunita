@model Kumunita.Web.Models.SignupViewModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="kmb-auth">
            <span class="kmb-auth-logo" aria-hidden="true">K</span>
        <h1><kw-l key="account.signup_title">Sign up</kw-l></h1>
        <form asp-action="Signup" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"><kw-l key="common.display_name">Display name</kw-l></label>
                <input asp-for="DisplayName" class="form-control" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"><kw-l key="common.email">Email</kw-l></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"><kw-l key="common.password">Password</kw-l></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"><kw-l key="account.confirm_password">Confirm password</kw-l></label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            @* F9 (AUTH-15, U3) — the bot-challenge widget (pin §4b/§4c). Rendered ONLY
               when the owner's KUMUNITA__SIGNUP__BOT_CHECK flag is on (Model.BotChallengeEnabled,
               set by the Signup GET from the flag) — when off (the default, the Noop
               verifier) this block is absent and the form is byte-identical to before
               this seam (the standing owner deferral, OPS.md §10; the frozen CSP
               invariant). The host div's data-sitekey drives the bot-challenge.ts module
               (a self-wiring client/lib module — no inline JS, the CSP script-src 'self'
               rule); it writes the solved token into the hidden BotChallengeToken input,
               which AccountController.Signup verifies (IBotChallengeVerifier gate). *@
            @if (Model is { BotChallengeEnabled: true })
            {
                <div class="kumunita-bot-challenge mb-3" data-sitekey="@(Model.BotChallengeSiteKey ?? string.Empty)"></div>
                <input type="hidden" asp-for="BotChallengeToken" />
            }

            <button type="submit" class="btn btn-primary"><kw-l key="account.signup_submit">Sign up</kw-l></button>
        </form>

        @if (Model is { BotChallengeFailed: true })
        {
            <p class="mt-3 text-danger">
                The security check did not pass. Please try again.
            </p>
        }

        @if (Model is { EmailDomainDisallowed: true })
        {
            <p class="mt-3 text-info">
                The email domain for that address is not accepted for new accounts.
                Please use a permanent email address.
            </p>
        }

        @if (Model is { EmailAlreadyExists: true })
        {
            <p class="mt-3 text-info">
                Never got the confirmation email?
                <a asp-action="ResendVerification" asp-route-email="@Model.Email">Resend the confirmation email</a>.
            </p>
        }

        <p class="mt-3 text-muted">
            <kw-l key="account.signup_has_account">Already have an account?</kw-l> <a asp-action="Login">Sign in</a>.
        </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* F9 (AUTH-15, U3) — the bot-challenge widget's self-wiring module (CSP
       script-src 'self' compliant). Loaded only when the widget rendered
       (Model.BotChallengeEnabled) — when off (the default) no script, no
       third-party load, the form is byte-identical to before this seam. *@
    @if (Model is { BotChallengeEnabled: true })
    {
        <script type="module" src="~/js/lib/bot-challenge.js"></script>
    }
}
