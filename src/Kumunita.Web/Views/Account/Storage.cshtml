@model Kumunita.Web.Models.ResidentStorageViewModel
@{
    ViewData["Title"] = "My storage";
}

<h1>My storage</h1>
<p class="text-muted">
    How much of your content the platform counts, your per-user quota, and how
    much of it you still have left.
</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-4 fw-semibold">@Model.MyUsageHuman</div>
                <div class="text-muted small">your content used</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-4 fw-semibold">@Model.QuotaHuman</div>
                <div class="text-muted small">your per-user quota</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-4 fw-semibold">@Model.RemainingHuman</div>
                <div class="text-muted small">remaining</div>
            </div>
        </div>
    </div>
</div>

@* Sentinel (C-UP·5): quota 0 ⇒ unlimited. The remaining figure is "Unlimited"
   (not 0, not an error) — the model's RemainingHuman is already resolved to
   that label, so the card above shows it directly. *@
@if (Model.QuotaUnlimited)
{
    <p class="text-muted small">
        Your per-user quota is unlimited — there is no total-content cap on your
        uploads.
    </p>
}
else
{
    <p class="text-muted small">
        Your remaining is what's left of your per-user quota
        (@Model.RemainingHuman). Ask an administrator to raise the quota if you
        need more.
    </p>
}
