@model Kumunita.Web.Models.SignupClosedViewModel
@{
    ViewData["Title"] = "Sign-up is closed";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1><kw-l key="account.signup_closed_title">Sign-up is closed</kw-l></h1>

        <p class="text-muted">
            <kw-l key="account.signup_closed_body">Sign-up is currently invitation-only on this instance. If you have been invited, an administrator will add your account and send you the sign-in link.</kw-l>
        </p>

        <p class="mt-3">
            <a class="btn btn-primary" asp-action="Login"><kw-l key="account.login_title">Sign in</kw-l></a>
        </p>
    </div>
</div>
