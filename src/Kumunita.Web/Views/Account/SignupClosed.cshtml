@model Kumunita.Web.Models.SignupClosedViewModel
@{
    ViewData["Title"] = "Sign-up is closed";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="kmb-auth">
        <h1><kw-l key="account.signup_closed_title">Sign-up is closed</kw-l></h1>

        @* ADR 0304 (IMPROVE-UX A08) — honest closed-page text (E9): the real
           path is an invitation link (an admin, or a neighbour when the
           resident-invite setting is on), not a promise that an admin will
           manually add the account. The ?invite= token from that link is what
           opens the sign-up surface (the ADR 0304 D4 "works while closed"
           invariant). *@
        <p class="text-muted">
            <kw-l key="account.signup_closed_body">Sign-up is currently invitation-only on this instance. To get an account, ask an administrator — or a neighbour who can invite — to send you an invitation link, then follow that link to sign up.</kw-l>
        </p>

        <p class="mt-3">
            <a class="btn btn-primary" asp-action="Login"><kw-l key="account.login_title">Sign in</kw-l></a>
        </p>
        </div>
    </div>
</div>
