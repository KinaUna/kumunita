@model Kumunita.Web.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Settings — Change password";
}

@* The settings sub-nav (the ADR 0080 idiom, the ADR 0028 "Children" precedent):
   the Change password surface is a settings tab (moved out of the account
   dropdown 2026-10-04), so the strip renders at the top of the page — it sits
   just under the navbar (the kmb-tab-under-navbar treatment, site.css). The
   active-tab detection is controller-aware in _SettingsTabs.cshtml (Account +
   ChangePassword → "Change password"). *@
@await Html.PartialAsync("~/Views/Locale/_SettingsTabs.cshtml")

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1><kw-l key="account.change_password_title">Change password</kw-l></h1>
        <p class="text-muted">
            <kw-l key="account.change_password_lede">Pick a new password for your account. After saving you'll be signed out and asked to sign in again with the new password.</kw-l>
        </p>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"><kw-l key="account.change_password_current">Current password</kw-l></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"><kw-l key="account.change_password_new">New password</kw-l></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label"><kw-l key="account.change_password_confirm_new">Confirm new password</kw-l></label>
                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary"><kw-l key="account.change_password_submit">Change password</kw-l></button>
        </form>

        <p class="mt-3 text-muted">
            <a href="/profile/edit"><kw-l key="account.change_password_back">Back to your profile</kw-l></a>.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
