@model Kumunita.Web.Models.BlogViewModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    var _aL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    var _blogDraftTitle = Translation is null ? "A draft — only you can see it until you publish it." : await Translation.GetAsync("blog.draft_title", _aL);
}
@{
    var hasName = Model.AuthorDisplayName is string dn && !string.IsNullOrWhiteSpace(dn);
    var heading = hasName ? $"{Model.AuthorDisplayName}'s blog" : "Blog";
    ViewData["Title"] = heading;
}

<div class="row justify-content-center">
    <div class="col-md-12 col-lg-12">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h1 class="mb-0">@heading</h1>
            @if (Model.IsOwner && User?.Identity?.IsAuthenticated == true)
            {
                @* ADR 0040 — the "New blog page" affordance is on the author's
                   own feed only (another resident's feed is read-only). It
                   routes to the composer, which — for a resident — opens on
                   a blog page (kind = User, their own namespace). *@
                <a class="btn btn-sm btn-primary ms-auto" href="/pages/new">
                    <kw-l key="blog.new_page">New blog page</kw-l>
                </a>
            }
        </div>

        @if (Model.Posts.Count == 0)
        {
            @* R29 (IMPROVE-UX) — the house .kmb-empty idiom; the body is the
               existing blog.empty_own/other sentence and the action is the
               page's New-blog-page button (the author's own feed only). *@
            <div class="kmb-empty">
                <p class="kmb-empty-title"><kw-l key="blog.empty_title">No blog pages yet.</kw-l></p>
                @if (Model.IsOwner)
                {
                    <p class="kmb-empty-body">
                        <kw-l key="blog.empty_own">You have no blog pages yet. Create your first — it becomes the root of your blog, and you can nest more under it.</kw-l>
                    </p>
                    <a class="btn btn-primary" href="/pages/new"><kw-l key="blog.new_page">New blog page</kw-l></a>
                }
                else
                {
                    <p class="kmb-empty-body">
                        <kw-l key="blog.empty_other">This resident has no blog pages yet.</kw-l>
                    </p>
                    <a class="btn btn-outline-secondary" href="/community"><kw-l key="about.cta_feed">See the feed</kw-l></a>
                }
            </div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var post in Model.Posts)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <a class="fw-semibold text-decoration-none" href="@post.Href">@post.Title</a>
                            @if (post.IsDraft && Model.IsOwner)
                            {
                                <span class="badge bg-warning text-dark ms-2" title="@_blogDraftTitle">
                                    <kw-l key="blog.draft">Draft</kw-l>
                                </span>
                            }
                        </div>
                        <span class="text-muted small text-nowrap" title="@post.Modified.ToString("u")">
                            @post.Modified.ToString("g")
                        </span>
                    </li>
                }
            </ul>
        }
    </div>
</div>
