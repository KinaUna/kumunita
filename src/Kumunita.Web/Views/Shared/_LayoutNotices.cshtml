@using Kumunita.Web.Security
@using Kumunita.Web.Helpers
@using Kumunita.Core.Identity
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IIdentityService Identity
@inject Kumunita.Core.UserInfo.IUserInfoService UserInfo
@inject Kumunita.Core.InstanceStatus.IInstanceStatusService InstanceStatus
@* IMPROVE-CODE C11 — extracted from _Layout.cshtml (the .kmb-notices
   region: the flash toast, the pinned announcement, the guest notice,
   the onboarding banner, and the What's-new toast). The markup, the
   async partial awaits, and the _noticesMore label resolution are all
   unchanged — only their container moves. *@
@* Flash toast — the one, uniform flash-message surface (TempData["info"]
   / ["error"]). Renders a fixed top-right Bootstrap toast when the
   controller left a flash value on the last redirect. Replaces the
   per-view .alert blocks that used to land inline wherever each view
   author placed them. *@
@await Html.PartialAsync("_FlashToast")
@* ADR 0176 — one notice strip: the stacked banners below are children of
   .kmb-notices; notice-strip.js shows the first non-dismissed one (DOM
   order = priority: pinned > guest > onboarding > what's new) and folds
   the rest behind a "+N" control. Without JS all of them render, compact.
   The control's accessible name is server-resolved (the kw-l TagHelper
   can't wrap an attribute); a null provider (a non-HTTP render) degrades
   to the en floor, matching the a11y.* block above. *@
@{
    string _noticesMore = "Show the next notice";
    if (Translation is not null)
    {
        try
        {
            string _noticesLang = await EffectiveLanguageCode.ResolveAsync(
                HttpContextAccessor.HttpContext?.Request, Localization, Translation);
            _noticesMore = await Translation.GetAsync("a11y.notices_more", _noticesLang);
        }
        catch
        {
            // Keep the en floor on a resolution failure — the label must never break.
        }
    }
}
<div class="kmb-notices" data-kmb-notices data-more-label="@_noticesMore">
@await Html.PartialAsync("_PinnedAnnouncement")
@* M19 F2 + IMPROVE-UX R20 — the guest shell notice (the account.guest_welcome
   key). Two states of a signed-in guest are handled, both resolved from the
   GuestAccess document (the end date is NOT a claim — ADR 0120 D3):

   (1) WINDOW LIVE — the Guest role is present (KumunitaClaimsPrincipalFactory
       mints it only when Profile.IsGuest && ValidFrom ≤ now < ValidUntil).
       The notice shows the existing text PLUS when the window ends (rendered
       in the guest's own effective zone via the <kw-dt> TagHelper, ADR 0019/0020)
       PLUS a "message the admins" affordance to GET /issues/new (the existing
       resident feedback surface — the R08/R22 channel; a labelled link, not a
       new form). A null/absent GuestAccess document degrades to the plain text
       (the kw-l en floor, no crash).

   (2) WINDOW LAPSED — the Guest role is ABSENT (no standing), so a role-based
       gate can never see it. Detected via Profile.IsGuest == true AND the
       window already past (now ≥ ValidUntil), read from the profile + the
       GuestAccess doc — NOT the role. A friendly "your guest access has ended"
       notice + the same "message the admins" affordance, so the guest is not
       left on a bare shell (the E18 dead end).

   Use KumunitaPrincipal.HasRole (NOT ClaimsPrincipal.IsInRole): Kumunita's
   roles ride the custom "Kumunita.Role" claim type, not the BCL default,
   so the built-in IsInRole would never match. Both branches are cheap and
   non-blocking: the profile + GuestAccess reads run only for a signed-in
   guest (an ordinary resident / member / admin never pays for them). *@
@if (User.Identity?.IsAuthenticated == true && KumunitaPrincipal.HasRole(User, "Guest"))
{
    // WINDOW LIVE (the Guest role is present ⇒ the window is live). The end
    // date is the GuestAccess.ValidUntil document value, rendered in the
    // guest's own effective zone/format by the <kw-dt> TagHelper (ADR 0019/0020
    // — the same seam every other timestamp renders through). A null/absent
    // document degrades to the existing text only (the kw-l en floor, no crash).
    string? _subject = KumunitaPrincipal.SubjectId(User);
    GuestAccess? _guest = _subject is null ? null : await Identity.GetGuestAccessAsync(_subject);
    <div class="container-fluid">
        <div class="kmb-notice alert alert-info py-2" role="status" data-kmb-notice="guest">
            <span>
                <kw-l key="account.guest_welcome">You are signed in as a guest. Your access is limited to the surfaces the admin has allowed, for the window they set.</kw-l>
            </span>
            @if (_guest is not null)
            {
                <span class="ms-1">
                    <kw-l key="account.guest_window_end">Your guest access ends on</kw-l>
                    <span class="ms-1 fw-semibold"><kw-dt dt="@_guest.ValidUntil" format="d"></kw-dt></span>
                </span>
            }
            @* The kw-l text IS the link's accessible name (no aria-label — the
               visible localised label is the label; a hardcoded English
               aria-label would override it and break the no-hardcoded-English
               convention). *@
            <span class="ms-2">
                <a href="/issues/new" class="alert-link"><kw-l key="account.guest_reach_admins">Message the admins</kw-l></a>
            </span>
        </div>
    </div>
}
else if (User.Identity?.IsAuthenticated == true
         && !KumunitaPrincipal.HasRole(User, "Member")
         && !KumunitaPrincipal.HasRole(User, "Moderator")
         && !KumunitaPrincipal.HasRole(User, "GlobalAdmin"))
{
    // WINDOW LAPSED (the Guest role is absent ⇒ the window has passed). A guest
    // NEVER gets Member (C-M19·2), and a Member / Moderator / GlobalAdmin is
    // never a guest, so the three role checks above are a cheap claim-only
    // short-circuit that keeps the profile + GuestAccess reads OFF the common
    // resident / admin / moderator path (the E18 concern: one neighborhood, one
    // or two guests — the read must not run for a Member / Moderator /
    // GlobalAdmin). Only a signed-in guest whose window has ended
    // (Profile.IsGuest true AND now ≥ ValidUntil) reaches the friendly lapsed
    // notice below; a roleless unverified resident reads the profile once and
    // falls through (IsGuest false → no notice).
    string? _lapsedSubject = KumunitaPrincipal.SubjectId(User);
    var _lapsedProfile = _lapsedSubject is null ? null : await UserInfo.GetProfileAsync(_lapsedSubject);
    var _lapsedGuest = (_lapsedProfile?.IsGuest == true && _lapsedSubject is not null)
        ? await Identity.GetGuestAccessAsync(_lapsedSubject)
        : null;
    @if (_lapsedProfile?.IsGuest == true && _lapsedGuest is not null && DateTimeOffset.UtcNow >= _lapsedGuest.ValidUntil)
    {
        <div class="container-fluid">
            <div class="kmb-notice alert alert-warning py-2" role="status" data-kmb-notice="guest-lapsed">
                <span>
                    <kw-l key="account.guest_window_expired">Your guest access has ended. If you need more time, or have a question, the admins can help.</kw-l>
                </span>
                <span class="ms-2">
                    <a href="/issues/new" class="alert-link"><kw-l key="account.guest_reach_admins">Message the admins</kw-l></a>
                </span>
            </div>
        </div>
    }
}
@* IMPROVE-UX O03 (D8, ADR 0176 strip idiom) — the GlobalAdmin dashboard
   notice. Shows on every page (the .kmb-notices strip, the same container
   as the guest / onboarding / what's-new notices) when any of the
   operator's instance-status rows is red (the O02 /admin/status page's
   green / amber / red logic mirrored exactly — the SAME booleans the O01
   POCO exposes, so the page and the notice can never disagree). One
   line, a dismissible alert (data-kmb-notice — the ADR 0176 strip
   idiom; data-dismiss-key + btn-close + data-bs-dismiss are the
   _PinnedAnnouncement / _AdminOnboardingBanner dismissal pattern), and
   a single link to /admin/status where the reasons and the full row set
   are rendered (the notice itself carries no warning reason text — the
   "no secret value" invariant is met: the kw-l key + the link, nothing
   else).

   Cheap short-circuit (the E10 / _AdminOnboardingBanner precedent): the
   IInstanceStatusService.GetStatusAsync read runs ONLY when the actor is
   a signed-in GlobalAdmin (KumunitaPrincipal.IsGlobalAdmin — the
   Kumunita.Role claim read, the thin-token rule ADR 0001-B). A Member,
   a Moderator, an ordinary resident, and an anonymous visitor all
   fail the cheap claim check and never pay for the read (the same
   "the reads never run for the other standings" discipline as the
   guest notice's profile + GuestAccess reads above).

   Read-only: no POST, no form, no audit row (a read is a read — the
   O02 AdminStatusController precedent). The notice is the E10 fix:
   today the operator learns about trouble only from logs (where an
   operator does not look) and from mail (SMTP may be exactly what
   failed — the E10 / D8 concern). The notice makes a red instance
   announce itself on the dashboard, so the operator does not have to
   navigate to /admin/status to find out. *@
@if (User.Identity?.IsAuthenticated == true && KumunitaPrincipal.IsGlobalAdmin(User))
{
    var _status = await InstanceStatus.GetStatusAsync(default);
    if (InstanceStatusNotice.AnyRedRow(_status))
    {
        // The accessible name is server-resolved through the same
        // cookie → Accept-Language → instance-default → en chain the
        // <kw-l> TagHelper uses (the EffectiveLanguageCode idiom — the
        // _PinnedAnnouncement / _AdminOnboardingBanner precedent; the
        // kw-l TagHelper can't wrap an attribute, so the a11y.* key is
        // the accessible name). A null provider / no context degrades to
        // the en floor (a11y.status_notice is present in en).
        var _statusNoticeEffLang = await EffectiveLanguageCode.ResolveAsync(
            HttpContextAccessor.HttpContext?.Request, Localization, Translation);
        string _statusNoticeAria = await Translation.GetAsync("a11y.status_notice", _statusNoticeEffLang);
        <div class="container-fluid">
            <div class="kmb-notice alert alert-warning alert-dismissible fade show py-2"
                 role="status" data-kmb-notice="admin-status" aria-label="@_statusNoticeAria">
                <span>
                    <kw-l key="admin.status_notice.text">This instance has configuration or health warnings.</kw-l>
                </span>
                <span class="ms-2">
                    <a href="/admin/status" class="alert-link"><kw-l key="admin.status_notice.action">View instance status</kw-l></a>
                </span>
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"
                        data-dismiss-key="kumunita-admin-status-notice-dismissed"
                        aria-label="Close"></button>
            </div>
        </div>
    }
}
@* M22 (ADR 0132, D5) — the onboarding affordance: the dismissible home/nav
   banner (the _OnboardingBanner partial). Rendered by the partial only
   when the signed-in resident's OnboardingCompletedAt is null (the owner-
   scope read, never a claim — the thin-token rule, ADR 0001-B / D6).
   Non-blocking (D5): it never gates sign-in; the close button is a
   client-side dismiss (onboarding-banner.js), and the only way to clear
   it for real is the explicit finish/skip POST (D2/D4). *@
@await Html.PartialAsync("_OnboardingBanner")
@* What's-new toast (the VN lane, ADR 0110) — announces the current
   platform version (WhatsNew.Latest) with a link to the About page's
   "What's new" section. Dismissal is remembered per browser (see
   _WhatsNewToast.cshtml + client/lib/whatsnew-toast.ts). *@
@await Html.PartialAsync("_WhatsNewToast")
</div>
