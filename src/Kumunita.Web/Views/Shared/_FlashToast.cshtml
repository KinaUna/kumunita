@*
    _FlashToast.cshtml — the one, uniform flash-message surface.

    Every controller that redirects after an action writes TempData["info"]
    or TempData["error"]; the view used to render that in an inline .alert
    wherever the view author chose (inside a card, mid-form, etc.). This
    partial replaces all of those: it renders a Bootstrap 5.3 toast in a
    fixed top-right container, driven by client/lib/flash-toast.js
    (type="module", loaded in _Layout.cshtml).

    The container only appears when there is at least one flash value,
    so pages with no flash render no extra markup.

    Accessibility:
      - info  → role="status"  aria-live="polite"     (non-assertive)
      - error → role="alert"   aria-live="assertive"  (assertive)
    Both are aria-atomic (the whole toast is announced, not char-by-char).

    Auto-hide: 5 s. The `show` class is in the markup so the message is
    visible even without JS (and to screen readers immediately);
    client/lib/flash-toast.js (loaded in _Layout.cshtml) attaches a
    Bootstrap 5.3 `Toast` instance with `{ autohide: true, delay: 5000 }`
    — the data API does not read data-bs-autohide / data-bs-delay (a
    Bootstrap upstream limitation), so the config is passed in JS.
*@
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    string? info = TempData["info"]   as string;
    string? err  = TempData["error"]  as string;
    // ADR 0241 — an optional action on the info toast (Undo after a document delete): a POST to
    // a same-site path. Only a path starting with a single "/" is honoured, so a value can never
    // point the form at another origin.
    string? actionUrl   = TempData["info_action_url"]   as string;
    string? actionLabel = TempData["info_action_label"] as string;
    bool hasAction = info is not null
        && !string.IsNullOrWhiteSpace(actionLabel)
        && actionUrl is { Length: > 1 } && actionUrl[0] == '/' && actionUrl[1] != '/' && actionUrl[1] != '\\';
    // The toast's accessible names are server-resolved (the kw-l TagHelper
    // can't wrap an attribute); the a11y.* floor is the closed set. A null
    // provider (a non-HTTP render) degrades to the en floor.
    string ariaNotifications = "Notifications";
    string ariaClose         = "Close";
    if (Translation is not null)
    {
        var effLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
        ariaNotifications = await Translation.GetAsync("a11y.notifications", effLang);
        ariaClose         = await Translation.GetAsync("a11y.close", effLang);
    }
}
@if (info is not null || err is not null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3 kmb-flash-toast"
         id="flash-toast-container" aria-label="@ariaNotifications">
        @if (info is not null)
        {
            <div class="toast align-items-center text-bg-success border-0 show"
                 role="status" aria-live="polite" aria-atomic="true"
                 data-kmb-toast-delay="@(hasAction ? 12000 : 5000)">
                <div class="d-flex">
                    <div class="toast-body">@info</div>
                    @if (hasAction)
                    {
                        <form method="post" action="@actionUrl" class="m-auto me-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-light">@actionLabel</button>
                        </form>
                    }
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="@ariaClose"></button>
                </div>
            </div>
        }
        @if (err is not null)
        {
            <div class="toast align-items-center text-bg-danger border-0 show"
                 role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">@err</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="@ariaClose"></button>
                </div>
            </div>
        }
    </div>
}
