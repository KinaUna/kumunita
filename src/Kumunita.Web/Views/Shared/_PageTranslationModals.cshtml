@*
    _PageTranslationModals — the shared Bootstrap modals for the
    page-translation add / edit lanes (the ADR 0027 / ADR 0071 rich-editor
    shape, carried verbatim from the <c>Views/Page/Show.cshtml</c> dropdown).
    Rendered once per page, referenced by the ⋮ action dropdown. Shared so
    the page detail surface (<c>Views/Page/Show.cshtml</c>) and the
    <c>/admin/platform</c> platform-pages table (ADR 0161) render the same
    modals without duplication.

    The <c>IdPrefix</c> disambiguates element ids when the same partial
    renders for multiple pages on one document (the /admin/platform table has
    one row per system page). Each modal's id, its aria-labelledby, the form
    id, and the title/body field ids are all derived from
    <c>{IdPrefix}-{edit|add}-{languageCode}-…</c>.

    The rich editor (client/lib/rich-editor.ts, tsc-built) self-wires every
    <c>.rc-editor</c> block at module load, so it works inside a modal without
    any extra wiring (the ADR 0031 surface, carried verbatim).

    Usage:
        <partial name="_PageTranslationModals" model="new PageTranslationModalsModel(
            IdPrefix, PageId, Title, Translations, MissingLanguages, Languages)" />
*@
@model Kumunita.Web.Models.PageTranslationModalsModel
@using Kumunita.Web.Models
@{
    string LangName(string code) =>
        Model.LangNames.TryGetValue(code, out var n) ? n : code;
    string prefix = Model.IdPrefix;
    string pid = Model.PageId;
    var existing = Model.Translations.OrderBy(x => x.LanguageCode).ToList();
    var addable = Model.MissingLanguages;
}

@foreach (var t in existing)
{
    string languageCode = t.LanguageCode;
    string formId = $"{prefix}-trans-edit-form-{languageCode}";
    string bodyId = $"{prefix}-trans-edit-body-{languageCode}";
    string titleId = $"{prefix}-trans-edit-title-{languageCode}";
    string labelId = $"{prefix}-trans-edit-label-{languageCode}";
    string modalId = $"{prefix}-trans-edit-{languageCode}";

    <div class="modal fade" id="@modalId" tabindex="-1"
         aria-labelledby="@labelId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" action="@($"/pages/{pid}/translations/update")" id="@formId">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="languageCode" value="@languageCode" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="@labelId">
                            <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(languageCode)</b>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="@titleId">
                                @LangName(languageCode) <kw-l key="posts.translation_title_label">title</kw-l>
                                <span class="text-muted">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                            </label>
                            <input class="form-control" type="text" name="title"
                                   id="@titleId" value="@t.Title" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="@bodyId">
                                <kw-l key="posts.translation_body_label">Body</kw-l>
                            </label>
                            <div class="rc-editor">
                                <div class="rc-editor-toolbar" data-rich-editor>
                                    <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                                    <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                                    <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                                    <partial name="_RichEditorToggle" />
                                </div>
                                <textarea class="form-control" id="@bodyId"
                                          name="body" rows="4" required placeholder="…" data-rich-editor>@t.Body</textarea>
                                <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <kw-l key="common.cancel">Cancel</kw-l>
                        </button>
                        <button type="submit" class="btn btn-primary" form="@formId">
                            <kw-l key="posts.translation_save">Save translation</kw-l>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

