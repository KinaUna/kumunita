@model Kumunita.Web.Models.PagedViewModel
@using System.Text
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@functions {
    // D7 — the pager's links carry the *current* filter values as query
    // pairs, so prev/next don't drop the filter (the F3 pin). `page`
    // comes first; the frozen FilterParams (D9 inventory) follow.
    string PagerLink(int page)
    {
        var sb = new StringBuilder(Model.BaseUrl);
        sb.Append('?');
        sb.Append("page=").Append(page.ToString());
        foreach (var (k, v) in Model.FilterParams)
        {
            sb.Append('&');
            sb.Append(Uri.EscapeDataString(k));
            sb.Append('=');
            sb.Append(Uri.EscapeDataString(v));
        }
        return sb.ToString();
    }
}
@if (Model.HasPrevious || Model.HasNext)
{
    // The pager's accessible name is server-resolved (the kw-l TagHelper can't
    // wrap an attribute); the a11y.* floor is the closed set. A null provider
    // (a non-HTTP render) degrades to the en floor.
    string ariaPagination = "Pagination";
    if (Translation is not null)
    {
        var effLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
        ariaPagination = await Translation.GetAsync("a11y.pagination", effLang);
    }

    <nav aria-label="@ariaPagination" class="mt-3">
        <ul class="pagination flex-wrap">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link"
                   href="@(Model.HasPrevious ? PagerLink(Model.CurrentPage - 1) : "#")"
                   rel="prev"><kw-l key="pagination.prev">Newer</kw-l></a>
            </li>
            @* ADR 0219 — numbered pages, count-free (ADR 0090 D1 stays: there is no
               TotalPages). Window: 1 … (current-1) [current] (current+1, only when the
               seam says there is a next page). The numerals are self-describing, so no
               new translation keys; the ellipsis is decorative (aria-hidden). *@
            @if (Model.CurrentPage > 2)
            {
                <li class="page-item"><a class="page-link" href="@PagerLink(1)">1</a></li>
            }
            @if (Model.CurrentPage > 3)
            {
                <li class="page-item disabled" aria-hidden="true"><span class="page-link">…</span></li>
            }
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item"><a class="page-link" href="@PagerLink(Model.CurrentPage - 1)">@(Model.CurrentPage - 1)</a></li>
            }
            <li class="page-item active" aria-current="page"><span class="page-link">@Model.CurrentPage</span></li>
            @if (Model.HasNext)
            {
                <li class="page-item"><a class="page-link" href="@PagerLink(Model.CurrentPage + 1)">@(Model.CurrentPage + 1)</a></li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link"
                   href="@(Model.HasNext ? PagerLink(Model.CurrentPage + 1) : "#")"
                   rel="next"><kw-l key="pagination.next">Older</kw-l></a>
            </li>
        </ul>
    </nav>
}
