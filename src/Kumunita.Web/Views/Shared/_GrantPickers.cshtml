@using Kumunita.Core.Authorization
@using Kumunita.Web.Models
@model GrantPickersModel
@*
    The shared "Who to grant to" section (extracted from
    Views/Profile/_AudienceEditor.cshtml, the M2 U11 editor's checkbox
    picker, moved verbatim). Rendered by:
      • _AudienceEditor (Profile/Edit — the "Visibility" /
        "ContactVisibility" invocations), and
      • Posts/New.cshtml — the M3 composer's "Audience" editor
        (the M3 U8 deviation's "a future unit decides whether to
        extract the shared partial" — decided and extracted here).

    Shape pins carried over from M2 (the U11 / F13 single-source pin):
      • The checkboxes are display-only (no name=) — the hidden
        <c>Grants</c> textarea below is the <b>only</b> form-bound
        grant field the default model binder lands on (<Name>.Grants).
      • <see cref="AudienceEditorModel.ParsedGrants"/> (a read view of
        the transport) pre-checks the boxes; the
        <c>_GrantPickerScripts</c> partial's script keeps the textarea
          in two-way sync with the pickers' selection as the user
        toggles options, so the posted JSON always reflects their
        choice. When JS is unavailable the checkboxes are inert but
        the textarea remains — the e2e selector pin
        (textarea[name="Visibility.Grants"] etc.) still finds it.
      • Each section gets a tri-state "Select all" shortcut checkbox
        (checked / unchecked / indeterminate), managed by the script.
*@
@{
    var usersSelected = Model.Editor.ParsedGrants
        .Where(g => g.Kind == GrantKind.User)
        .Select(g => g.Id)
        .ToHashSet(StringComparer.Ordinal);
    var groupsSelected = Model.Editor.ParsedGrants
        .Where(g => g.Kind == GrantKind.Group)
        .Select(g => g.Id)
        .ToHashSet(StringComparer.Ordinal);

    var userCount = Model.Users.Count;
    var groupCount = Model.Groups.Count;

    // Renders one checkbox-list section (a "select all" shortcut
    // row + one form-check per option). Checkboxes are display-only
    // (no name=) — the hidden Grants textarea is still the only
    // form-bound grant field (the U11 / F13 single-source pin);
    // the _GrantPickerScripts script keeps them in two-way sync.
    string renderGrantCheckboxSection(string kind, IReadOnlyList<GrantOption> opts,
        HashSet<string> selected, string groupLabel)
    {
        var sb = new System.Text.StringBuilder();
        string sectionId = Model.EditorName + "-grants-" + kind.ToLowerInvariant();
        string allId = sectionId + "-all";
        sb.Append(
            "<div class=\"kw-grant-section\" data-editor=\"" + Html.Encode(Model.EditorName) + "\"" +
            " data-kind=\"" + kind + "\">" +
            "<div class=\"form-check ms-1\" style=\"margin-bottom:0.25rem;\">" +
            "<input class=\"form-check-input kw-grant-all\" type=\"checkbox\" id=\"" + allId + "\"" +
            " aria-label=\"Select all " + groupLabel.ToLowerInvariant() + "\" />" +
            "<label class=\"form-check-label small fw-semibold\" for=\"" + allId + "\">" +
            "Select all " + Html.Encode(groupLabel) + "</label>" +
            "</div>" +
            "<div class=\"kw-grant-boxes ms-1\" style=\"max-height:14rem;overflow:auto;\">");
        foreach (var o in opts)
        {
            string boxId = sectionId + "-" + o.Id;
            sb.Append(
                "<div class=\"form-check\">" +
                "<input class=\"form-check-input kw-grant-check\" type=\"checkbox\"" +
                " id=\"" + boxId + "\" value=\"" + Html.Encode(o.Id) + "\"" +
                " data-kind=\"" + kind + "\"" +
                (selected.Contains(o.Id) ? " checked" : "") +
                " aria-label=\"" + Html.Encode(o.Label) + "\" />" +
                "<label class=\"form-check-label\" for=\"" + boxId + "\">" +
                Html.Encode(o.Label) + "</label>" +
                "</div>");
        }
        sb.Append("</div>" +
                "<small class=\"text-muted ms-1\" data-role=\"grant-count\">" +
                selected.Count + " of " + opts.Count + " selected</small>" +
                "</div>");
        return sb.ToString();
    }
}

<div class="form-label mt-3" style="font-weight:600;">
    Who to grant to
</div>
<div class="small text-muted" style="margin-left:0.25rem;">
    Check one or many — or use the "Select all" row above each
    list as a shortcut.
</div>

@if (userCount > 0)
{
    <div class="mt-1">
        @Html.Raw(renderGrantCheckboxSection("User", Model.Users, usersSelected, "Residences"))
    </div>
}
else
{
    <p class="mb-1 text-muted small ms-1">
        You're the only verified resident, so there's no one else
        to grant to yet.
    </p>
}

@if (groupCount > 0)
{
    <div class="mt-2">
        @Html.Raw(renderGrantCheckboxSection("Group", Model.Groups, groupsSelected, "Groups"))
    </div>
}
else
{
    <p class="mb-1 mt-2 text-muted small ms-1">
        No groups exist on the platform yet — create one under
        "Groups" to add group-scoped visibility.
    </p>
}

@* The grants textarea — d-none, the form's posting element only.
   The e2e selector pin (textarea[name="{EditorName}.Grants"])
   survives for every invocation; the _GrantPickerScripts script
   keeps its value in sync with the pickers' selection as the user
   toggles options, so the posted JSON always reflects their choice.
   The U11 / F13 single-source pin: <c>BuildAudience</c>
   deserializer on AudienceEditorModel is the only
   deserialization site; this textarea is the only
   serialization site (the controller's ToEditorModel the dual on
   the GET). The JSON shape is the transport, not a second
   audience object — the <c>Audience</c> document is the only
   audience the write seam receives (F13). The hidden textarea
   also remains editable by hand for the no-JS fallback path. *@
<textarea class="d-none"
          name="@($"{Model.EditorName}.Grants")" id="@($"{Model.EditorName}.Grants")" rows="1"
          data-editor-name="@Model.EditorName">
@(Model.Editor.Grants ?? string.Empty)</textarea>
