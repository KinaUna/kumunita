@using Kumunita.Core.Localization
@using Kumunita.Web.Security
@inject ILocalizationService Localization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@*
    Right-hand nav actions (the public section links live in the layout's
    left nav). Signed in: Profile · Admin (global admins only) · Sign out.
    Signed out: Sign in · Sign up.
*@
@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    // KumunitaPrincipal.IsGlobalAdmin reads the Kumunita.Role claim type (not the BCL
    // default) — see the helper's doc; ClaimsPrincipal.IsInRole would not match this shape.
    bool isGlobalAdmin = KumunitaPrincipal.IsGlobalAdmin(User);
    // ADR 0021 — the Translator lane: a delegated translation editor gets a direct link
    // to the languages surface (the translation editors are open to them). GlobalAdmins
    // already reach it through the Admin shell, so this link is Translator-only.
    bool isTranslator = KumunitaPrincipal.IsTranslator(User);

    // The nav-bar language switcher: the enabled catalog (in SortOrder), and the
    // resident's current preference (the kumunita.locale cookie) to mark the
    // active choice. A read — never a write, never a claim (the thin-token rule).
    var httpReq = HttpContextAccessor.HttpContext?.Request;
    var navLanguages = (await Localization.ListLanguagesAsync())
        .Where(l => l.Enabled)
        .OrderBy(l => l.SortOrder)
        .ToList();
    var currentLang = httpReq is null ? null : LocaleCookie.Read(httpReq);
    var returnUrl = httpReq is null ? null : httpReq.Path + httpReq.QueryString;
}

<ul class="navbar-nav">
    @* Language switcher — a globe icon with a Bootstrap dropdown of the enabled
       languages (visible to signed-in AND signed-out residents, ML-UI U7). Picking
       a language posts to the same public /language save the quick picker used;
       the ReturnUrl keeps the resident on the page they were on. The full settings
       experience (/settings/language) remains the [Authorize]d page. *@
    <li class="nav-item dropdown">
        <a class="nav-link text-dark dropdown-toggle d-inline-flex align-items-center" href="#"
           id="languageMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false"
           title="@("Language — " + (currentLang is null ? "instance default" : currentLang))">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16"
                 fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="8" cy="8" r="6.2"/>
                <path d="M1.9 8h12.2"/>
                <path d="M8 1.9c2.55 2.1 2.55 10.1 0 12.2"/>
                <path d="M8 1.9c-2.55 2.1-2.55 10.1 0 12.2"/>
            </svg>
            <span class="visually-hidden"><kw-l key="settings.choose_language">Choose your language</kw-l></span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageMenu">
            @foreach (var lang in navLanguages)
            {
                var isActive = currentLang == lang.Id;
                <li>
                    <form method="post" action="/language" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <input type="hidden" name="code" value="@lang.Id" />
                        <button type="submit" class="dropdown-item text-start @(isActive ? "fw-semibold" : "")">
                            @lang.NativeName
                            @(isActive ? " ✓" : "")
                        </button>
                    </form>
                </li>
            }
        </ul>
    </li>
    @if (isAuthenticated)
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Profile" asp-action="Edit"><kw-l key="nav.profile">Profile</kw-l></a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" href="/settings/language"><kw-l key="settings.settings">Settings</kw-l></a>
        </li>
        @if (isGlobalAdmin)
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index"><kw-l key="nav.admin">Admin</kw-l></a>
            </li>
        }
        @* ADR 0021 — the Translator's home: the language catalog + translation editors.
           Shown to Translators only (a GlobalAdmin reaches it via the Admin shell link). *@
        @if (isTranslator && !isGlobalAdmin)
        {
            <li class="nav-item">
                <a class="nav-link text-dark" href="/admin/languages"><kw-l key="nav.translations">Translations</kw-l></a>
            </li>
        }
        <li class="nav-item">
            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post"
                  style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-link nav-link text-dark" style="border:none; background:none;"><kw-l key="nav.sign_out">Sign out</kw-l></button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login"><kw-l key="nav.sign_in">Sign in</kw-l></a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Signup"><kw-l key="nav.sign_up">Sign up</kw-l></a>
        </li>
    }
</ul>
