@using Kumunita.Web.Security
@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    // KumunitaPrincipal.IsGlobalAdmin reads the Kumunita.Role claim type (not the BCL
    // default) — see the helper's doc; ClaimsPrincipal.IsInRole would not match this shape.
    bool isGlobalAdmin = KumunitaPrincipal.IsGlobalAdmin(User);
}

<ul class="navbar-nav">
    @if (isAuthenticated)
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Profile" asp-action="Edit">Profile</a>
        </li>
        @* M2 (U8): the resident-facing directory — the visible-profile list
           + the two-gate detail (§9 pin at DirectoryController.ProjectDetail).
           The DirectoryController is [Authorize]-gated, so the link belongs
           in the signed-in branch here rather than the layout's anonymous
           nav. *@
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Directory" asp-action="Index">Directory</a>
        </li>
        @* M3 (U8): the single-entry Community nav link.
           one component (id "safety", per FirstBootSeeder's seed order) —
           the "default community". Now repointed to the all-sections feed
           (GET /community) so the link shows the union of every enabled
           section; each per-section feed remains one click away at
           /community/{sectionId}. *@
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-controller="Posts" asp-action="AllSections">
                Community
            </a>
        </li>
        @if (isGlobalAdmin)
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Admin</a>
            </li>
        }
        <li class="nav-item">
            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post"
                  style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-link nav-link text-dark" style="border:none; background:none;">
                    Sign out
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Sign in</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Signup">Sign up</a>
        </li>
    }
</ul>
