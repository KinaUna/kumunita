@using Kumunita.Web.Security
@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    // KumunitaPrincipal.IsGlobalAdmin reads the Kumunita.Role claim type (not the BCL
    // default) — see the helper's doc; ClaimsPrincipal.IsInRole would not match this shape.
    bool isGlobalAdmin = KumunitaPrincipal.IsGlobalAdmin(User);
}

<ul class="navbar-nav">
    @if (isAuthenticated)
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Profile" asp-action="Edit">Profile</a>
        </li>
        @* M3 (U8): the single-entry Community nav link. The "exact routing is
           U8's call" line of the plan pins the nav to *one* entry linking to
           the Posts feed (the "default community" — the first-seeded component,
           id "safety", per FirstBootSeeder's seed order) — one line, not three
           (the "part sprawl" anti-pattern). *@
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-controller="Posts" asp-action="Index"
               asp-route-componentId="safety">
                Community
            </a>
        </li>
        @if (isGlobalAdmin)
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Admin</a>
            </li>
        }
        <li class="nav-item">
            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post"
                  style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-link nav-link text-dark" style="border:none; background:none;">
                    Sign out
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Sign in</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Signup">Sign up</a>
        </li>
    }
</ul>
