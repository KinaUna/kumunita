    <script type="module" src="~/js/lib/admin-edit-toggle.js"></script>
    <!-- Directory-card click→nav (SECURITY.md §6; Directory/Index whole-card) -->
    <script type="module" src="~/js/lib/directory-card.js"></script>
    <!-- Pinned-announcement dismissal (SECURITY.md §6; per-announcement sessionStorage) -->
    <script type="module" src="~/js/lib/pinned-announcement.js"></script>
    <!-- Page-form visibility (SECURITY.md §6; ADR 0041 scope/individual blocks) -->
    <script type="module" src="~/js/lib/page-form-visibility.js"></script>
