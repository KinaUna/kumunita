                        <a class="kmb-rail-btn @(activeNav == "events" ? "active" : null)" href="/events">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><path d="M8 5v3.2l2.2 1.3"/></svg>
                            <span class="visually-hidden">@_navEvents</span>
                            <span class="kmb-rail-label">@_navEvents</span>
                            <span class="kmb-rail-tip">@_navEvents</span>
                        </a>
                        <a class="kmb-rail-btn @(activeNav == "projects" ? "active" : null)" href="/projects/todos">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2.5" y="2.5" width="11" height="11" rx="2"/><path d="M5 6h6M5 9h4"/></svg>
                            <span class="visually-hidden">@_navProjects</span>
                            <span class="kmb-rail-label">@_navProjects</span>
                            <span class="kmb-rail-tip">@_navProjects</span>
                        </a>
                        @* M16 (ADR 0117) — the Inventory surface rail icon
                           (the M5 projects nav-entry shape; D6 standing core
                           surface). *@
                        <a class="kmb-rail-btn @(activeNav == "inventory" ? "active" : null)" href="/inventory">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2.5" y="5" width="11" height="8" rx="1"/><path d="M6 5V3.5h4V5M8 8v3M6.5 9.5h3"/></svg>
                            <span class="visually-hidden">@_navInventory</span>
                            <span class="kmb-rail-label">@_navInventory</span>
                            <span class="kmb-rail-tip">@_navInventory</span>
                        </a>
                        @* M17 (ADR 0118) — the Bookmarks surface rail icon
                           (the M16 inventory nav-entry shape; D6 standing
                           core surface). *@
                        <a class="kmb-rail-btn @(activeNav == "bookmarks" ? "active" : null)" href="/bookmarks">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M4 2.5h8v11l-4-3-4 3z"/></svg>
                            <span class="visually-hidden">@_navBookmarks</span>
                            <span class="kmb-rail-label">@_navBookmarks</span>
                            <span class="kmb-rail-tip">@_navBookmarks</span>
                        </a>
                        @* M37 (ADR 0167) — the Personal Notes surface rail icon
                           (the M17 bookmarks rail-entry shape; D6 standing core
                           surface). A paper + pencil glyph (a note). *@
                        <a class="kmb-rail-btn @(activeNav == "notes" ? "active" : null)" href="/notes">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M4 2.5h6l2 2v9.5H4z"/><path d="M10 2.5V4.5h2"/><path d="M6 8h4M6 10.5h3"/></svg>
                            <span class="visually-hidden">@_navNotes</span>
                            <span class="kmb-rail-label">@_navNotes</span>
                            <span class="kmb-rail-tip">@_navNotes</span>
                        </a>
                        @* M21 (ADR 0122) — the Document management surface rail
                           icon (the M17 bookmarks rail-entry shape). Reuses
                           documents.title — the closed 12-key nav set stays
                           closed (no 13th nav.documents key). *@
                        <a class="kmb-rail-btn @(activeNav == "documents" ? "active" : null)" href="/documents">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M4 2.5h5l3.5 3.5v7.5h-8.5z"/><path d="M9 2.5V6h3.5"/><path d="M6 9.5h4M6 12h3"/></svg>
                            <span class="visually-hidden">@_navDocuments</span>
                            <span class="kmb-rail-label">@_navDocuments</span>
                            <span class="kmb-rail-tip">@_navDocuments</span>
                        </a>
                        <a class="kmb-rail-btn @(activeNav == "pages" ? "active" : null)" href="/pages">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2.5" y="2.5" width="11" height="11" rx="2"/><path d="M5 6h6M5 9h6M5 12h4"/></svg>
                            <span class="visually-hidden">@_navPages</span>
                            <span class="kmb-rail-label">@_navPages</span>
                            <span class="kmb-rail-tip">@_navPages</span>
                        </a>
                        <a class="kmb-rail-btn @(activeNav == "tags" ? "active" : null)" href="/tags">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m5.5 4 6.5 6.5"/><circle cx="4" cy="4" r="1.8"/><circle cx="12" cy="12" r="1.8"/></svg>
                            <span class="visually-hidden">@_navTags</span>
                            <span class="kmb-rail-label">@_navTags</span>
                            <span class="kmb-rail-tip">@_navTags</span>
                        </a>
                        <a class="kmb-rail-btn @(activeNav == "directory" ? "active" : null)" asp-controller="Directory" asp-action="Index">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8" cy="5.5" r="3"/><path d="M2.5 14c.5-3 2.5-4.5 5.5-4.5s5 1.5 5.5 4.5"/></svg>
                            <span class="visually-hidden">@_navDirectory</span>
                            <span class="kmb-rail-label">@_navDirectory</span>
                            <span class="kmb-rail-tip">@_navDirectory</span>
                        </a>
                        @* M23 (ADR 0123 F6) — the "People" nav entry (the
                           find-people surface, /people): next to Directory in
                           the rail, the same rail-btn shape (a two-people icon). *@
                        <a class="kmb-rail-btn @(activeNav == "people" ? "active" : null)" asp-controller="FindPeople" asp-action="Index">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="5.5" cy="5" r="2.5"/><path d="M1.5 13c.4-2.6 2-3.9 4-3.9s3.6 1.3 4 3.9"/><circle cx="11" cy="6" r="2"/><path d="M10 13c.3-2 1.4-3 3-3 1 0 1.9.6 2.3 1.6"/></svg>
                            <span class="visually-hidden">@_navPeople</span>
                            <span class="kmb-rail-label">@_navPeople</span>
                            <span class="kmb-rail-tip">@_navPeople</span>
                        </a>
                    }
                </nav>
                <nav class="navbar navbar-expand-sm kmb-topbar navbar-light bg-white border-bottom">
                    <div class="container-fluid kmb-topbar-inner">
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".kmb-topbar-collapse"
                                aria-expanded="false" aria-label="@_a11yToggleNav">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="kmb-topbar-collapse collapse d-sm-inline-flex flex-grow-1 align-items-center gap-2">
                            @* M8 (ADR 0091 D1) — the search box. *@
                            @{ var _kwLNavC = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
                               var _navPlaceholderC = Translation is null ? Kumunita.Core.Localization.KnownTranslationKeys.EnValues["search.placeholder"] : await Translation.GetAsync("search.placeholder", _kwLNavC);
                               var _navAriaLabelC = Translation is null ? Kumunita.Core.Localization.KnownTranslationKeys.EnValues["search.nav"] : await Translation.GetAsync("search.nav", _kwLNavC); }
                            <form class="navbar-form kmb-topbar-search" action="/search" method="get" role="search">
                                <input class="form-control" type="search" name="q" placeholder="@_navPlaceholderC" aria-label="@_navAriaLabelC" required />
                            </form>
                            @* The _AccountNav partial renders here in variant C exactly
                               as it does in variant B (bell + account dropdown signed-in;
                               language + sign in/up signed-out) — the e2e-frozen
                               a#accountMenu / a#notifications-bell / a#languageMenu
                               all resolve here. *@
                            <partial name="_AccountNav" />
                        </div>
                    </div>
                </nav>
            }
        </header>
    <main role="main" class="pb-3">
        @if (fullBleed)
        {
            @RenderBody()
        }
        else
        {
            <div class="container">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="kmb-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-md-5 col-lg-4">
                    <p class="navbar-brand mb-2">Kumunita</p>
                    <p class="mb-2" style="max-width: 34ch;"><kw-l key="footer.tagline">A private home for one neighborhood — the feed, the groups and the pinned notes. What happens on your street stays on your street.</kw-l></p>
                    <p class="small mb-0">&copy; @DateTime.Now.Year Kumunita <kw-l key="footer.copyright">· self-hosted by your community</kw-l></p>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <h3><kw-l key="nav.community">Community</kw-l></h3>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index"><kw-l key="nav.home">Home</kw-l></a></li>
                        @* ADR 0039 §3.8 — the mount-point resolver (footer/community slot):
                           the page mounted here renders as a link; an unmounted slot
                           renders nothing. Display, not access — the Show action is
                           the Read decision. *@
                        @{ ViewData["MountSlot"] = "footer/community"; }
                        <partial name="_MountSlot" />
                        <li><a href="/announcements"><kw-l key="nav.announcements">Announcements</kw-l></a></li>
                        <li><a asp-controller="Posts" asp-action="AllSections"><kw-l key="footer.feed">The feed</kw-l></a></li>
                    </ul>
                </div>
                @* SP U03 (ADR 0043 D4) — the footer "Platform" column: the five
                   shipped platform surfaces, linked **unconditionally** for every
                   visitor (floor-honesty — no existence probe, no @if: a link whose
                   page is absent from the tree lands on its existing floor). The
                   navbar is deliberately untouched (the recorded D4 decision). *@
                <div class="col-6 col-md-4 col-lg-2">
                    <h3><kw-l key="footer.platform.heading">Platform</kw-l></h3>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><a href="/about"><kw-l key="footer.platform.about">About</kw-l></a></li>
                        <li><a href="/terms"><kw-l key="footer.platform.terms">Terms of use</kw-l></a></li>
                        <li><a href="/help"><kw-l key="footer.platform.help">Help</kw-l></a></li>
                        <li><a href="/privacy"><kw-l key="footer.platform.privacy">Privacy</kw-l></a></li>
                        <li><a href="/conduct"><kw-l key="footer.platform.conduct">Code of conduct</kw-l></a></li>
                        @* M32 (ADR 0155) — the public "Report an issue" affordance
                           (the issue.nav key, key 9 of the U06 closed set): links the
                           M32 /issues/new general issue-submission surface. Linked
                           unconditionally for every visitor (floor-honesty, the SP U03
                           shape above) because M32·4 is public/anonymous-safe — the
                           M31·2 500-form precedent. The design doc §2.3 named it "the
                           nav entry (issue.nav)"; the footer Platform column is the
                           public, platform-level seam that matches that intent — the
                           signed-in-only More menu would gate a public surface. *@
                        <li><a href="/issues/new"><kw-l key="issue.nav">Report an issue</kw-l></a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <h3><kw-l key="footer.project.heading">The project</kw-l></h3>
                    <ul class="list-unstyled d-grid gap-2">
                        @foreach (var link in RepositoryInfo.Links)
                        {
                            <li>
                                <a href="@link.Url" target="_blank" rel="noopener noreferrer"><kw-l key="@link.Key">@link.Label</kw-l></a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-12 col-md-3 col-lg-3">
                    <h3><kw-l key="footer.gtk_heading">Good to know</kw-l></h3>
                    <p class="small mb-2"><kw-l key="footer.gtk_privacy">Private by default: each post's audience is chosen by its author, and everything is readable by you, not the world.</kw-l></p>
                    <p class="small mb-0"><kw-l key="footer.gtk_oss">Kumunita is open source — the code, the decisions, the docs.</kw-l></p>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Avatar monogram fallback (client/lib/avatar.ts, tsc-built — SECURITY.md §6:
         no inline on*/<script> in Razor views; the U8 onerror it replaced is per img) -->
    <script type="module" src="~/js/lib/avatar.js"></script>
    <!-- Avatar upload gating (client/lib/avatar-upload.ts, tsc-built — SECURITY.md §6:
         no inline on*/<script> in Razor views; disables "Save avatar" until a file is chosen) -->
    <script type="module" src="~/js/lib/avatar-upload.js"></script>
    <!-- Translation display swap (client/lib/translation-swap.ts, tsc-built — TD / ADR 0027:
         click-to-swap toggles the pre-rendered .td-variant containers; display-only, no fetch) -->
    <script type="module" src="~/js/lib/translation-swap.js"></script>
    <!-- Confirm-before-submit (SECURITY.md §6 no-inline-script; replaces the
         onsubmit="return confirm(..." pattern across ~18 views) -->
    <script type="module" src="~/js/lib/confirm.js"></script>
    <!-- Reset-form (SECURITY.md §6 no-inline-script; replaces the
         onclick="this.form.reset()" pattern) -->
    <script type="module" src="~/js/lib/reset-form.js"></script>
    <!-- Detach menu (SECURITY.md §6 no-inline-script): while an opted-in
         dropdown (data-detach) is open, re-home its .dropdown-menu onto <body>
         so it escapes overflow-clipping ancestors (Kanban board / to-do feed)
         and always renders fully on top. Loaded after bootstrap.bundle so
         window.bootstrap is available. -->
    <script type="module" src="~/js/lib/detach-menu.js"></script>
    <!-- Audience-toggle (SECURITY.md §6; ADR 0036 checkbox→panel visibility) -->
    <script type="module" src="~/js/lib/audience-toggle.js"></script>
    <!-- Name-filter (SECURITY.md §6; Groups/Detail invite + add-member forms) -->
    <script type="module" src="~/js/lib/name-filter.js"></script>
