@using Kumunita.Web.Security
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    // ADR 0133 — the theme preference (the kumunita.theme cookie): auto (default,
    // follow the OS prefers-color-scheme) | light | dark (the Forest theme).
    // auto is resolved entirely in site.css (@media prefers-color-scheme), so
    // the attribute is only emitted for an explicit override — no JS, no flash.
    var themeMode = ThemeCookie.Read(Context.Request);
}
<!DOCTYPE html>
<html lang="en" data-kmb-theme="@(themeMode == ThemeCookie.Light ? ThemeCookie.Light : (themeMode == ThemeCookie.Dark ? ThemeCookie.Dark : null))">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1c4532" />
    @* RC U05 (drift pause e, resolved): the anti-forgery token for the fetch-based
       page modules (client/lib/api.ts). api.ts reads <meta name="anti-forgery-token">
       and sends it in the RequestVerificationToken header — the header [ValidateAntiForgeryToken]
       accepts by convention. The value is the RequestToken from the same IAntiforgery
       that @Html.AntiForgeryToken() on every existing form draws on, so the upload fetch
       (POST /content-image) is CSRF-aware. (GetAndStoreTokens is the canonical way to get the
       bare token string in a model-less layout; the avatar lane never needed this because it
       form-POSTs, but the content-image upload is the first fetch-based consumer.) *@
    <meta name="anti-forgery-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - Kumunita</title>
    <link rel="icon" type="image/png" href="~/images/logo/kumunita_k_logo_64x64.png" />
    <link rel="apple-touch-icon" href="~/images/logo/kumunita_k_logo_64x64.png" />
    @* M10 (ADR 0107 D3) — the PWA web-app manifest: the installable app shell
       (wwwroot/manifest.webmanifest — D3's closed field set + the 192/512
       icon pair). Same-origin static asset, so script-src 'self' (C-M10·3) is
       untouched; the install affordance (U03, pwa-install.ts) is the only
       consumer of the beforeinstallprompt this enables. *@
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    // Landing-style pages opt out of the shared .container wrapper (see the
    // <main> block below) so their sections can run full-bleed. Set with
    // ViewData["FullBleed"] = true in the page (home page, Views/Home/Index).
    bool fullBleed = ViewData["FullBleed"] is true;

    // ADR 0111 — the nav-variant preference (the kumunita.nav cookie, ADR
    // 0001-B: a preference, never a claim). Default B (compact top row);
    // variant C (icon rail) is the explicit opt-in.
    var navVariant = NavLayoutCookie.Read(Context.Request);
}

<body class="@(fullBleed ? "kmb-page-fullbleed" : null) @(navVariant == NavLayoutCookie.Rail ? "kmb-nav-rail-mode" : null)">
    @* Flash toast — the one, uniform flash-message surface (TempData["info"]
       / ["error"]). Renders a fixed top-right Bootstrap toast when the
       controller left a flash value on the last redirect. Replaces the
       per-view .alert blocks that used to land inline wherever each view
       author placed them. *@
    @await Html.PartialAsync("_FlashToast")
    @await Html.PartialAsync("_PinnedAnnouncement")
    @* M19 F2 — the guest shell notice (the account.guest_welcome key).
       Renders only when the Guest role is present, which is only minted by
       KumunitaClaimsPrincipalFactory when the allowance window is live
       (ValidFrom ≤ now < ValidUntil). An expired guest gets no Guest claim,
       so the notice disappears automatically — no job, no extra DB read.
       Use KumunitaPrincipal.HasRole (NOT ClaimsPrincipal.IsInRole): Kumunita's
       roles ride the custom "Kumunita.Role" claim type, not the BCL default,
       so the built-in IsInRole would never match. The kw-l TagHelper resolves
       the label in the viewer's language. *@
    @if (User.Identity?.IsAuthenticated == true && KumunitaPrincipal.HasRole(User, "Guest"))
    {
        <div class="container-fluid">
            <div class="alert alert-info mb-3 py-2" role="status">
                <kw-l key="account.guest_welcome">You are signed in as a guest. Your access is limited to the surfaces the admin has allowed, for the window they set.</kw-l>
            </div>
        </div>
    }
    @* M22 (ADR 0132, D5) — the onboarding affordance: the dismissible home/nav
       banner (the _OnboardingBanner partial). Rendered by the partial only
       when the signed-in resident's OnboardingCompletedAt is null (the owner-
       scope read, never a claim — the thin-token rule, ADR 0001-B / D6).
       Non-blocking (D5): it never gates sign-in; the close button is a
       client-side dismiss (onboarding-banner.js), and the only way to clear
       it for real is the explicit finish/skip POST (D2/D4). *@
    @await Html.PartialAsync("_OnboardingBanner")
    @* What's-new toast (the VN lane, ADR 0110) — announces the current
       platform version (WhatsNew.Latest) with a link to the About page's
       "What's new" section. Dismissal is remembered per browser (see
       _WhatsNewToast.cshtml + client/lib/whatsnew-toast.ts). *@
    @await Html.PartialAsync("_WhatsNewToast")
    <header>
        @if (navVariant == NavLayoutCookie.Row)
        {
            @* ── Variant B (default): compact top row with a More menu ──
               The existing navbar shape is preserved (the e2e-frozen selectors
               header .navbar, .navbar-toggler, a#accountMenu,
               a#notifications-bell, a#languageMenu all live here). The five
               less-frequent sections (Events, Projects, Pages, Tags, Directory)
               are folded into a single Bootstrap "More" dropdown, so the flat
               row carries only Home · Announcements · Community · Groups +
               More ▾ + search + account. *@
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 kmb-nav-row">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo/kumunita_k_logo_52x52.png" alt="Kumunita" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index"><kw-l key="nav.home">Home</kw-l></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/announcements"><kw-l key="nav.announcements">Announcements</kw-l></a>
                            </li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @* ADR 0113 — data-nav-fold: when the variant-B row doesn't
                                   fit between the sm and md breakpoints, the nav-more-fold.ts
                                   module moves these two <li>s into the More menu below
                                   (data-nav-more) and back when there is room again. The hooks
                                   are inert without that module, and absent in variant C and
                                   for signed-out users, so the fold is self-scoped. *@
                                <li class="nav-item" data-nav-fold>
                                    <a class="nav-link text-dark" asp-controller="Posts" asp-action="AllSections"><kw-l key="nav.community">Community</kw-l></a>
                                </li>
                                <li class="nav-item" data-nav-fold>
                                    <a class="nav-link text-dark" asp-controller="Groups" asp-action="Index"><kw-l key="nav.groups">Groups</kw-l></a>
                                </li>
                                @* ADR 0111 — the More menu: the five less-frequent
                                   resident-only sections folded into one dropdown.
                                   ADR 0113 — data-nav-more marks this as the fold target. *@
                                <li class="nav-item dropdown" data-nav-more>
                                    <a class="nav-link text-dark dropdown-toggle" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <kw-l key="nav.more">More</kw-l>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item text-dark" href="/events"><kw-l key="nav.events">Events</kw-l></a></li>
                                        <li><a class="dropdown-item text-dark" href="/projects/todos"><kw-l key="nav.projects">Projects</kw-l></a></li>
                                        @* M16 (ADR 0117) — the Inventory surface (D6: a
                                           standing core surface, no admin toggle; the M5
                                           projects nav-entry shape). *@
                                        <li><a class="dropdown-item text-dark" href="/inventory"><kw-l key="inv.nav">Inventory</kw-l></a></li>
                                        @* M17 (ADR 0118) — the Bookmarks surface (D6: a
                                           standing core surface, no admin toggle; the M16
                                           inventory nav-entry shape). *@
                                        <li><a class="dropdown-item text-dark" href="/bookmarks"><kw-l key="bm.nav">Bookmarks</kw-l></a></li>
                                        @* M21 (ADR 0122) — the Document management surface
                                           (D5 standing, D6 download; the M16/M17 nav-entry
                                           shape). Reuses documents.title (the closed 12-key set
                                           stays closed — no 13th nav.documents key). *@
                                        <li><a class="dropdown-item text-dark" href="/documents"><kw-l key="documents.title">Documents</kw-l></a></li>
                                        <li><a class="dropdown-item text-dark" href="/pages"><kw-l key="nav.pages">Pages</kw-l></a></li>
                                        <li><a class="dropdown-item text-dark" href="/tags"><kw-l key="nav.tags">Tags</kw-l></a></li>
                                        <li><a class="dropdown-item text-dark" asp-controller="Directory" asp-action="Index"><kw-l key="nav.directory">Directory</kw-l></a></li>
                                        @* M23 (ADR 0123 F6) — the "People" nav
                                           entry (the find-people surface, /people):
                                           next to Directory, the same
                                           asp-controller/asp-action dropdown-item
                                           shape. *@
                                        <li><a class="dropdown-item text-dark" asp-controller="FindPeople" asp-action="Index"><kw-l key="nav.people">People</kw-l></a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        @* M8 (ADR 0091 D1) — the one /search entry in the navbar. *@
                        @{ var _kwLNav = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation); var _navPlaceholder = await Translation.GetAsync("search.placeholder", _kwLNav); var _navAriaLabel = await Translation.GetAsync("search.nav", _kwLNav); }
                        <form class="navbar-form me-2 my-2 my-sm-0" action="/search" method="get" role="search">
                            <input class="form-control" type="search" name="q" placeholder="@_navPlaceholder" aria-label="@_navAriaLabel" required />
                        </form>

                        <partial name="_AccountNav" />
                    </div>
                </div>
            </nav>
        }
        else
        {
            @* ── Variant C: icon rail + slim top bar ──────────────────────
               the page content (main + footer + the pinned-announcement
               banner) shifts right via the body.kmb-nav-rail-mode class the
               layout sets (site.css) so it clears the fixed rail. The topbar
               carries class="navbar" (the e2e frozen pin header .navbar) + a
               .navbar-toggler (the 360-px floor pin). The _AccountNav partial
               renders in the topbar (bell, account dropdown, language picker,
               sign in/up) exactly as it does in variant B — the frozen
               a#accountMenu / a#notifications-bell / a#languageMenu pins all
               resolve here. The rail is purely section icons (no _AccountNav
               duplication). *@
            <nav class="kmb-rail" aria-label="Primary">
                    <a class="kmb-rail-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo/kumunita_k_logo_52x52.png" alt="Kumunita" />
                    </a>
                    <a class="kmb-rail-btn" asp-area="" asp-controller="Home" asp-action="Index">
                        <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 7.5 8 2.5l5.5 5v6h-11z"/></svg>
                        <span class="visually-hidden"><kw-l key="nav.home">Home</kw-l></span>
                        <span class="kmb-rail-tip"><kw-l key="nav.home">Home</kw-l></span>
                    </a>
                    <a class="kmb-rail-btn" href="/announcements">
                        <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 5.5h10v5H3z"/><path d="m3 5.5 5 3.5 5-3.5"/></svg>
                        <span class="visually-hidden"><kw-l key="nav.announcements">Announcements</kw-l></span>
                        <span class="kmb-rail-tip"><kw-l key="nav.announcements">Announcements</kw-l></span>
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="kmb-rail-btn" asp-controller="Posts" asp-action="AllSections">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 11V4.5h4v6.5H3zM8.5 11V2.5h4V11h-4z"/></svg>
                            <span class="visually-hidden"><kw-l key="nav.community">Community</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="nav.community">Community</kw-l></span>
                        </a>
                        <a class="kmb-rail-btn" asp-controller="Groups" asp-action="Index">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="5.5" cy="5.5" r="2.5"/><path d="M2 13c.5-2.5 2-3.5 3.5-3.5S8.5 10.5 9 13"/><circle cx="11" cy="6.5" r="2"/><path d="M10.5 13c.4-1.8 1.3-2.6 2.5-2.6 1.2 0 2.1.8 2.5 2.6"/></svg>
                            <span class="visually-hidden"><kw-l key="nav.groups">Groups</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="nav.groups">Groups</kw-l></span>
                        </a>
                        <a class="kmb-rail-btn" href="/events">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><path d="M8 5v3.2l2.2 1.3"/></svg>
                            <span class="visually-hidden"><kw-l key="nav.events">Events</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="nav.events">Events</kw-l></span>
                        </a>
                        <a class="kmb-rail-btn" href="/projects/todos">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2.5" y="2.5" width="11" height="11" rx="2"/><path d="M5 6h6M5 9h4"/></svg>
                            <span class="visually-hidden"><kw-l key="nav.projects">Projects</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="nav.projects">Projects</kw-l></span>
                        </a>
                        @* M16 (ADR 0117) — the Inventory surface rail icon
                           (the M5 projects nav-entry shape; D6 standing core
                           surface). *@
                        <a class="kmb-rail-btn" href="/inventory">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2.5" y="5" width="11" height="8" rx="1"/><path d="M6 5V3.5h4V5M8 8v3M6.5 9.5h3"/></svg>
                            <span class="visually-hidden"><kw-l key="inv.nav">Inventory</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="inv.nav">Inventory</kw-l></span>
                        </a>
                        @* M17 (ADR 0118) — the Bookmarks surface rail icon
                           (the M16 inventory nav-entry shape; D6 standing
                           core surface). *@
                        <a class="kmb-rail-btn" href="/bookmarks">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M4 2.5h8v11l-4-3-4 3z"/></svg>
                            <span class="visually-hidden"><kw-l key="bm.nav">Bookmarks</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="bm.nav">Bookmarks</kw-l></span>
                        </a>
                        @* M21 (ADR 0122) — the Document management surface rail
                           icon (the M17 bookmarks rail-entry shape). Reuses
                           documents.title — the closed 12-key nav set stays
                           closed (no 13th nav.documents key). *@
                        <a class="kmb-rail-btn" href="/documents">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M4 2.5h5l3.5 3.5v7.5h-8.5z"/><path d="M9 2.5V6h3.5"/><path d="M6 9.5h4M6 12h3"/></svg>
                            <span class="visually-hidden"><kw-l key="documents.title">Documents</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="documents.title">Documents</kw-l></span>
                        </a>
                        <a class="kmb-rail-btn" href="/pages">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2.5" y="2.5" width="11" height="11" rx="2"/><path d="M5 6h6M5 9h6M5 12h4"/></svg>
                            <span class="visually-hidden"><kw-l key="nav.pages">Pages</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="nav.pages">Pages</kw-l></span>
                        </a>
                        <a class="kmb-rail-btn" href="/tags">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m5.5 4 6.5 6.5"/><circle cx="4" cy="4" r="1.8"/><circle cx="12" cy="12" r="1.8"/></svg>
                            <span class="visually-hidden"><kw-l key="nav.tags">Tags</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="nav.tags">Tags</kw-l></span>
                        </a>
                        <a class="kmb-rail-btn" asp-controller="Directory" asp-action="Index">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8" cy="5.5" r="3"/><path d="M2.5 14c.5-3 2.5-4.5 5.5-4.5s5 1.5 5.5 4.5"/></svg>
                            <span class="visually-hidden"><kw-l key="nav.directory">Directory</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="nav.directory">Directory</kw-l></span>
                        </a>
                        @* M23 (ADR 0123 F6) — the "People" nav entry (the
                           find-people surface, /people): next to Directory in
                           the rail, the same rail-btn shape (a two-people icon). *@
                        <a class="kmb-rail-btn" asp-controller="FindPeople" asp-action="Index">
                            <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="5.5" cy="5" r="2.5"/><path d="M1.5 13c.4-2.6 2-3.9 4-3.9s3.6 1.3 4 3.9"/><circle cx="11" cy="6" r="2"/><path d="M10 13c.3-2 1.4-3 3-3 1 0 1.9.6 2.3 1.6"/></svg>
                            <span class="visually-hidden"><kw-l key="nav.people">People</kw-l></span>
                            <span class="kmb-rail-tip"><kw-l key="nav.people">People</kw-l></span>
                        </a>
                    }
                </nav>
                <nav class="navbar navbar-expand-sm kmb-topbar navbar-light bg-white border-bottom">
                    <div class="container-fluid kmb-topbar-inner">
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".kmb-topbar-collapse"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="kmb-topbar-collapse collapse d-sm-inline-flex flex-grow-1 align-items-center gap-2">
                            @* M8 (ADR 0091 D1) — the search box. *@
                            @{ var _kwLNavC = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation); var _navPlaceholderC = await Translation.GetAsync("search.placeholder", _kwLNavC); var _navAriaLabelC = await Translation.GetAsync("search.nav", _kwLNavC); }
                            <form class="navbar-form kmb-topbar-search" action="/search" method="get" role="search">
                                <input class="form-control" type="search" name="q" placeholder="@_navPlaceholderC" aria-label="@_navAriaLabelC" required />
                            </form>
                            @* The _AccountNav partial renders here in variant C exactly
                               as it does in variant B (bell + account dropdown signed-in;
                               language + sign in/up signed-out) — the e2e-frozen
                               a#accountMenu / a#notifications-bell / a#languageMenu
                               all resolve here. *@
                            <partial name="_AccountNav" />
                        </div>
                    </div>
                </nav>
            }
        </header>
    <main role="main" class="pb-3">
        @if (fullBleed)
        {
            @RenderBody()
        }
        else
        {
            <div class="container">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="kmb-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-md-5 col-lg-4">
                    <p class="navbar-brand mb-2">Kumunita</p>
                    <p class="mb-2" style="max-width: 34ch;"><kw-l key="footer.tagline">A private home for one neighborhood — the feed, the groups and the pinned notes. What happens on your street stays on your street.</kw-l></p>
                    <p class="small mb-0">&copy; @DateTime.Now.Year Kumunita <kw-l key="footer.copyright">· self-hosted by your community</kw-l></p>
                </div>
                <div class="col-6 col-md-4 col-lg-2">
                    <h3>Community</h3>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        @* ADR 0039 §3.8 — the mount-point resolver (footer/community slot):
                           the page mounted here renders as a link; an unmounted slot
                           renders nothing. Display, not access — the Show action is
                           the Read decision. *@
                        @{ ViewData["MountSlot"] = "footer/community"; }
                        <partial name="_MountSlot" />
                        <li><a href="/announcements">Announcements</a></li>
                        <li><a asp-controller="Posts" asp-action="AllSections">The feed</a></li>
                    </ul>
                </div>
                @* SP U03 (ADR 0043 D4) — the footer "Platform" column: the five
                   shipped platform surfaces, linked **unconditionally** for every
                   visitor (floor-honesty — no existence probe, no @if: a link whose
                   page is absent from the tree lands on its existing floor). The
                   navbar is deliberately untouched (the recorded D4 decision). *@
                <div class="col-6 col-md-4 col-lg-2">
                    <h3><kw-l key="footer.platform.heading">Platform</kw-l></h3>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><a href="/about"><kw-l key="footer.platform.about">About</kw-l></a></li>
                        <li><a href="/terms"><kw-l key="footer.platform.terms">Terms of use</kw-l></a></li>
                        <li><a href="/help"><kw-l key="footer.platform.help">Help</kw-l></a></li>
                        <li><a href="/privacy"><kw-l key="footer.platform.privacy">Privacy</kw-l></a></li>
                        <li><a href="/conduct"><kw-l key="footer.platform.conduct">Code of conduct</kw-l></a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <h3><kw-l key="footer.project.heading">The project</kw-l></h3>
                    <ul class="list-unstyled d-grid gap-2">
                        @foreach (var link in RepositoryInfo.Links)
                        {
                            <li>
                                <a href="@link.Url" target="_blank" rel="noopener noreferrer"><kw-l key="@link.Key">@link.Label</kw-l></a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-12 col-md-3 col-lg-3">
                    <h3><kw-l key="footer.gtk_heading">Good to know</kw-l></h3>
                    <p class="small mb-2"><kw-l key="footer.gtk_privacy">Private by default: each post's audience is chosen by its author, and everything is readable by you, not the world.</kw-l></p>
                    <p class="small mb-0"><kw-l key="footer.gtk_oss">Kumunita is open source — the code, the decisions, the docs.</kw-l></p>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Avatar monogram fallback (client/lib/avatar.ts, tsc-built — SECURITY.md §6:
         no inline on*/<script> in Razor views; the U8 onerror it replaced is per img) -->
    <script type="module" src="~/js/lib/avatar.js"></script>
    <!-- Avatar upload gating (client/lib/avatar-upload.ts, tsc-built — SECURITY.md §6:
         no inline on*/<script> in Razor views; disables "Save avatar" until a file is chosen) -->
    <script type="module" src="~/js/lib/avatar-upload.js"></script>
    <!-- Translation display swap (client/lib/translation-swap.ts, tsc-built — TD / ADR 0027:
         click-to-swap toggles the pre-rendered .td-variant containers; display-only, no fetch) -->
    <script type="module" src="~/js/lib/translation-swap.js"></script>
    <!-- Confirm-before-submit (SECURITY.md §6 no-inline-script; replaces the
         onsubmit="return confirm(..." pattern across ~18 views) -->
    <script type="module" src="~/js/lib/confirm.js"></script>
    <!-- Reset-form (SECURITY.md §6 no-inline-script; replaces the
         onclick="this.form.reset()" pattern) -->
    <script type="module" src="~/js/lib/reset-form.js"></script>
    <!-- Detach menu (SECURITY.md §6 no-inline-script): while an opted-in
         dropdown (data-detach) is open, re-home its .dropdown-menu onto <body>
         so it escapes overflow-clipping ancestors (Kanban board / to-do feed)
         and always renders fully on top. Loaded after bootstrap.bundle so
         window.bootstrap is available. -->
    <script type="module" src="~/js/lib/detach-menu.js"></script>
    <!-- Audience-toggle (SECURITY.md §6; ADR 0036 checkbox→panel visibility) -->
    <script type="module" src="~/js/lib/audience-toggle.js"></script>
    <!-- Name-filter (SECURITY.md §6; Groups/Detail invite + add-member forms) -->
    <script type="module" src="~/js/lib/name-filter.js"></script>
    <!-- Admin edit-row toggle (SECURITY.md §6; Admin/Index collapsed rows) -->
    <script type="module" src="~/js/lib/admin-edit-toggle.js"></script>
    <!-- Directory-card click→nav (SECURITY.md §6; Directory/Index whole-card) -->
    <script type="module" src="~/js/lib/directory-card.js"></script>
    <!-- Pinned-announcement dismissal (SECURITY.md §6; per-announcement sessionStorage) -->
    <script type="module" src="~/js/lib/pinned-announcement.js"></script>
    <!-- Page-form visibility (SECURITY.md §6; ADR 0041 scope/individual blocks) -->
    <script type="module" src="~/js/lib/page-form-visibility.js"></script>
    <!-- Grant-picker sync (SECURITY.md §6; hidden textarea ↔ checkbox pickers) -->
    <script type="module" src="~/js/lib/grant-picker-sync.js"></script>
    <!-- Flash toast (SECURITY.md §6; the one uniform flash surface — see
         _FlashToast.cshtml). Wires Bootstrap 5.3's Toast to the .toast
         element(s) the partial renders, so the close button + the
         data-bs-autohide / data-bs-delay attributes drive the 5 s
         auto-dismiss + fade-out. -->
    <script type="module" src="~/js/lib/flash-toast.js"></script>
    <!-- What's-new toast (the VN lane, ADR 0110; see _WhatsNewToast.cshtml):
         hides the toast on load if this version was already seen in this
         browser (localStorage), otherwise records it + arms the auto-hide. -->
    <script type="module" src="~/js/lib/whatsnew-toast.js"></script>
    <!-- What's-new "show more" (the VN lane, ADR 0110; see About.cshtml):
         reveals the hidden earlier releases in batches of 10 on click.
         Self-guards: no-op if the list has ≤3 entries (no button). -->
    <script type="module" src="~/js/lib/whatsnew-more.js"></script>
    <!-- Home roadmap "show more" (both directions; see Home/Index.cshtml):
         reveals the hidden earlier + upcoming milestones in batches of 10
         on click. Self-guards: no-op on pages without #roadmap-list, and
         per-side no-op where a direction has no button (≤3 items). -->
    <script type="module" src="~/js/lib/roadmap-more.js"></script>
    <!-- Full-page expand mode (client/lib/expand-page.ts — shared by the
         Kanban board + the events calendar): wires the .page-expand-toggle /
         .page-expand-close buttons to the body.kmb-page-expanded class
         (site.css does the filling/hiding). Self-guards on pages without
         either button, so loading it globally is safe. -->
    <script type="module" src="~/js/lib/expand-page.js"></script>
    <!-- M10 U03 (ADR 0107 D5/D10) — the PWA install affordance + the
         service-worker registration (client/lib/pwa-install.ts, tsc-built).
         Registers /sw.js (U02's passive SW) and reveals the #pwa-install
         label source as one quiet fixed button on beforeinstallprompt;
         a clean no-op where the browser never fires it (iOS). -->
    <script type="module" src="~/js/lib/pwa-install.js"></script>
    <!-- Nav-row overflow fold (client/lib/nav-more-fold.ts, tsc-built — ADR 0113):
         in the variant-B "top row" nav, folds Community + Groups into the More
         menu when the row doesn't fit, and back when there is room. Self-guards
         (no-op) in variant C, signed-out, and where the data-nav-* hooks are
         absent, so loading it globally is safe. -->
    <script type="module" src="~/js/lib/nav-more-fold.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
