                    @* The rail expander (variant C): toggles each section's text
                       label beside its icon. rail-expander.ts flips the body's
                       .kmb-rail-expanded class (site.css widens the rail + shows
                       the .kmb-rail-label spans + updates the content shift). *@
                    <button type="button" class="kmb-rail-expander" aria-expanded="false"
                            aria-label="@_a11yRailExpand" title="@_a11yRailExpand">
                        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="m6.5 4.5 4.5 3.5-4.5 3.5"/><path d="M5 4.5v7"/></svg>
