                        <span class="visually-hidden">@_navHome</span>
                        <span class="kmb-rail-label">@_navHome</span>
                        <span class="kmb-rail-tip">@_navHome</span>
                    </a>
                    <a class="kmb-rail-btn @(activeNav == "announcements" ? "active" : null)" href="/announcements">
