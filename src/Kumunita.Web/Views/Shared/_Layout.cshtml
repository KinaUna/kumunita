@using Kumunita.Web.Security
@using System.Text.Json
@using System.Text.Json.Serialization
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Kumunita.Core.SurfaceLabels.ISurfaceLabelsService SurfaceLabels
@inject Kumunita.Web.Services.PlatformPaletteProvider PlatformPalette
@{
    // ADR 0133 — the theme preference (the kumunita.theme cookie): auto (default,
    // follow the OS prefers-color-scheme) | light | dark (the Forest theme).
    // auto is resolved entirely in site.css (@media prefers-color-scheme), so
    // the attribute is only emitted for an explicit override — no JS, no flash.
    var themeMode = ThemeCookie.Read(Context.Request);

    // ADR 0175 — the palette (the kumunita.palette cookie): forest (default) | ember.
    // Independent of the mode above. Order: member cookie -> the admin's platform
    // default (SiteContent.DefaultPalette, cached) -> forest.
    var platformPalette = await PlatformPalette.GetDefaultAsync();
    var palette = PaletteCookie.Read(Context.Request, platformPalette);

    // The navbar active highlight: the top-level section the current page
    // belongs to — the nav item itself, or its parent (the /community feed
    // AND the /posts/{id} detail both sit under Community; /projects/todos
    // sits under Projects). Null on Home and on every non-nav path (admin,
    // account, search, …) so nothing highlights there. Matched against the
    // same hrefs the nav anchors use, so a route rename cannot silently drop
    // the highlight. Rendered only as the .active class on the anchors — the
    // targets, selectors, and e2e-frozen hooks are untouched; site.css paints
    // the state (light + both dark scopes, all three nav variants).
    string? activeNav = null;
    if (Context?.Request is not null)
    {
        var _navPath = Context.Request.Path.Value ?? "";
        if (_navPath.StartsWith("/community", StringComparison.OrdinalIgnoreCase)
            || _navPath.StartsWith("/posts", StringComparison.OrdinalIgnoreCase))
            activeNav = "community";
        else if (_navPath.StartsWith("/announcements", StringComparison.OrdinalIgnoreCase))
            activeNav = "announcements";
        else if (_navPath.StartsWith("/groups", StringComparison.OrdinalIgnoreCase)) activeNav = "groups";
        else if (_navPath.StartsWith("/events", StringComparison.OrdinalIgnoreCase)) activeNav = "events";
        else if (_navPath.StartsWith("/projects", StringComparison.OrdinalIgnoreCase)) activeNav = "projects";
        else if (_navPath.StartsWith("/inventory", StringComparison.OrdinalIgnoreCase)) activeNav = "inventory";
        else if (_navPath.StartsWith("/bookmarks", StringComparison.OrdinalIgnoreCase)) activeNav = "bookmarks";
        else if (_navPath.StartsWith("/notes", StringComparison.OrdinalIgnoreCase)) activeNav = "notes";
        else if (_navPath.StartsWith("/documents", StringComparison.OrdinalIgnoreCase)) activeNav = "documents";
        else if (_navPath.StartsWith("/pages", StringComparison.OrdinalIgnoreCase)) activeNav = "pages";
        else if (_navPath.StartsWith("/tags", StringComparison.OrdinalIgnoreCase)) activeNav = "tags";
        else if (_navPath.StartsWith("/directory", StringComparison.OrdinalIgnoreCase)) activeNav = "directory";
    }

    // P0-6 (translation audit) — the client-JS strings bundle: the effective
    // language (the ADR 0049 chain, same seam as the Home page) is resolved
    // once per request and the client-facing keys are batch-resolved in ONE
    // query (the GetManyAsync convention), then serialized to JSON. The
    // client modules (rich-editor / image-editor / tag-suggest /
    // notifications-bell) read #kumunita-strings and fall back to the en
    // floor if it is absent. The key list is closed here (mirrored by the
    // L(key, fallback) calls in the TS); HtmlEncoding at the emission point
    // keeps a value containing `</script>` from ever terminating the tag.
    string[] ClientJsStringKeys =
    {
        "common.close",
        "common.cancel",
        // Onboarding walk-through modal (M22/M30 rework): the "Step X of Y"
        // counter template (the common.step_of {0}/{1} placeholders, resolved
        // in the effective language) + the iframe title fallback. Read by
        // client/lib/onboarding-modal.ts from this bundle (the L(key, fallback)
        // idiom). The Previous / Next button labels are server-rendered
        // <kw-l> in the partial, so they are not needed here.
        "common.step_of",
        "common.title",
        "rc.editor.error_generic",
        "rc.editor.link.title",
        "rc.editor.link.url",
        "rc.editor.link.confirm",
        "rc.editor.link.busy",
        "rc.editor.link.err_empty",
        "rc.editor.link.err_invalid",
        "rc.editor.image.title",
        "rc.editor.image.err_rejected",
        "rc.editor.image.err_upload",
        "rc.editor.attach.title",
        "rc.editor.attach.file",
        "rc.editor.attach.link_text",
        "rc.editor.attach.default_label",
        "rc.editor.attach.confirm",
        "rc.editor.attach.busy",
        "rc.editor.attach.err_no_file",
        "img.edit.close",
        "img.edit.crop_area",
        "img.edit.width",
        "img.edit.output",
        "img.edit.reset_crop",
        "img.edit.use_original",
        "img.edit.apply",
        "img.edit.title",
        "img.edit.err_edit",
        "img.edit.err_could",
        "img.edit.err_load",
        "img.edit.err_export",
        "tag.suggest.remove_prefix",
        "notif.fallback",
        "kiosk.slide_denied",
        // M37 (ADR 0167) — the note-modal client strings (note-modal.ts).
        "pn.note.body_label",
        "pn.note.delete_confirm",
        "pn.note.add",
        "pn.note.view",
        "pn.note.attached",
    };
    string clientStringsJson = "{}";
    if (Translation is not null)
    {
        try
        {
            string effLang = await EffectiveLanguageCode.ResolveAsync(
                HttpContextAccessor.HttpContext?.Request, Localization, Translation);
            var resolved = await Translation.GetManyAsync(ClientJsStringKeys, effLang);
            clientStringsJson = JsonSerializer.Serialize(resolved,
                new JsonSerializerOptions { DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull });
        }
        catch
        {
            // The bundle is a display enhancement — a resolution failure must
            // never break the page (the TS side carries the en fallbacks).
        }
    }

    // The navbar toggles + rail's accessible names are server-resolved (the
    // kw-l TagHelper can't wrap an attribute); the a11y.* floor is the closed
    // set. A null provider (a non-HTTP render) degrades to the en floor.
    string _a11yToggleNav = "Toggle navigation";
    string _a11yPrimary   = "Primary";
    string _a11yRailExpand = "Toggle navigation labels";
    if (Translation is not null)
    {
        try
        {
            string a11yLang = await EffectiveLanguageCode.ResolveAsync(
                HttpContextAccessor.HttpContext?.Request, Localization, Translation);
            _a11yToggleNav   = await Translation.GetAsync("a11y.toggle_nav", a11yLang);
            _a11yPrimary     = await Translation.GetAsync("a11y.primary_nav", a11yLang);
            _a11yRailExpand  = await Translation.GetAsync("a11y.rail_expand", a11yLang);
        }
        catch
        {
            // Keep the en floor on a resolution failure — the label must never break.
        }
    }

    // M29 (ADR 0152) — the 13 top-nav surface labels (the flat row + More
    // dropdown + mobile rail all resolve to the SAME value, M29·1). The
    // SurfaceLabels singleton (a display override, never a re-route) wins when
    // a non-blank admin label is set; otherwise the kw-l key resolves in the
    // viewer's effective language. The dict is resolved ONCE per request and
    // every nav occurrence (flat row / dropdown / rail hidden+tip) reads the
    // same entry, so a rename stays consistent across the surface. Best-effort:
    // GetLabelAsync never throws (missing row / store degrades to the kw-l
    // floor), so a null/absent service only degrades to the raw kw-l text.
    string _navHome, _navAnnouncements, _navCommunity, _navGroups,
           _navEvents, _navProjects, _navInventory, _navBookmarks, _navNotes,
           _navDocuments, _navPages, _navTags, _navDirectory;
    if (SurfaceLabels is not null)
    {
        try
        {
            string navLang = await EffectiveLanguageCode.ResolveAsync(
                HttpContextAccessor.HttpContext?.Request, Localization, Translation);
            _navHome         = await SurfaceLabels.GetLabelAsync("home",          "nav.home",          navLang);
            _navAnnouncements= await SurfaceLabels.GetLabelAsync("announcements","nav.announcements", navLang);
            _navCommunity    = await SurfaceLabels.GetLabelAsync("community",    "nav.community",     navLang);
            _navGroups       = await SurfaceLabels.GetLabelAsync("groups",       "nav.groups",        navLang);
            _navEvents       = await SurfaceLabels.GetLabelAsync("events",       "nav.events",        navLang);
            _navProjects     = await SurfaceLabels.GetLabelAsync("projects",     "nav.projects",      navLang);
            _navInventory    = await SurfaceLabels.GetLabelAsync("inventory",    "inv.nav",           navLang);
            _navBookmarks    = await SurfaceLabels.GetLabelAsync("bookmarks",    "bm.nav",            navLang);
            // M37 (ADR 0167) — the Personal Notes nav entry (D6: a standing
            // core surface, no admin toggle; the M17 bookmarks nav-entry shape,
            // immediately after the bm.nav block). The pn.nav kw-l key is the
            // closed 24-key §kw-l set (U05 registered it).
            _navNotes        = await SurfaceLabels.GetLabelAsync("notes",        "pn.nav",            navLang);
            _navDocuments    = await SurfaceLabels.GetLabelAsync("documents",    "documents.title",   navLang);
            _navPages        = await SurfaceLabels.GetLabelAsync("pages",        "nav.pages",         navLang);
            _navTags         = await SurfaceLabels.GetLabelAsync("tags",         "nav.tags",          navLang);
            _navDirectory    = await SurfaceLabels.GetLabelAsync("directory",    "nav.directory",     navLang);
        }
        catch
        {
            // A resolution failure must never blank the nav (the kw-l floor).
            _navHome = "Home"; _navAnnouncements = "Announcements"; _navCommunity = "Community";
            _navGroups = "Groups"; _navEvents = "Events"; _navProjects = "Projects";
            _navInventory = "Inventory"; _navBookmarks = "Bookmarks"; _navNotes = "Notes"; _navDocuments = "Documents";
            _navPages = "Pages"; _navTags = "Tags"; _navDirectory = "Directory";
        }
    }
    else
    {
        // No service in the composition (a non-HTTP render) — the shipped en floor.
        _navHome = "Home"; _navAnnouncements = "Announcements"; _navCommunity = "Community";
        _navGroups = "Groups"; _navEvents = "Events"; _navProjects = "Projects";
        _navInventory = "Inventory"; _navBookmarks = "Bookmarks"; _navNotes = "Notes"; _navDocuments = "Documents";
        _navPages = "Pages"; _navTags = "Tags"; _navDirectory = "Directory";
    }
}
<!DOCTYPE html>
<html lang="en" data-kmb-palette="@palette" data-kmb-theme="@(themeMode == ThemeCookie.Light ? ThemeCookie.Light : (themeMode == ThemeCookie.Dark ? ThemeCookie.Dark : null))">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1c4532" />
    @* RC U05 (drift pause e, resolved): the anti-forgery token for the fetch-based
       page modules (client/lib/api.ts). api.ts reads <meta name="anti-forgery-token">
       and sends it in the RequestVerificationToken header — the header [ValidateAntiForgeryToken]
       accepts by convention. The value is the RequestToken from the same IAntiforgery
       that @Html.AntiForgeryToken() on every existing form draws on, so the upload fetch
       (POST /content-image) is CSRF-aware. (GetAndStoreTokens is the canonical way to get the
       bare token string in a model-less layout; the avatar lane never needed this because it
       form-POSTs, but the content-image upload is the first fetch-based consumer.) *@
    <meta name="anti-forgery-token" content="@Antiforgery.GetAndStoreTokens(Context!).RequestToken" />
    @* ADR 0273 — the tab title is looked up by its English text (PageTitleKeys) and
       resolved with the effective language; an unmapped (data-built) title and every
       failure pass through as the English the view set. *@
    @{
        var _pageTitle = ViewData["Title"] as string;
        if (Translation is not null && PageTitleKeys.TryGetKey(_pageTitle, out var _pageTitleKey))
        {
            try
            {
                var _pageTitleLang = await EffectiveLanguageCode.ResolveAsync(
                    HttpContextAccessor.HttpContext?.Request, Localization, Translation);
                var _pageTitleText = await Translation.GetAsync(_pageTitleKey, _pageTitleLang);
                if (!string.IsNullOrWhiteSpace(_pageTitleText) && _pageTitleText != _pageTitleKey) _pageTitle = _pageTitleText;
            }
            catch
            {
                // The English title the view set is the floor.
            }
        }
    }
    <title>@(_pageTitle ?? ViewData["Title"]) - Kumunita</title>
    <link rel="icon" type="image/png" href="~/images/logo/kumunita_k_logo_64x64.png" />
    <link rel="apple-touch-icon" href="~/images/logo/kumunita_k_logo_64x64.png" />
    @* M10 (ADR 0107 D3) — the PWA web-app manifest: the installable app shell
       (wwwroot/manifest.webmanifest — D3's closed field set + the 192/512
       icon pair). Same-origin static asset, so script-src 'self' (C-M10·3) is
       untouched; the install affordance (U03, pwa-install.ts) is the only
       consumer of the beforeinstallprompt this enables. *@
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/palettes.css" asp-append-version="true" />
</head>
@{
    // Landing-style pages opt out of the shared .container wrapper (see the
    // <main> block below) so their sections can run full-bleed. Set with
    // ViewData["FullBleed"] = true in the page (home page, Views/Home/Index).
    bool fullBleed = ViewData["FullBleed"] is true;

    // ADR 0111 — the nav-variant preference (the kumunita.nav cookie, ADR
    // 0001-B: a preference, never a claim). Default B (compact top row);
    // variant C (icon rail) is the explicit opt-in.
    var navVariant = NavLayoutCookie.Read(Context!.Request);

    // Onboarding walk-through modal (M22/M30 rework) — this page is being
    // iframed by the shared _OnboardingModal (the M35 kiosk "frame the
    // surface's own route" idiom): the Sec-Fetch-Dest: iframe fetch-metadata
    // signal (browser-driven, CSP-legal, no route change needed) is true only
    // when a same-origin <iframe> loads the page. When set, the body carries
    // the kmb-embed class and site.css hides the page chrome (navbar / footer
    // / banners / toasts) so the framed page reads as a focused panel inside
    // the modal — the ADR 0104 / M35 chrome-hide idiom. A direct navigation
    // (Sec-Fetch-Dest: document) never sets it, so the page is unchanged when
    // visited normally. A header-reading failure degrades to "not embedded"
    // (the safe floor — the full page renders).
    bool kmbEmbed = false;
    try
    {
        if (Context.Request.Headers.TryGetValue("Sec-Fetch-Dest", out var dest))
            kmbEmbed = string.Equals(dest.ToString(), "iframe", System.StringComparison.OrdinalIgnoreCase);
    }
    catch
    {
        // Non-HTTP render / missing context — not embedded (the floor).
    }

    // M35 (ADR 0164) kiosk display — this page is being iframed by the /kiosk
    // display (the kiosk "frame the surface's own route" idiom, M35·6). The
    // kmb-embed class above is SHARED with the onboarding walk-through modal,
    // which frames INTERACTIVE settings pages where the buttons ARE the point
    // — the kiosk is the opposite: a read-only wall display that wants ONLY
    // the title / subtitle / content. So the differentiator is "did /kiosk
    // frame it?", answered by the ?kiosk=1 query param the kiosk appends to
    // every slide href (ADR 0285 D7) — a URL value that arrives intact under
    // the site's Referrer-Policy: no-referrer (F7), which suppresses the
    // Referer a referrer test would need. The onboarding modal's iframes never
    // carry ?kiosk=1, so they stay interactive (kmb-embed floor on both). A
    // read failure degrades to "not kiosk" (the floor — full page renders).
    // The kmb-kiosk class then drives the site.css kiosk rules (hide buttons /
    // tabs / nav, stretch content, tight margins).
    bool kmbKiosk = kmbEmbed
        && string.Equals(Context.Request.Query["kiosk"].ToString(), "1", StringComparison.Ordinal);
    // ADR 0285 D5 — a kiosk slide hides comment threads, replies and RSVP
    // lists unless its playlist entry shows them; the kiosk passes
    // ?kioskComments=1 on the framed route, and the kmb-kiosk-comments class
    // lets site.css keep the .kmb-discussion sections visible. Display-only.
    bool kmbKioskComments = kmbKiosk
        && string.Equals(Context.Request.Query["kioskComments"].ToString(), "1", StringComparison.Ordinal);
}

<body class="@(fullBleed ? "kmb-page-fullbleed" : null) @(navVariant == NavLayoutCookie.Rail ? "kmb-nav-rail-mode" : null) @(kmbEmbed ? "kmb-embed" : null) @(kmbKiosk ? "kmb-kiosk" : null) @(kmbKioskComments ? "kmb-kiosk-comments" : null)">
    <partial name="_IconSprite" />
    @* IMPROVE-CODE C11 — the flash toast + the .kmb-notices banner strip
       (pinned / guest / onboarding / what's-new) extracted into the
       _LayoutNotices partial (the markup is unchanged). *@
    <partial name="_LayoutNotices" />
    <header>
        @if (navVariant == NavLayoutCookie.Row)
        {
            @* ── Variant B (default): compact top row with a More menu ──
               The existing navbar shape is preserved (the e2e-frozen selectors
               header .navbar, .navbar-toggler, a#accountMenu,
               a#notifications-bell, a#languageMenu all live here). The five
               less-frequent sections (Events, Projects, Pages, Tags, Directory)
               are folded into a single Bootstrap "More" dropdown, so the flat
               row carries only Home · Announcements · Community · Groups +
               More ▾ + search + account. *@
            @* not extracted: the nav bar (brand + the Home/Announcements/Community/Groups row +
               the More menu + account) is the site's single-use chrome — the nav-more-fold /
               nav-variant C logic is entangled with it and it is not repeated across views — so it
               stays inline. The notices strip + footer + global <script> block DID extract (each is
               independently touched). Note: extracting footer/notices drops the inert ASP.NET
               scoped-CSS attribute (b-xer*) from those elements because the scoped bundle
               (_Layout.cshtml.css) is never in the served <link> list — a neutral delta, see the
               C11-1 close note. *@
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 kmb-nav-row">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo/kumunita_k_logo_52x52.png" alt="Kumunita" />
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="@_a11yToggleNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-home"/></svg><span class="kmb-nav-label">@_navHome</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(activeNav == "announcements" ? "active" : null)" href="/announcements"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-announcements"/></svg><span class="kmb-nav-label">@_navAnnouncements</span></a>
                            </li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @* ADR 0113 — data-nav-fold: when the variant-B row doesn't
                                   fit between the sm and md breakpoints, the nav-more-fold.ts
                                   module moves these two <li>s into the More menu below
                                   (data-nav-more) and back when there is room again. The hooks
                                   are inert without that module, and absent in variant C and
                                   for signed-out users, so the fold is self-scoped. *@
                                <li class="nav-item" data-nav-fold>
                                    <a class="nav-link text-dark @(activeNav == "community" ? "active" : null)" asp-controller="Posts" asp-action="AllSections"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-community"/></svg><span class="kmb-nav-label">@_navCommunity</span></a>
                                </li>
                                <li class="nav-item" data-nav-fold>
                                    <a class="nav-link text-dark @(activeNav == "groups" ? "active" : null)" asp-controller="Groups" asp-action="Index"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-groups"/></svg><span class="kmb-nav-label">@_navGroups</span></a>
                                </li>
                                @* ADR 0111 — the More menu: the five less-frequent
                                   resident-only sections folded into one dropdown.
                                   ADR 0113 — data-nav-more marks this as the fold target. *@
                                <li class="nav-item dropdown" data-nav-more>
                                    <a class="nav-link text-dark dropdown-toggle" href="#" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <kw-l key="nav.more">More</kw-l>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item text-dark @(activeNav == "events" ? "active" : null)" href="/events"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-events"/></svg>@_navEvents</a></li>
                                        <li><a class="dropdown-item text-dark @(activeNav == "projects" ? "active" : null)" href="/projects/todos"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-projects"/></svg>@_navProjects</a></li>
                                        @* M16 (ADR 0117) — the Inventory surface (D6: a
                                           standing core surface, no admin toggle; the M5
                                           projects nav-entry shape). *@
                                        <li><a class="dropdown-item text-dark @(activeNav == "inventory" ? "active" : null)" href="/inventory"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-inventory"/></svg>@_navInventory</a></li>
                                        @* M17 (ADR 0118) — the Bookmarks surface (D6: a
                                           standing core surface, no admin toggle; the M16
                                           inventory nav-entry shape). *@
                                        <li><a class="dropdown-item text-dark @(activeNav == "bookmarks" ? "active" : null)" href="/bookmarks"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-bookmarks"/></svg>@_navBookmarks</a></li>
                                        @* M37 (ADR 0167) — the Personal Notes surface (D6: a
                                           standing core surface, no admin toggle; the M17
                                           bookmarks nav-entry shape, immediately after bm.nav). *@
                                        <li><a class="dropdown-item text-dark @(activeNav == "notes" ? "active" : null)" href="/notes"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-notes"/></svg>@_navNotes</a></li>
                                        @* M21 (ADR 0122) — the Document management surface
                                           (D5 standing, D6 download; the M16/M17 nav-entry
                                           shape). Reuses documents.title (the closed 12-key set
                                           stays closed — no 13th nav.documents key). *@
                                        <li><a class="dropdown-item text-dark @(activeNav == "documents" ? "active" : null)" href="/documents"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-documents"/></svg>@_navDocuments</a></li>
                                        <li><a class="dropdown-item text-dark @(activeNav == "pages" ? "active" : null)" href="/pages"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-pages"/></svg>@_navPages</a></li>
                                        <li><a class="dropdown-item text-dark @(activeNav == "tags" ? "active" : null)" href="/tags"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-tags"/></svg>@_navTags</a></li>
                                        <li><a class="dropdown-item text-dark @(activeNav == "directory" ? "active" : null)" asp-controller="Directory" asp-action="Index"><svg class="kmb-nav-icon kmb-icon" width="18" height="18" aria-hidden="true"><use href="#kmb-i-directory"/></svg>@_navDirectory</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        @* M8 (ADR 0091 D1) — the one /search entry in the navbar. *@
                        @{ var _kwLNav = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
                           var _navPlaceholder = Translation is null ? Kumunita.Core.Localization.KnownTranslationKeys.EnValues["search.placeholder"] : await Translation.GetAsync("search.placeholder", _kwLNav);
                           var _navAriaLabel = Translation is null ? Kumunita.Core.Localization.KnownTranslationKeys.EnValues["search.nav"] : await Translation.GetAsync("search.nav", _kwLNav); }
                        <form class="navbar-form me-2 my-2 my-sm-0" action="/search" method="get" role="search">
                            <input class="form-control" type="search" name="q" placeholder="@_navPlaceholder" aria-label="@_navAriaLabel" required />
                        </form>

                        <partial name="_AccountNav" />
                    </div>
                </div>
            </nav>
        }
        else
        {
            @* ── Variant C: icon rail + slim top bar ──────────────────────
               the page content (main + footer + the pinned-announcement
               banner) shifts right via the body.kmb-nav-rail-mode class the
               layout sets (site.css) so it clears the fixed rail. The topbar
               carries class="navbar" (the e2e frozen pin header .navbar) + a
               .navbar-toggler (the 360-px floor pin). The _AccountNav partial
               renders in the topbar (bell, account dropdown, language picker,
               sign in/up) exactly as it does in variant B — the frozen
               a#accountMenu / a#notifications-bell / a#languageMenu pins all
               resolve here. The rail is purely section icons (no _AccountNav
               duplication). *@
            <nav class="kmb-rail" aria-label="@_a11yPrimary">
                    <a class="kmb-rail-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo/kumunita_k_logo_52x52.png" alt="Kumunita" />
                    </a>
                    @* The rail expander (variant C): toggles each section's text
                       label beside its icon. rail-expander.ts flips the body's
                       .kmb-rail-expanded class (site.css widens the rail + shows
                       the .kmb-rail-label spans + updates the content shift). *@
                    <button type="button" class="kmb-rail-expander" aria-expanded="false"
                            aria-label="@_a11yRailExpand" title="@_a11yRailExpand">
                        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="m6.5 4.5 4.5 3.5-4.5 3.5"/><path d="M5 4.5v7"/></svg>
                    </button>
                    <a class="kmb-rail-btn" asp-area="" asp-controller="Home" asp-action="Index">
                        <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-home"/></svg>
                        <span class="visually-hidden">@_navHome</span>
                        <span class="kmb-rail-label">@_navHome</span>
                        <span class="kmb-rail-tip">@_navHome</span>
                    </a>
                    <a class="kmb-rail-btn @(activeNav == "announcements" ? "active" : null)" href="/announcements">
                        <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-announcements"/></svg>
                        <span class="visually-hidden">@_navAnnouncements</span>
                        <span class="kmb-rail-label">@_navAnnouncements</span>
                        <span class="kmb-rail-tip">@_navAnnouncements</span>
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="kmb-rail-btn @(activeNav == "community" ? "active" : null)" asp-controller="Posts" asp-action="AllSections">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-community"/></svg>
                            <span class="visually-hidden">@_navCommunity</span>
                            <span class="kmb-rail-label">@_navCommunity</span>
                            <span class="kmb-rail-tip">@_navCommunity</span>
                        </a>
                        <a class="kmb-rail-btn @(activeNav == "groups" ? "active" : null)" asp-controller="Groups" asp-action="Index">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-groups"/></svg>
                            <span class="visually-hidden">@_navGroups</span>
                            <span class="kmb-rail-label">@_navGroups</span>
                            <span class="kmb-rail-tip">@_navGroups</span>
                        </a>
                        <a class="kmb-rail-btn @(activeNav == "events" ? "active" : null)" href="/events">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-events"/></svg>
                            <span class="visually-hidden">@_navEvents</span>
                            <span class="kmb-rail-label">@_navEvents</span>
                            <span class="kmb-rail-tip">@_navEvents</span>
                        </a>
                        <a class="kmb-rail-btn @(activeNav == "projects" ? "active" : null)" href="/projects/todos">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-projects"/></svg>
                            <span class="visually-hidden">@_navProjects</span>
                            <span class="kmb-rail-label">@_navProjects</span>
                            <span class="kmb-rail-tip">@_navProjects</span>
                        </a>
                        @* M16 (ADR 0117) — the Inventory surface rail icon
                           (the M5 projects nav-entry shape; D6 standing core
                           surface). *@
                        <a class="kmb-rail-btn @(activeNav == "inventory" ? "active" : null)" href="/inventory">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-inventory"/></svg>
                            <span class="visually-hidden">@_navInventory</span>
                            <span class="kmb-rail-label">@_navInventory</span>
                            <span class="kmb-rail-tip">@_navInventory</span>
                        </a>
                        @* M17 (ADR 0118) — the Bookmarks surface rail icon
                           (the M16 inventory nav-entry shape; D6 standing
                           core surface). *@
                        <a class="kmb-rail-btn @(activeNav == "bookmarks" ? "active" : null)" href="/bookmarks">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-bookmarks"/></svg>
                            <span class="visually-hidden">@_navBookmarks</span>
                            <span class="kmb-rail-label">@_navBookmarks</span>
                            <span class="kmb-rail-tip">@_navBookmarks</span>
                        </a>
                        @* M37 (ADR 0167) — the Personal Notes surface rail icon
                           (the M17 bookmarks rail-entry shape; D6 standing core
                           surface). A paper + pencil glyph (a note). *@
                        <a class="kmb-rail-btn @(activeNav == "notes" ? "active" : null)" href="/notes">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-notes"/></svg>
                            <span class="visually-hidden">@_navNotes</span>
                            <span class="kmb-rail-label">@_navNotes</span>
                            <span class="kmb-rail-tip">@_navNotes</span>
                        </a>
                        @* M21 (ADR 0122) — the Document management surface rail
                           icon (the M17 bookmarks rail-entry shape). Reuses
                           documents.title — the closed 12-key nav set stays
                           closed (no 13th nav.documents key). *@
                        <a class="kmb-rail-btn @(activeNav == "documents" ? "active" : null)" href="/documents">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-documents"/></svg>
                            <span class="visually-hidden">@_navDocuments</span>
                            <span class="kmb-rail-label">@_navDocuments</span>
                            <span class="kmb-rail-tip">@_navDocuments</span>
                        </a>
                        <a class="kmb-rail-btn @(activeNav == "pages" ? "active" : null)" href="/pages">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-pages"/></svg>
                            <span class="visually-hidden">@_navPages</span>
                            <span class="kmb-rail-label">@_navPages</span>
                            <span class="kmb-rail-tip">@_navPages</span>
                        </a>
                        <a class="kmb-rail-btn @(activeNav == "tags" ? "active" : null)" href="/tags">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-tags"/></svg>
                            <span class="visually-hidden">@_navTags</span>
                            <span class="kmb-rail-label">@_navTags</span>
                            <span class="kmb-rail-tip">@_navTags</span>
                        </a>
                        <a class="kmb-rail-btn @(activeNav == "directory" ? "active" : null)" asp-controller="Directory" asp-action="Index">
                            <svg class="kmb-icon" width="20" height="20" aria-hidden="true"><use href="#kmb-i-directory"/></svg>
                            <span class="visually-hidden">@_navDirectory</span>
                            <span class="kmb-rail-label">@_navDirectory</span>
                            <span class="kmb-rail-tip">@_navDirectory</span>
                        </a>
                    }
                </nav>
                <nav class="navbar navbar-expand-sm kmb-topbar navbar-light bg-white border-bottom">
                    <div class="container-fluid kmb-topbar-inner">
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".kmb-topbar-collapse"
                                aria-expanded="false" aria-label="@_a11yToggleNav">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="kmb-topbar-collapse collapse d-sm-inline-flex flex-grow-1 align-items-center gap-2">
                            @* M8 (ADR 0091 D1) — the search box. *@
                            @{ var _kwLNavC = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
                               var _navPlaceholderC = Translation is null ? Kumunita.Core.Localization.KnownTranslationKeys.EnValues["search.placeholder"] : await Translation.GetAsync("search.placeholder", _kwLNavC);
                               var _navAriaLabelC = Translation is null ? Kumunita.Core.Localization.KnownTranslationKeys.EnValues["search.nav"] : await Translation.GetAsync("search.nav", _kwLNavC); }
                            <form class="navbar-form kmb-topbar-search" action="/search" method="get" role="search">
                                <input class="form-control" type="search" name="q" placeholder="@_navPlaceholderC" aria-label="@_navAriaLabelC" required />
                            </form>
                            @* The _AccountNav partial renders here in variant C exactly
                               as it does in variant B (bell + account dropdown signed-in;
                               language + sign in/up signed-out) — the e2e-frozen
                               a#accountMenu / a#notifications-bell / a#languageMenu
                               all resolve here. *@
                            <partial name="_AccountNav" />
                        </div>
                    </div>
                </nav>
            }
        </header>
    <main role="main" class="pb-3">
        @if (fullBleed)
        {
            @RenderBody()
        }
        else
        {
            <div class="container">
                @RenderBody()
            </div>
        }
    </main>

    @* IMPROVE-CODE C11 — the <footer> extracted into the _LayoutFooter
       partial (the markup is unchanged). *@
    <partial name="_LayoutFooter" />
    @* IMPROVE-CODE C11 — the global <script> tags + the client-strings
       bundle emission extracted into the _LayoutScripts partial (the
       markup is unchanged; the bundle JSON is threaded via Model). *@
    <partial name="_LayoutScripts" model="clientStringsJson" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
