@using Kumunita.Web.Security
@model Kumunita.Web.Controllers.LocaleController.LocaleSettingsViewModel
@{
    ViewData["Title"] = "Choose your language";
}

<h1>Choose your language</h1>
<p class="text-muted">
    Pick the language the platform shows you. Your choice is saved in a
    browser cookie — it takes effect on the next request, and never
    affects other residents.
</p>

@if (TempData["info"] is string info)
{
    <div class="alert alert-success" role="alert">@info</div>
}
@if (TempData["error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form method="post" action="/language">
    @Html.AntiForgeryToken()
    <div class="row g-2 align-items-end">
        <div class="col-sm-8">
            <label for="languageCode" class="form-label">Preferred language</label>
            <select class="form-select" name="code" id="languageCode">
                @foreach (var lang in Model.Languages)
                {
                    var selected = lang.Code == Model.CurrentCode;
                    <option value="@lang.Code" selected="@(selected ? "selected" : null)">
                        @lang.NativeName (@lang.Code)
                    </option>
                }
            </select>
        </div>
        <div class="col-sm-4">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>

<form method="post" action="/language" class="mt-3"
      onsubmit="return confirm('Reset your language preference to the instance default?');">
    @Html.AntiForgeryToken()
    <input type="hidden" name="clear" value="1" />
    <button type="submit" class="btn btn-outline-secondary">Reset to instance default</button>
</form>
