@using Kumunita.Web.Security
@model Kumunita.Web.Controllers.LocaleController.LocaleSettingsViewModel
@{
    ViewData["Title"] = "Choose your language";
}

<h1><kw-l key="locale.public_title">Choose your language</kw-l></h1>
<p class="text-muted">
    <kw-l key="locale.lede">Pick the language the platform shows you. Your choice is saved in a browser cookie — it takes effect on the next request, and never affects other residents.</kw-l>
</p>

<form method="post" action="/language">
    @Html.AntiForgeryToken()
    <div class="row g-2 align-items-end">
        <div class="col-sm-8">
            <label for="languageCode" class="form-label"><kw-l key="locale.preferred_label">Preferred language</kw-l></label>
            <select class="form-select" name="code" id="languageCode">
                @foreach (var lang in Model.Languages)
                {
                    // ADR 0046: the pre-selection is the saved preference, or
                    // the browser match when none is saved (suggested only —
                    // saving is what makes it the preference).
                    var selected = lang.Code == Model.CurrentCode
                        || (Model.CurrentCode is null && lang.Code == Model.BrowserCode);
                    <option value="@lang.Code" selected="@(selected ? "selected" : null)">
                        @lang.NativeName (@lang.Code)
                        @if (Model.CurrentCode is null && lang.Code == Model.BrowserCode)
                        {
                            <span class="text-muted small"><kw-l key="locale.browser_matched">— matched from your browser</kw-l></span>
                        }
                    </option>
                }
            </select>
            @if (Model.CurrentCode is null && Model.BrowserCode is not null)
            {
                <div class="form-text small">
                    <kw-l key="locale.browser_note">We picked </kw-l><strong>@Model.BrowserCode</strong><kw-l key="locale.browser_note_tail"> from your browser settings. Saving makes it your preferred language — it stays until you change it.</kw-l>
                </div>
            }
        </div>
        <div class="col-sm-4">
            <button type="submit" class="btn btn-primary"><kw-l key="locale.save">Save</kw-l></button>
        </div>
    </div>
</form>

<form method="post" action="/language" class="mt-3"
      data-confirm="Reset your language preference to the instance default?">
    @Html.AntiForgeryToken()
    <input type="hidden" name="clear" value="1" />
    <button type="submit" class="btn btn-outline-secondary"><kw-l key="locale.reset">Reset to instance default</kw-l></button>
</form>
