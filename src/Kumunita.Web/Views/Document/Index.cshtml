@model Kumunita.Web.Models.DocumentIndexViewModel
@using Kumunita.Core.Documents
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    ViewData["Title"] = "Documents";
    var _kwL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <header class="airy-head">
            <div class="head-row">
                <div>
                    <h1><kw-l key="documents.title">Documents</kw-l></h1>
                </div>
                @if (Model.CanUpload)
                {
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-primary" href="/documents/new">
                            <kw-l key="documents.upload">Upload a document</kw-l>
                        </a>
                        <details class="d-inline-block">
                            <summary class="btn btn-outline-secondary"><kw-l key="documents.folder_new">New folder</kw-l></summary>
                            <form method="post" action="/documents/folders" class="mt-2 d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input class="form-control" type="text" name="Name" maxlength="120"
                                       placeholder="@await Translation.GetAsync("documents.folder_name_placeholder", _kwL)" required />
                                <button type="submit" class="btn btn-primary"><kw-l key="documents.folder_create">Create</kw-l></button>
                            </form>
                        </details>
                    </div>
                }
            </div>
        </header>

        <div class="airy-ann-list">
            @if (Model.Visible.Count == 0)
            {
                <div class="p-4 text-muted">
                    <kw-l key="documents.empty">No documents are visible to you yet.</kw-l>
                </div>
            }
            @foreach (var d in Model.Visible)
            {
                <div class="airy-ann-row">
                    <div>
                        <h3 class="airy-ann-title">
                            <a href="/documents/@d.Id">@d.Title</a>
                        </h3>
                        @if (!string.IsNullOrWhiteSpace(d.Summary))
                        {
                            <p class="airy-ann-preview mb-2">@d.Summary</p>
                        }
                        <div class="airy-ann-meta">
                            <span><kw-dt dt="@d.Created" format="g"></kw-dt></span>
                        </div>
                    </div>
                    <div class="airy-ann-side">
                        <div class="airy-ann-actions">
                            <a class="link-quiet small text-decoration-none" href="/documents/@d.Id/download">
                                <kw-l key="documents.download">Download</kw-l>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @* M26 U13 (D-SORT·5) — the documents list's sort control
               (the U10 _Sort reference, reused): the closed documents
               allowlist (U2 §2.2 row 12 — created/modified/title + this
               surface's own size key). Renders nothing when the VM field is
               null (the no-sort pin — the _Pager null ⇒ no partial
               precedent). Placed above the pager so the viewer's sort choice
               stays beside the paging affordance. *@
            @if (Model.Sort is not null)
            {
                <partial name="_Sort" model="Model.Sort" />
            }
            @if (Model.HasMore)
            {
                <nav aria-label="pagination" class="mt-3">
                    <a class="page-link" href="/documents?page=@(Model.Page + 1)" rel="next">
                        <kw-l key="pagination.next">Older</kw-l>
                    </a>
                </nav>
            }
        </div>
    </div>
</div>
