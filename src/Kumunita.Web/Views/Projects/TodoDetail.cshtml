@model Kumunita.Web.Models.TodoDetailViewModel
@using Kumunita.Web.Security
@using Kumunita.Core.Projects
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Todo.Title) ? "To-do" : Model.Todo.Title;
    // ADR 0069 — the fixed status vocabulary's label keys (the same closed
    // set the Kanban lane's Set-status select offers: None + the four codes).
    static string StatusLabelKey(string code) => code switch
    {
        KanbanStatuses.NotStarted => "projects.board.status.not_started",
        KanbanStatuses.InProgress => "projects.board.status.in_progress",
        KanbanStatuses.Done => "projects.board.status.done",
        KanbanStatuses.Cancelled => "projects.board.status.cancelled",
        _ => "projects.board.status.none",
    };
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <p>
            <a href="/projects/todos" class="btn btn-link p-0"><kw-l key="projects.todo.back">← Back to to-dos</kw-l></a>
        </p>

        @* The action dropdown (the _AccountNav.cshtml Bootstrap dropdown shape,
           the M2/M3/M4 shared nav-dropdown idiom): assign / add-subtask /
           delete — plain POST forms to the U07 routes, CSRF-tokenized,
           redirect-after-POST. Standing + cascade are the service's (F7/F8/
           F9); the view only renders what the service returns (C3). The
           assign-to-user picker draws on the seeded grant-picker option lists
           (the _GrantPickers partial's option source, the M2/M3/M4 shared
           shape); "Unassign" clears the assignee. *@
        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            @if (!string.IsNullOrWhiteSpace(Model.Todo.Status))
            {
                <span class="badge text-bg-light border">@Model.Todo.Status</span>
            }
            @if (Model.Todo.ComponentDisplayName is not null)
            {
                <span class="badge text-bg-light border">@Model.Todo.ComponentDisplayName</span>
            }
            @if (Model.Todo.GroupNames is { Count: > 0 })
            {
                <span class="badge text-bg-light border">
                    <kw-l key="projects.todo.addressed_to">Addressed to</kw-l>: @string.Join(", ", Model.Todo.GroupNames)
                </span>
            }
            <div class="dropdown ms-auto">
                <button class="btn btn-sm action-glyph-btn dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false"
                        aria-label="Actions for @Model.Todo.Title">⋮</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    @if (Model.Todo.CanClaim)
                    {
                        <li>
                            <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/claim")" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-dark"><kw-l key="projects.todo.claim">Claim</kw-l></button>
                            </form>
                        </li>
                    }
                    <li>
                        <a class="dropdown-item text-dark" href="@($"/projects/todos/{Model.Todo.Id}/edit")"><kw-l key="projects.todo.edit">Edit</kw-l></a>
                    </li>
                    <li>
                        <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/assign")"
                              data-confirm="@("Remove the assignee from this to-do?")" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-dark"><kw-l key="projects.todo.unassign">Unassign</kw-l></button>
                        </form>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item text-dark"
                                data-bs-toggle="modal"
                                data-bs-target="#subtask-modal">
                            <kw-l key="projects.todo.add_subtask">Add subtask</kw-l>
                        </button>
                    </li>
                    <li>
                        <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/delete")"
                              data-confirm="@("Delete this to-do and its subtasks? This cannot be undone.")" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger"><kw-l key="projects.todo.delete">Delete</kw-l></button>
                        </form>
                    </li>
                </ul>
            </div>

            @* ADR 0071 — the Add-subtask modal (same convention as the Kanban
               board card; the inline Title input is replaced). *@
            <div class="modal fade" id="subtask-modal" tabindex="-1"
                 aria-labelledby="subtask-modal-label" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/subtasks")" id="subtask-modal-form">
                            @Html.AntiForgeryToken()
                            <div class="modal-header">
                                <h5 class="modal-title" id="subtask-modal-label">
                                    <kw-l key="projects.todo.add_subtask">Add subtask</kw-l>
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="@("Close")"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label" for="subtask-modal-title">
                                        <kw-l key="common.title">Title</kw-l>
                                    </label>
                                    <input class="form-control" type="text" name="Title"
                                           id="subtask-modal-title" maxlength="120" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="subtask-modal-status">
                                        <kw-l key="projects.todo.status">Status</kw-l>
                                    </label>
                                    @* ADR 0069 — the fixed status vocabulary
                                       (the same <c>KanbanStatuses.Known</c> set
                                       the Kanban lane's Set-status select offers:
                                       None + the four codes). A new subtask
                                       starts with no status, so "None" is the
                                       selected default. *@
                                    <select class="form-select" name="Status" id="subtask-modal-status">
                                        <option value="" selected><kw-l key="projects.board.status.none">None</kw-l></option>
                                        @foreach (var statusCode in KanbanStatuses.Known)
                                        {
                                            <option value="@statusCode">
                                                <kw-l key="@StatusLabelKey(statusCode)">@statusCode</kw-l>
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label" for="subtask-modal-assignee">
                                        <kw-l key="projects.todo.assignee">Assignee</kw-l>
                                    </label>
                                    @{ var _opts = (ViewData["Audience_Users"] as List<GrantOption>) ?? new List<GrantOption>(); }
                                    <select class="form-control" name="AssigneeId" id="subtask-modal-assignee">
                                        <option value=""><kw-l key="projects.todo.unassigned">Unassigned</kw-l></option>
                                        @foreach (var o in _opts)
                                        {
                                            <option value="@o.Id">@o.Label</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <kw-l key="common.cancel">Cancel</kw-l>
                                </button>
                                <button type="submit" class="btn btn-primary" form="subtask-modal-form">
                                    <kw-l key="common.add">Add</kw-l>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                @* ADR 0088 — user-added translations of the to-do (the ADR 0059
                   chip-swap: the original + one variant per translation, the
                   td-swap JS shows the viewer's current-language variant
                   default — ADR 0049). The title is the to-do's surface; a
                   translation's title (if any) swaps in. The add/edit/remove
                   management is gated on Model.CanTranslate (the service's
                   display pin — the standing is re-pinned server-side). *@
                <div data-td-group="todo" class="mb-1">
                    <div class="td-variant" data-td-variant="@(Model.Todo.LanguageCode)">
                        <h1 class="mb-1">
                            @if (string.IsNullOrWhiteSpace(Model.Todo.Title))
                            {
                                <span class="text-body-tertiary"><kw-l key="projects.todo.untitled">Untitled to-do</kw-l></span>
                            }
                            else
                            {
                                @Model.Todo.Title
                            }
                        </h1>
                    </div>

                    @if (Model.Translations is { Count: > 0 })
                    {
                        foreach (var tr in Model.Translations)
                        {
                            <div class="td-variant" data-td-variant="@tr.LanguageCode">
                                <h1 class="mb-1">
                                    @if (string.IsNullOrWhiteSpace(tr.Title))
                                    {
                                        <span class="text-body-tertiary"><kw-l key="projects.todo.untitled">Untitled to-do</kw-l></span>
                                    }
                                    else
                                    {
                                        @tr.Title
                                    }
                                </h1>
                            </div>
                        }

                        <div class="td-chips btn-group mt-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-translation-chip data-td-group="todo"
                                    data-td-variant="@(Model.Todo.LanguageCode)">@Model.Todo.LanguageCode</button>
                            @foreach (var tr in Model.Translations)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-translation-chip data-td-group="todo"
                                        data-td-variant="@tr.LanguageCode">@tr.LanguageCode</button>
                            }
                        </div>
                    }
                </div>

                @* ADR 0088 — the translation management (add / edit / remove),
                   gated on the standing (the same shape as the ADR 0059 /
                   ADR 0027 / ADR 0039 translation sections). *@
                @if (Model.CanTranslate)
                {
                    @* The add surface (one <details> per enabled language that
                       does not yet have a translation, the ADR 0027 / ADR 0048
                       shape — the <kw-l> fallback is the English gloss; the
                       posts.translation_* keys are the Event lane's). The
                       rich editor uses the canonical rc-editor markup
                       (data-rich-editor + data-rich-editor-preview). *@
                    <div class="card mb-3">
                        <div class="card-body p-2">
                            <div class="small text-muted mb-1"><kw-l key="posts.translations_label">Translations</kw-l></div>

                            @foreach (var opt in (Model.Languages ?? []))
                            {
                                bool hasTranslation = Model.Translations is not null
                                    && Model.Translations.Any(t => t.LanguageCode == opt.Code);
                                if (hasTranslation) continue;

                                <details class="mb-1 mt-2">
                                    <summary class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <kw-l key="posts.translation_add">Add</kw-l> <b>@opt.NativeName</b>
                                    </summary>
                                    <form class="ms-2" method="post"
                                          action="@($"/projects/todos/{Model.Todo.Id}/translations")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="languageCode" value="@opt.Code" />
                                        <label class="form-label small" for="todo-t-title-@opt.Code">
                                            @opt.NativeName <kw-l key="posts.translation_title_label">title</kw-l>
                                            <span class="text-muted">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                        </label>
                                        <input class="form-control form-control-sm mb-2" id="todo-t-title-@opt.Code"
                                               name="title" value="@Model.Todo.Title" />
                                        <label class="form-label small" for="todo-t-body-@opt.Code">
                                            <kw-l key="posts.translation_body_label">Body</kw-l>
                                            <span class="text-muted">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                        </label>
                                        <div class="rc-editor">
                                            <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                                <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                                <partial name="_RichEditorToggle" />
                                            </div>
                                            <textarea class="form-control form-control-sm mb-2" id="todo-t-body-@opt.Code"
                                                      name="body" rows="3" placeholder="…" data-rich-editor></textarea>
                                            <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                                        </div>
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            <kw-l key="posts.translation_save">Save translation</kw-l>
                                        </button>
                                    </form>
                                </details>
                            }
                        </div>
                    </div>

                    @if (Model.Translations is { Count: > 0 })
                    {
                        <div class="card mb-3">
                            <div class="card-body p-2">
                                <div class="small text-muted mb-1"><kw-l key="posts.translations_label">Translations</kw-l></div>
                                @foreach (var tr in Model.Translations)
                                {
                                    <details class="mb-1 border rounded p-2">
                                        <summary class="small"><b>@tr.LanguageCode</b>
                                            @if (!string.IsNullOrWhiteSpace(tr.Title))
                                            {
                                                <span class="text-body-tertiary"> — @tr.Title</span>
                                            }
                                        </summary>
                                        <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/translations/update")" class="mt-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="languageCode" value="@tr.LanguageCode" />
                                            <div class="mb-2">
                                                <label class="form-label small"><kw-l key="common.title">Title</kw-l></label>
                                                <input type="text" name="title" value="@tr.Title" class="form-control" maxlength="120" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small"><kw-l key="posts.translation_body_label">Body</kw-l></label>
                                                <div class="rc-editor">
                                                    <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                                        <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                                        <partial name="_RichEditorToggle" />
                                                    </div>
                                                    <textarea class="form-control form-control-sm mb-2" name="body" rows="3" placeholder="…" data-rich-editor>@tr.Body</textarea>
                                                    <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                                                </div>
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-outline-primary"><kw-l key="posts.translation_save">Save translation</kw-l></button>
                                        </form>
                                        <form method="post" action="@($"/projects/todos/{Model.Todo.Id}/translations/remove")"
                                              class="mt-2 d-inline"
                                              onsubmit="return confirm('Remove this translation?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="languageCode" value="@tr.LanguageCode" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><kw-l key="posts.translation_remove">Remove</kw-l></button>
                                        </form>
                                    </details>
                                }
                            </div>
                        </div>
                    }
                }

                @* The assignee avatar (the BoardDetail card pattern, the same
                   fail-closed contract every other avatar <img> uses: the
                   <img> links the audited serving lane (GET
                   /profile/avatar/{subjectId}) and avatar.ts hides it on
                   the 404 it fails closed to, showing the monogram sibling). *@
                @if (!string.IsNullOrWhiteSpace(Model.Todo.AssigneeId))
                {
                    string assigneeInitial = !string.IsNullOrWhiteSpace(Model.Todo.AssigneeDisplayName)
                        ? char.ToUpperInvariant(Model.Todo.AssigneeDisplayName.TrimStart()[0]).ToString()
                        : string.Empty;
                    <div class="mb-2">
                        <span class="d-inline-flex align-items-center">
                            <img class="avatar avatar-sm" src="/profile/avatar/@Model.Todo.AssigneeId" alt=""
                                 data-avatar-fallback>
                            <span class="avatar-mono avatar-sm" style="display:none;">@assigneeInitial</span>
                        </span>
                    </div>
                }
                <div class="text-muted small mt-2 mb-3">
                    @Model.Todo.AuthorDisplayName
                    @if (!string.IsNullOrWhiteSpace(Model.Todo.AssigneeDisplayName))
                    {
                        <span> · <kw-l key="projects.todo.assignee">Assignee</kw-l>: @Model.Todo.AssigneeDisplayName</span>
                    }
                    else
                    {
                        <span> · <kw-l key="projects.todo.unassigned">Unassigned</kw-l></span>
                    }
                    <span> · <kw-l key="projects.todo.created">Created</kw-l>
                    <kw-dt dt="@Model.Todo.Created" format="g"></kw-dt></span>
                    @if (Model.Todo.Modified is not null)
                    {
                        <span> · <kw-l key="projects.todo.modified">Modified</kw-l>
                        <kw-dt dt="@Model.Todo.Modified" format="g"></kw-dt></span>
                    }
                </div>

                @* U08 (ADR 0086 §3.9) — the Project link (D9): the to-do's
                   project association (F3) rendered as a link to the project
                   detail (ADR 0086 D4). The controller's read surface resolved
                   the title (a dangling / unreadable association — F6 / F8 —
                   yields null fields and the whole line is hidden: the link is
                   a display surface, not an error for the to-do). *@
                @if (Model.ProjectId is not null && Model.ProjectTitle is not null)
                {
                    <div class="text-muted small mt-2 mb-3">
                        <kw-l key="pl.todo.project_link">Project</kw-l>:
                        <a href="@($"/projects/projects/{Model.ProjectId}")">@Model.ProjectTitle</a>
                    </div>
                }

                @* F9 — the parent link (a subtask is a full to-do shown under
                   its parent; the service's read surface, the view renders it). *@
                @if (!string.IsNullOrWhiteSpace(Model.Todo.ParentId) && !string.IsNullOrWhiteSpace(Model.Todo.ParentTitle))
                {
                    <div class="mb-3">
                        <span class="text-muted small"><kw-l key="projects.todo.parent">Parent</kw-l> · </span>
                        <a href="@($"/projects/todos/{Model.Todo.ParentId}")">@Model.Todo.ParentTitle</a>
                    </div>
                }

                @* ADR 0087 — the "waiting on" chip (the D4 surface). The
                   service resolved the blocker over the existing
                   TodoItemToAuditableResource; a to-do the actor may not read,
                   or one that is absent/soft-deleted, is a **Generic** chip
                   (no title, no link, no leak — C-TBD·4). A resolved chip is
                   a link to the blocker's detail (LinkPath non-null). The
                   blocker is purely informational — it never gates the to-do
                   itself (D2). *@
                @if (Model.Blocker is not null)
                {
                    <div class="mb-3">
                        <span class="text-muted small"><kw-l key="todo.blocked_by">Waiting on</kw-l> · </span>
                        @if (Model.Blocker.Generic)
                        {
                            <span class="badge text-bg-secondary"><kw-l key="todo.blocked_generic">Another to-do (not visible to you)</kw-l></span>
                        }
                        else
                        {
                            <a href="@Model.Blocker.LinkPath">@Model.Blocker.Title</a>
                            @if (!string.IsNullOrWhiteSpace(Model.Blocker.Status))
                            {
                                <span class="text-muted small"> · @Model.Blocker.Status</span>
                            }
                        }
                    </div>
                }

                @* ADR 0079 — the optional start / due dates (the <kw-dt>
                   TagHelper renders null as empty; the label is gated on the
                   value so an unset date shows nothing at all). Shown to
                   viewers in their own timezone (the kw-dt effective-timezone
                   conversion). *@
                @if (Model.Todo.StartAt is not null || Model.Todo.DueAt is not null)
                {
                    <div class="mb-3">
                        @if (Model.Todo.StartAt is not null)
                        {
                            <span class="text-muted small"><kw-l key="projects.todo.start">Start</kw-l> · </span>
                            <kw-dt dt="@Model.Todo.StartAt" format="g"></kw-dt>
                        }
                        @if (Model.Todo.StartAt is not null && Model.Todo.DueAt is not null)
                        {
                            <span class="text-muted small mx-2">·</span>
                        }
                        @if (Model.Todo.DueAt is not null)
                        {
                            <span class="text-muted small"><kw-l key="projects.todo.due">Due</kw-l> · </span>
                            <kw-dt dt="@Model.Todo.DueAt" format="g"></kw-dt>
                        }
                    </div>
                }

                @* The body (the U09 spec's rich-editor shape — the
                   rc-editor-toolbar / data-rich-editor /
                   data-rich-editor-preview pattern, the ADR 0031 pin, the
                   M3/M4 precedent): shown + editable in place. *@
                @if (!string.IsNullOrWhiteSpace(Model.Todo.Body))
                {
                    <div class="rc-editor">
                        <div class="rc-editor-toolbar" data-rich-editor>
                            <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                            <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                            <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                            <partial name="_RichEditorToggle" />
                        </div>
                        <textarea class="form-control" id="body" name="Body" rows="6" data-rich-editor>@Model.Todo.Body</textarea>
                        <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                    </div>
                }
                else
                {
                    <p class="text-body-tertiary mb-0"><kw-l key="projects.todo.no_body">No body — this to-do is title-only.</kw-l></p>
                }
            </div>
        </div>

        @* F9 — the subtasks (each a full to-do — its own status / assignee /
           audience; the service's per-subtask Read gate already ran). *@
        @if (Model.Subtasks.Count > 0)
        {
            <section class="mb-4">
                <h2 class="h5 mb-3"><kw-l key="projects.todo.subtasks">Subtasks</kw-l></h2>
                <div class="airy-ann-list">
                    @foreach (var sub in Model.Subtasks)
                    {
                        <div class="airy-ann-row">
                            <div>
                                <h3 class="airy-ann-title">
                                    <a href="@($"/projects/todos/{sub.Id}")">@sub.Title</a>
                                </h3>
                                <div class="text-muted small mb-1">
                                    @sub.AuthorDisplayName
                                    @if (!string.IsNullOrWhiteSpace(sub.AssigneeDisplayName))
                                    {
                                        <span> · <kw-l key="projects.todo.assignee">Assignee</kw-l>: @sub.AssigneeDisplayName</span>
                                    }
                                    <span> · <kw-dt dt="@sub.Created" format="g"></kw-dt></span>
                                    @if (!string.IsNullOrWhiteSpace(sub.Status))
                                    {
                                        <span class="badge text-bg-light border ms-2">@sub.Status</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        @* F2 — the board placements (a to-do appears on each board it is
           placed on; the service's read surface, the view renders it). *@
        @if (Model.Placements.Count > 0)
        {
            <section class="mb-4">
                <h2 class="h5 mb-3"><kw-l key="projects.todo.boards">Boards</kw-l></h2>
                <div class="list-group">
                    @foreach (var placement in Model.Placements)
                    {
                        <div class="list-group-item">
                            <a href="@($"/projects/boards/{placement.BoardId}")">
                                @placement.BoardTitle
                                @if (string.IsNullOrWhiteSpace(placement.BoardTitle))
                                {
                                    @placement.BoardId
                                }
                            </a>
                            @if (!string.IsNullOrWhiteSpace(placement.LaneTitle))
                            {
                                <span class="text-muted small ms-2">· @placement.LaneTitle</span>
                            }
                        </div>
                    }
                </div>
            </section>
        }
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/lib/rich-editor.js"></script>
}
