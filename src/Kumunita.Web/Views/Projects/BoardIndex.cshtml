@model Kumunita.Web.Models.BoardIndexViewModel
@using Kumunita.Web.Security
@{
    ViewData["Title"] = "Boards";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <header class="airy-head">
            <div class="head-row">
                <div>
                    <h1><kw-l key="projects.board.title">Boards</kw-l></h1>
                    <p class="lede">
                        <kw-l key="projects.board.lede">The neighborhood's shared boards — arrange to-dos in lanes, move them through statuses, and keep the work visible.</kw-l>
                    </p>
                </div>
                <a class="btn btn-outline-primary" href="/projects/boards/new"><kw-l key="projects.board.new">New board</kw-l></a>
            </div>
        </header>

        @* The To-dos / Boards tab strip (the _AdminNav.cshtml idiom): start from
           a to-do or from a board — both entry points are first-class. *@
        <partial name="_ProjectsTabs" />

        @if (Model.Components.Count > 0)
        {
            <form method="get" action="/projects/boards" class="mb-4">
                <div class="d-flex gap-2 align-items-end">
                    <div>
                        <label class="form-label" for="component-filter" style="font-weight:600;"><kw-l key="nav.community">Community</kw-l></label>
                        <select class="form-select" id="component-filter" name="componentId">
                            <option value=""><kw-l key="projects.todo.all_communities">All communities</kw-l></option>
                            @foreach (var (id, name) in Model.Components)
                            {
                                <option value="@id" selected="@(id == Model.CurrentComponentId ? "selected" : null)">@name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-outline-secondary"><kw-l key="common.filter">Filter</kw-l></button>
                </div>
            </form>
        }

        <div class="airy-ann-list">
            @if (Model.Boards.Count == 0)
            {
                <div class="p-4 text-muted"><kw-l key="projects.board.empty">No boards yet — create one to start arranging the shared work.</kw-l></div>
            }
            @foreach (var row in Model.Boards)
            {
                <div class="airy-ann-row">
                    <div>
                        <h3 class="airy-ann-title">
                            <a href="@($"/projects/boards/{row.Id}")">@row.Title</a>
                        </h3>
                        <div class="text-muted small mb-1">
                            @row.AuthorDisplayName
                            <span>· <kw-dt dt="@row.Created" format="g"></kw-dt></span>
                            @if (row.ComponentDisplayName is not null)
                            {
                                <span class="badge text-bg-light border ms-2">@row.ComponentDisplayName</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(row.Description))
                        {
                            <p class="mb-1">@MarkdownRenderer.PlainTextPreview(row.Description, 250)</p>
                        }
                    </div>
                    @* The row action (the _AccountNav.cshtml Bootstrap dropdown
                       shape, the M2/M3/M4 shared nav-dropdown idiom): delete
                       board — a plain POST form to the U08 route,
                       CSRF-tokenized, redirect-after-POST. The cascade
                       (lanes + placements deleted, to-dos kept) is the
                       service's (F2 / F8); this surface only renders what the
                       service returns (C3). *@
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false"
                                aria-label="Actions for @row.Title">⋮</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (Model.Projects is { Count: > 0 })
                            {
                                @* ADR 0086 D9 — "Add to Project…": opens the
                                   per-row modal (the TodosIndex subtask-modal
                                   idiom) whose picker posts to the U04
                                   set-project lane (the BoardEdit set-project
                                   card idiom, repackaged as a modal). Hidden
                                   when the actor sees no readable project —
                                   a picker with no options is a noise
                                   surface, not a control (F10). *@
                                <li>
                                    <button type="button" class="dropdown-item text-dark"
                                            data-bs-toggle="modal"
                                            data-bs-target="@($"#add-project-{row.Id}")">
                                        <kw-l key="pl.board.add_to_project">Add to Project…</kw-l>
                                    </button>
                                </li>
                            }
                            <li>
                                <form method="post" action="@($"/projects/boards/{row.Id}/delete")"
                                      data-confirm="@("Delete this board? Its lanes and card placements are removed — the to-dos themselves are kept.")" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger"><kw-l key="projects.board.delete">Delete board</kw-l></button>
                                </form>
                            </li>
                        </ul>
                    </div>
                    @if (Model.Projects is { Count: > 0 })
                    {
                        @* ADR 0086 D9 — the "Add to Project…" modal (one per
                           row, the TodosIndex subtask-modal idiom): a picker
                           over the actor's readable projects posting to the
                           U04 set-project lane. The current association is
                           preselected (the row's stored `ProjectId`); a
                           blank choice clears it (the BoardEdit card
                           idiom). The write's standing + project guard are
                           the service's (C3 split) — this surface only
                           renders the options. *@
                        <div class="modal fade" id="@($"add-project-{row.Id}")" tabindex="-1"
                             aria-labelledby="@($"add-project-label-{row.Id}")" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <form method="post" action="@($"/projects/boards/{row.Id}/set-project")">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="@($"add-project-label-{row.Id}")">
                                                <kw-l key="pl.board.add_to_project">Add to Project…</kw-l>
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="@("Close")"></button>
                                        </div>
                                        <div class="modal-body">
                                            <label class="form-label" for="@($"add-project-select-{row.Id}")">
                                                <kw-l key="pl.board.project_link">Project</kw-l>
                                            </label>
                                            <select class="form-select" id="@($"add-project-select-{row.Id}")" name="ProjectId">
                                                <option value="" selected="@(string.IsNullOrWhiteSpace(row.ProjectId))">@(Html.Raw("&mdash;"))</option>
                                                @foreach (var (id, name) in Model.Projects)
                                                {
                                                    <option value="@id" selected="@(id == row.ProjectId)">@name</option>
                                                }
                                            </select>
                                            <div class="text-muted small mt-2">
                                                <kw-l key="pl.board.project_hint">A project link is a display surface — it groups this board under the project, it never limits who can see it.</kw-l>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                <kw-l key="common.cancel">Cancel</kw-l>
                                            </button>
                                            <button type="submit" class="btn btn-primary">
                                                <kw-l key="pl.board.set_project">Set project</kw-l>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
