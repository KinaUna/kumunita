@model Kumunita.Web.Models.ProjectComposerViewModel
@using Kumunita.Web.Security
@using Kumunita.Core.Projects
@{
    ViewData["Title"] = "Edit project";
    // The fixed status vocabulary's label keys (the same closed set the
    // Kanban lane's Set-status select offers: None + the four codes, ADR 0069
    // — the to-do status shape, now shared with projects).
    static string StatusLabelKey(string code) => code switch
    {
        KanbanStatuses.NotStarted => "projects.board.status.not_started",
        KanbanStatuses.InProgress => "projects.board.status.in_progress",
        KanbanStatuses.Done => "projects.board.status.done",
        KanbanStatuses.Cancelled => "projects.board.status.cancelled",
        _ => "projects.board.status.none",
    };
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <h1><kw-l key="pl.project.edit_heading">Edit project</kw-l></h1>
        <p class="text-muted">
            <kw-l key="pl.project.edit_lead">Update this project's title, description, goal, status, and dates. Its audience, community, and language are fixed when the project is created.</kw-l>
        </p>

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <ul class="mb-0">
                    @foreach (var msg in ViewData.ModelState
                        .SelectMany(kvp => kvp.Value?.Errors ?? [])
                        .Select(e => e.ErrorMessage))
                    {
                        <li>@msg</li>
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form id="edit-project-form" method="post" action="/projects/projects/@(ViewData["projectId"] ?? throw new InvalidOperationException("The project id is not in the view data."))">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-label" style="font-weight:600;"><kw-l key="common.title">Title</kw-l></div>
                    <input class="form-control" type="text" id="title" name="Title"
                           maxlength="120" required value="@Model.Title" />
                    <div class="text-muted small mt-1"><kw-l key="pl.project.title_hint">A short name for the project — the feed label.</kw-l></div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="description" style="font-weight:600;"><kw-l key="common.body">Body</kw-l></label>
                    <div class="rc-editor">
                        <div class="rc-editor-toolbar" data-rich-editor>
                            <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                            <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                            <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                            <partial name="_RichEditorToggle" />
                        </div>
                        <textarea class="form-control" id="description" name="Description" rows="5" data-rich-editor>@Model.Description</textarea>
                        <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                    </div>
                    <div class="text-muted small mt-2"><kw-l key="pl.project.description_hint">An optional description of what this project is about. A project is usable title-only.</kw-l></div>
                </div>
            </div>

            @* The goal picker (D10) — re-associate or un-goal (the empty
               choice posts ClearGoal). A display surface, never a gate; the
               service's standing gate is the enforcement. *@
            @if (Model.Goals.Count > 0)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <label class="form-label" for="goal" style="font-weight:600;"><kw-l key="pl.project.goal_heading">Goal</kw-l></label>
                        <select class="form-control" id="goal" name="GoalId">
                            <option value="" selected="@(Model.GoalId is null ? "selected" : null)"><kw-l key="projects.board.status.none">None</kw-l></option>
                            @foreach (var (id, name) in Model.Goals)
                            {
                                <option value="@id" selected="@(id == Model.GoalId ? "selected" : null)">@name</option>
                            }
                        </select>
                        <div class="text-muted small mt-2">
                            <kw-l key="pl.project.goal_hint">An optional goal to organize this project under. Leave blank for a standalone project.</kw-l>
                        </div>
                    </div>
                </div>
            }

            <div class="card mb-4">
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col">
                            <label class="form-label" for="status" style="font-weight:600;"><kw-l key="pl.project.status">Status</kw-l></label>
                            @* The fixed status vocabulary (ADR 0069) — None +
                               the four known codes, the same <c>
                               KanbanStatuses.Known</c> set the to-do / Kanban
                               lane selects offer (the to-do status shape
                               shared with projects). A free-text value
                               (pre-migration) is preserved as an extra option
                               so editing never loses it (C3). *@
                            <select class="form-select" id="status" name="Status">
                                <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Status))"><kw-l key="projects.board.status.none">None</kw-l></option>
                                @if (!string.IsNullOrWhiteSpace(Model.Status) && !KanbanStatuses.Known.Contains(Model.Status))
                                {
                                    <option value="@Model.Status" selected>@Model.Status</option>
                                }
                                @foreach (var statusCode in KanbanStatuses.Known)
                                {
                                    <option value="@statusCode" selected="@(Model.Status == statusCode)">
                                        <kw-l key="@StatusLabelKey(statusCode)">@statusCode</kw-l>
                                    </option>
                                }
                            </select>
                            <div class="text-muted small mt-1"><kw-l key="pl.project.status_hint">An optional state label — the same fixed vocabulary as to-dos. Leave blank for none.</kw-l></div>
                        </div>
                    </div>
                    <div class="row g-2 mt-3">
                        <div class="col">
                            <label class="form-label" for="start-at" style="font-weight:600;"><kw-l key="pl.project.start_date">Start</kw-l></label>
                            <input class="form-control" type="datetime-local" id="start-at" name="StartAt"
                                   value="@Model.StartAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="col">
                            <label class="form-label" for="due-at" style="font-weight:600;"><kw-l key="pl.project.due_date">Due</kw-l></label>
                            <input class="form-control" type="datetime-local" id="due-at" name="DueAt"
                                   value="@Model.DueAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                    <div class="text-muted small mt-2">
                        <kw-l key="pl.project.dates_hint">Both are optional — leave blank for no date. Shown to viewers in their own timezone.</kw-l>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><kw-l key="pl.project.save">Save changes</kw-l></button>
                <a href="@($"/projects/projects/{ViewData["projectId"]}")" class="btn btn-link p-0"><kw-l key="common.cancel">Cancel</kw-l></a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/lib/rich-editor.js"></script>
}
