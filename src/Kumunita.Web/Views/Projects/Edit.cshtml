@model Kumunita.Web.Models.TodoEditorModel
@using Kumunita.Web.Security
@using Kumunita.Core.Projects
@{
    ViewData["Title"] = "Edit to-do";
    string[] modes = { "Any", "All" };
    var assigneeOptions = (ViewData["Audience_Users"] as List<GrantOption>) ?? new List<GrantOption>();
    // The fixed status vocabulary's label keys (the same closed set the
    // Kanban lane's Set-status select offers: None + the four codes, ADR 0069).
    static string StatusLabelKey(string code) => code switch
    {
        KanbanStatuses.NotStarted => "projects.board.status.not_started",
        KanbanStatuses.InProgress => "projects.board.status.in_progress",
        KanbanStatuses.Done => "projects.board.status.done",
        KanbanStatuses.Cancelled => "projects.board.status.cancelled",
        _ => "projects.board.status.none",
    };
    // The form POSTs to /projects/todos/{id} (the UpdatePost lane). When
    // rendered via the GET /projects/todos/{id}/edit route the path carries
    // the "/edit" suffix — strip it to get the correct POST target. When
    // re-rendered after a failed POST the path is already /projects/todos/{id}.
    var rawPath = ViewContext.HttpContext?.Request?.Path.Value ?? "/projects/todos";
    var editPath = rawPath.EndsWith("/edit") ? rawPath[..^"/edit".Length] : rawPath;
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <h1><kw-l key="projects.todo.edit_heading">Edit to-do</kw-l></h1>
        <p class="text-muted">
            <kw-l key="projects.todo.edit_lead">Update this to-do's details. Your audience choice is the sole access boundary — the community pick is only a filter.</kw-l>
        </p>

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <ul class="mb-0">
                    @foreach (var msg in ViewData.ModelState
                        .SelectMany(kvp => kvp.Value?.Errors ?? [])
                        .Select(e => e.ErrorMessage))
                    {
                        <li>@msg</li>
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form id="edit-todo-form" method="post" action="@editPath">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-label" style="font-weight:600;"><kw-l key="common.title">Title</kw-l></div>
                    <input class="form-control" type="text" id="title" name="Title"
                           maxlength="120" required value="@Model.Title" />
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-6">
                            <label class="form-label" for="status" style="font-weight:600;"><kw-l key="projects.todo.status">Status</kw-l></label>
                            @* The fixed status vocabulary (ADR 0069) — None +
                               the four known codes, the same <c>
                               KanbanStatuses.Known</c> set the Kanban lane's
                               Set-status select offers. A pre-ADR-0069
                               free-text status is preserved as an extra option
                               so editing never loses it (C3). *@
                            <select class="form-control" id="status" name="Status">
                                <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Status))"><kw-l key="projects.board.status.none">None</kw-l></option>
                                @if (!string.IsNullOrWhiteSpace(Model.Status) && !KanbanStatuses.Known.Contains(Model.Status))
                                {
                                    <option value="@Model.Status" selected>@Model.Status</option>
                                }
                                @foreach (var statusCode in KanbanStatuses.Known)
                                {
                                    <option value="@statusCode" selected="@(Model.Status == statusCode)">
                                        <kw-l key="@StatusLabelKey(statusCode)">@statusCode</kw-l>
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="assignee" style="font-weight:600;"><kw-l key="projects.todo.assignee">Assignee</kw-l></label>
                            <select class="form-control" id="assignee" name="AssigneeId">
                                <option value=""><kw-l key="projects.todo.unassigned">Unassigned</kw-l></option>
                                @foreach (var o in assigneeOptions)
                                {
                                    <option value="@o.Id" selected="@(o.Id == Model.AssigneeId ? "selected" : null)">@o.Label</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-6">
                            <label class="form-label" for="parent" style="font-weight:600;"><kw-l key="projects.todo.parent">Parent</kw-l></label>
                            <select class="form-control" id="parent" name="ParentId">
                                <option value=""><kw-l key="projects.todo.no_parent">No parent (top-level)</kw-l></option>
                                @foreach (var (id, title) in Model.ParentOptions)
                                {
                                    <option value="@id" selected="@(id == Model.ParentId ? "selected" : null)">@title</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6 d-flex align-items-end pb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="clear-parent"
                                       name="ClearParent" value="true" @(Model.ClearParent ? "checked" : null) />
                                <input type="hidden" name="ClearParent" value="false" />
                                <label class="form-check-label" for="clear-parent">
                                    <kw-l key="projects.todo.clear_parent">Clear parent (make top-level)</kw-l>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="text-muted small mt-2">
                        <kw-l key="projects.todo.reparent_hint">A subtask is a full to-do with its own status, assignee, and board placement. Reparenting to a descendant is refused (cycle guard).</kw-l>
                    </div>
                </div>
            </div>

            @* ADR 0087 — the "waiting on" picker (D7): the actor's readable,
               non-deleted to-dos (a display surface, never a gate — C-TBD·4;
               the cycle guard is the service's, C-TBD·3). A leading "No
               blocker" option + a "no blocker" checkbox post the clear
               (the ClearParent idiom). *@
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-6">
                            <label class="form-label" for="blocked-by" style="font-weight:600;"><kw-l key="todo.blocked_by">Waiting on</kw-l></label>
                            <select class="form-control" id="blocked-by" name="BlockedByTodoId">
                                <option value=""><kw-l key="todo.blocked_by_none">No blocker</kw-l></option>
                                @foreach (var (id, title) in Model.BlockerOptions)
                                {
                                    <option value="@id" selected="@(id == Model.BlockedByTodoId ? "selected" : null)">@title</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6 d-flex align-items-end pb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="clear-blocked-by"
                                       name="ClearBlockedBy" value="true" @(Model.ClearBlockedBy ? "checked" : null) />
                                <input type="hidden" name="ClearBlockedBy" value="false" />
                                <label class="form-check-label" for="clear-blocked-by">
                                    <kw-l key="todo.blocked_by_none">No blocker</kw-l>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="text-muted small mt-2">
                        <kw-l key="todo.blocked_by">Waiting on</kw-l> — purely informational: a blocker never blocks this to-do itself, and a reference back to a to-do already in its own chain is refused (cycle guard).
                    </div>
                </div>
            </div>

            @* ADR 0079 — the optional start / due dates (the Event Start/End
               `datetime-local` shape, but OPTIONAL). On the edit lane a blank
               field posts null, which *clears* the stored date (the
               UpdateTodoRequest partial shape) — the prefill above shows the
               stored value. *@
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col">
                            <label class="form-label" for="start-at" style="font-weight:600;"><kw-l key="projects.todo.start">Start</kw-l></label>
                            <input class="form-control" type="datetime-local" id="start-at" name="StartAt"
                                   value="@Model.StartAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="col">
                            <label class="form-label" for="due-at" style="font-weight:600;"><kw-l key="projects.todo.due">Due</kw-l></label>
                            <input class="form-control" type="datetime-local" id="due-at" name="DueAt"
                                   value="@Model.DueAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                    <div class="text-muted small mt-2">
                        <kw-l key="projects.todo.dates_hint">Both are optional — leave blank for no date. Shown to viewers in their own timezone.</kw-l>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="body" style="font-weight:600;"><kw-l key="common.body">Body</kw-l></label>
                    <div class="rc-editor">
                        <div class="rc-editor-toolbar" data-rich-editor>
                            <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                            <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                            <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                            <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                            <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                            <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                            <partial name="_RichEditorToggle" />
                        </div>
                        <textarea class="form-control" id="body" name="Body" rows="6" data-rich-editor>@Model.Body</textarea>
                        <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                    </div>
                </div>
            </div>

            @if (Model.Components.Count > 0)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <label class="form-label" for="component" style="font-weight:600;"><kw-l key="nav.community">Community</kw-l></label>
                        <select class="form-control" id="component" name="ComponentId">
                            <option value="" selected="@(Model.ComponentId is null ? "selected" : null)"><kw-l key="projects.todo.all_communities">All communities</kw-l></option>
                            @foreach (var (id, name) in Model.Components)
                            {
                                <option value="@id" selected="@(id == Model.ComponentId ? "selected" : null)">@name</option>
                            }
                        </select>
                    </div>
                </div>
            }

            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="language" style="font-weight:600;"><kw-l key="common.language">Language</kw-l></label>
                    <select class="form-control" id="language" name="LanguageCode">
                        @foreach (var (languageCode, nativeName) in Model.Languages)
                        {
                            <option value="@languageCode" selected="@(languageCode == Model.LanguageCode ? "selected" : null)">
                                @nativeName
                            </option>
                        }
                    </select>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h6 class="card-title" style="font-weight:600;"><kw-l key="projects.todo.audience_heading">Audience — who can see this to-do</kw-l></h6>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               name="Audience.CommunityVisible"
                               id="aud-community" data-audience-toggle
                               value="true"
                               @(Model.Audience?.CommunityVisible ?? true ? "checked" : null) />
                        <label class="form-check-label fw-semibold" for="aud-community">
                            <kw-l key="posts.audience_all_members">Everyone</kw-l>
                        </label>
                    </div>

                    @* ADR 0102 — the granular audience block (mode radios +
                       "Who to grant to") is hidden while "Everyone" is on:
                       the checkbox above drives show/hide via
                       client/lib/audience-toggle.js (loaded in _Layout).
                       The hidden <c>Grants</c> textarea inside _GrantPickers
                       stays the ONLY form-bound grant field (the single-
                       source pin) regardless of visibility. *@
                    <div id="audience-restricted" data-audience-panel class="mt-3 audience-restricted"
                         @(Model.Audience?.CommunityVisible ?? true ? "d-none" : null)>
                        <label class="form-label" for="aud-mode" style="font-weight:600;"><kw-l key="posts.audience_combine">How the picks combine</kw-l></label>
                        @foreach (var m in modes)
                        {
                            var checkedMark =
                                string.Equals(Model.Audience?.Mode, m, StringComparison.OrdinalIgnoreCase)
                                    ? "checked" : null;
                            <div class="form-check" style="margin-left:0.5rem;">
                                <input class="form-check-input" type="radio"
                                       name="Audience.Mode" id="@($"aud-mode-{m}")"
                                       value="@m" @checkedMark required />
                                <label class="form-check-label" for="@($"aud-mode-{m}")">
                                    @m
                                    @if (m == "Any")
                                    {
                                        @(" — ")<kw-l key="events.audience_mode_any">a viewer matches if they're on any of the picks</kw-l>
                                    }
                                    else
                                    {
                                        @(" — ")<kw-l key="events.audience_mode_all">a viewer must be on every pick — an empty list denies everyone</kw-l>
                                    }
                                </label>
                            </div>
                        }

                        <partial name="_GrantPickers" model="@(new GrantPickersModel
                        {
                            EditorName = "Audience",
                            Editor     = Model.Audience
                                        ?? new AudienceEditorModel { Mode = "Any", Grants = string.Empty },
                            Users      = (ViewData["Audience_Users"]  as List<GrantOption>) ?? new List<GrantOption>(),
                            Groups     = (ViewData["Audience_Groups"] as List<GrantOption>) ?? new List<GrantOption>(),
                        })" />
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><kw-l key="projects.todo.save">Save changes</kw-l></button>
                <a href="@editPath" class="btn btn-link p-0"><kw-l key="common.cancel">Cancel</kw-l></a>
            </div>
        </form>

        @* U08 (ADR 0086 §3.9) — the standalone set-project card (D10): a
           separate POST (PUT /projects/todos/{id}/set-project) that keeps the
           frozen UpdateTodoRequest DTO (C-PL·8: zero migrations) untouched. The
           picker is a display surface, never a gate (C-PL·3): the to-do exists
           with or without the association, and the empty option clears it. The
           card is hidden when the actor sees no readable project (F10). *@
        @if (Model.Projects.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label fw-semibold" for="set-project-select">
                        <kw-l key="pl.todo.project_link">Project</kw-l>
                    </label>
                    <form method="post" action="@($"{editPath}/set-project")">
                        @Html.AntiForgeryToken()
                        <select class="form-select" id="set-project-select" name="ProjectId">
                            <option value="">@(Html.Raw("&mdash;"))</option>
                            @foreach (var (id, name) in Model.Projects)
                            {
                                <option value="@id" selected="@(id == Model.ProjectId ? "selected" : null)">@name</option>
                            }
                        </select>
                        <div class="d-flex gap-2 mt-2">
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <kw-l key="pl.todo.set_project">Set project</kw-l>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/lib/rich-editor.js"></script>
    <partial name="_GrantPickerScripts" />
}
