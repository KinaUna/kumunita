@model Kumunita.Web.Models.DirectoryViewModel.Detail
@using Kumunita.Web.Security
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor httpContextAccessor

@{
    ViewData["Title"] = Model.DisplayName;

    // U8 of the media feature: the avatar's subject is this detail row's
    // resident — the {subjectId} of the route (DirectoryController.Detail's
    // [HttpGet("{subjectId}")] parameter, the same value the directory list's
    // rows link through). The Detail view-model record is pinned to exactly
    // its contact-gate fields (the M2 register's pin at
    // DirectoryController.ProjectDetail — no avatar field added), so the
    // subject comes from the stable URL contract, not a view-model shape.
    // Same fail-closed contract as the list rows: U7's serving endpoint
    // (GET /profile/avatar/{subjectId}, C-MED·3 — never a static path)
    // returns 404 when the profile is blocked, the audience denies, or no
    // avatar is set (FACES M3–M5), and the monogram sibling then takes
    // over (no broken-image icon).
    string? avatarSubject = httpContextAccessor.HttpContext?.Request.RouteValues["subjectId"] as string;
    string avatarInitial = !string.IsNullOrWhiteSpace(Model.DisplayName)
        ? char.ToUpperInvariant(Model.DisplayName.TrimStart()[0]).ToString()
        : string.Empty;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        @* M17 (ADR 0118) + M37 (ADR 0167) — the bookmark toggle and the
           personal-note button, on ONE right-aligned row at the TOP of the
           parent column (just below the nav bar, to the right). The M17
           closed set now includes "directory" (the ADR 0118 amendment,
           2026-10-16 — the M37 PersonalNotes closed-set vocabulary
           re-applied to the M17 surface). *@
        <div class="d-flex justify-content-end gap-2 mb-2">
            @{ var _bm = ("directory", avatarSubject ?? string.Empty, $"/directory/{avatarSubject}"); }
            <partial name="_BookmarkButton" model="@_bm" />
            @{ var _pn = ("directory", avatarSubject ?? string.Empty, $"/directory/{avatarSubject}"); }
            <partial name="_NoteButton" model="@_pn" />
        </div>
        <p>
            <a href="@Url.Action("Index", "Directory")" class="btn btn-link p-0">
                <kw-l key="directory.detail_back">&larr; Back to the directory</kw-l>
            </a>
        </p>
        <div class="card kmb-detail-card kmb-member-head">
            <div class="card-body">
                <div class="kmb-member-id">
                    @if (!string.IsNullOrEmpty(avatarSubject))
                    {
                        <span class="d-inline-flex align-items-center">
                            <kw-avatar subject="@avatarSubject" mono="@avatarInitial" size="lg" mono-hue="@AvatarHue.For(avatarSubject)" />
                        </span>
                    }
                    else
                    {
                        <span class="avatar-mono avatar-lg">@avatarInitial</span>
                    }
                    <div class="kmb-member-name">
                        <h1 class="mb-1">@Model.DisplayName</h1>
                        @if (Model.Verified)
                        {
                            <span class="kmb-chip kmb-chip-verified"><span aria-hidden="true">&#10003;</span> <kw-l key="directory.detail_verified">Verified</kw-l></span>
                        }
                    </div>
                    @* M9 amendment (ADR 0139) — "Send a message": only when Model.CanMessage
                       (two-sided gate computed by DirectoryController; a self-view is never
                       flagged). Same POST seam (/messages/open), now inside the header card. *@
                    @if (Model.CanMessage && !string.IsNullOrEmpty(avatarSubject))
                    {
                        <form method="post" action="/messages/open" class="kmb-member-msg m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="otherId" value="@avatarSubject" />
                            <button type="submit" class="btn btn-outline-primary">
                                <kw-l key="directory.send_message">Send a message</kw-l>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        @*
          M23 (ADR 0123 D2/D6) — the bio/tags surface, on the profile's
          Visibility gate (a SEPARATE gate from the contact block below — the
          F2 "two independent gates" pin). Model.Bio is null when the gate
          denied (or the resident set no bio) — the view renders no bio block
          (the "no bio block" shape); Model.TagNames is null when the gate
          denied (render no tag row at all) or an empty list when the gate
          allowed but the resident set none (the "No tags set." shape). The
          bio is rich content, rendered via MarkdownRenderer (the M22/rc-body
          idiom) — never an un-awaited async helper.
        *@
        @if (!string.IsNullOrWhiteSpace(Model.Bio))
        {
            <div class="card kmb-detail-card mt-3">
                <div class="card-header"><span class="kmb-card-title"><kw-l key="profile.detail.bio">About</kw-l></span></div>
                <div class="card-body">
                    <div class="rc-body">@Html.Raw(Kumunita.Web.Security.MarkdownRenderer.RenderHtml(Model.Bio))</div>
                </div>
            </div>
        }
        @if (Model.TagNames is not null)
        {
            <div class="card kmb-detail-card mt-3">
              <div class="card-body">
                <div class="kmb-meta-label mb-2"><kw-l key="profile.detail.tags">Interests &amp; skills</kw-l></div>
                @if (Model.TagNames.Count > 0)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        @foreach (var tag in Model.TagNames)
                        {
                            <span class="kmb-chip">@tag</span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0"><kw-l key="profile.detail.tags.empty">No tags set.</kw-l></p>
                }
              </div>
            </div>
        }

        @*
          Contact-block opt-in pin (M2 design doc §2.4, invariant C-M2·1,
          ARCHITECTURE.md §9): the contact block is rendered ONLY when the
          service's ContactVisibility decision allowed *this* viewer — a
          not-opted-in (null) or denied audience yields ShowContactBlock=false
          and null Email/Phone/Address — see DirectoryController.ProjectDetail —
          so even a hand-edited model has nowhere to put a contact value (the
          Razor view cannot render Email/Phone/Address independently of
          ShowContactBlock). Basic info (name + verified badge) above always
          renders: the directory has no "hidden profile" shape anymore.
        *@
        @if (Model.ShowContactBlock)
        {
            <div class="card kmb-detail-card mt-3"><div class="card-body"><dl class="row mb-0">
                @if (!string.IsNullOrEmpty(Model.Address))
                {
                    <dt class="col-sm-3"><kw-l key="directory.detail_contact_address">Address</kw-l></dt>
                    <dd class="col-sm-9">@Model.Address</dd>
                }
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <dt class="col-sm-3"><kw-l key="directory.detail_contact_email">Email</kw-l></dt>
                    <dd class="col-sm-9">
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <dt class="col-sm-3"><kw-l key="directory.detail_contact_phone">Phone</kw-l></dt>
                    <dd class="col-sm-9">@Model.Phone</dd>
                }
            </dl></div></div>
        }
        else
        {
            <p class="text-muted mt-3">
                <kw-l key="directory.detail_no_contact">This resident hasn't shared a contact method with you (yet). You can still see their profile page.</kw-l>
            </p>
        }
    </div>
</div>
