@model Kumunita.Web.Models.DirectoryViewModel.Detail
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor httpContextAccessor

@{
    ViewData["Title"] = Model.DisplayName;

    // U8 of the media feature: the avatar's subject is this detail row's
    // resident — the {subjectId} of the route (DirectoryController.Detail's
    // [HttpGet("{subjectId}")] parameter, the same value the directory list's
    // rows link through). The Detail view-model record is pinned to exactly
    // its contact-gate fields (the M2 register's pin at
    // DirectoryController.ProjectDetail — no avatar field added), so the
    // subject comes from the stable URL contract, not a view-model shape.
    // Same fail-closed contract as the list rows: U7's serving endpoint
    // (GET /profile/avatar/{subjectId}, C-MED·3 — never a static path)
    // returns 404 when the profile is blocked, the audience denies, or no
    // avatar is set (FACES M3–M5), and the monogram sibling then takes
    // over (no broken-image icon).
    string? avatarSubject = httpContextAccessor.HttpContext?.Request.RouteValues["subjectId"] as string;
    string avatarInitial = !string.IsNullOrWhiteSpace(Model.DisplayName)
        ? char.ToUpperInvariant(Model.DisplayName.TrimStart()[0]).ToString()
        : string.Empty;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <p>
            <a href="@Url.Action("Index", "Directory")" class="btn btn-link p-0">
                &larr; Back to the directory
            </a>
        </p>
        <div class="d-flex align-items-center gap-3">
            @if (!string.IsNullOrEmpty(avatarSubject))
            {
                <span class="d-inline-flex align-items-center">
                    <img class="avatar avatar-lg" src="/profile/avatar/@avatarSubject" alt=""
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';">
                    <span class="avatar-mono avatar-lg" style="display:none;">@avatarInitial</span>
                </span>
            }
            else
            {
                <span class="avatar-mono avatar-lg">@avatarInitial</span>
            }
            <h1 class="mb-0">
                @Model.DisplayName
                @if (Model.Verified)
                {
                    <span class="badge text-bg-success">Verified</span>
                }
            </h1>
        </div>

        @*
          Contact-block opt-in pin (M2 design doc §2.4, invariant C-M2·1,
          ARCHITECTURE.md §9): the contact block is rendered ONLY when the
          service's ContactVisibility decision allowed *this* viewer — a
          not-opted-in (null) or denied audience yields ShowContactBlock=false
          and null Email/Phone/Address — see DirectoryController.ProjectDetail —
          so even a hand-edited model has nowhere to put a contact value (the
          Razor view cannot render Email/Phone/Address independently of
          ShowContactBlock). Basic info (name + verified badge) above always
          renders: the directory has no "hidden profile" shape anymore.
        *@
        @if (Model.ShowContactBlock)
        {
            <dl class="row mt-4">
                @if (!string.IsNullOrEmpty(Model.Address))
                {
                    <dt class="col-sm-3">Address</dt>
                    <dd class="col-sm-9">@Model.Address</dd>
                }
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">
                        <a href="mailto:@Model.Email">@Model.Email</a>
                    </dd>
                }
                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@Model.Phone</dd>
                }
            </dl>
        }
        else
        {
            <p class="text-muted mt-3">
                This resident hasn't shared a contact method with you (yet). You can
                still see their profile page.
            </p>
        }
    </div>
</div>
