@model Kumunita.Web.Models.DirectoryViewModel
@{
    ViewData["Title"] = "Directory";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <h1><kw-l key="directory.title">Directory</kw-l></h1>
        <p class="text-muted"><kw-l key="directory.lead">Everyone in the neighborhood — every resident on the platform.</kw-l></p>

        @if (Model.Profiles.Count == 0)
        {
            <div class="alert alert-info">
                <kw-l key="directory.empty">No residents on this neighborhood yet.</kw-l>
            </div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var p in Model.Profiles)
                {
                    @*
                      U8 of the media feature: the per-resident avatar. The
                      <img> src is always U7's serving endpoint (GET
                      /profile/avatar/{subjectId}, C-MED·3 — never a static
                      path; the gate + audit run on the endpoint, not on the
                      <img>). The row's own SubjectId is the subject — the
                      frozen VisibleProfile already carries it. The endpoint
                      fails closed to 404 (no avatar set, a denied audience
                      or a blocked profile — FACES M3–M5), so on load error
                      the monogram sibling takes over (no broken-image icon).
                    *@
                    string avatarInitial = !string.IsNullOrWhiteSpace(p.DisplayName)
                        ? char.ToUpperInvariant(p.DisplayName.TrimStart()[0]).ToString()
                        : string.Empty;
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span class="d-flex align-items-center gap-2">
                            <span class="d-inline-flex align-items-center">
                                <img class="avatar" src="/profile/avatar/@p.SubjectId" alt=""
                                     data-avatar-fallback>
                                <span class="avatar-mono" style="display:none;">@avatarInitial</span>
                            </span>
                            <span>
                                <a href="@Url.Action("Detail", "Directory", new { subjectId = p.SubjectId })">@p.DisplayName</a>
                                @if (!string.IsNullOrEmpty(p.Address))
                                {
                                    <span class="text-muted small"> · @p.Address</span>
                                }
                            </span>
                        </span>
                        <span>
                            @if (p.Verified)
                            {
                                <span class="badge text-bg-success">Verified</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        }
    </div>
</div>
