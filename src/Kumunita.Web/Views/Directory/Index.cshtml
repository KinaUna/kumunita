@model Kumunita.Web.Models.DirectoryViewModel
@{
    ViewData["Title"] = "Directory";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <h1>Directory</h1>
        <p class="text-muted">Everyone in the neighborhood — every resident on the platform.</p>

        @if (Model.Profiles.Count == 0)
        {
            <div class="alert alert-info">
                No residents on this neighborhood yet.
            </div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var p in Model.Profiles)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span>@p.DisplayName</span>
                        <span>
                            @if (p.Verified)
                            {
                                <span class="badge text-bg-success">Verified</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        }
    </div>
</div>
