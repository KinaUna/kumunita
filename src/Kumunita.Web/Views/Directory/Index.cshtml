@model Kumunita.Web.Models.DirectoryViewModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Kumunita.Core.SurfaceLabels.ISurfaceLabelsService SurfaceLabels
@{
    ViewData["Title"] = "Directory";

    // M29 (ADR 0152) — the surface header label (M29·1: the same value the nav
    // item resolves — one resolver, one value, so a rename is never "nav says
    // X, header says Y"). A non-blank admin label wins; otherwise the
    // nav.directory kw-l key resolves in the viewer's effective language.
    // Best-effort: GetLabelAsync never throws (a missing row / store degrades to
    // the kw-l floor), so a null/absent service only degrades to the raw kw-l
    // floor.
    string _surfaceTitle = "Directory";
    if (SurfaceLabels is not null)
    {
        try
        {
            string surfaceLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
            _surfaceTitle = await SurfaceLabels.GetLabelAsync("directory", "nav.directory", surfaceLang);
        }
        catch
        {
            // A resolution failure must never blank the header (the kw-l floor).
        }
    }

    // The search form's aria-label — a value-free a11y attribute, so it is
    // resolved through the ITranslationProvider chain (the a11y.* exclusion in
    // this codebase: the kw-l TagHelper can't wrap an attribute). Best-effort:
    // a null/absent service degrades to the English floor.
    string _searchLabel = "Search residents";
    if (Translation is not null)
    {
        try
        {
            string a11yLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
            _searchLabel = await Translation.GetAsync("a11y.find_directory", a11yLang);
        }
        catch
        {
            // A resolution failure must never blank the a11y label (the floor).
        }
    }
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <header class="airy-head">
            <div class="head-row">
                <div>
                    <h1>@_surfaceTitle</h1>
                    <p class="lede"><kw-l key="directory.lead">Everyone in the neighborhood — every resident on the platform.</kw-l></p>
                </div>
            </div>
        </header>

        @* The viewer's own narrowing: a name search (q) + a verified-only
           toggle (verified). Both are presentation filters over the already-
           catalogued rows (the find-people "organizer, never a gate" posture) —
           no CanAsync, no audit. The form GETs /directory so the active state
           rides the URL (?q=&verified=), the _Sort partial carries it on sort
           flips, and the "clear" link drops it. *@
        <form method="get" action="/directory" class="d-flex flex-wrap align-items-end gap-2 mb-2"
              role="search" aria-label="@_searchLabel">
            @* min-w-0 (the Event/Detail + BoardDetail flex idiom): without it the
               flex-grow-1 item's min-width:auto keeps the search input from
               shrinking below its content width, so it overflows and slides
               under the verified switch. min-w-0 lets it shrink to fit the
               remaining row space. *@
            <div class="flex-grow-1 min-w-0">
                <label class="form-label small mb-1" for="directory-search">
                    <kw-l key="directory.search">Search</kw-l>
                </label>
                <input class="form-control" type="search" name="q" id="directory-search"
                       value="@Model.Query" placeholder="a name in the neighborhood…"
                       autocomplete="off" />
            </div>
            @* Do NOT add ps-0 here: Bootstrap's .form-switch puts the track in a
               left padding gutter (input margin-left:-2.5em offset by the
               container's padding-left:2.5em). Stripping that padding with ps-0
               leaves the -2.5em margin uncompensated, so the track slides under
               the search input. Keep the gutter; align-items-end + mb-2 handle
               the vertical offset against the taller search field. *@
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" role="switch" name="verified"
                       id="directory-verified" value="true" @(Model.VerifiedOnly ? "checked" : null) />
                <label class="form-check-label" for="directory-verified">
                    <kw-l key="directory.verified_only">Verified only</kw-l>
                </label>
            </div>
            @* The submit button makes both controls immediately actionable
               (the verified toggle applies on click, the search on click or
               Enter — the FindPeople explicit-submit pattern; no inline JS,
               SECURITY.md §6). *@
            <button type="submit" class="btn btn-sm btn-outline-primary">
                <kw-l key="directory.search">Search</kw-l>
            </button>
            @* The "clear" link only appears when a filter is active; it drops
               q/verified and any sort, returning to the full catalog. *@
            @if (Model.Query is not null || Model.VerifiedOnly)
            {
                <a class="btn btn-sm btn-outline-secondary" href="/directory">
                    <kw-l key="directory.clear">Clear</kw-l>
                </a>
            }
        </form>

        @* The shared sort control (the _Sort partial, the FindPeople/Posts
           reference reused): one closed key — name → DisplayName, asc. It sits
           at the TOP of the list so the sort options are the first thing the
           viewer sees; it renders nothing when the VM field is null. *@
        @if (Model.Sort is not null)
        {
            <partial name="_Sort" model="Model.Sort" />
        }

        @if (Model.Profiles.Count == 0)
        {
            @* Two distinct empty shapes: no residents on the platform at all
               (directory.empty) vs. residents exist but the viewer's search or
               verified toggle narrowed them to zero (directory.no_results). *@
            <div class="alert alert-info">
                @if (Model.HasAnyResidents)
                {
                    <kw-l key="directory.no_results">No residents match your search.</kw-l>
                }
                else
                {
                    <kw-l key="directory.empty">No residents on this neighborhood yet.</kw-l>
                }
            </div>
        }
        else
        {
            @* Cards (variant C): the "bigger avatars" overview. The card is
               the row's identity — avatar first, then name, address, and the
               Verified badge on its own line. The .avatar-lg sizing comes
               from site.css (U8) — the same endpoint + fallback pattern the
               list version used, just a larger target. *@
            <div class="dir-cards">
                @foreach (var p in Model.Profiles)
                {
                    @*
                      U8 of the media feature: the per-resident avatar. The
                      <img> src is always U7's serving endpoint (GET
                      /profile/avatar/{subjectId}, C-MED·3 — never a static
                      path; the gate + audit run on the endpoint, not on the
                      <img>). The card's own SubjectId is the subject — the
                      frozen VisibleProfile already carries it. The endpoint
                      fails closed to 404 (no avatar set, a denied audience
                      or a blocked profile — FACES M3–M5), so on load error
                      the monogram sibling takes over (no broken-image icon).
                    *@
                    string avatarInitial = !string.IsNullOrWhiteSpace(p.DisplayName)
                        ? char.ToUpperInvariant(p.DisplayName.TrimStart()[0]).ToString()
                        : string.Empty;
                    <div class="dir-card">
                        <span class="d-inline-flex align-items-center justify-content-center">
                            <kw-avatar subject="@p.SubjectId" mono="@avatarInitial" size="lg" mono-hue="@AvatarHue.For(p.SubjectId)" />
                        </span>
                        <span class="dname">
                            <a href="@Url.Action("Detail", "Directory", new { subjectId = p.SubjectId })">@p.DisplayName</a>
                            @if (p.Verified)
                            {
                                <span class="kmb-chip kmb-chip-verified"><span aria-hidden="true">&#10003;</span> <kw-l key="directory.detail_verified">Verified</kw-l></span>
                            }
                        </span>
                        @if (!string.IsNullOrEmpty(p.Address))
                        {
                            <span class="daddr">@p.Address</span>
                        }
                        @* M9 amendment (ADR 0139) — "Send a message", pinned to the card
                           bottom (ADR 0197) so cards with and without it keep equal height.
                           Rendered only when p.CanMessage; same POST seam as before. *@
                        @if (p.CanMessage)
                        {
                            <form method="post" action="/messages/open" class="dir-msg-form m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="otherId" value="@p.SubjectId" />
                                <button type="submit" class="btn btn-sm btn-outline-primary dir-msg-btn">
                                    <kw-l key="directory.send_message">Send a message</kw-l>
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>

            @* Whole-card click→nav is handled by client/lib/directory-card.js
               (loaded in _Layout.cshtml — SECURITY.md §6 no-inline-script). *@
        }
    </div>
</div>
