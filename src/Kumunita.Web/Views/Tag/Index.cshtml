@model Kumunita.Web.Models.TagListViewModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Kumunita.Core.SurfaceLabels.ISurfaceLabelsService SurfaceLabels
@{
    ViewData["Title"] = "Tags";

    // M29 (ADR 0152) — the surface header label (M29·1: the same value the nav
    // item resolves — one resolver, one value, so a rename is never "nav says
    // X, header says Y"). A non-blank admin label wins; otherwise the nav.tags
    // kw-l key resolves in the viewer's effective language. Best-effort:
    // GetLabelAsync never throws (a missing row / store degrades to the kw-l
    // floor), so a null/absent service only degrades to the raw kw-l floor.
    string _surfaceTitle = "Tags";
    if (SurfaceLabels is not null)
    {
        try
        {
            string surfaceLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
            _surfaceTitle = await SurfaceLabels.GetLabelAsync("tags", "nav.tags", surfaceLang);
        }
        catch
        {
            // A resolution failure must never blank the header (the kw-l floor).
        }
    }
}

<div class="row justify-content-center">
    <div class="col-md-12 col-lg-12">
        <h1>@_surfaceTitle</h1>
        <p class="text-muted">
            <kw-l key="tags.list.lede">Subjects your posts and blog pages are tagged with — click one to browse what's been posted about it.</kw-l>
        </p>

        @if (Model.Tags.Count == 0)
        {
            @* R29 (IMPROVE-UX) — the house .kmb-empty idiom; the next action
               is the feed (tags are born when a resident tags a post/page). *@
            <div class="kmb-empty">
                <p class="kmb-empty-title"><kw-l key="tags.list.empty_title">No tags yet.</kw-l></p>
                <p class="kmb-empty-body">
                    <kw-l key="tags.list.empty">No tags yet — tags appear here once a resident attaches one to a post or a blog page.</kw-l>
                </p>
                <a class="btn btn-outline-secondary" href="/community"><kw-l key="about.cta_feed">See the feed</kw-l></a>
            </div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var item in Model.Tags)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
                        <a class="fw-semibold text-decoration-none" href="@($"/tags/{item.Tag.Slug}")">@item.DisplayedName</a>
                        <span class="text-muted small text-nowrap">@item.UseCount</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>
