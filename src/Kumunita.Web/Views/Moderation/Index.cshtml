@using Kumunita.Web.Models
@model ModerationQueueViewModel
@{
    ViewData["Title"] = "Moderation";
}

<h1><kw-l key="moderation.title">Moderation</kw-l></h1>

<p class="text-muted">
    @Model.TotalCount report(s) — @Model.ByStatus.GetValueOrDefault("filed", 0) filed,
    @Model.ByStatus.GetValueOrDefault("assigned", 0) assigned,
    @Model.ByStatus.GetValueOrDefault("unlocked", 0) unlocked,
    @Model.ByStatus.GetValueOrDefault("resolved", 0) resolved.
</p>

@if (Model.TotalCount == 0)
{
    <div class="alert alert-secondary">
        <kw-l key="moderation.empty">No reports yet. The queue is empty.</kw-l>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th><kw-l key="moderation.th_status">Status</kw-l></th>
                    <th><kw-l key="moderation.th_post">Post</kw-l></th>
                    <th><kw-l key="moderation.th_component">Component</kw-l></th>
                    <th><kw-l key="moderation.th_reporter">Reporter</kw-l></th>
                    <th><kw-l key="moderation.th_filed">Filed</kw-l></th>
                    <th class="text-end"><kw-l key="moderation.th_action">Action</kw-l></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reports)
                {
                    <tr>
                        <td>
                            @* The §2.3 item-2 four Status literals: filed /
                               assigned / unlocked / resolved — each gets a
                               distinct Bootstrap badge (no new literal
                               introduced, per C-M3b·1 / §2.3 item 3).*@
                            <span class="badge text-bg-secondary">@r.Status</span>
                        </td>
                        <td>
                            <div class="fw-semibold">@(r.PostTitle ?? $"Post {r.PostId}")</div>
                            @* ADR 0023 — the reply-report-target lane: when the
                               report targets a specific reply, show the
                               "reply by X" line under the post title. The
                               UGC author name renders as-is (M·3); only the
                               "reply by" platform label is translated. *@
                            @if (r.ReplyId is not null)
                            {
                                <div class="text-muted small">
                                    <kw-l key="moderation.queue_reply_by">reply by</kw-l>
                                    @(r.ReplyAuthorName ?? "—")
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(r.Reason))
                            {
                                <div class="text-muted small">@r.Reason</div>
                            }
                        </td>
                        <td>
                            @(r.ComponentName ?? "—")
                        </td>
                        <td>
                            @(r.ReporterName ?? $"Resident {r.PostId[..Math.Min(8, r.PostId.Length)]}…")
                        </td>
                        <td>
                            <kw-dt dt="@r.At" format="g"></kw-dt>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary" href="/moderation/@r.Id">
                                <kw-l key="moderation.review">Review →</kw-l>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
