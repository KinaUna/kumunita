@using Kumunita.Web.Models
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    ViewData["Title"] = $"Moderation: report {Model.ReportId[..Math.Min(8, Model.ReportId.Length)]}…";

    // IMPROVE-UX R04 — the resolve-note placeholder (the Document/Index.cshtml
    // idiom: resolved via the effective language, the en registry floor is
    // the backstop; <kw-l> cannot be placed inside a quoted attribute —
    // the Razor trap the ADR 0285 comment in Admin/Escalation names).
    var _kwL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    var notePlaceholder = Translation is null
        ? Kumunita.Core.Localization.KnownTranslationKeys.EnValues["moderation.resolve_note_placeholder"]
        : await Translation.GetAsync("moderation.resolve_note_placeholder", _kwL);
}

<h1><kw-l key="moderation.resolve_title">Moderation — Review report</kw-l></h1>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><kw-l key="moderation.details">Report details</kw-l></span>
        <span class="badge text-bg-secondary">@Model.Status</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            @* ADR 0173 — the report-targets lane: when the report's target
               is one of the new surfaces (Model.TargetKind non-null), show
               the target's kind + title + author in place of the original
               post / post-author shape (the PostTitle / PostAuthorName
               fields are still populated by the controller for the new
               shapes — the Target* fields carry the identity). *@
            <dt class="col-sm-3"><kw-l key="moderation.th_post_label">Post</kw-l></dt>
            <dd class="col-sm-9">
                @if (Model.TargetKind is not null)
                {
                    <span class="badge text-bg-light border me-2">@Model.TargetKind</span>
                    @(Model.TargetTitle ?? Model.TargetId)
                }
                else
                {
                    @(Model.PostTitle ?? Model.PostId)
                }
            </dd>

            <dt class="col-sm-3"><kw-l key="moderation.th_component_label">Component</kw-l></dt>
            <dd class="col-sm-9">@(Model.ComponentName ?? "—")</dd>

            <dt class="col-sm-3"><kw-l key="moderation.th_reporter_label">Reporter</kw-l></dt>
            <dd class="col-sm-9">@(Model.ReporterName ?? "—")</dd>

            <dt class="col-sm-3"><kw-l key="moderation.th_author_label">Post author</kw-l></dt>
            <dd class="col-sm-9">
                @(Model.TargetKind is not null ? (Model.TargetAuthorName ?? "—") : (Model.PostAuthorName ?? "—"))
            </dd>

            <dt class="col-sm-3"><kw-l key="moderation.th_filed_label">Filed</kw-l></dt>
            <dd class="col-sm-9"><kw-dt dt="@Model.At" format="g"></kw-dt></dd>

            <dt class="col-sm-3"><kw-l key="moderation.th_reason_label">Reason</kw-l></dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrEmpty(Model.Reason))
                {
                    <kw-l key="moderation.no_reason">(no reason given)</kw-l>
                }
                else
                {
                    @Model.Reason
                }
            </dd>

            @* The body preview — for the original post / grouppost shapes
               it is the post body; for the new surfaces (event / project /
               board) it is the target's description (the controller's
               PostBody field carries the same value, the ADR 0173 lane's
               shared shape). The todo surface has no body field — the
               block is omitted (Model.PostBody is null). *@
            @if (!string.IsNullOrEmpty(Model.PostBody))
            {
                string bodyLabel = Model.TargetKind is not null
                    ? (Model.TargetKind + " body")
                    : "Post body";
                string bodyPreview = Model.TargetKind is not null
                    ? (Model.TargetKind + " preview")
                    : "post preview";
                <dt class="col-sm-3">@bodyLabel</dt>
                <dd class="col-sm-9">
                    <blockquote class="blockquote mb-0">
                        <div>@Model.PostBody</div>
                        <footer class="blockquote-footer">@bodyPreview</footer>
                    </blockquote>
                </dd>
            }

            @* ADR 0023 — the reply-report-target lane: when this report's
               target is a specific reply (Model.ReplyId non-null), show the
               reply's body as a blockquote preview under the post body. The
               UGC body / author name render as-is (M·3); only the platform
               labels around them are translated. A null ReplyId (the
               original M3b post-target shape) omits this block entirely. *@
            @if (Model.ReplyId is not null && !string.IsNullOrEmpty(Model.ReplyBody))
            {
                <dt class="col-sm-3"><kw-l key="moderation.resolve_reply_label">Reply (target of this report)</kw-l></dt>
                <dd class="col-sm-9">
                    <blockquote class="blockquote mb-0">
                        <div>@Model.ReplyBody</div>
                        <footer class="blockquote-footer">
                            <kw-l key="moderation.resolve_reply_by">Reply by</kw-l>
                            @(Model.ReplyAuthorName ?? "—")
                        </footer>
                    </blockquote>
                </dd>
            }
        </dl>
    </div>
</div>

@* ── The three forms — assign / unlock / resolve ────────────────────
    Each is a POST /moderation/{id}/{action} form (the U7 route
    shape; the design-doc line-91–98 surface list used the
    `POST /moderation/reports/{assign|unlock|resolve}` naming —
    the U7 plan's U7 body line 254–257 shape `{id}/{action}` is
    what U7 ships, the more RESTful shape matching M2/M3's thin-
    controller precedent; the design-doc's `reports/` is a
    shorthand for "the three GlobalAdmin-gated write actions on
    a report" and is not a route-position pin).

    The §2.3 item-2 four Status-literal predicates drive which
    forms appear (display-level only):
    - A "filed" report: assignable + unlockable + resolvable.
    - An "assigned" report: unlockable + resolvable.
    - An "unlocked" report: resolvable only.
    - A "resolved" report: none (the report is closed).

    The real SoD / authorization gate is the [Authorize(Roles =
    GlobalAdmin)] attribute on the ModerationController class +
    the Core's CanAsync(..., AccessAction.Moderate, ...) inside
    each U5 method (C3 / ADR 0006-C, "audit-row + no-domain-
    write on denial" — the "audit-row written, domain-write NOT
    executed" shape). *@

@if (Model.IsAssignable)
{
    <div class="card mb-4">
        <div class="card-header"><kw-l key="moderation.assign_header">Assign to a standing moderator</kw-l></div>
        <div class="card-body">
            <form method="post" action="/moderation/@Model.ReportId/assign">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label class="form-label" for="assignedToModeratorId">
                        <kw-l key="moderation.assign_label">Standing moderator on this report's component</kw-l>
                    </label>
                    <select class="form-select" name="assignedToModeratorId" id="assignedToModeratorId" required>
                        <option value="" disabled selected hidden><kw-l key="moderation.assign_pick">Choose a standing moderator …</kw-l></option>
                        @foreach (var m in Model.Moderators)
                        {
                            <option value="@m.SubjectId">@(m.DisplayName ?? m.SubjectId)</option>
                        }
                    </select>
                    @* The §9 "SoD" note: only a standing moderator
                       on this report's component (ModeratorAssignment
                       row on the report's ComponentId) is offered —
                       the Core's AssignReportAsync writes the
                       ModeratorAssignment row with GrantedBy =
                       the acting GlobalAdmin (U5's shape).*@
                </div>
                <button class="btn btn-primary" type="submit"><kw-l key="moderation.assign_submit">Assign</kw-l></button>
                <a href="/moderation" class="btn btn-link ms-2"><kw-l key="moderation.cancel">Cancel</kw-l></a>
            </form>
        </div>
    </div>
}

@if (Model.IsUnlockable)
{
    <div class="card mb-4">
        <div class="card-header">
            <kw-l key="moderation.unlock_header">Unlock (turn on moderation access for this community)</kw-l>
        </div>
        <div class="card-body">
            <p class="text-muted">
                <kw-l key="moderation.unlock_desc">This turns on moderation access for the community this report is about and marks the report unlocked. A moderator can then act on its content. Everything you do here is written to the audit log.</kw-l></p>
            <form method="post" action="/moderation/@Model.ReportId/unlock">
                @Html.AntiForgeryToken()
                <button class="btn btn-warning" type="submit"><kw-l key="moderation.unlock_submit">Unlock</kw-l></button>
                <a href="/moderation" class="btn btn-link ms-2"><kw-l key="moderation.cancel">Cancel</kw-l></a>
            </form>
        </div>
    </div>
}

@if (Model.IsResolvable)
{
    <div class="card mb-4">
        <div class="card-header"><kw-l key="moderation.resolve_header">Resolve (close this report)</kw-l></div>
        <div class="card-body">
            <p class="text-muted">
                <kw-l key="moderation.resolve_desc">This closes the report — it is marked as resolved, which is its final state. Everything you do here is written to the audit log.</kw-l></p>
            <form method="post" action="/moderation/@Model.ReportId/resolve">
                @Html.AntiForgeryToken()

                @* IMPROVE-UX R04 — the optional outcome radio group + note
                   textarea (the R03 seam's (outcome, resolutionNote) pair,
                   wired through the controller to ResolveReportAsync).
                   The <fieldset> wraps the radio group so screen readers
                   announce the group label once (the E15 a11y pin — a
                   programmatic label, not a per-input aria-label); the
                   textarea uses a <label for> with a matching id (the
                   assign form's programmatic-label idiom, ADR 0015 D1).
                   Both are optional — an empty form is the pre-R04 "no
                   outcome recorded" call shape (the controller maps the
                   blank / unrecognized outcome to null, the note to null). *@
                <div class="mb-3">
                    <fieldset>
                        <legend class="col-form-label pt-0">
                            <kw-l key="moderation.resolve_outcome_label">Outcome</kw-l>
                        </legend>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="outcome" id="outcome-NoAction" value="NoAction">
                            <label class="form-check-label" for="outcome-NoAction"><kw-l key="moderation.resolve_outcome_noaction">No action</kw-l></label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="outcome" id="outcome-Hidden" value="Hidden">
                            <label class="form-check-label" for="outcome-Hidden"><kw-l key="moderation.resolve_outcome_hidden">Hide the post</kw-l></label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="outcome" id="outcome-Removed" value="Removed">
                            <label class="form-check-label" for="outcome-Removed"><kw-l key="moderation.resolve_outcome_removed">Remove the post</kw-l></label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="outcome" id="outcome-Other" value="Other">
                            <label class="form-check-label" for="outcome-Other"><kw-l key="moderation.resolve_outcome_other">Other (see note)</kw-l></label>
                        </div>
                    </fieldset>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="resolutionNote">
                        <kw-l key="moderation.resolve_note_label">Note to the reporter (optional)</kw-l>
                    </label>
                    <textarea class="form-control" id="resolutionNote" name="resolutionNote" rows="3" maxlength="500"
                              placeholder="@notePlaceholder"></textarea>
                </div>
                <button class="btn btn-success" type="submit"><kw-l key="moderation.resolve_submit">Resolve</kw-l></button>
                <a href="/moderation" class="btn btn-link ms-2"><kw-l key="moderation.cancel">Cancel</kw-l></a>
            </form>
        </div>
    </div>
}

<div>
    <a href="/moderation" class="btn btn-link"><kw-l key="moderation.back_to_queue">← Back to queue</kw-l></a>
</div>
