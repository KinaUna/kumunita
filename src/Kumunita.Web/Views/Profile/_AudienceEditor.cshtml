@using Kumunita.Web.Models
@model ProfileEditViewModel
@{
    // The parent-model discriminator (the Edit view sets it before each
    // <partial> invocation): "Visibility" or "ContactVisibility". The
    // form field names are "<Name>.Mode" and "<Name>.Grants" — the
    // default complex model binder lands them on
    // ProfileEditViewModel.Visibility / .ContactVisibility on the
    // POST (the U11 "only one _AudienceEditor.cshtml exists" pin).
    string editorName = ViewData["EditorName"] as string ?? "Visibility";
    bool optIn = ViewData["OptIn"] is bool b && b; // only meaningful for ContactVisibility
    var editor = string.Equals(editorName, "Visibility", StringComparison.OrdinalIgnoreCase)
        ? Model.Visibility
        : (optIn ? Model.ContactVisibility : null);

    // Render a "well-formed but unchecked" editor when the saved shape is
    // absent (the bootstrap self-only shape for Visibility, the off shape for
    // an author who hasn't opted into a contact block). The *inputs* are
    // ALWAYS rendered enabled (no HTML `disabled` attribute) — a disabled
    // input is not submitted with the form, so a checkbox-flipped post would
    // lose the mode/grants and `ProfileEditViewModel.IsValid` would reject it
    // (the "checked the opt-in but the editor is still disabled" bug that
    // made the contact-block toggle not stick across edits).
    //
    // The gate's *off* shape — the §2.4 "null ⇒ short-circuit" row — is
    // enforced server-side: when the parent's `OptIn` flag is false, the
    // `ToProfileUpdate` builder emits a null `ContactVisibility` patch field,
    // so a non-null editor shape on this form never becomes a non-null patch.
    // The shape-level `Visibility` gate (non-nullable on the document, ADR
    // 0001-B bootstrap default) always posts a valid shape either way.
    var activeEditor = editor 
        ?? new AudienceEditorModel { Mode = "Any", Grants = string.Empty };

    var modePrefix = editorName + ".Mode";
    var grantsPrefix = editorName + ".Grants";
    string[] modes = { "Any", "All" };

    // Whether the editor *block* should visually dim (the off shape is
    // visually de-emphasised but still editable so the author can opt in from
    // the UI without needing to flip the checkbox first) — this is a CSS
    // class, NOT the HTML `disabled` attribute (a `disabled` attribute would
    // stop the form from posting the inputs and break the round-trip described
    // in the above comment).
    bool visuallyOff = !(editor is not null);
}

<div class="audience-editor card mb-4">
    <div class="card-body">
        <h6 class="card-title" style="font-weight:600;">
            @if (string.Equals(editorName, "Visibility", StringComparison.OrdinalIgnoreCase))
            {
                <text>Visibility — who can see this profile</text>
            }
            else
            {
                <text>Contact visibility — who can see address/email/phone (opt-in)</text>
            }
        </h6>

        @if (visuallyOff && string.Equals(editorName, "ContactVisibility", StringComparison.OrdinalIgnoreCase))
        {
            <p class="text-muted" style="margin-bottom:0;">
                Contact info is hidden for every viewer (the "null ⇒
                short-circuit" shape of §2.4). To change this, check
                "Opt in contact info" above this box.
            </p>
        }

        <div class="@(visuallyOff ? "opacity-75" : null)">
            <div class="form-label mt-2" style="font-weight:600;">Match mode</div>
            @foreach (var m in modes)
            {
                var checkedMark = string.Equals(activeEditor.Mode, m, StringComparison.OrdinalIgnoreCase)
                    ? "checked"
                    : null;
            <div class="form-check" style="margin-left:0.5rem;">
                <input class="form-check-input" type="radio"
                       name="@modePrefix" id="@($"{modePrefix}-{m}")"
                       value="@m" @checkedMark />
                <label class="form-check-label" for="@($"{modePrefix}-{m}")">
                    @m @(" — " + (m == "Any"
                        ? "any matching grant is enough"
                        : "every matching grant must apply (an empty grant list with \"All\" denies everyone, per C1)"))
                </label>
            </div>
            }

            <label class="form-label mt-3" for="@grantsPrefix" style="font-weight:600;">
                Grants
            </label>
            @* The grants textarea: a JSON array of
                {"Kind":"User"|"Group","Id":"<id>"}. The U11 single-source
                pin: the <c>BuildAudience</c> deserializer on
                AudienceEditorModel is the only deserialization site; this
                textarea is the only serialization site (the controller's
                ToEditorModel, the dual on the GET). The JSON shape is the
                transport, not a second audience object — the <c>Audience</c>
                document is the only audience the M1 write seam receives
                (F13). *@
            <textarea class="form-control font-monospace"
                      name="@grantsPrefix" id="@grantsPrefix" rows="3"
                      placeholder='[{"Kind":"User","Id":"&lt;subject-id&gt;"}] — or leave empty for "no one"'
                      >@(activeEditor.Grants ?? string.Empty)</textarea>

            @if (string.Equals(editorName, "ContactVisibility", StringComparison.OrdinalIgnoreCase))
            {
                @* The empty-audience warning is meaningful only when the author has
                   actually opted in AND the grant list is empty — an opt-out with
                   an empty editor is the §2.4 short-circuit row, not a mis-set gate. *@
                @if (optIn && activeEditor.IsEmpty)
                {
                    <div class="alert alert-warning mt-2 mb-0">
                        <b>Empty audience.</b>
                        @if (activeEditor.Mode is "All")
                        {
                            <text>With <b>All</b> mode + an empty grant list, <b>zero
                            grants must all apply</b> — vacuously <b>no one
                            matches</b>, so this denies everyone (C1's "empty
                            audience denies" invariant).</text>
                        }
                        else
                        {
                            <text>With <b>Any</b> mode + an empty grant list, <b>no
                            grant matches</b>, so this denies everyone (C1's "empty
                            audience denies" invariant).</text>
                        }
                    </div>
                }
            }
        </div>

        <small class="text-muted d-block mt-2">
            The grants are bound as a JSON array of
            <code>{ "Kind": "User" | "Group", "Id": "&lt;id&gt;" }</code>
            elements — the <c>AudienceEditorModel.BuildAudience</c>
            single-source deserializer (the F13 single-write pin: the
            <c>Audience</c> document field is the <b>only</b> audience the
            <c>UpsertProfileAsync</c> patch ever receives).
        </small>
    </div>
</div>
