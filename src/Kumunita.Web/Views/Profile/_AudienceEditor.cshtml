@using Kumunita.Core.Authorization
@using Kumunita.Web.Models
@model ProfileEditViewModel
@{
    // The parent-model discriminator (the Edit view sets it before each
    // <partial> invocation): "Visibility" or "ContactVisibility". The
    // form field names are "<Name>.Mode" and "<Name>.Grants" — the
    // default complex model binder lands them on
    // ProfileEditViewModel.Visibility / .ContactVisibility on the
    // POST (the U11 "only one _AudienceEditor.cshtml exists" pin).
    string editorName = ViewData["EditorName"] as string ?? "Visibility";
    bool optIn = ViewData["OptIn"] is bool b && b; // only meaningful for ContactVisibility
    var editor = string.Equals(editorName, "Visibility", StringComparison.OrdinalIgnoreCase)
        ? Model.Visibility
        : (optIn ? Model.ContactVisibility : null);

    // Render a "well-formed but unchecked" editor when the saved shape is
    // absent (the bootstrap self-only shape for Visibility, the off shape for
    // an author who hasn't opted into a contact block). The *inputs* are
    // ALWAYS rendered enabled (no HTML `disabled` attribute) — a disabled
    // input is not submitted with the form, so a checkbox-flipped post would
    // lose the mode/grants and `ProfileEditViewModel.IsValid` would reject it
    // (the "checked the opt-in but the editor is still disabled" bug that
    // made the contact-block toggle not stick across edits).
    //
    // The gate's *off* shape — the §2.4 "null ⇒ short-circuit" row — is
    // enforced server-side: when the parent's `OptIn` flag is false, the
    // `ToProfileUpdate` builder emits a null `ContactVisibility` patch field,
    // so a non-null editor shape on this form never becomes a non-null patch.
    // The shape-level `Visibility` gate (non-nullable on the document, ADR
    // 0001-B bootstrap default) always posts a valid shape either way.
    var activeEditor = editor 
        ?? new AudienceEditorModel { Mode = "Any", Grants = string.Empty };

    var modePrefix = editorName + ".Mode";
    var grantsPrefix = editorName + ".Grants";
    string[] modes = { "Any", "All" };

    // Whether the editor *block* should visually dim (the off shape is
    // visually de-emphasised but still editable so the author can opt in from
    // the UI without needing to flip the checkbox first) — this is a CSS
    // class, NOT the HTML `disabled` attribute (a `disabled` attribute would
    // stop the form from posting the inputs and break the round-trip described
    // in the above comment).
    bool visuallyOff = !(editor is not null);
}

<div class="audience-editor card mb-4">
    <div class="card-body">
        <h6 class="card-title" style="font-weight:600;">
            @if (string.Equals(editorName, "Visibility", StringComparison.OrdinalIgnoreCase))
            {
                <text>Who can see your profile</text>
            }
            else
            {
                <text>Who can see your contact details</text>
            }
        </h6>

        @if (visuallyOff && string.Equals(editorName, "ContactVisibility", StringComparison.OrdinalIgnoreCase))
        {
            <p class="text-muted" style="margin-bottom:0;">
                Your contact details are currently hidden from everyone.
                To change this, switch on “Share my contact info” above.
            </p>
        }

        <div class="@(visuallyOff ? "opacity-75" : null)">
            <div class="form-label mt-2" style="font-weight:600;">Match mode</div>
            @foreach (var m in modes)
            {
                var checkedMark = string.Equals(activeEditor.Mode, m, StringComparison.OrdinalIgnoreCase)
                    ? "checked"
                    : null;
            <div class="form-check" style="margin-left:0.5rem;">
                <input class="form-check-input" type="radio"
                       name="@modePrefix" id="@($"{modePrefix}-{m}")"
                       value="@m" @checkedMark />
                <label class="form-check-label" for="@($"{modePrefix}-{m}")">
                    @m @(" — " + (m == "Any"
                        ? "a person is allowed if they meet <i>any</i> of the people/groups you picked"
                        : "a person is allowed only if they meet <i>all</i> of the people/groups you picked"))
                </label>
            </div>
            }

            @* The grant pickers — the user-friendly UX layer over the
               frozen <c>Grants</c> JSON transport. Two checkbox-list sections
               (one for users, one for groups) are rendered from
               the option lists the controller seeds on <c>ViewBag</c>
               ("&lt;EditorName&gt;_Users" / "&lt;EditorName&gt;_Groups").
               These are read-only view data — they are NOT model properties
               on <c>ProfileEditViewModel</c> (the U11 "exactly six form
               fields" shape-pin test forbids a new writable surface; the
               <c>Grants</c> JSON string is the only form-bound grant
               field).

               A small script in @section Scripts below syncs the user's
               selection back into the hidden textarea — which is the only
               form-bound element the default model binder lands on, the
               U11 / F13 single-source pin. The hidden textarea posts as
               <Name>.Grants; the checkboxes themselves have no name= and are
               display-only. When JS is unavailable the checkboxes are inert
               but the textarea remains (hidden) — the e2e spec still
               finds it via its textarea selector pin.

               Each section also gets a "Select all" shortcut checkbox; its
               tri-state (checked / unchecked / indeterminate) is managed by
               the same client-side script. *@
            @{
                var bagKey = string.Equals(editorName, "Visibility", StringComparison.OrdinalIgnoreCase)
                             ? "Visibility" : "ContactVisibility";
                // Read from the statically-typed ViewDataDictionary (the
                // channel the controller's SeedGrantPickerOptionsAsync wrote
                // into), not ViewBag — the bag's indexer goes through
                // dynamic binding and throws RuntimeBinderException.
                var vd = ViewContext.ViewData;
                var userOpts  = (vd[bagKey + "_Users"]  as List<GrantOption>)
                                ?? new List<GrantOption>();
                var groupOpts = (vd[bagKey + "_Groups"] as List<GrantOption>)
                                ?? new List<GrantOption>();

                var usersSelected = activeEditor.ParsedGrants
                    .Where(g => g.Kind == GrantKind.User)
                    .Select(g => g.Id)
                    .ToHashSet(StringComparer.Ordinal);
                var groupsSelected = activeEditor.ParsedGrants
                    .Where(g => g.Kind == GrantKind.Group)
                    .Select(g => g.Id)
                    .ToHashSet(StringComparer.Ordinal);

                var userCount  = userOpts.Count;
                var groupCount = groupOpts.Count;

                // Renders one checkbox-list section (a "select all" shortcut
                // row + one form-check per option). Checkboxes are display-
                // only (no name=) — the hidden Grants textarea is still the
                // only form-bound grant field (the U11 / F13 single-source
                // pin); the Edit.cshtml script keeps them in two-way sync.
                string renderGrantCheckboxSection(string kind, List<GrantOption> opts,
                    HashSet<string> selected, string groupLabel)
                {
                    var sb = new System.Text.StringBuilder();
                    string sectionId = editorName + "-grants-" + kind.ToLowerInvariant();
                    string allId = sectionId + "-all";
                    sb.Append(
                        "<div class=\"kw-grant-section\" data-editor=\"" + Html.Encode(editorName) + "\"" +
                        " data-kind=\"" + kind + "\">" +
                        "<div class=\"form-check ms-1\" style=\"margin-bottom:0.25rem;\">" +
                        "<input class=\"form-check-input kw-grant-all\" type=\"checkbox\" id=\"" + allId + "\"" +
                        " aria-label=\"Select all " + groupLabel.ToLowerInvariant() + "\" />" +
                        "<label class=\"form-check-label small fw-semibold\" for=\"" + allId + "\">" +
                        "Select all " + Html.Encode(groupLabel) + "</label>" +
                        "</div>" +
                        "<div class=\"kw-grant-boxes ms-1\" style=\"max-height:14rem;overflow:auto;\">");
                    foreach (var o in opts)
                    {
                        string boxId = sectionId + "-" + o.Id;
                        sb.Append(
                            "<div class=\"form-check\">" +
                            "<input class=\"form-check-input kw-grant-check\" type=\"checkbox\"" +
                            " id=\"" + boxId + "\" value=\"" + Html.Encode(o.Id) + "\"" +
                            " data-kind=\"" + kind + "\"" +
                            (selected.Contains(o.Id) ? " checked" : "") +
                            " aria-label=\"" + Html.Encode(o.Label) + "\" />" +
                            "<label class=\"form-check-label\" for=\"" + boxId + "\">" +
                            Html.Encode(o.Label) + "</label>" +
                            "</div>");
                    }
                    sb.Append("</div>" +
                            "<small class=\"text-muted ms-1\" data-role=\"grant-count\">" +
                            selected.Count + " of " + opts.Count + " selected</small>" +
                            "</div>");
                    return sb.ToString();
                }
            }

            <div class="form-label mt-3" style="font-weight:600;">
                Who to grant to
            </div>
            <div class="small text-muted" style="margin-left:0.25rem;">
                Check one or many — or use the "Select all" row above each
                list as a shortcut.
            </div>

            @if (userCount > 0)
            {
                <div class="mt-1">
                    @Html.Raw(renderGrantCheckboxSection("User", userOpts, usersSelected, "Residences"))
                </div>
            }
            else
            {
                <p class="mb-1 text-muted small ms-1">
                    You're the only verified resident, so there's no one else
                    to grant to yet.
                </p>
            }

            @if (groupCount > 0)
            {
                <div class="mt-2">
                    @Html.Raw(renderGrantCheckboxSection("Group", groupOpts, groupsSelected, "Groups"))
                </div>
            }
            else
            {
                <p class="mb-1 mt-2 text-muted small ms-1">
                    No groups exist on the platform yet — create one under
                    "Groups" to add group-scoped visibility.
                </p>
            }

            @* The grants textarea — now hidden (d-none) as the form's
                posting element only. The e2e spec's selector pin
                (textarea[name="Visibility.Grants"]) survives unchanged;
                the script in @section Scripts below keeps its value in
                sync with the pickers' selection as the user toggles
                options, so the posted JSON always reflects their choice.
                The U11 / F13 single-source pin: the <c>BuildAudience</c>
                deserializer on AudienceEditorModel is the only
                deserialization site; this textarea is the only
                serialization site (the controller's ToEditorModel the
                dual on the GET). The JSON shape is the transport, not a
                second audience object — the <c>Audience</c> document is
                the only audience the M1 write seam receives (F13). The
                hidden textarea also remains editable by hand for the no-JS
                fallback path. *@
            <textarea class="d-none"
                      name="@grantsPrefix" id="@grantsPrefix" rows="1"
                      data-editor-name="@editorName">
@(activeEditor.Grants ?? string.Empty)</textarea>

            @if (string.Equals(editorName, "ContactVisibility", StringComparison.OrdinalIgnoreCase))
            {
                @* The empty-audience warning is meaningful only when the author has
                   actually opted in AND the grant list is empty — an opt-out with
                   an empty editor is the §2.4 short-circuit row, not a mis-set gate. *@
                @if (optIn && activeEditor.IsEmpty)
                {
                    <div class="alert alert-warning mt-2 mb-0">
                        <b>Heads up:</b> you haven't picked anyone or any group below,
                        so your contact details are currently hidden from <b>everyone</b>.
                        Add a person or group if you'd like to share them.
                    </div>
                }
            }
        </div>
    </div>
</div>
