@using Kumunita.Web.Models
@model ProfilePreviewViewModel
@{
    ViewData["Title"] = "Preview — how I appear";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <p>
            <a class="text-muted" href="@Url.Action("Edit","Profile")">← Back to the editor</a>
        </p>
        <h1>Preview — how I appear</h1>

        <p class="text-muted">
            Read-only "view as" (the F6 preview pin): the same
            <c>ContactVisibility</c> opt-in decision the directory detail
            uses, with <b>@Model.AsDisplayName</b> standing in as the viewer.
            This <b>does not</b> change anything in the saved profile — the
            preview is a composition read, never a write (M2's scope pin; the
            only write lane is
            <a asp-controller="Profile" asp-action="Edit">the editor</a>).
            <br/>
            <br/>
            The contact-block decision (when an opt-in audience exists) still
            commits its own <c>AccessAudit</c> row (C3, F6's preview pin:
            "a preview is an evaluation, not an exemption") — that's the
            <c>DirectoryService.PreviewAsAsync</c>'s job, not this view
            model's.
        </p>

        @if (Model.ShowContactBlock)
        {
            <div class="alert alert-success">
                <b>Visible.</b> As <b>@Model.AsDisplayName</b>, you would
                see this contact block on the directory detail.
            </div>
            <dl class="row mt-3">
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                }
                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@Model.Phone</dd>
                }
            </dl>
        }
        else
        {
            <div class="alert alert-secondary">
                <b>Contact hidden.</b> As <b>@Model.AsDisplayName</b>, you
                would <b>not</b> see a contact block — either the contact
                opt-in is off (no audience, the §2.4 "null ⇒ not opted in"
                pin) or an existing audience did not allow it. The profile
                itself (name + verified badge) still renders in the
                directory; only the contact block is gated.
            </div>
        }

        <div class="d-flex gap-2 mt-4">
            <a class="btn btn-primary" href="@Url.Action("Edit","Profile")">
                Edit profile
            </a>
        </div>
    </div>
</div>
