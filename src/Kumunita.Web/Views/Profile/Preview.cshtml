@using Kumunita.Web.Models
@using Kumunita.Web.Security
@model ProfilePreviewViewModel
@{
    ViewData["Title"] = "Preview — how I appear";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <p>
            <a class="text-muted" href="@Url.Action("Edit","Profile")"><kw-l key="profile.preview_back">← Back to the editor</kw-l></a>
        </p>
        <h1><kw-l key="profile.preview_title">Preview — how I appear</kw-l></h1>

        @*
          U8 of the media feature: the avatar of the profile being previewed.
          The preview is a composition read of the SIGNED-IN AUTHOR'S own saved
          profile as seen by the ?as= viewer (ProfileController.Preview /
          U5's PreviewAsAsync), so the profile — and its avatar — is always
          the author's (FACES M1's owner row: allowed through the same serving
          endpoint's single CanAsync). The subject is the signed-in principal,
          minted in the view (the repo idiom — Groups/Detail.cshtml), because
          ProfilePreviewViewModel deliberately carries no raw subject id (the
          contact-peek pin). Same fail-closed contract as every other avatar
          <img>: src is U7's GET /profile/avatar/{subjectId} (C-MED·3 — never
          a static path); a 404 (no avatar set) hides the <img> and shows the
          placeholder circle instead (no broken-image icon). This view has no
          display-name channel (the view model is a contact-block projection
          only), so the fallback is the empty-circle shape, not an initial.
        *@
        @{
            string? avatarSubject = KumunitaPrincipal.SubjectId(User);
        }
        @if (!string.IsNullOrEmpty(avatarSubject))
        {
            <div class="d-flex align-items-center gap-3">
                <span class="d-inline-flex align-items-center">
                    <img class="avatar avatar-lg" src="/profile/avatar/@avatarSubject" alt=""
                         data-avatar-fallback>
                    <span class="avatar-mono avatar-lg" style="display:none;"></span>
                </span>
                <span class="text-muted small">
                    <kw-l key="profile.preview_avatar_note">Your avatar, as it appears next to your name in the neighbor directory.</kw-l>
                </span>
            </div>
        }

        <p class="text-muted">
            <kw-l key="profile.preview_readonly_lead">This is a read-only preview. It shows how your profile appears to </kw-l>
            <b>@Model.AsDisplayName</b>
            <kw-l key="profile.preview_readonly_tail"> in the neighbor directory. It doesn't change anything in your saved profile — to make a change, </kw-l>
            <a asp-controller="Profile" asp-action="Edit"><kw-l key="profile.preview_edit_link">edit your profile</kw-l></a>.
        </p>

        @if (Model.ShowContactBlock)
        {
            <div class="alert alert-success">
                <b><kw-l key="profile.preview_visible_badge">Visible.</kw-l></b> As <b>@Model.AsDisplayName</b>, <kw-l key="profile.preview_visible_tail">you would see this contact block in the neighbor directory.</kw-l>
            </div>
            <dl class="row mt-3">
                @if (!string.IsNullOrEmpty(Model.Address))
                {
                    <dt class="col-sm-3"><kw-l key="profile.contact_address">Address</kw-l></dt>
                    <dd class="col-sm-9">@Model.Address</dd>
                }
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <dt class="col-sm-3"><kw-l key="profile.contact_email">Email</kw-l></dt>
                    <dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>
                }
                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <dt class="col-sm-3"><kw-l key="profile.contact_phone">Phone</kw-l></dt>
                    <dd class="col-sm-9">@Model.Phone</dd>
                }
            </dl>
        }
        else
        {
            <div class="alert alert-secondary">
                <b><kw-l key="profile.preview_hidden_badge">Contact hidden.</kw-l></b> As <b>@Model.AsDisplayName</b>, you
                <b><kw-l key="profile.preview_hidden_tail">would not see a contact block. Your name (and verified badge, if you have one) still shows in the directory — only the contact details are hidden.</kw-l></b>
            </div>
        }

        <div class="d-flex gap-2 mt-4">
            <a class="btn btn-primary" href="@Url.Action("Edit","Profile")">
                <kw-l key="profile.edit_profile_btn">Edit profile</kw-l>
            </a>
        </div>
    </div>
</div>
