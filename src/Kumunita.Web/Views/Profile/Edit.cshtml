@using Kumunita.Web.Models
@model ProfileEditViewModel
@{
    ViewData["Title"] = "Edit your profile";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <h1>Your profile</h1>
        <p class="text-muted">
            This is where you decide what other residents can see about you.
            Whatever you choose here is exactly what the neighbor directory
            shows — no surprises.
        </p>

        @if (TempData["info"] is string info)
        {
            <div class="alert alert-success" role="alert">@info</div>
        }

        <form method="post" action="@Url.Action("Edit","Profile")">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <h5 class="mt-4 mb-2" style="font-weight:600;">Your name + email</h5>
            <div class="row g-2">
                <div class="col-sm-6">
                    <label asp-for="DisplayName" class="form-label"></label>
                    <input asp-for="DisplayName" class="form-control" required maxlength="100" />
                    <span asp-validation-for="DisplayName" class="text-danger"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" required type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <h5 class="mt-4 mb-2" style="font-weight:600;">Your address (optional)</h5>
            <div class="row g-2">
                <div class="col-sm-12">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" maxlength="200"
                           placeholder="Street — shown to neighbors when you opt in below" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                    <div class="form-text small">
                        Shown on the directory list and detail only when you've also
                        opted in the contact block below; leave empty to keep your
                        street private to this profile.
                    </div>
                </div>
            </div>

            <h5 class="mt-4 mb-2" style="font-weight:600;">Who can see what</h5>

            @* The two audience editors share ONE partial (the U11 "only one
               _AudienceEditor.cshtml exists" pin). Each invocation is
               discriminated by ViewData["EditorName"] — the partial's form
               fields are named <Name>.Mode + <Name>.Grants, which the
               default complex binder lands on ProfileEditViewModel. *@
            @{
                ViewContext.ViewData["EditorName"] = "Visibility";
                ViewContext.ViewData["OptIn"] = true;
            }
            <partial name="_AudienceEditor" model="Model" />

            @* The §2.4 "null ==> short-circuit" opt-in gate. A checkbox in
               the parent, not a second editor block: unchecked leaves
               ContactVisibility at the "null" shape (the patch emits null),
               checked enables the editor block below. *@
            <div class="form-check form-switch mt-3 mb-3">
                <input class="form-check-input"
                       type="checkbox" id="optin-contact"
                       name="OptInContactVisibility"
                       value="true"
                       @(Model.OptInContactVisibility ? "checked" : null) />
                <label class="form-check-label" for="optin-contact">
                    <b>Share my contact info (address, email, phone)</b>
                    <br/>
                    <span class="text-muted small">
                        Leave this off if you'd rather keep your address,
                        email, and phone completely hidden from the
                        directory. When it's on, you choose <i>who</i> can see
                        it in the box below.
                    </span>
                </label>
            </div>

            @{
                ViewContext.ViewData["EditorName"] = "ContactVisibility";
                ViewContext.ViewData["OptIn"] = Model.OptInContactVisibility;
            }
            <partial name="_AudienceEditor" model="Model" />

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary"
                   href="@Url.Action("Preview","Profile")">
                    Preview — how I appear
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* The grant-picker sync, moved to the shared partial
       <c>Views/Shared/_GrantPickerScripts.cshtml</c> (shared with the
       M3 composer, which renders the same shared picker): keeps the
       hidden textarea (the form-bound Grants JSON — the U11 / F13
       single-source pin) and the two checkbox-list sections (the
       user-friendly UX) in two-way sync. The textarea is the only
       element posted; the pickers are display-only (no name=). *@
    <partial name="_GrantPickerScripts" />
}

