@model Kumunita.Web.Controllers.AdminSignupController.SignupAdminViewModel
@{
    ViewData["Title"] = "Admin — Sign-up";
}

<a href="/admin" class="text-muted small">&larr; <kw-l key="nav.admin">Admin</kw-l></a>

<h1 class="mt-2"><kw-l key="admin.signup_title">Sign-up</kw-l></h1>

<p class="text-muted">
    <kw-l key="admin.signup_lede">Whether new residents may create an account on their own. Closing the gate makes sign-up invitation-only — existing residents are unaffected.</kw-l>
</p>

<form method="post" action="/admin/signup">
    @Html.AntiForgeryToken()
    <div class="row g-2 align-items-end">
        <div class="col-sm-8">
            <label for="isOpen" class="form-label"><kw-l key="admin.signup_title">Sign-up</kw-l></label>
            <select class="form-select" name="isOpen" id="isOpen">
                <option value="True" selected="@(Model.IsOpen ? "selected" : null)"><kw-l key="admin.signup_open">Open — residents can sign up</kw-l></option>
                <option value="False" selected="@(!Model.IsOpen ? "selected" : null)"><kw-l key="admin.signup_invitation_only">Invitation-only — new self-service accounts are gated</kw-l></option>
            </select>
        </div>
        <div class="col-sm-4">
            <button type="submit" class="btn btn-primary"><kw-l key="admin.signup_save">Save</kw-l></button>
        </div>
    </div>
</form>

<hr />

<h2 class="h5 mt-4"><kw-l key="admin.signup_notify_title">Notify admins</kw-l></h2>
<p class="text-muted">
    <kw-l key="admin.signup_notify_lede">When a new resident signs up and when a resident verifies their account, the GlobalAdmins get an inbox notification and a best-effort email. Turning it off silences that — the account lane itself is unaffected.</kw-l>
</p>

<form method="post" action="/admin/signup/notify">
    @Html.AntiForgeryToken()
    <div class="row g-2 align-items-end">
        <div class="col-sm-8">
            <label for="notifyAdmins" class="form-label"><kw-l key="admin.signup_notify_title">Notify admins</kw-l></label>
            <select class="form-select" name="notifyAdmins" id="notifyAdmins">
                <option value="True" selected="@(Model.NotifyAdmins ? "selected" : null)"><kw-l key="admin.signup_notify_on">On — admins are notified of new sign-ups and verifications</kw-l></option>
                <option value="False" selected="@(!Model.NotifyAdmins ? "selected" : null)"><kw-l key="admin.signup_notify_off">Off — no admin notifications on sign-up / verification</kw-l></option>
            </select>
        </div>
        <div class="col-sm-4">
            <button type="submit" class="btn btn-primary"><kw-l key="admin.signup_save">Save</kw-l></button>
        </div>
    </div>
</form>
