@model Kumunita.Web.Models.MembershipEditorModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Manage a child account";
    // The messaging allow / restrict + hand-over forms' data-confirms (the ADR
    // 0072 attribute idiom — resolved through the provider; the kw-l TagHelper
    // can't wrap an attribute). The en floor is the server fallback (a null
    // provider, a non-HTTP render, degrades to en).
    string confirmAllow    = "Allow messaging for this child? They will be able to send and receive direct messages (their own opt-in must also be on).";
    string confirmRestrict = "Restrict messaging for this child? They will no longer be able to send or receive direct messages, regardless of their own opt-in.";
    string confirmHandover = "Hand over this account to the child? This dissolves your guardianship over it.";
    string confirmRemoveMyself = "Remove yourself as this child's guardian? You will no longer be able to manage their account. They keep their account, and their other guardian(s) continue.";
    string confirmDeleteChild = "Delete this child account permanently? This removes their sign-in, profile, and memberships, and cannot be undone.";
    if (Translation is not null)
    {
        var effLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
        confirmAllow    = await Translation.GetAsync("guardian.messaging.allow_confirm", effLang);
        confirmRestrict = await Translation.GetAsync("guardian.messaging.restrict_confirm", effLang);
        confirmHandover = await Translation.GetAsync("guardian.handover_confirm", effLang);
        confirmRemoveMyself = await Translation.GetAsync("guardian.remove_myself_confirm", effLang);
        confirmDeleteChild = await Translation.GetAsync("guardian.delete_child_confirm", effLang);
    }
    @*
        The child's per-community block set (the guardian's block-and-hide
        ceiling — Detail's ViewData["BlockedCommunityIds"], the M9
        MessagingRestricted precedent; the MembershipEditorModel is a pinned
        5-field record so the block state rides ViewData). Used by the
        community section's block/unblock toggle.
    *@
    var _blockedCommunities = ((IReadOnlyCollection<string>?)ViewData["BlockedCommunityIds"]) ?? [];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <p><a class="text-muted" href="@Url.Action("Index", "Guardian")">&larr; <kw-l key="guardian.back">Back to your children</kw-l></a></p>

        <h1><kw-l key="guardian.manage_title">Manage a child account</kw-l></h1>
        @*
            The child's identity — name + email (the Detail action's
            ViewData["ChildDisplayName"] / ["ChildEmail"], the M9
            ViewData precedent — the MembershipEditorModel is a pinned
            5-field record). The raw child id only shows when the
            profile has no name (the fail-safe the Index list already
            uses).
        *@
        @{
            var _childName = (string?)ViewData["ChildDisplayName"];
            var _childEmail = (string?)ViewData["ChildEmail"];
        }
        <p class="text-muted">
            <kw-l key="guardian.account_label">Account</kw-l>:
            @if (!string.IsNullOrEmpty(_childName))
            {
                <span>@_childName</span>
                @if (!string.IsNullOrEmpty(_childEmail))
                {
                    <span> (@_childEmail)</span>
                }
            }
            else
            {
                <code>@Model.ChildId</code>
            }
        </p>

        @*
            GU (ADR 0028) — the per-child curation surface. Every section is
            membership ids/names only (G·1 — the child's posts, profile body, or
            any audience-restricted content never appears here, and there is no
            link to them). Groups + communities are curatable (U07 exposed
            POST .../memberships/group and .../memberships/community); the
            guardian's standing + the Via: Guardian audit row are minted in the
            Core seam, not here. The actor is the signed-in principal (the U07
            route), never a form field.
        *@
        <h2><kw-l key="guardian.group_memberships">Group memberships</kw-l></h2>
        @if (Model.GroupIds.Count == 0)
        {
            <p class="text-muted"><kw-l key="guardian.no_groups">No group memberships.</kw-l></p>
        }
        else
        {
            <ul class="list-group mb-2">
                @foreach (var groupId in Model.GroupIds)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
                        <code>@groupId</code>
                        <form method="post" action="@Url.Action("CurateGroup", "Guardian", new { childId = Model.ChildId })">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="groupId" value="@groupId" />
                            <input type="hidden" name="add" value="false" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </li>
                }
            </ul>
        }
        @* No "add a group" form: joining a group is decided by its owner (an
           invitation) or a platform admin — a guardian does not mint group
           membership for their child. The pending-invitations section below is
           the guardian's gate on invitations. *@

        <h2 class="mt-4"><kw-l key="guardian.community_memberships">Community memberships</kw-l></h2>
        @*
            Communities are decided by admins (the mandatory communities are
            implicit for everyone, so there is nothing for a guardian to "add"),
            and — because a mandatory community's membership cannot be removed
            (ADR 0012) — the guardian's control here is to BLOCK ACCESS AND HIDE
            the community from the child, not to remove them from it. Each row
            toggles the child's Profile.BlockedCommunityIds entry (the
            SetChildCommunityBlock lane); a blocked community is hidden from the
            child's directory, feed, posting gate and community posts. The list
            itself is the RAW membership read (Model.CommunityIds) so a mandatory
            community still shows up for the guardian to block.
        *@
        <p class="text-muted"><kw-l key="guardian.community_block_note">Choose which communities this child can access. Blocking a community hides it from them — including its posts — even if it is one of the mandatory communities everyone belongs to. This is the guardian's control: you decide who joins a community by inviting them or through an admin, but you can hide one you don't want this child to see.</kw-l></p>
        @if (Model.CommunityIds.Count == 0)
        {
            <p class="text-muted"><kw-l key="guardian.no_communities">No community memberships.</kw-l></p>
        }
        else
        {
            <ul class="list-group mb-2">
                @foreach (var communityId in Model.CommunityIds)
                {
                    var isBlocked = _blockedCommunities.Contains(communityId, StringComparer.OrdinalIgnoreCase);
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <code>@communityId</code>
                            @if (isBlocked)
                            {
                                <span class="badge text-bg-warning ms-2"><kw-l key="guardian.community_blocked">Blocked &amp; hidden</kw-l></span>
                            }
                        </div>
                        <form method="post" action="@Url.Action("SetChildCommunityBlock", "Guardian", new { childId = Model.ChildId, communityId })">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="blocked" value="@(isBlocked ? "false" : "true")" />
                            @if (isBlocked)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-primary"><kw-l key="guardian.community_unblock">Unblock &amp; show</kw-l></button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger"><kw-l key="guardian.community_block">Block access &amp; hide</kw-l></button>
                            }
                        </form>
                    </li>
                }
            </ul>
        }

        <h2 class="mt-4"><kw-l key="guardian.pending_invitations">Pending group invitations</kw-l></h2>
        @if (Model.PendingInvitations.Count == 0)
        {
            <p class="text-muted"><kw-l key="guardian.no_invitations">No pending invitations.</kw-l></p>
        }
        else
        {
            <ul class="list-group mb-2">
                @foreach (var inv in Model.PendingInvitations)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <strong>@inv.GroupName</strong>
                            <div class="text-muted small">Invited @inv.InvitedAt</div>
                        </div>
                        <div class="d-flex gap-2">
                            <form method="post"
                                  action="@Url.Action("RejectInvitation", "Guardian", new { childId = Model.ChildId, groupId = inv.GroupId })">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    <kw-l key="guardian.reject">Reject</kw-l>
                                </button>
                            </form>
                            <form method="post"
                                  action="@Url.Action("ApproveInvitation", "Guardian", new { childId = Model.ChildId, groupId = inv.GroupId })">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-primary"><kw-l key="guardian.approve">Approve</kw-l></button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }

        @*
            GU community-approval lane (ADR 0141) — the child's pending
            community-membership requests (the supervised-child branch of the
            admin / moderator add-community lanes): one row per pending
            CommunityMembershipRequest, with the approve / reject POSTs (the
            ApproveCommunityMembership / RejectCommunityMembership actions).
            The membership does NOT land until approved (the
            ApproveCommunityMembershipRequestAsync lane writes it — the ADR
            0094 / m2b state-machine shape). G·1 held: ids/names only.
        *@
        <h2 class="mt-4"><kw-l key="guardian.pending_community_requests">Pending community memberships</kw-l></h2>
        @if (Model.PendingCommunityRequests.Count == 0)
        {
            <p class="text-muted"><kw-l key="guardian.no_community_requests">No pending community memberships.</kw-l></p>
        }
        else
        {
            <ul class="list-group mb-2">
                @foreach (var req in Model.PendingCommunityRequests)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
                        <div>
                            <strong>@req.CommunityName</strong>
                            <div class="text-muted small">Requested @req.RequestedAt</div>
                        </div>
                        <div class="d-flex gap-2">
                            <form method="post"
                                  action="@Url.Action("RejectCommunityMembership", "Guardian", new { childId = Model.ChildId, communityId = req.CommunityId })">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    <kw-l key="guardian.reject">Reject</kw-l>
                                </button>
                            </form>
                            <form method="post"
                                  action="@Url.Action("ApproveCommunityMembership", "Guardian", new { childId = Model.ChildId, communityId = req.CommunityId })">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-primary"><kw-l key="guardian.approve">Approve</kw-l></button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }

        @*
            M9 amendment — the guardian's messaging-restriction ceiling over
            the supervised child (the ADR 0028 G·2/G·3 guardian-standing
            shape, the Suspend/Unsuspend idiom verbatim): a single checkbox
            toggle. true = force messaging OFF for the child (a hard ceiling
            that wins over the child's own opt-in); false = allow messaging,
            deferring to the child's own opt-in. The standing gate + the
            audit row are minted in the Core seam (the
            SetChildMessagingRestrictionAsync lane), not here — the Web
            layer resolves the actor (the ActiveLinkAsync check) and
            passes it through. The flag + the child's own opt-in state are
            exposed on ViewData (the MembershipEditorModel is a pinned
            5-field record — the U07 pin forbids adding a field; the repo's
            _AudienceEditor / SeedGrantPickerOptionsAsync precedent for
            non-model view data).
        *@
        @{
            var _messagingRestricted = (bool)(ViewData["MessagingRestricted"] ?? false);
            var _childOptIn = (bool)(ViewData["ChildMessagingOptIn"] ?? false);
        }
        <h2 class="mt-4"><kw-l key="guardian.messaging.title">Messaging</kw-l></h2>
        <p class="text-muted">
            <kw-l key="guardian.messaging.description">Choose whether this child can use direct 1:1 messaging. When restricted, the child cannot send or receive messages and the choice wins over their own opt-in; when allowed, the child decides for themselves on their own messaging settings page.</kw-l>
        </p>

        @* The current state — the child's MessagingRestricted flag (the
           guardian's ceiling) plus, as context, the child's own opt-in
           state (a read; the messaging gate composes all three: instance
           master gate + child's own opt-in + this ceiling). *@
        <div class="alert @(_messagingRestricted ? "alert-warning" : "alert-success") mb-2">
            @if (_messagingRestricted)
            {
                <kw-l key="guardian.messaging.current_restricted">Messaging is currently restricted for this child.</kw-l>
            }
            else
            {
                <kw-l key="guardian.messaging.current_allowed">Messaging is currently allowed for this child.</kw-l>
            }
            @if (_childOptIn)
            {
                <span class="d-block small mt-1"><kw-l key="guardian.messaging.child_optin_on">The child has opted in to messaging on their own account.</kw-l></span>
            }
            else
            {
                <span class="d-block small mt-1"><kw-l key="guardian.messaging.child_optin_off">The child has not opted in to messaging on their own account — even if you allow it, they will need to opt in on their own settings page.</kw-l></span>
            }
        </div>

        @* The toggle — two POSTs (the ADR 0028 Suspend/Unsuspend idiom
           verbatim: two buttons, two routes, two data-confirms; the
           server gate is the SetChildMessaging action's ActiveLinkAsync
           standing check + the Core seam's audit row). *@
        <div class="d-flex gap-2">
            @if (_messagingRestricted)
            {
                <form method="post" action="@Url.Action("SetChildMessaging", "Guardian", new { childId = Model.ChildId })"
                      data-confirm="@confirmAllow">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="restricted" value="false" />
                    <button type="submit" class="btn btn-outline-primary">
                        <kw-l key="guardian.messaging.allow">Allow messaging</kw-l>
                    </button>
                </form>
            }
            else
            {
                <form method="post" action="@Url.Action("SetChildMessaging", "Guardian", new { childId = Model.ChildId })"
                      data-confirm="@confirmRestrict">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="restricted" value="true" />
                    <button type="submit" class="btn btn-outline-danger">
                        <kw-l key="guardian.messaging.restrict">Restrict messaging</kw-l>
                    </button>
                </form>
            }
        </div>

        @* ── The lane — event attendance (the guardian's three postures) ──
           The EventRsvpMode radio group (the SetChildMessaging toggle idiom,
           over a mode instead of a bool) + the mode's live list:
             · GuardianApproves → the child's pending requests (approve/deny)
             · GuardianNotifies → the child's existing RSVPs (veto)
           Exposed on ViewData (the MessagingRestricted precedent — the
           MembershipEditorModel is a pinned record; the U07 pin forbids
           adding a field). *@
        @{
            var _eventRsvpMode = (Kumunita.Core.UserInfo.EventRsvpMode)(ViewData["EventRsvpMode"] ?? Kumunita.Core.UserInfo.EventRsvpMode.GuardianApproves);
            var _pendingRequests = (System.Collections.IEnumerable)(ViewData["PendingEventRsvpRequests"] ?? System.Array.Empty<Kumunita.Web.Models.EventRsvpRequestItem>());
            var _childRsvps = (System.Collections.IEnumerable)(ViewData["ChildEventRsvps"] ?? System.Array.Empty<Kumunita.Web.Models.EventRsvpVetoItem>());
            var _pendingList = _pendingRequests as System.Collections.Generic.IEnumerable<Kumunita.Web.Models.EventRsvpRequestItem>
                ?? System.Array.Empty<Kumunita.Web.Models.EventRsvpRequestItem>();
            var _rsvpList = _childRsvps as System.Collections.Generic.IEnumerable<Kumunita.Web.Models.EventRsvpVetoItem>
                ?? System.Array.Empty<Kumunita.Web.Models.EventRsvpVetoItem>();
            string confirmApprove = "Approve this child's attendance on this event?";
            string confirmDeny = "Deny this child's attendance on this event? They will not be attending.";
            string confirmVeto = "Remove this child's attendance on this event? Their RSVP will be deleted.";
            if (Translation is not null)
            {
                var effLang2 = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
                confirmApprove = await Translation.GetAsync("guardian.eventrsvp.approve_confirm", effLang2);
                confirmDeny   = await Translation.GetAsync("guardian.eventrsvp.deny_confirm", effLang2);
                confirmVeto   = await Translation.GetAsync("guardian.eventrsvp.veto_confirm", effLang2);
            }
        }
        <h2 class="mt-4"><kw-l key="guardian.eventrsvp.title">Event attendance</kw-l></h2>
        <p class="text-muted">
            <kw-l key="guardian.eventrsvp.description">Choose how this child's event attendance is handled. "Guardian approves" means you must approve or deny each one; "Guardian notifies" means the child attends freely and you are told (and can remove it afterwards); "Child decides" means the child decides for themselves.</kw-l>
        </p>

        @* The mode selector — one form + submit button per mode (the
           SetChildMessaging "two forms, two buttons" idiom verbatim, over a
           mode instead of a bool; the server gate is the SetEventRsvpMode
           action's ActiveLinkAsync standing check + the Core seam's audit
           row). The current mode's button is the *active* state — the
           other two are the alternatives the guardian can switch to. *@
        <div class="d-flex flex-column gap-2 mb-3">
            @if (_eventRsvpMode == Kumunita.Core.UserInfo.EventRsvpMode.GuardianApproves)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rsvp-approves-active" checked disabled />
                    <label class="form-check-label" for="rsvp-approves-active"><kw-l key="guardian.eventrsvp.mode_approves_active">Currently: Guardian approves — I approve or deny every event the child wants to attend.</kw-l></label>
                </div>
                <div class="d-flex gap-2">
                    <form method="post" action="@Url.Action("SetEventRsvpMode", "Guardian", new { childId = Model.ChildId })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="mode" value="GuardianNotifies" />
                        <button type="submit" class="btn btn-outline-primary"><kw-l key="guardian.eventrsvp.switch_to_notifies">Switch to Guardian notifies</kw-l></button>
                    </form>
                    <form method="post" action="@Url.Action("SetEventRsvpMode", "Guardian", new { childId = Model.ChildId })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="mode" value="ChildDecides" />
                        <button type="submit" class="btn btn-outline-secondary"><kw-l key="guardian.eventrsvp.switch_to_childdecides">Switch to Child decides</kw-l></button>
                    </form>
                </div>
            }
            else if (_eventRsvpMode == Kumunita.Core.UserInfo.EventRsvpMode.GuardianNotifies)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rsvp-notifies-active" checked disabled />
                    <label class="form-check-label" for="rsvp-notifies-active"><kw-l key="guardian.eventrsvp.mode_notifies_active">Currently: Guardian notifies — the child attends freely; I'm told and can remove any of their attendance afterwards.</kw-l></label>
                </div>
                <div class="d-flex gap-2">
                    <form method="post" action="@Url.Action("SetEventRsvpMode", "Guardian", new { childId = Model.ChildId })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="mode" value="GuardianApproves" />
                        <button type="submit" class="btn btn-outline-primary"><kw-l key="guardian.eventrsvp.switch_to_approves">Switch to Guardian approves</kw-l></button>
                    </form>
                    <form method="post" action="@Url.Action("SetEventRsvpMode", "Guardian", new { childId = Model.ChildId })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="mode" value="ChildDecides" />
                        <button type="submit" class="btn btn-outline-secondary"><kw-l key="guardian.eventrsvp.switch_to_childdecides">Switch to Child decides</kw-l></button>
                    </form>
                </div>
            }
            else
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="rsvp-childdecides-active" checked disabled />
                    <label class="form-check-label" for="rsvp-childdecides-active"><kw-l key="guardian.eventrsvp.mode_childdecides_active">Currently: Child decides — the child chooses their own attendance; no approval and no notification.</kw-l></label>
                </div>
                <div class="d-flex gap-2">
                    <form method="post" action="@Url.Action("SetEventRsvpMode", "Guardian", new { childId = Model.ChildId })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="mode" value="GuardianApproves" />
                        <button type="submit" class="btn btn-outline-primary"><kw-l key="guardian.eventrsvp.switch_to_approves">Switch to Guardian approves</kw-l></button>
                    </form>
                    <form method="post" action="@Url.Action("SetEventRsvpMode", "Guardian", new { childId = Model.ChildId })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="mode" value="GuardianNotifies" />
                        <button type="submit" class="btn btn-outline-primary"><kw-l key="guardian.eventrsvp.switch_to_notifies">Switch to Guardian notifies</kw-l></button>
                    </form>
                </div>
            }
        </div>

        @* The GuardianApproves posture's live list — the child's pending
           event-attendance requests, each with an approve / deny button
           (the ApproveInvitation / RejectInvitation idiom verbatim). *@
        @if (_eventRsvpMode == Kumunita.Core.UserInfo.EventRsvpMode.GuardianApproves)
        {
            <h3 class="h6 mt-3"><kw-l key="guardian.eventrsvp.pending_title">Pending attendance requests</kw-l></h3>
            @if (!_pendingList.Any())
            {
                <p class="text-muted"><kw-l key="guardian.eventrsvp.pending_empty">No pending attendance requests.</kw-l></p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var req in _pendingList)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-semibold"><kw-l key="guardian.eventrsvp.desired">@(req.DesiredStatus.ToString())</kw-l></span>
                                <span class="text-muted small d-block">Requested @req.RequestedAt</span>
                            </div>
                            <div class="d-flex gap-2">
                                <form method="post" action="@Url.Action("ApproveEventRsvp", "Guardian", new { childId = Model.ChildId, eventId = req.EventId })" data-confirm="@confirmApprove">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success"><kw-l key="guardian.eventrsvp.approve">Approve</kw-l></button>
                                </form>
                                <form method="post" action="@Url.Action("DenyEventRsvp", "Guardian", new { childId = Model.ChildId, eventId = req.EventId })" data-confirm="@confirmDeny">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><kw-l key="guardian.eventrsvp.deny">Deny</kw-l></button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            }
        }

        @* The GuardianNotifies posture's live list — the child's existing
           RSVPs, each with a veto button (the MessagingRestricted veto
           shape). *@
        @if (_eventRsvpMode == Kumunita.Core.UserInfo.EventRsvpMode.GuardianNotifies)
        {
            <h3 class="h6 mt-3"><kw-l key="guardian.eventrsvp.rsvps_title">This child's current attendance</kw-l></h3>
            @if (!_rsvpList.Any())
            {
                <p class="text-muted"><kw-l key="guardian.eventrsvp.rsvps_empty">No current attendance to veto.</kw-l></p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var rsvp in _rsvpList)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-semibold"><kw-l key="guardian.eventrsvp.desired">@(rsvp.Status.ToString())</kw-l></span>
                                <span class="text-muted small d-block">Attended @rsvp.At</span>
                            </div>
                            <form method="post" action="@Url.Action("VetoEventRsvp", "Guardian", new { childId = Model.ChildId, eventId = rsvp.EventId })" data-confirm="@confirmVeto">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><kw-l key="guardian.eventrsvp.veto">Remove</kw-l></button>
                            </form>
                        </li>
                    }
                </ul>
            }
        }

        @*
            M28 (ADR 0151 D6) — the "Time limits" section (the GU inverse
            of the M20 quiet lane, the LocaleController.SaveQuiet shape).
            The form is seeded with the current schedule via
            ViewData["TimeLimitsSection"] (the TimeLimitsSection record:
            Enabled / Mode / Hours / DaysOfWeek — the M20 Quiet shape
            re-expressed on the GU surface). A missing/disabled schedule
            renders the floor (C-M28·3): Enabled=false, Mode="blocked",
            Hours=[], DaysOfWeek=[].
            Exposed on ViewData (the MessagingRestricted / EventRsvpMode
            precedent — the MembershipEditorModel is a pinned record; the
            U07 exact-projection pin forbids adding a field).
            Bound to U05's guardian.timelimit.* keys (NOT the M20
            settings.quiet.* keys — those are the notification lane's).
            The save / clear POST is the SaveTimeLimits action (POST
            me/children/{childId}/timelimits); the clear form posts
            clear=1 → null → row delete (the M20 "clear" idiom, C-M28·3).
        *@
        @{
            var _tl = (Kumunita.Web.Models.TimeLimitsSection?)(ViewData["TimeLimitsSection"])
                ?? new Kumunita.Web.Models.TimeLimitsSection(false, "blocked", [], []);
            var _tlHours = _tl.Hours ?? System.Array.Empty<int>();
            var _tlDays  = _tl.DaysOfWeek ?? System.Array.Empty<int>();
        }
        <h2 class="mt-4"><kw-l key="guardian.timelimit.title">Time limits</kw-l></h2>
        <p class="text-muted">
            <kw-l key="guardian.timelimit.description">Choose when your child may use the platform. The schedule is saved on their account, applied in their own time zone — it takes effect on their next sign-in, and never affects you.</kw-l>
        </p>

        <form method="post" action="@Url.Action("SaveTimeLimits", "Guardian", new { childId = Model.ChildId })">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-sm-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" role="switch" id="tlEnabled"
                               name="enabled" value="true"
                               @(_tl.Enabled ? "checked" : null) />
                        <label class="form-check-label" for="tlEnabled">
                            <kw-l key="guardian.timelimit.enabled">Enforce time limits for this child</kw-l>
                        </label>
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-sm-12">
                    <span class="form-label"><kw-l key="guardian.timelimit.mode_label">When may the child use the platform?</kw-l></span>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="tlModeBlocked"
                               name="mode" value="blocked"
                               @(_tl.Mode == "blocked" ? "checked" : null) />
                        <label class="form-check-label" for="tlModeBlocked">
                            <kw-l key="guardian.timelimit.mode_blocked">Blocked during the selected hours &amp; days</kw-l>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="tlModeAllowed"
                               name="mode" value="allowed"
                               @(_tl.Mode == "allowed" ? "checked" : null) />
                        <label class="form-check-label" for="tlModeAllowed">
                            <kw-l key="guardian.timelimit.mode_allowed">Allowed only during the selected hours &amp; days</kw-l>
                        </label>
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-sm-6">
                    <label for="tlHours" class="form-label">
                        <kw-l key="guardian.timelimit.hours_label">Hours of day</kw-l>
                    </label>
                    <select class="form-select" name="hours" id="tlHours" multiple size="6">
                        @for (var h = 0; h < 24; h++)
                        {
                            <option value="@h" selected="@(_tlHours.Contains(h) ? "selected" : null)">@h</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6">
                    <label for="tlDays" class="form-label">
                        <kw-l key="guardian.timelimit.days_label">Days of week</kw-l>
                    </label>
                    <select class="form-select" name="daysOfWeek" id="tlDays" multiple size="7">
                        @for (var d = 0; d < 7; d++)
                        {
                            <option value="@d" selected="@(_tlDays.Contains(d) ? "selected" : null)">@d</option>
                        }
                    </select>
                </div>
            </div>

            <div class="row g-2 mt-3">
                <div class="col-sm-12">
                    <button type="submit" class="btn btn-primary">
                        <kw-l key="guardian.timelimit.save">Save time limits</kw-l>
                    </button>
                </div>
            </div>
        </form>

        @* The clear lane — a separate form posting clear=1; the controller
           maps this to a null schedule (the "never restricted" floor,
           C-M28·3 — the M20 clear idiom). *@
        <form method="post" action="@Url.Action("SaveTimeLimits", "Guardian", new { childId = Model.ChildId })" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="clear" value="1" />
            <button type="submit" class="btn btn-outline-secondary">
                <kw-l key="guardian.timelimit.clear">Clear time limits</kw-l>
            </button>
        </form>

        @*
            Count-aware steering (ADR 0028 §F amendment, 2026-10-05). Both
            lanes below POST to the same Dissolve action — the standing over
            the child ends either way — but they are framed differently
            depending on whether this is the child's sole active guardian or
            a co-guardian:
              • co-guardian (≥2 active guardians): "Remove myself as
                guardian" — the other guardian(s) continue, the child keeps
                their account. The hand-over framing would be misleading
                (nothing is being handed over; the other guardian is still
                there), so it is not shown.
              • sole guardian (this is the only active guardian): "Hand over
                the account" — the account is handed to the child and they
                come of age (the independence lane, ADR 0028 G·4/G·2). A
                separate "delete" lane below covers the case where the
                account itself should go away.
            The branching reads the IsSoleGuardian flag the Detail action
            exposes on ViewData (the M9 MessagingRestricted precedent — the
            MembershipEditorModel is a pinned 6-field record, the U07
            exact-projection pin forbids adding a field, so the flag rides
            ViewData).
        *@
        @{
            var _isSoleGuardian = (bool)(ViewData["IsSoleGuardian"] ?? false);
        }
        @if (_isSoleGuardian)
        {
            <h2 class="mt-4"><kw-l key="guardian.handover">Hand over the account</kw-l></h2>
            <p class="text-muted"><kw-l key="guardian.handover_hint">Dissolving the guardianship hands the account to the child. Their memberships are preserved, and their own self-serve lanes come back on the next read.</kw-l></p>
            <form method="post" action="@Url.Action("Dissolve", "Guardian", new { childId = Model.ChildId })"
                  data-confirm="@confirmHandover">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"><kw-l key="guardian.dissolve">Dissolve guardianship</kw-l></button>
            </form>
        }
        else
        {
            <h2 class="mt-4"><kw-l key="guardian.remove_myself">Remove myself as guardian</kw-l></h2>
            <p class="text-muted"><kw-l key="guardian.remove_myself_hint">You are one of several guardians of this child. Removing yourself ends your standing over their account; the other guardian(s) continue, and their account is preserved.</kw-l></p>
            <form method="post" action="@Url.Action("Dissolve", "Guardian", new { childId = Model.ChildId })"
                  data-confirm="@confirmRemoveMyself">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"><kw-l key="guardian.remove_myself_submit">Remove myself</kw-l></button>
            </form>
        }

        @*
            ADR 0143 — delete the child account (the 6th GU supervisory
            action, reusing the ADR 0142 deletion core). The dangerous-action
            guard is the same two layers as the admin self-serve delete
            surface (the ADR 0142 Delete.cshtml precedent): a client-side
            data-confirm dialog (resolved through the provider; the kw-l
            TagHelper can't wrap an attribute) + a server-side checkbox. The
            form is NOT bound to the child or the guardian (both come from
            the route + the cookie principal — the AddChildForm precedent);
            the only bound field is the Confirmed checkbox (the
            GuardianDeleteChildForm shape). The child's content never
            reaches this form (G·1).
        *@
        @if (_isSoleGuardian)
        {
            <h2 class="mt-4"><kw-l key="guardian.delete_child">Delete the child account</kw-l></h2>
            <p class="text-muted"><kw-l key="guardian.delete_child_lede">Deleting the account removes the child's sign-in, profile, and group and community memberships, and dissolves any other guardianship over it. Their past actions in the audit trail are preserved with their identity replaced by a placeholder. This cannot be undone.</kw-l></p>
            <form method="post" action="@Url.Action("DeleteChild", "Guardian", new { childId = Model.ChildId })"
                  data-confirm="@confirmDeleteChild">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-2"></div>
                <div class="mb-2 form-check">
                    <input name="Confirmed" type="checkbox" class="form-check-input" />
                    <label class="form-check-label"><kw-l key="guardian.delete_child_confirm_checkbox">I understand the child account will be permanently deleted.</kw-l></label>
                </div>
                <button type="submit" class="btn btn-danger"><kw-l key="guardian.delete_child_submit">Delete account</kw-l></button>
            </form>
        }

        @*
            GA (ADR 0038 §F) — the "other guardians" list: the child's
            active-or-pending GuardianLink rows (not the guardian's child
            rows — the ActiveChildrenAsync read inverted), each resolved to a
            display name via the existing GetProfileAsync (a read, not a
            decision; G-A·3 — the assigned guardian's standing is
            identical in kind to the creator's). The list is the
            standing itself — a non-guardian's page is a 404 (the
            Detail route already gates on ActiveLinkAsync). ADR 0038 §F:
            a row that is still Pending shows a "pending" badge next to
            the assignee's name — the conferrer sees the state change
            live (the assignee's accept or decline is visible here on the
            very next read, G·2/C4).
        *@
        <h2 class="mt-4"><kw-l key="guardian.otherGuardians.title">Other guardians</kw-l></h2>
        @if (Model.GuardianItems.Count == 0)
        {
            <div class="alert alert-info"><kw-l key="guardian.otherGuardians.empty">No other guardians assigned.</kw-l></div>
        }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var g in Model.GuardianItems)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
                        <span>@g.DisplayName</span>
                        @if (g.IsPending)
                        {
                            <span class="badge bg-warning text-dark"><kw-l key="guardian.pending">Pending</kw-l></span>
                        }
                    </li>
                }
            </ul>
        }

        @*
            GA (ADR 0038) — the assign form: a single email field +
            submit. The form is NOT bound to the child or the guardian
            (both come from the route + the cookie principal — the
            AddChildForm precedent). The POST is the one-commit write
            (G-A·1 standing gate + G-A·2 resolution + G-A·4 idempotency +
            G-A·5 self-assignment refusal + the CreateGuardianLinkAsync
            call). The field posts as name="Email" (this view's @model is
            MembershipEditorModel, so the pinned markup's asp-for="Email"
            is uncompilable here — see the U06 drift pause); the Assign
            action's [FromForm] AssignGuardianForm binds the "Email" post
            field, exactly as the design doc's prose note pins.
        *@
        <h2 class="mt-4"><kw-l key="guardian.assign.title">Assign a guardian</kw-l></h2>
        <form method="post" action="@Url.Action("Assign", "Guardian", new { childId = Model.ChildId })">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label for="assignEmail" class="form-label"><kw-l key="guardian.assign.email">Email of the guardian to assign</kw-l></label>
                <input name="Email" id="assignEmail" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary"><kw-l key="guardian.assign.submit">Assign</kw-l></button>
        </form>
    </div>
</div>
