@model Kumunita.Web.Models.GuardianIndexModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Your children";
    // The suspend form's data-confirm (the ADR 0072 attribute idiom — resolved
    // through the provider, the confirm.js seam reads the attribute verbatim).
    // The kw-l TagHelper can't wrap an attribute, so the en floor is the
    // server fallback (a null provider, a non-HTTP render, degrades to en).
    string confirmSuspend = "Suspend this child account? They will be blocked until you un-suspend them.";
    if (Translation is not null)
    {
        var effLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
        confirmSuspend = await Translation.GetAsync("guardian.suspend_confirm", effLang);
    }
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        @* The settings sub-nav (ADR 0028, moved here from the account dropdown
           2026-09-30). Shown to every signed-in resident — a non-guardian sees
           the same page with an empty list — so the tab is unconditional, exactly
           as the old dropdown entry was. Top of the page — the strip sits just
           under the navbar (the kmb-tab-under-navbar treatment, site.css). *@
        @await Html.PartialAsync("~/Views/Locale/_SettingsTabs.cshtml")

        <h1><kw-l key="guardian.title">Your children</kw-l></h1>
        <p class="text-muted"><kw-l key="guardian.lead">The accounts you set up for a child, and the controls you hold over each one.</kw-l></p>

        @*
            GA (ADR 0038 §F) — the acceptance lane: when an existing guardian
            assigns you as a co-guardian for one of their supervised children,
            you are asked to ACCEPT (with the same consent to the child-account
            terms the creating guardian accepts on the AddChild form) or to
            DECLINE. Until you accept, you hold no standing over the child —
            the standing gates all query Active exclusively (the ADR 0038 §F
            supersession of the "no acceptance step" deferral). The card shows
            only for assignees with at least one pending request; a non-assignee
            sees nothing (the GU lane's "a non-guardian sees an empty card"
            shape, applied to the acceptance lane).
        *@
        @if (Model.PendingRequests.Count > 0)
        {
            <div class="mb-4">
                <h2><kw-l key="guardian.pendingRequests.title">Guardian requests awaiting your acceptance</kw-l></h2>
                <p class="text-muted"><kw-l key="guardian.pendingRequests.lead">Another guardian has asked you to become a co-guardian for one of their children. Accept (and agree to the child-account terms) or decline — until you act, you hold no standing over the account.</kw-l></p>
                <ul class="list-group">
                    @foreach (var req in Model.PendingRequests)
                    {
                        <li class="list-group-item p-3">
                            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                                <div>
                                    <div class="fw-semibold">
                                        <kw-l key="guardian.pendingRequests.child">Child</kw-l>:
                                        @req.ChildDisplayName
                                    </div>
                                    <div class="text-muted">
                                        <kw-l key="guardian.pendingRequests.conferrer">Requested by</kw-l>:
                                        @req.ConferrerDisplayName
                                        <span class="ms-1">(@req.RequestedAt)</span>
                                    </div>
                                </div>
                                <div>
                                    <form method="post" action="@Url.Action("Decline", "Guardian", new { childId = req.ChildId })" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary"><kw-l key="guardian.decline">Decline</kw-l></button>
                                    </form>
                                </div>
                            </div>
                            @*
                                The consent block + Accept — the ADR 0038 §F
                                acceptance step: the assignee confirms the
                                child-account terms inside the Accept form
                                (the AddChild form's GuardianConsent
                                precedent, verbatim — the checkbox is the
                                [Required] field on
                                AcceptGuardianForm.GuardianConsent, and the
                                controller refuses the accept until it is
                                checked: the TempData["error"] surface, the
                                Suspend / Unsuspend / Dissolve precedent).
                                The consent block and the Accept button are
                                the same form — the browser requires the
                                checkbox (required attribute) to be ticked
                                before the form can submit, AND the
                                controller enforces the same guard (defense
                                in depth).
                            *@
                            <div class="border rounded p-3 bg-body-tertiary mt-3">
                                <p class="mb-2"><kw-l key="guardian.accept.consent.intro">By accepting, you confirm that you are a legal guardian of this child. As their guardian, you maintain full control over their account:</kw-l></p>
                                <ul class="list-unstyled mb-2">
                                    <li><kw-l key="guardian.accept.consent.duties_invitations">You must approve or deny all group and event invitations.</kw-l></li>
                                    <li><kw-l key="guardian.accept.consent.duties_chat">You can enable or disable chat features for this profile at any time.</kw-l></li>
                                    <li><kw-l key="guardian.accept.consent.duties_data">This data is fully isolated to this community's own instance and will never be sold, profiled, or used for advertising.</kw-l></li>
                                </ul>
                                <form method="post" action="@Url.Action("Accept", "Guardian", new { childId = req.ChildId })">
                                    @Html.AntiForgeryToken()
                                    <div class="form-check">
                                        <input name="GuardianConsent" type="checkbox" value="true" class="form-check-input" required />
                                        <label class="form-check-label"><kw-l key="guardian.accept.consent.checkbox">I consent to the processing of this child's data under these terms.</kw-l></label>
                                    </div>
                                    <button type="submit" class="btn btn-primary mt-2"><kw-l key="guardian.accept">Accept &amp; agree to the terms</kw-l></button>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }

        @*
            GU (ADR 0028) — the child list: each row is the child's display name
            + the Blocked badge only (G·1 — never the child's posts or profile
            body). The Blocked state picks the action button (the m2b
            accept/decline "state picks the card" shape): a blocked child
            carries Un-suspend, an active child carries Suspend. The list is
            the standing itself — a non-guardian sees an empty card, nothing else.
        *@
        @if (Model.Children.Count == 0)
        {
            <div class="alert alert-info">
                <kw-l key="guardian.empty">No children yet.</kw-l>
            </div>
        }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var item in Model.Children)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
                        <span>
                            <a href="@Url.Action("Detail", "Guardian", new { childId = item.ChildId })">@item.DisplayName</a>
                            @if (item.Blocked)
                            {
                                <span class="badge bg-secondary ms-1"><kw-l key="guardian.suspended">Suspended</kw-l></span>
                            }
                        </span>
                        @if (item.Blocked)
                        {
                            <form method="post" action="@Url.Action("Unsuspend", "Guardian", new { childId = item.ChildId })">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary"><kw-l key="guardian.unsuspend">Un-suspend</kw-l></button>
                            </form>
                        }
                        else
                        {
                            <form method="post"
                                  action="@Url.Action("Suspend", "Guardian", new { childId = item.ChildId })"
                                  data-confirm="@confirmSuspend">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><kw-l key="guardian.suspend">Suspend</kw-l></button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }

        @*
            GU (G·4) — the add-a-child form, rendered inline on the Index page
            (U07 exposes POST me/children -> AddChild only; the form is its
            one-commit write: RegisterAsync then CreateGuardianLinkAsync, the
            verification email staged by M1's lane). A created-but-unlinked
            account can never exist. The child's content never reaches this
            form (G·1).
        *@
        <h2><kw-l key="guardian.add">Add a child account</kw-l></h2>
        <form method="post" action="@Url.Action("AddChild", "Guardian")">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="DisplayName" class="form-label"><kw-l key="guardian.display_name">Display name</kw-l></label>
                <input id="DisplayName" name="DisplayName" class="form-control" maxlength="100" required />
            </div>

            <div class="mb-3">
                <label for="Email" class="form-label"><kw-l key="guardian.email">Email address</kw-l></label>
                <input id="Email" name="Email" type="email" class="form-control" maxlength="255" required />
            </div>

            @*
                ADR 0146 — no password field: the child sets their own password at the
                confirmation link (the guardian never holds the credential — ADR 0028
                "supervision rides the link, not the password").

                Guardian consent — before creation, the guardian confirms they
                are the legal guardian and agrees to the child-account terms
                (guardian duties + data-processing terms). The checkbox is the
                [Required] field on AddChildForm.GuardianConsent; the controller
                refuses creation until it is checked.
            *@
            <div class="mb-3 border rounded p-3 bg-body-tertiary">
                <p class="mb-2"><kw-l key="guardian.consent.intro">By creating this profile, you confirm that you are the legal guardian of this child. As their guardian, you maintain full control over their account:</kw-l></p>
                <ul class="list-unstyled mb-2">
                    <li><kw-l key="guardian.consent.duties_invitations">You must approve or deny all group and event invitations.</kw-l></li>
                    <li><kw-l key="guardian.consent.duties_chat">You can enable or disable chat features for this profile at any time.</kw-l></li>
                    <li><kw-l key="guardian.consent.duties_data">This data is fully isolated to this community's own instance and will never be sold, profiled, or used for advertising.</kw-l></li>
                </ul>
                <div class="form-check">
                    <input id="GuardianConsent" name="GuardianConsent" type="checkbox" value="true" class="form-check-input" required />
                    <label class="form-check-label" for="GuardianConsent"><kw-l key="guardian.consent.checkbox">I consent to the processing of my child's data under these terms.</kw-l></label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary"><kw-l key="guardian.add">Add a child account</kw-l></button>
            <div class="form-text mt-1"><kw-l key="guardian.child_email_hint">The child verifies their own email to sign in — the usual sign-up flow.</kw-l></div>
        </form>
    </div>
</div>
