@model Kumunita.Web.Models.AddChildForm
@{
    ViewData["Title"] = "Add a child account";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <p><a class="text-muted" href="@Url.Action("Index", "Guardian")">&larr; Back to your children</a></p>

        <h1><kw-l key="guardian.add">Add a child account</kw-l></h1>
        <p class="text-muted">The child verifies their own email to sign in — the usual sign-up flow.</p>


        @*
            GU (G·4) — the add-a-child form re-rendered after a validation or
            signup-lane failure (U07's AddChild returns View(form) on the
            error paths). This is the failure landing surface, not a separate
            navigation page: the success path redirects to Index, where the
            form also renders inline. The guardian is never form-bound — it is
            minted by the controller from the signed-in principal (G·4, one
            commit). The child's content never reaches this form (G·1).
        *@
        <form asp-action="AddChild" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"><kw-l key="common.display_name">Display name</kw-l></label>
                <input asp-for="DisplayName" class="form-control" maxlength="100" required />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"><kw-l key="common.email">Email</kw-l></label>
                <input asp-for="Email" class="form-control" maxlength="255" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"><kw-l key="common.password">Password</kw-l></label>
                <input asp-for="Password" class="form-control" minlength="8" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            @*
                Guardian consent — before creation, the guardian confirms they
                are the legal guardian and agrees to the child-account terms
                (guardian duties + data-processing terms). The checkbox is the
                [Required] field on AddChildForm.GuardianConsent; the controller
                refuses creation until it is checked.
            *@
            <div class="mb-3 border rounded p-3 bg-body-tertiary">
                <p class="mb-2"><kw-l key="guardian.consent.intro">By creating this profile, you confirm that you are the legal guardian of this child. As their guardian, you maintain full control over their account:</kw-l></p>
                <ul class="list-unstyled mb-2">
                    <li><kw-l key="guardian.consent.duties_invitations">You must approve or deny all group and event invitations.</kw-l></li>
                    <li><kw-l key="guardian.consent.duties_chat">You can enable or disable chat features for this profile at any time.</kw-l></li>
                    <li><kw-l key="guardian.consent.duties_data">This data is fully isolated, hosted securely in the Switzerland/EU region, and will never be sold, profiled, or used for advertising.</kw-l></li>
                </ul>
                <div class="form-check">
                    <input asp-for="GuardianConsent" value="true" class="form-check-input" required />
                    <label asp-for="GuardianConsent" class="form-check-label"><kw-l key="guardian.consent.checkbox">I consent to the processing of my child's data under these terms.</kw-l></label>
                    <span asp-validation-for="GuardianConsent" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary"><kw-l key="guardian.add">Add a child account</kw-l></button>
        </form>
    </div>
</div>
