@model Kumunita.Web.Models.InvitationsAdminViewModel
@{
    ViewData["Title"] = "Admin — Invitations";
}

<div class="mb-2"><a href="/admin" class="btn btn-link p-0">&larr; <kw-l key="nav.admin">Admin</kw-l></a></div>

<h1 class="mt-2"><kw-l key="admin.invitations_title">Invitations</kw-l></h1>

<p class="text-muted">
    <kw-l key="admin.invitations.lede">Invite neighbours to join the community. Each invitation is a one-time link that opens sign-up for that address (even while sign-up is closed) and expires after 7 days. The invitation is sent as an email carrying the link.</kw-l></p>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h5"><kw-l key="admin.invitations_invite_label">Email addresses</kw-l></h2>
                <form method="post" action="@Url.Action("Invite", "AdminInvitations")" class="mt-2">
                    @Html.AntiForgeryToken()
                    <label for="emails" class="form-label small">
                        <kw-l key="admin.invitations_invite_label">Email addresses</kw-l>
                    </label>
                    <textarea class="form-control" name="emails" id="emails" rows="4"
                              placeholder="a@neighbour.example&#10;b@neighbour.example"
                              required>@Model.DraftEmails</textarea>
                    <div class="form-text">
                        <kw-l key="admin.invitations_invite_hint">One or more email addresses — separate with a newline or a comma. Each gets a one-time sign-up link by email.</kw-l>
                    </div>
                    <button type="submit" class="btn btn-primary mt-2">
                        <kw-l key="admin.invitations_invite_button">Send invitations</kw-l>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        @* IMPROVE-UX A12 (ADR 0304 D6 c) — the approval queue: the
           PendingApproval rows across all inviters (the A12 card: "a new
           section on this surface (the PendingApproval rows + the
           admin-approve button) — the A09 view is already built; A12
           extends it, does not re-wire it"). The section is visible when
           the A11 setting is OnWithApproval (the resident surface can
           create PendingApproval rows) and hidden when Off (no resident
           invitations can exist) or On (the resident's invitations land
           Pending directly — the A09 list surface is unchanged). *@
        @if (Model.ApprovalQueueVisible)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5"><kw-l key="admin.invitations_approval_title">Resident invitations pending approval</kw-l></h2>
                    <p class="text-muted">
                        <kw-l key="admin.invitations_approval_lede">Residents have invited neighbours. Approve each invitation before it becomes usable.</kw-l>
                    </p>
                    @if (Model.PendingApprovalItems.Count == 0)
                    {
                        @* ADR 0177 / R29–R33 — friendly empty state (.kmb-empty + one next action). *@
                        <div class="kmb-empty">
                            <p class="kmb-empty-title"><kw-l key="admin.invitations_approval_empty">No resident invitations are pending approval.</kw-l></p>
                            <p class="kmb-empty-body">
                                <kw-l key="admin.invitations_approval_empty_hint">When a resident invites a neighbour (in "On with admin approval" mode), the invitation appears here for review.</kw-l>
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th><kw-l key="admin.invitations_approval_invited">Invited</kw-l></th>
                                        <th><kw-l key="admin.invitations_approval_inviter">Inviter</kw-l></th>
                                        <th><kw-l key="admin.invitations_approval_created">Created</kw-l></th>
                                        <th><kw-l key="admin.invitations_approval_expires">Expires</kw-l></th>
                                        <th class="text-end"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.PendingApprovalItems)
                                    {
                                        <tr>
                                            <td>@item.Email</td>
                                            <td><code>@item.InviterSubjectId</code></td>
                                            <td class="text-nowrap">@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                            <td class="text-nowrap">@item.ExpiresAt.ToString("yyyy-MM-dd")</td>
                                            <td class="text-end">
                                                <form method="post" action="@Url.Action("Approve", "AdminInvitations")" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="invitationId" value="@item.InvitationId" />
                                                    <button type="submit" class="btn btn-outline-primary">
                                                        <kw-l key="admin.invitations_approval_approve">Approve</kw-l>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        <h2 class="h5"><kw-l key="admin.invitations_list_label">Invitations</kw-l></h2>
        @if (Model.IsEmpty)
        {
            @* ADR 0177 / R29–R33 — friendly empty state (.kmb-empty + one next action). *@
            <div class="kmb-empty">
                <p class="kmb-empty-title"><kw-l key="admin.invitations.empty">No invitations yet. Invite a neighbour to get them in.</kw-l></p>
                <p class="kmb-empty-body">
                    <kw-l key="admin.invitations.empty_hint">Each invitation is a one-time link that opens sign-up for that address and expires after 7 days.</kw-l>
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th><kw-l key="admin.invitations_invite_label">Email addresses</kw-l></th>
                            <th><kw-l key="admin.invitations_status_pending">Pending</kw-l></th>
                            <th><kw-l key="admin.invitations_created">Created</kw-l></th>
                            <th><kw-l key="admin.invitations_expires">Expires</kw-l></th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var statusKey = item.DisplayStatus switch
                            {
                                Kumunita.Core.Identity.EmailInvitationStatus.Pending   => "admin.invitations_status_pending",
                                Kumunita.Core.Identity.EmailInvitationStatus.Accepted  => "admin.invitations_status_accepted",
                                Kumunita.Core.Identity.EmailInvitationStatus.Revoked   => "admin.invitations_status_revoked",
                                _                                                        => "admin.invitations_status_expired",
                            };
                            var statusText = item.DisplayStatus switch
                            {
                                Kumunita.Core.Identity.EmailInvitationStatus.Pending   => "Pending",
                                Kumunita.Core.Identity.EmailInvitationStatus.Accepted  => "Accepted",
                                Kumunita.Core.Identity.EmailInvitationStatus.Revoked   => "Revoked",
                                _                                                        => "Expired",
                            };
                            var canRevoke = item.DisplayStatus == Kumunita.Core.Identity.EmailInvitationStatus.Pending
                                || item.DisplayStatus == Kumunita.Core.Identity.EmailInvitationStatus.Expired;
                            <tr>
                                <td>@item.Email</td>
                                <td><span class="badge text-bg-light text-dark border"><kw-l key="@statusKey">@statusText</kw-l></span></td>
                                <td class="text-nowrap">@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-nowrap">@item.ExpiresAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (canRevoke)
                                        {
                                            <form method="post" action="@Url.Action("Revoke", "AdminInvitations")" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="invitationId" value="@item.InvitationId" />
                                                <button type="submit" class="btn btn-outline-secondary">
                                                    <kw-l key="admin.invitations_revoke">Revoke</kw-l>
                                                </button>
                                            </form>
                                        }
                                        @if (item.DisplayStatus == Kumunita.Core.Identity.EmailInvitationStatus.Expired)
                                        {
                                            @* IMPROVE-UX A09 resend semantics (settled): the token is
                                               shown-once + hashed (ADR 0304 D2), so a resend is a FRESH
                                               invitation (a new token) for the same email — not a re-email
                                               of a dead token. The superseded pending row is revoked in the
                                               same action (the // TODO ❓ the A09 card leaves for the SEC
                                               review — settled: clean up the zombie so the list doesn't
                                               accumulate past-expiry rows). *@
                                            <form method="post" action="@Url.Action("Resend", "AdminInvitations")" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="email" value="@item.Email" />
                                                <input type="hidden" name="supersededId" value="@item.InvitationId" />
                                                <button type="submit" class="btn btn-outline-secondary">
                                                    <kw-l key="admin.invitations_resend">Resend</kw-l>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
