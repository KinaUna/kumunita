@model Kumunita.Web.Models.SetupViewModel
@{
    ViewData["Title"] = "Complete first-boot setup";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1><kw-l key="admin.setup.title">Complete first-boot setup</kw-l></h1>
        <p class="text-muted">
            <kw-l key="admin.setup.lede">Entering your setup token sets the first admin’s password and signs you in. This one-time handoff is the only way to activate the seed account.</kw-l></p>

        @if (Model.Error is not null)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }

        <form asp-action="Setup" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SetupToken" class="form-label"></label>
                <input asp-for="SetupToken" class="form-control" autocomplete="off" spellcheck="false" />
                <span asp-validation-for="SetupToken" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary"><kw-l key="admin.setup.submit">Set my password</kw-l></button>
        </form>

        <p class="mt-3 text-muted">
            <kw-l key="admin.setup.have_password">Already have a password?</kw-l> <a asp-controller="Account" asp-action="Login"><kw-l key="account.login_submit">Sign in</kw-l></a>.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
