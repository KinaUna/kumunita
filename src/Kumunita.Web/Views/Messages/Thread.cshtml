@model Kumunita.Web.Controllers.MessagesController.MessagesThreadViewModel
@using Kumunita.Core.Localization
@using Kumunita.Core.Messaging
@using Kumunita.Web.Security
@inject ITranslationProvider Translation
@inject ILocalizationService Localization
@{
    ViewData["Title"] = "Messages";
    // The composer's placeholder is a fixed UI string in a placeholder="…"
    // attribute — the <kw-l> TagHelper can't sit inside an attribute, so
    // resolve it server-side (the ADR 0072 / Search/Index pattern).
    var lang = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    // The back arrow's accessible name is server-resolved (the kw-l TagHelper
    // can't wrap an attribute); the a11y.* floor is the closed set.
    var ariaBack = await Translation.GetAsync("a11y.back_to_messages", lang);
    var composePlaceholder = await Translation.GetAsync("message.compose.placeholder", lang);
    var otherWord = await Translation.GetAsync("message.other", lang);
    var loadEarlierWord = await Translation.GetAsync("message.load_earlier", lang);
    // The header name: the other participant's display name, or the fallback
    // word when the conversation is unnamed (or absent in the error states).
    string headerName = Model.Conversation is { } hConv && !string.IsNullOrEmpty(hConv.OtherDisplayName)
        ? hConv.OtherDisplayName
        : otherWord;
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <header class="airy-head d-flex align-items-baseline gap-3">
            <a href="/messages" class="text-dark text-decoration-none me-1" aria-label="@ariaBack">←</a>
            <h1>
                @headerName
            </h1>
        </header>

        @if (Model.Disabled)
        {
            @* F5 — the toggle is off: the disabled state, no thread, no composer. *@
            <div class="alert alert-secondary" role="status">
                <kw-l key="message.disabled">Direct messaging is turned off on this instance.</kw-l>
            </div>
            return;
        }

        @if (Model.Error)
        {
            @* A send failed (blank/over-cap body): the composer error state. *@
            <div class="alert alert-warning" role="alert">
                <kw-l key="message.compose.send">Send</kw-l> —
                <span>
                    @if (Model.Conversation is { } eConv)
                    {
                        <a href="/messages/@eConv.Id" class="alert-link">
                            @(string.IsNullOrEmpty(eConv.OtherDisplayName) ? otherWord : eConv.OtherDisplayName)
                        </a>
                    }
                    else
                    {
                        <a href="/messages" class="alert-link">@otherWord</a>
                    }
                </span>
            </div>
        }

        @* ── The thread (chronological — latest last, the view's rendering) ── *@
        @if (Model.Messages.Count == 0)
        {
            <div class="alert alert-secondary" role="status">
                <kw-l key="message.thread.empty">No messages yet — say hello.</kw-l>
            </div>
        }
        else
        {
            @if (Model.Pager is { HasNext: true } p)
            {
                <div class="text-center mb-3">
                    <a class="btn btn-outline-secondary btn-sm"
                       href="@p.BaseUrl?page=@(p.CurrentPage + 1)"
                       title="@loadEarlierWord">@loadEarlierWord</a>
                </div>
            }

            <ul class="message-thread">
                @foreach (var m in Model.Messages)
                {
                    bool mine = m.SenderId == Model.ActorId;
                    bool unread = !mine && m.ReadBy is null;
                    string senderName = mine
                        ? (!string.IsNullOrEmpty(Model.ActorDisplayName) ? Model.ActorDisplayName : otherWord)
                        : (Model.Conversation is { } tConv
                            ? (string.IsNullOrEmpty(tConv.OtherDisplayName) ? otherWord : tConv.OtherDisplayName)
                            : otherWord);
                    string senderAvatarId = mine
                        ? Model.ActorId
                        : (Model.Conversation?.OtherParticipantId ?? string.Empty);
                    string senderInitial = !string.IsNullOrWhiteSpace(senderName)
                        ? char.ToUpperInvariant(senderName.TrimStart()[0]).ToString()
                        : string.Empty;
                    <li class="msg-row @(mine ? "mine" : "other") @(unread ? "unread" : "")">
                        @if (!string.IsNullOrEmpty(senderAvatarId))
                        {
                            <span class="msg-avatar d-inline-flex align-items-center">
                                <img class="avatar" src="/profile/avatar/@senderAvatarId" alt="" data-avatar-fallback>
                                <span class="avatar-mono" style="display:none;">@senderInitial</span>
                            </span>
                        }
                        <div class="msg-bundle">
                            <div class="msg-meta d-flex gap-2 align-items-baseline flex-wrap">
                                <span class="fw-semibold small">@senderName</span>
                                <span class="small text-secondary">
                                    <kw-dt dt="@m.Created" format="g"></kw-dt>
                                    @if (unread)
                                    {
                                        <span class="badge text-bg-primary ms-2"><kw-l key="message.unread">unread</kw-l></span>
                                    }
                                </span>
                            </div>
                            <div class="message-body">@m.Body</div>
                        </div>
                    </li>
                }
            </ul>
        }

        @* ── The composer ───────────────────────────────────────────────── *@
        @if (Model.Conversation is { } conv)
        {
            if (Model.RecipientMessagingEnabled)
            {
                <form method="post" action="/messages/@conv.Id/send" class="mt-3">
                    @Html.AntiForgeryToken()
                    <textarea class="form-control mb-2" name="body" rows="3"
                              placeholder="@composePlaceholder" required
                              maxlength="@Kumunita.Core.Messaging.MessagingService.MaxBodyChars"
                              aria-label="@composePlaceholder"></textarea>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary"><kw-l key="message.compose.send">Send</kw-l></button>
                    </div>
                </form>
            }
            else
            {
                @* The recipient has disabled messaging (opt-in off, or a
                   guardian's restriction): the write form is inert — the
                   resident can still read the exchange they were part of,
                   but the composer is disabled (the ADR 0139 two-sided
                   gate's recipient half, the DirectoryController button
                   affordance shape). The fields are disabled — not merely
                   hidden — so the surface is still visible as "why not". *@
                <div class="alert alert-secondary mt-3" role="status">
                    <kw-l key="message.compose.disabled">This resident has turned off direct messaging, so you can't send them a new message.</kw-l>
                </div>
                <form method="post" action="/messages/@conv.Id/send" class="mt-3" aria-disabled="true">
                    @Html.AntiForgeryToken()
                    <textarea class="form-control mb-2" name="body" rows="3"
                              placeholder="@composePlaceholder" disabled
                              maxlength="@Kumunita.Core.Messaging.MessagingService.MaxBodyChars"
                              aria-label="@composePlaceholder"></textarea>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary" disabled><kw-l key="message.compose.send">Send</kw-l></button>
                    </div>
                </form>
            }
        }
    </div>
</div>
