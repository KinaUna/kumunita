@using Kumunita.Web.Security
@model Kumunita.Web.Models.MfaSettingsViewModel
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    var _aL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    var _mfaOne = Translation is null ? "You have {0} unused recovery code remaining." : await Translation.GetAsync("settings.mfa.codes_remaining_one", _aL);
    var _mfaMany = Translation is null ? "You have {0} unused recovery codes remaining." : await Translation.GetAsync("settings.mfa.codes_remaining_other", _aL);
    var _mfaRotateConfirm = Translation is null ? "Replace your 10 recovery codes with a fresh set? The current codes stop working immediately." : await Translation.GetAsync("settings.mfa.rotate_confirm", _aL);
    var _mfaDisableConfirm = Translation is null ? "Turn off two-factor authentication? If you are the only GlobalAdmin on this instance, you will lose your last defense against a stolen password." : await Translation.GetAsync("settings.mfa.disable_confirm", _aL);
    var _mfaCodesAria = Translation is null ? "Recovery codes" : await Translation.GetAsync("settings.mfa.recovery_heading", _aL);
    var _mfaQrAlt = Translation is null ? "QR code to pair your authenticator app" : await Translation.GetAsync("settings.mfa.qr_alt", _aL);
}
@{
    ViewData["Title"] = "Settings — Security";
}

@* F3 (AUTH-03) — the per-resident MFA enrollment surface (F3.U3). The
   /settings/security/mfa section, the ADR 0080 settings-tab shape (the
   same sub-nav strip + page heading + section + forms as
   /settings/messaging).
   <para>
   <b>Plain-English strings, deliberately not <c>kw-l</c> keys:</b> the
   KwLRegistryConsistencyTests view-scan fails the build if a <c>kw-l</c>
   key is used but not in KnownTranslationKeys, and registering new keys
   would require a 4th file (KnownTranslationKeys + De/Fr/Da parity), which
   exceeds this unit's ≤3-file budget. The enforcement leg (F3.U4) and the
   multilingual close-flip may register the keys then; the surface works
   en-only today.
   </para>
   <para>
   <b>Recovery-codes-shown-once rule:</b> the setup key, the otpauth URI,
   and the 10 codes are rendered only when present on the model (the
   enabling/rotating response); a steady GET sets them to null and renders
   the count-only floor.
   </para>
*@
@await Html.PartialAsync("../Locale/_SettingsTabs.cshtml")

@{
    var _mfaRemaining = string.Format(System.Globalization.CultureInfo.InvariantCulture,
        Model.RemainingRecoveryCodes == 1 ? _mfaOne : _mfaMany, Model.RemainingRecoveryCodes);
}

<h1><kw-l key="locale.settings_title">Your settings</kw-l></h1>

<h2 class="mt-1"><kw-l key="settings.security.title">Security</kw-l></h2>
<p class="text-muted">
    <kw-l key="settings.mfa.intro">Add two-factor authentication (an authenticator app) to your account. A GlobalAdmin must have this on before signing in; for everyone else it is optional.</kw-l></p>

@* ---- Enabled + count-only steady state -------------------------------- * @*
   When MFA is on and no one-time secrets are present (Model.RecoveryCodes is
   null), render the status + the remaining-code count. This is the floor
   that a steady GET /settings/security/mfa and
   /settings/security/mfa/recovery land on. *@
@if (Model.Enabled && Model.RecoveryCodes is null)
{
    <div class="alert alert-info">
        <kw-l key="settings.mfa.enabled_status">Two-factor authentication is enabled on this account.</kw-l>
        @_mfaRemaining
    </div>

    <div class="card">
        <div class="card-body">
            <h3 class="h5"><kw-l key="settings.mfa.recovery_heading">Recovery codes</kw-l></h3>
            <p class="text-muted mb-2">
                <kw-l key="settings.mfa.recovery_desc">If you lose your authenticator app, a recovery code lets you sign in once and reset your second factor.</kw-l>
                @_mfaRemaining
            </p>
            <form method="post" action="/settings/security/mfa/recovery"
                  data-confirm="@_mfaRotateConfirm">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary">
                    <kw-l key="settings.mfa.rotate_button">Rotate recovery codes</kw-l>
                </button>
            </form>
        </div>
    </div>

    <hr />

    <div class="card border-danger-subtle">
        <div class="card-body">
            <h3 class="h5 text-danger"><kw-l key="settings.mfa.disable_heading">Turn off two-factor authentication</kw-l></h3>
            <p class="text-muted mb-2">
                <kw-l key="settings.mfa.disable_desc">Disabling removes your second factor. If you are the only GlobalAdmin on this instance, doing so removes your last defense against a stolen password.</kw-l></p>
            <form method="post" action="/settings/security/mfa/disable"
                  data-confirm="@_mfaDisableConfirm">
                @Html.AntiForgeryToken()
                <div class="row g-2 align-items-end">
                    <div class="col-sm-8">
                        <label for="disableCode" class="form-label">
                            <kw-l key="settings.mfa.disable_code_label">Enter the current code from your authenticator app to confirm</kw-l>
                        </label>
                        <input type="text" class="form-control" id="disableCode"
                               name="Code" inputmode="numeric" autocomplete="one-time-code"
                               pattern="[0-9]{6}" />
                    </div>
                    <div class="col-sm-4">
                        <button type="submit" class="btn btn-outline-danger">
                            <kw-l key="settings.mfa.disable_button">Disable two-factor authentication</kw-l>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@* ---- Enrollment (not enabled) or rotate result (codes present) ------- * @*
   When the one-time secrets are present (Model.SetupKey /
   Model.RecoveryCodes not null), this is either the first enrollment (the
   setup key + otpauth URI + 10 codes, shown once) or a rotate result (the
   10 codes, shown once). Render them together with the enable form so the
   resident can pair the app, then submit the first code. *@
else
{
    @* The one-time secrets (enrollment / rotate leg — shown once). *@
    @if (Model.RecoveryCodes is not null)
    {
        <div class="card border-warning-subtle">
            <div class="card-body">
                <h3 class="h5"><kw-l key="settings.mfa.codes_heading">Your recovery codes — copy them now</kw-l></h3>
                <p class="text-muted">
                    <kw-l key="settings.mfa.codes_desc">These 10 codes let you sign in if you lose your authenticator app. They are shown once and cannot be recovered later.</kw-l></p>
                <ol class="recovery-codes" aria-label="@_mfaCodesAria">
                    @foreach (var code in Model.RecoveryCodes)
                    {
                        <li><code>@code</code></li>
                    }
                </ol>
            </div>
        </div>
    }

    @* The setup key + otpauth URI (enrollment leg only — absent on a
       rotate, which has no new key). *@
    @if (Model.SetupKey is not null && Model.OtpAuthUrl is not null)
    {
        <div class="card">
            <div class="card-body">
                <h3 class="h5"><kw-l key="settings.mfa.pair_heading">Pair your authenticator app</kw-l></h3>
                <p class="text-muted">
                    <kw-l key="settings.mfa.pair_desc">Add this account to your authenticator app (Google Authenticator, 1Password, Authy, or any TOTP app). Scan the QR code below, or enter the setup key manually.</kw-l></p>
                @* ADR 0174 — the pairing QR. Server-side QR encode (QRCoder,
                   ADR 0174) embedded as a data: URI, so the resident can scan
                   an image with no client JS — the page works with scripts
                   disabled. The <img> is the primary affordance; the setup
                   key + otpauth URI below are the manual-entry fallback. *@
                @if (!string.IsNullOrEmpty(Model.QrDataUri))
                {
                    <div class="d-flex justify-content-center mb-3">
                        <img src="@Model.QrDataUri" alt="@_mfaQrAlt"
                             class="rounded border" style="width:220px;height:220px;" />
                    </div>
                }
                <div class="mb-2">
                    <label for="otpAuthUrl" class="form-label d-block">otpauth URI</label>
                    <input type="text" class="form-control font-monospace" id="otpAuthUrl"
                           value="@Model.OtpAuthUrl" readonly />
                </div>
                <div class="mb-2">
                    <label for="setupKey" class="form-label d-block"><kw-l key="settings.mfa.setup_key">Setup key</kw-l></label>
                    <input type="text" class="form-control font-monospace" id="setupKey"
                           value="@Model.SetupKey" readonly />
                </div>
            </div>
        </div>
    }

    @* The enable form (the pin's POST /settings/security/mfa — MfaEnable).
       Visible on the enrollment leg (not enabled). On a rotate result the
       flag is already on, so the form is suppressed. *@
    @if (!Model.Enabled)
    {
        <div class="card">
            <div class="card-body">
                <h3 class="h5"><kw-l key="settings.mfa.enable">Enable two-factor authentication</kw-l></h3>
                <p class="text-muted">
                    <kw-l key="settings.mfa.enable_desc">Enter the 6-digit code your authenticator app is showing to confirm and turn on your second factor.</kw-l></p>
                <form method="post" action="/settings/security/mfa">
                    @Html.AntiForgeryToken()
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-8">
                            <label for="enableCode" class="form-label"><kw-l key="settings.mfa.enable_code_label">Current code from your authenticator app</kw-l></label>
                            <input type="text" class="form-control" id="enableCode"
                                   name="Code" inputmode="numeric" autocomplete="one-time-code"
                                   pattern="[0-9]{6}" required />
                        </div>
                        <div class="col-sm-4">
                            <button type="submit" class="btn btn-primary">
                                <kw-l key="settings.mfa.enable">Enable two-factor authentication</kw-l>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
}
