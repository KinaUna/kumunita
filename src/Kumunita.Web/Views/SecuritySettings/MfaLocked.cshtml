@model Kumunita.Web.Models.MfaLockedViewModel
@{
    ViewData["Title"] = "Settings — Security";
}

@* ADR 0194 — the sample-account MFA lock (amending ADR 0138). The MFA
   enrollment surface (/settings/security/mfa) is replaced by this static
   notice for a locked, non-admin sample account (the ADR 0138
   "surface-replaced-by-notice" shape, re-applied to the MFA surface — the
   ChangePasswordLocked.cshtml precedent). The settings sub-nav strip is the
   same _SettingsTabs partial the Mfa.cshtml view uses (the Security tab is
   active for the SecuritySettings controller, so the locked notice lands on
   the same tab). The GlobalAdmin sample admin and every real (non-sample)
   account never see this page (IsMfaLockedForAsync exempts both — the admin
   keeps its own MFA lane, exactly as it keeps its own password lane under
   ADR 0138). *@
@await Html.PartialAsync("../Locale/_SettingsTabs.cshtml")

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1><kw-l key="settings.security.mfa_locked_title">Two-factor authentication is locked</kw-l></h1>
        <p class="text-muted">
            <kw-l key="settings.security.mfa_locked_body">This is a demo account and two-factor authentication (MFA) is locked by the administrator so everyone can keep using the shared credentials. You can still use every other feature of the platform.</kw-l>
        </p>

        <p class="mt-3">
            <a href="/settings/language" class="btn btn-outline-secondary"><kw-l key="settings.security.back">Back to your settings</kw-l></a>
        </p>
    </div>
</div>
