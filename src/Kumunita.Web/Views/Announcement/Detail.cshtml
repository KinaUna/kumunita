@model Kumunita.Web.Models.AnnouncementDetailViewModel
@using Kumunita.Core.Announcements
@using Kumunita.Web.Security
@using Kumunita.Web.Views.Shared
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Title) ? "Announcement" : Model.Title;

    // ADR 0029 — translation display (TD / ADR 0027, carried to announcements):
    // the authored-in language is the first, default-visible variant, each
    // user-added translation is a hidden variant, and the chip row is a
    // selector that swaps them. The "add a translation" candidate list
    // excludes the authored-in language (missingLanguages).
    var langNames = Model.Languages.ToDictionary(l => l.Code, l => l.NativeName);
    var originalCode = Model.OriginalLanguageCode;
    var missingLanguages = Model.Languages
        .Where(l => !l.HasTranslation && l.Code != originalCode).ToList();
    string LangName(string code) => langNames.TryGetValue(code, out var n) ? n : code;

    // ADR 0049 — the announcement's **default-visible** variant is the
    // viewer's current language when a translation exists in it, else the
    // authored-in language (the ADR 0027 floor). The ADR 0027 click-to-swap +
    // return path are untouched — only *which* variant shows first changes.
    var defaultVariant = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);

    // The remove-translation form's data-confirm (the ADR 0072 attribute
    // idiom — the confirm.js seam reads the attribute verbatim; the kw-l
    // TagHelper can't wrap an attribute). The en floor is the server fallback
    // (a null provider — a non-HTTP render — degrades to en).
    string confirmRemoveTrans = "Remove this translation?";
    // The actions menu's accessible name is a template with a {0} slot (the
    // announcement's title) — server-resolved (the kw-l TagHelper can't wrap
    // an attribute, and can't substitute). The en floor is the server fallback
    // (a null provider — a non-HTTP render — degrades to en).
    string ariaActionsFor = "Actions for {0}";
    if (Translation is not null)
    {
        confirmRemoveTrans = await Translation.GetAsync("common.remove_translation_confirm", defaultVariant);
        ariaActionsFor     = await Translation.GetAsync("a11y.actions_for", defaultVariant);
    }
    bool originalHidden = Model.Translations.Any(t => String.Equals(t.LanguageCode, defaultVariant, StringComparison.OrdinalIgnoreCase));
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        @* M17 (ADR 0118) + M37 (ADR 0167) — the bookmark toggle and the
           personal-note button. Gathered onto ONE right-aligned row at the
           TOP of the parent column (just below the nav bar, to the right),
           OUTSIDE the main card. Each partial still carries its own d-flex
           wrapper + the bootstrap modal, so they only need to be side-by-side
           here; the d-flex justify-content-end gap-2 row pushes the cluster to
           the right edge of the column. D2 / C-M17·2 pin holds: the label is
           static per render — this view does not load the owner's bookmark
           list to decide it. *@
        <div class="d-flex justify-content-end gap-2 mb-2">
            @{ var _bm = ("announcement", Model.Id, $"/announcements/{Model.Id}"); }
            <partial name="_BookmarkButton" model="@_bm" />
            @{ var _pn = ("announcement", Model.Id, $"/announcements/{Model.Id}"); }
            <partial name="_NoteButton" model="@_pn" />
        </div>
        <p>
            <a href="/announcements" class="btn btn-link p-0">
                <kw-l key="announcements.detail_back">&larr; Back to the announcements</kw-l>
            </a>
        </p>

        <div class="d-flex align-items-center flex-wrap gap-2 mb-3 kmb-detail-chips">
            <span class="kmb-chip">
                @if (Model.Scope == AnnouncementScope.Public)
                {
                    <kw-l key="announcements.scope_everyone">everyone</kw-l>
                }
                else if (Model.CommunityDisplayName is not null)
                {
                    @Model.CommunityDisplayName
                }
                else
                {
                    <kw-l key="announcements.scope_residents">residents</kw-l>
                }
            </span>
            @if (Model.Pinned)
            {
                <span class="kmb-chip kmb-chip-pinned" title="Shown as a banner at the top of every page">
                    <kw-l key="announcements.pinned_badge">pinned</kw-l>
                </span>
            }
            @* ADR 0037 — the draft surface: GetAsync returns a draft to the
               author only, so IsAuthor ⇔ IsDraft here. The badge is visible
               to the one viewer who may act on it; Publish is the sole lever
               that clears the flag (the author-only lane). *@
            @if (Model.IsDraft && Model.IsAuthor)
            {
                <span class="kmb-chip kmb-chip-draft" title="Only you can see this — it is not yet public">
                    <kw-l key="posts.draft_badge">Draft</kw-l>
                </span>
                <form class="d-inline" method="post" action="/announcements/@Model.Id/publish">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-success">
                        <kw-l key="posts.publish">Publish</kw-l>
                    </button>
                </form>
            }
            @* ADR 0071 modal shape — one modal per language the
                   standing-holder may edit or add. The rich editor is
                   self-wired at module load (class-based, no dependency on
                   the containing element) so it works inside a modal.
                   The form's name="body" sink is the server's binding target
                   (WY·1 / RE·3). *@
                @if (Model.CanTranslate)
                {
                    @foreach (var existing in Model.Translations.OrderBy(x => x.LanguageCode))
                    {
                        <div class="modal fade" id="@($"ann-trans-edit-{existing.LanguageCode}")" tabindex="-1"
                             aria-labelledby="@($"ann-trans-edit-label-{existing.LanguageCode}")" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <form method="post" action="@($"/announcements/{Model.Id}/translations/update")" id="@($"ann-trans-edit-form-{existing.LanguageCode}")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="@($"ann-trans-edit-label-{existing.LanguageCode}")">
                                                <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label" for="@($"ann-trans-edit-title-{existing.LanguageCode}")">
                                                    @LangName(existing.LanguageCode) <kw-l key="posts.translation_title_label">title</kw-l>
                                                    <span class="text-muted">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                                </label>
                                                <input class="form-control" type="text" name="title"
                                                       id="@($"ann-trans-edit-title-{existing.LanguageCode}")"
                                                       value="@existing.Title" />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label" for="@($"ann-trans-edit-body-{existing.LanguageCode}")">
                                                    <kw-l key="posts.translation_body_label">Body</kw-l>
                                                </label>
                                                @* RE U06 — toolbar + live preview (image OFF: RC's
                                                   announcement image serve branch is inert-404 [RC U03
                                                   drift pause]; RE·3 forbids inventing that seam). The
                                                   name="body" / id / required shape is preserved exactly. *@
                                                <div class="rc-editor">
                                                    <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                                        <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                                                        <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                                                        <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                                                        <partial name="_RichEditorToggle" />
                                                    </div>
                                                    <textarea class="form-control" id="@($"ann-trans-edit-body-{existing.LanguageCode}")"
                                                              name="body" rows="4" required placeholder="…" data-rich-editor>@existing.Body</textarea>
                                                    <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                <kw-l key="common.cancel">Cancel</kw-l>
                                            </button>
                                            <button type="submit" class="btn btn-primary" form="@($"ann-trans-edit-form-{existing.LanguageCode}")">
                                                <kw-l key="posts.translation_save">Save translation</kw-l>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }

                    @foreach (var lang in missingLanguages)
                    {
                        <div class="modal fade" id="@($"ann-trans-add-{lang.Code}")" tabindex="-1"
                             aria-labelledby="@($"ann-trans-add-label-{lang.Code}")" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <form method="post" action="@($"/announcements/{Model.Id}/translations")" id="@($"ann-trans-add-form-{lang.Code}")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="languageCode" value="@lang.Code" />
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="@($"ann-trans-add-label-{lang.Code}")">
                                                <kw-l key="posts.translation_add">Add</kw-l> — <b>@LangName(lang.Code)</b>
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label" for="@($"ann-trans-add-title-{lang.Code}")">
                                                    @LangName(lang.Code) <kw-l key="posts.translation_title_label">title</kw-l>
                                                    <span class="text-muted">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                                </label>
                                                <input class="form-control" type="text" name="title"
                                                       id="@($"ann-trans-add-title-{lang.Code}")"
                                                       value="@Model.Title" />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label" for="@($"ann-trans-add-body-{lang.Code}")">
                                                    <kw-l key="posts.translation_body_label">Body</kw-l>
                                                </label>
                                                <div class="rc-editor">
                                                    <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                                        <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                                        <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                                                        <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                                                        <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                                                        <partial name="_RichEditorToggle" />
                                                    </div>
                                                    <textarea class="form-control" id="@($"ann-trans-add-body-{lang.Code}")"
                                                              name="body" rows="4" required placeholder="…" data-rich-editor></textarea>
                                                    <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                <kw-l key="common.cancel">Cancel</kw-l>
                                            </button>
                                            <button type="submit" class="btn btn-primary" form="@($"ann-trans-add-form-{lang.Code}")">
                                                <kw-l key="posts.translation_save">Save translation</kw-l>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
        </div>

        <div class="card kmb-detail-card kmb-detail-page">
            <div class="card-body">
                @* TD (ADR 0027) — the authored-in language is the first,
                   default-visible variant; each added translation is a hidden
                   variant; the chip row is a selector that swaps them. The
                   title + body are the announcement's toggle scope. *@
                <div data-td-group="announcement">
                    @* Title row — the title (the shared fallback heading,
                       td-variant-shared) on the left; the ⋮ actions dropdown
                       (ADR 0082) on the right, INSIDE the card — the
                       community-posts (Posts/Detail) idiom, so the action
                       surface sits in the top-right corner of the card rather
                       than in the badge row above it. The dropdown is NOT a
                       .td-variant, so it stays put on a translation swap. The
                       dedicated per-translation titles render in their own
                       .td-variant-title blocks below. *@
                    <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
                        <div class="min-w-0">
                            @* Authored-in title — the SHARED FALLBACK heading
                               (td-variant-shared). Default-visible unless ADR 0049
                               auto-selects a translation of it into the viewer's
                               language (originalHidden); it also stays the heading
                               for any translation that has no title of its own.
                               The swap + return path (ADR 0027) are unchanged either
                               way. *@
                            <div class="td-variant td-variant-shared" data-td-variant="@Model.OriginalLanguageCode"
                                 @(originalHidden ? Html.Raw(" style=\"display:none\"") : Html.Raw(""))>
                                <h1 class="mb-0 kmb-detail-title">
                                    @if (string.IsNullOrWhiteSpace(Model.Title))
                                    {
                                        <span class="text-body-tertiary"><kw-l key="announcements.detail_untitled">Untitled announcement</kw-l></span>
                                    }
                                    else
                                    {
                                        @Model.Title
                                    }
                                </h1>
                            </div>
                            @* One dedicated title per user-added translation
                               (only when it has one) — td-variant-title, shown in
                               place of the shared heading for that language; the
                               matching one shows first if ADR 0049 selects it over
                               the original. A translation with no title has NO
                               dedicated container — the shared heading stays. *@
                            @foreach (var t in Model.Translations.OrderBy(x => x.LanguageCode))
                            {
                                if (!string.IsNullOrWhiteSpace(t.Title))
                                {
                                    bool tDefault = String.Equals(t.LanguageCode, defaultVariant, StringComparison.OrdinalIgnoreCase);
                                    <div class="td-variant td-variant-title" data-td-variant="@t.LanguageCode"
                                         @(tDefault ? Html.Raw("") : Html.Raw(" style=\"display:none\""))>
                                        <h1 class="mb-0 kmb-detail-title">@t.Title</h1>
                                    </div>
                                }
                            }
                        </div>

                        @* The action surface (ADR 0082) — one ⋮ dropdown, the ADR 0069 /
                           ADR 0071 todo/board idiom. Edit is a plain link; translation
                           add / edit each open a Bootstrap modal (ADR 0071 "Add subtask"
                           shape); translation remove is a confirm form inside the menu.
                           The service's write-lane re-check at POST is the real gate —
                           the same standing rules the inline surface used (CanEdit,
                           CanTranslate, missingLanguages) are the only gates. *@
                        @if (Model.CanEdit || Model.CanTranslate)
                        {
                            <div class="dropdown flex-shrink-0">
                                <button class="btn btn-sm action-glyph-btn dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="@(ariaActionsFor.Replace("{0}", Model.Title))">⋮</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (Model.CanEdit)
                                    {
                                        <li>
                                            <a class="dropdown-item text-dark" href="/announcements/@Model.Id/edit">
                                                <kw-l key="announcements.edit_button">Edit</kw-l>
                                            </a>
                                        </li>
                                    }

                                    @* ADR 0048 — translation edit + remove (the
                                       inline <details> blocks are now modal/menu items). *@
                                    @if (Model.CanTranslate)
                                    {
                                        @foreach (var existing in Model.Translations.OrderBy(x => x.LanguageCode))
                                        {
                                            <li>
                                                <button type="button" class="dropdown-item text-dark"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="@($"#ann-trans-edit-{existing.LanguageCode}")">
                                                    <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                                </button>
                                            </li>
                                        }
                                        @foreach (var lang in missingLanguages)
                                        {
                                            <li>
                                                <button type="button" class="dropdown-item text-dark"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="@($"#ann-trans-add-{lang.Code}")">
                                                    <kw-l key="posts.translation_add">Add</kw-l> — <b>@LangName(lang.Code)</b>
                                                </button>
                                            </li>
                                        }
                                        <li><hr class="dropdown-divider" /></li>
                                        @foreach (var existing in Model.Translations.OrderBy(x => x.LanguageCode))
                                        {
                                            <li>
                                                <form method="post" action="@($"/announcements/{Model.Id}/translations/remove")"
                                                      data-confirm="@confirmRemoveTrans" style="margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <kw-l key="posts.translation_remove">Remove</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                                    </button>
                                                </form>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    @* ADR 0184 — the author byline sits under the title (the feed
                       card header: 44px avatar, name, date, edited). The <img>
                       links the audited serving lane (GET
                       /profile/avatar/{subjectId}) and on its fail-closed 404 the
                       monogram sibling takes over. *@
                    @{
                        string authorAvatarInitial = !string.IsNullOrWhiteSpace(Model.AuthorDisplayName)
                            ? char.ToUpperInvariant(Model.AuthorDisplayName.TrimStart()[0]).ToString()
                            : string.Empty;
                    }
                    <div class="airy-post-head kmb-detail-byline">
                        <kw-avatar subject="@Model.AuthorSubjectId" mono="@authorAvatarInitial"
                                  mono-hue="@AvatarHue.For(Model.AuthorSubjectId)" />
                        <span class="airy-post-author">
                            <span class="name">@Model.AuthorDisplayName</span>
                            <span class="when">
                                <kw-dt dt="@Model.Created" format="g"></kw-dt>
                                @if (Model.Modified is not null)
                                {
                                    <span> — <kw-l key="announcements.edited">edited</kw-l> <kw-dt dt="@Model.Modified.Value" format="g"></kw-dt></span>
                                }
                            </span>
                        </span>
                    </div>

                    @* Original variant's body (default-visible unless ADR 0049
                       auto-selects a translation of it into the viewer's
                       language — originalHidden — in which case the matching
                       dedicated title + body below show instead). The title now
                       lives in the title row above as td-variant-shared. *@
                    <div class="td-variant" data-td-variant="@Model.OriginalLanguageCode"
                         @(originalHidden ? Html.Raw(" style=\"display:none\"") : Html.Raw(""))>
                        @* The full body (the /announcements list shows the
                           first 250 characters and links here). Rendered
                           through the one MarkdownRenderer (R·1). *@
                        <div class="mb-3 rc-body"><partial name="_MentionRenderer" model="new MentionBodyModel(Model.Body, Model.AuthorSubjectId)" /></div>
                    </div>

                    @* One body per user-added translation — hidden by default,
                       EXCEPT the one matching the viewer's current language, which
                       ADR 0049 shows first (in place of the original); the rest
                       stay hidden behind their chip. The translation's TITLE is no
                       longer here — it lives on the title row above as a dedicated
                       td-variant-title, so the swap JS hides the shared fallback
                       heading in its place (the Posts/Detail idiom). *@
                    @foreach (var t in Model.Translations.OrderBy(x => x.LanguageCode))
                    {
                        bool tDefault = String.Equals(t.LanguageCode, defaultVariant, StringComparison.OrdinalIgnoreCase);
                        <div class="td-variant" data-td-variant="@t.LanguageCode"
                             @(tDefault ? Html.Raw("") : Html.Raw(" style=\"display:none\""))>
                            <div class="mb-3 rc-body"><partial name="_MentionRenderer" model="new MentionBodyModel(t.Body, Model.AuthorSubjectId)" /></div>
                        </div>
                    }

                    @* The chip row — a selector. The original chip is always
                       present (TD·1); one chip per added translation (TD·2). *@
                    <div class="mb-3 border-top pt-3">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="text-muted small fw-semibold">
                                <kw-l key="posts.translations_label">Translations</kw-l>
                            </span>
                            <button type="button" class="kmb-chip kmb-chip-btn"
                                    data-translation-chip data-td-group="announcement"
                                    data-td-variant="@Model.OriginalLanguageCode"
                                    aria-pressed="@(originalHidden ? "false" : "true")">
                                @LangName(Model.OriginalLanguageCode)
                            </button>
                            @foreach (var t in Model.Translations.OrderBy(x => x.LanguageCode))
                            {
                                <button type="button" class="kmb-chip kmb-chip-btn"
                                        data-translation-chip data-td-group="announcement"
                                        data-td-variant="@t.LanguageCode"
                                        aria-pressed="@(String.Equals(t.LanguageCode, defaultVariant, StringComparison.OrdinalIgnoreCase) ? "true" : "false")">
                                    @LangName(t.LanguageCode)
                                </button>
                            }
                        </div>

                        @* ADR 0048 + ADR 0029 translation lanes are now in the
                           ⋮ dropdown above (ADR 0082): edit / add each open a
                           Bootstrap modal, remove is a confirm form inside the
                           menu. The chip row above is the *selector* — it stays.* @*
                        @* (the old inline <details> blocks for edit / remove / add
                           were removed by ADR 0082 — the dropdown + modals are the
                           single action surface now) *@
                    </div>
                </div>
            </div>
        </div>

        @* ADR 0101 — the resident-comment surface. Rendered only when
           <c>Model.CanComment</c> is true: the viewer is **signed in** *and*
           the admin announcement-comments toggle is **on** (the
           <see cref="AnnouncementDetailViewModel.CanComment"/> read). A
           visitor, or a signed-in user with the toggle off, sees only the
           announcement body above — no comment list, no composer. A comment
           inherits the announcement's flat scope split (the C-M3·1
           "comment-inherits the parent's single decision" rule, with the flat
           split standing in for the to-do's <c>Read</c> decision) — so it is
           never visible where the announcement is not, and never to a
           visitor, even on a public-scope announcement. *@
        @if (Model.CanComment)
        {
            <section class="mt-4" id="announcement-comments">
                <h2 class="h5 mb-3"><kw-l key="announcements.comments">Comments</kw-l></h2>

                @{
                    string CommentBodyHtml(string body) => Kumunita.Web.Security.MarkdownRenderer.RenderHtml(body);
                }

                @if (Model.Comments.Count == 0)
                {
                    <p class="text-body-tertiary mb-3">
                        <kw-l key="announcements.comment_empty">No comments yet. Be the first to say something.</kw-l>
                    </p>
                }
                else
                {
                    <div class="kmb-detail-comments mb-3">
                        @foreach (var c in Model.Comments)
                        {
                            <div class="kmb-detail-comment">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="d-inline-flex align-items-center flex-shrink-0 me-2">
                                        <kw-avatar subject="@c.AuthorId" mono="@(string.IsNullOrWhiteSpace(c.AuthorDisplayName) ? string.Empty : char.ToUpperInvariant(c.AuthorDisplayName.TrimStart()[0]).ToString())" size="sm" mono-hue="@AvatarHue.For(c.AuthorId)" />
                                    </div>
                                    <div class="flex-grow-1" style="min-width:0;">
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="fw-semibold">@c.AuthorDisplayName</span>
                                            <span class="text-muted small"><kw-dt dt="@c.Created" format="g"></kw-dt></span>
                                            @if (c.DeletedAt is not null)
                                            {
                                                <span class="kmb-chip"><kw-l key="announcements.comment_deleted">This comment has been deleted by its author.</kw-l></span>
                                            }
                                            @if (c.IsAuthor && c.DeletedAt is null)
                                            {
                                                <form class="d-inline ms-2" method="post"
                                                      action="@($"/announcements/{Model.Id}/comments/{c.Id}/delete")"
                                                      style="margin:0;">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0"><kw-l key="announcements.comment_delete">Delete</kw-l></button>
                                                </form>
                                            }
                                        </div>
                                        @if (c.DeletedAt is null)
                                        {
                                            <div class="rc-body mt-1">@Html.Raw(CommentBodyHtml(c.Body))</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* The composer (the M3 / to-do reply-form shape: rc-editor +
                   language picker — ADR 0018 the authored-in tag). *@
                <div class="card kmb-detail-card kmb-detail-composer">
                    <div class="card-body">
                        <form class="mb-0" method="post" action="@($"/announcements/{Model.Id}/comments")">
                            @Html.AntiForgeryToken()
                            <label class="form-label" for="ann-comment-body" style="font-weight:600;">
                                <kw-l key="announcements.comment_reply">Comment</kw-l>
                            </label>
                            <div class="rc-editor">
                                <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                    <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                    <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                    <partial name="_RichEditorToggle" />
                                </div>
                                <textarea class="form-control mb-3" id="ann-comment-body" name="body" rows="3"
                                          required placeholder="…" data-rich-editor></textarea>
                                <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="ann-comment-language" style="font-weight:600;">
                                    <kw-l key="posts.reply_language_label">Language</kw-l>
                                </label>
                                <select class="form-control" id="ann-comment-language" name="languageCode">
                                    @foreach (var l in Model.CommentLanguages)
                                    {
                                        @* ADR 0049 — default to the language the resident is reading in *@
                                        <option value="@l.Code" selected="@(String.Equals(l.Code, defaultVariant, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@l.NativeName</option>
                                    }
                                </select>
                                <div class="text-muted small mt-1">
                                    <kw-l key="posts.reply_language_note">The language you're commenting in — a tag, not a translation.</kw-l>
                                </div>
                            </div>
                            <details class="kw-audience-disclosure mb-3">
                                <summary><kw-l key="announcements.comment_audience_note_label">Who can see comments?</kw-l></summary>
                                <div class="text-muted small">
                                    <kw-l key="announcements.comment_audience_note">Comments are visible to signed-in residents only, even on a public announcement, and under this announcement's own audience (a community-targeted one is visible to that community's residents).</kw-l>
                                </div>
                            </details>
                            <button type="submit" class="btn btn-primary"><kw-l key="announcements.comment_submit">Comment</kw-l></button>
                        </form>
                    </div>
                </div>
            </section>
        }
    </div>
</div>

@section Scripts {
    @* RE U06 — the rich editor (client/lib/rich-editor.ts, tsc-built).
       Self-wires the one .rc-editor block on this page (the
       name="body" announcement translation textarea); the image
       button is omitted (data-rich-editor-no-image — RC's
       announcement image serve branch is inert-404; RE·3).
       RE·3: no editor dependency. *@
    <script type="module" src="~/js/lib/rich-editor.js"></script>
}
