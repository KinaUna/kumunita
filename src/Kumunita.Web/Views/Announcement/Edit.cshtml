@model Kumunita.Web.Models.AnnouncementComposeViewModel
@using Kumunita.Core.Announcements
@{
    ViewData["Title"] = "Edit announcement";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <h1><kw-l key="announcements.edit_title">Edit announcement</kw-l></h1>
        <p class="text-muted">
            <kw-l key="announcements.edit_lede">Update this announcement's title, body, and visibility. A public announcement is visible to everyone, including people who are not signed in (e.g. a maintenance window). A resident announcement is only visible to signed-in residents (e.g. a "help us with X" call).</kw-l>
        </p>

        @if (TempData["info"] is string info)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <ul class="mb-0">
                    @foreach (var msg in ViewData.ModelState
                        .SelectMany(kvp => kvp.Value?.Errors ?? [])
                        .Select(e => e.ErrorMessage))
                    {
                        <li>@msg</li>
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form id="edit-announcement-form" method="post" action="/announcements/@Model.Id/edit">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="scope" style="font-weight:600;">
                        <kw-l key="announcements.scope_label">Who sees this?</kw-l>
                    </label>
                    <select class="form-control" id="scope" name="Scope" required>
                        @foreach (var s in Model.AllowedScopes)
                        {
                            string scopeValue = s.ToString();
                            bool isSelected = scopeValue == (Model.Scope ?? "Community");
                            <option value="@scopeValue" selected="@(isSelected ? "selected" : null)">
                                @if (s == AnnouncementScope.Public)
                                {
                                    <kw-l key="announcements.scope_public">Everyone (public) — visible to visitors and residents</kw-l>
                                }
                                else
                                {
                                    <kw-l key="announcements.scope_resident">Residents — visible only when signed in</kw-l>
                                }
                            </option>
                        }
                    </select>
                    <div class="text-muted small mt-2">
                        <kw-l key="announcements.edit_scope_hint">Changing who sees this applies immediately for the next reader.</kw-l>
                    </div>
                </div>
            </div>

            
@if (Model.TargetCommunities.Count > 0)
{
<div class="card mb-4"><div class="card-body">
<label class="form-label" for="community" style="font-weight:600;"><kw-l key="announcements.community_label">Send to a specific community (optional)</kw-l></label>
<select class="form-control" id="community" name="CommunityId">
<option value="" selected="@(Model.CommunityId is null ? "selected" : null)"><kw-l key="announcements.all_residents">All residents</kw-l></option>
@foreach (var t in Model.TargetCommunities)
{
<option value="@t.Id" selected="@(Model.CommunityId == t.Id ? "selected" : null)">@t.Name</option>
}
</select>
<div class="text-muted small mt-2"><kw-l key="announcements.community_hint">Leave as All residents to send to everyone, or pick a community to limit who sees it.</kw-l></div>
</div></div>
}

<div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="title" style="font-weight:600;">
                        <kw-l key="announcements.title_label">Title</kw-l>
                    </label>
                    <input class="form-control" type="text" id="title" name="Title"
                           maxlength="120" placeholder="optional"
                           value="@Model.Title" />
                    <div class="text-muted small mt-1">
                        <kw-l key="announcements.title_hint">A short headline (up to 120 characters).</kw-l>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="body" style="font-weight:600;">
                        <kw-l key="announcements.body_label">Body</kw-l>
                    </label>
                    <div class="rc-editor">
                        @* Image button ON — the announcement image lane is complete
                           (RC U05 persists Announcement.ImageIds on edit; the
                           /content-image/{id} serve branch gates on the announcement's
                           flat scope/communities visibility). *@
                        <div class="rc-editor-toolbar" data-rich-editor>
                            <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                            <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                            <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                            <button type="button" class="rc-btn" data-md="link"><kw-l key="rc.editor.link">Link</kw-l></button>
                            <button type="button" class="rc-btn" data-md="image"><kw-l key="rc.editor.image">Image</kw-l></button>
                            <button type="button" class="rc-btn" data-md="attach"><kw-l key="rc.editor.attach">Attach file</kw-l></button>
                            <partial name="_RichEditorToggle" />
                        </div>
                        <textarea class="form-control" id="body" name="Body"
                                  rows="6" required data-rich-editor>@Model.Body</textarea>
                        <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                    </div>
                </div>
            </div>

            @* ADR 0018 — the authored-in language picker (shared New/Edit partial).
               Pre-selected from the stored row's tag (AnnouncementController.Edit GET). *@
            <partial name="_AnnouncementLanguagePicker" model="Model" />

            <div class="card mb-4">
                <div class="card-body">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="pinned" name="Pinned"
                               value="true" checked="@(Model.Pinned ? "checked" : null)" />
                        <input type="hidden" name="Pinned" value="false" />
                        <label class="form-check-label" for="pinned" style="font-weight:600;">
                            <kw-l key="announcements.pin_label">Pin to the top of all pages</kw-l>
                        </label>
                        <div class="text-muted small mt-1">
                            <kw-l key="announcements.pin_hint">A pinned announcement also appears as a banner at the very top of every page (including Home), in addition to the usual Announcements list. Its visibility still follows the audience you picked above: a public pin shows to every visitor; a resident pin shows only when a user is signed in. If more than one is pinned, the most recently pinned one wins.</kw-l>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><kw-l key="announcements.edit_submit">Save changes</kw-l></button>
                <a href="/announcements" class="btn btn-link p-0"><kw-l key="announcements.cancel">Cancel</kw-l></a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @* The rich editor (RE U03, client/lib/rich-editor.ts, tsc-built —
       the toolbar + live preview pane. Self-wires the .rc-editor surface.
       RE·3: no editor dependency. *@
    <script type="module" src="~/js/lib/rich-editor.js"></script>
}
