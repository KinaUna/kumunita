@model Kumunita.Web.Models.AnnouncementIndexViewModel
@using Kumunita.Core.Announcements
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Kumunita.Core.SurfaceLabels.ISurfaceLabelsService SurfaceLabels
@{
    var _closeLang = await Kumunita.Web.Security.EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    var pinnedTip = Translation is null ? "Shown as a banner at the top of every page" : await Translation.GetAsync("announcements.pinned_tooltip", _closeLang);
}
@{
    ViewData["Title"] = "Announcements";
    bool isGlobalAdmin = Kumunita.Web.Security.KumunitaPrincipal.IsGlobalAdmin(User);
    bool isModerator = User?.Claims.Any(c => c.Type == Kumunita.Core.Identity.ClaimTypes.Role && c.Value == Kumunita.Core.Identity.Roles.Moderator) ?? false;
    string? subjectId = (User?.Identity?.IsAuthenticated == true) ? Kumunita.Web.Security.KumunitaPrincipal.SubjectId(User) : null;

    // M29 (ADR 0152) — the surface header label (M29·1: the same value the nav
    // item resolves — one resolver, one value, so a rename is never "nav says
    // X, header says Y"). A non-blank admin label wins; otherwise the
    // nav.announcements kw-l key resolves in the viewer's effective language.
    // Best-effort: GetLabelAsync never throws (a missing row / store degrades to
    // the kw-l floor), so a null/absent service only degrades to the raw kw-l
    // floor.
    string _surfaceTitle = "Announcements";
    if (SurfaceLabels is not null)
    {
        try
        {
            string surfaceLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
            _surfaceTitle = await SurfaceLabels.GetLabelAsync("announcements", "nav.announcements", surfaceLang);
        }
        catch
        {
            // A resolution failure must never blank the header (the kw-l floor).
        }
    }

    // The delete form's data-confirm (the ADR 0072 attribute idiom — the
    // confirm.js seam reads the attribute verbatim; the kw-l TagHelper can't
    // wrap an attribute). The en floor is the server fallback (a null provider
    // — a non-HTTP render — degrades to en).
    string confirmDelete = "Delete this announcement? This cannot be undone.";
    // ADR 0248 — the card footer's comment count (plural keys, English floor, the
    // posts.reply_count_* shape). Model.CommentCounts is null = show nothing.
    string cNone = "No comments yet", cOne = "{0} comment", cOther = "{0} comments";
    if (Translation is not null)
    {
        var effLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
        confirmDelete = await Translation.GetAsync("announcements.delete_confirm", effLang);
        if (Model.CommentCounts is not null)
        {
            cNone = await Translation.GetAsync("announcements.comment_count_none", effLang);
            cOne = await Translation.GetAsync("announcements.comment_count_one", effLang);
            cOther = await Translation.GetAsync("announcements.comment_count_other", effLang);
        }
    }
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <header class="airy-head">
            <div class="head-row">
                <div>
                    <h1>@_surfaceTitle</h1>
                    <p class="lede">
                        <kw-l key="announcements.index_lede">Platform notices: public ones are visible to everyone (e.g. scheduled maintenance); resident-only ones are visible to all signed-in users (e.g. "help us with X" calls).</kw-l>
                    </p>
                </div>
                @if (isGlobalAdmin || isModerator || (User?.Claims.Any(c => c.Type == Kumunita.Core.Identity.ClaimTypes.Role && c.Value.StartsWith("moderator:")) ?? false))
                {
                    <a class="btn btn-outline-primary" href="/announcements/new">
                        <kw-l key="announcements.new_button">New announcement</kw-l>
                    </a>
                }
            </div>
        </header>

        @* 2026-10-25 page-level notes lane (ADR 0167 amendment) — a note about
           the /announcements page itself (not about a specific announcement).
           The _NoteButton partial renders its own d-flex wrapper (the M37
           bookmark/note convention), so it sits right-aligned below the
           header. Signed-in residents only (the partial's ownerId gate). *@
        <div class="mb-2">
            @{ var _pn = ("page-announcements", "static", "/announcements"); }
            <partial name="_NoteButton" model="@_pn" />
        </div>

        <div class="kmb-ann-list">
            @* The shared sort control (the _Sort partial) sits at the TOP of
               the feed — above the list — so the sort options are the first
               thing the viewer sees (it renders nothing when the VM field is
               null, the no-sort pin). *@
            @if (Model.Sort is not null)
            {
                <partial name="_Sort" model="Model.Sort" />
            }
            @if (Model.Announcements.Count == 0)
            {
                <div class="kmb-empty">
                    <p class="kmb-empty-title"><kw-l key="announcements.empty">No announcements yet.</kw-l></p>
                </div>
            }
            @foreach (var a in Model.Announcements)
            {
                // Edit affordance — mirrors the controller's CanEditAnnouncement
                // (and the service's EnsureEditPermissionAsync gate at POST):
                // Public → GlobalAdmin; flat "all residents" (Community, no
                // target) → the author or a GlobalAdmin (a community moderator
                // who did not author it is denied, ADR 0017); community-
                // targeted → that community's moderator or a GlobalAdmin.
                bool canEdit = (a.Scope == AnnouncementScope.Public && isGlobalAdmin)
                    || (a.Scope == AnnouncementScope.Community && a.CommunityId is null && (isGlobalAdmin || (subjectId is not null && a.AuthorSubjectId == subjectId)))
                    || (a.Scope == AnnouncementScope.Community && a.CommunityId is not null && (isGlobalAdmin || (User?.Claims.Any(c => c.Type == Kumunita.Core.Identity.ClaimTypes.Role && c.Value == Kumunita.Core.Identity.Roles.ModeratorComponent(a.CommunityId)) ?? false)));
                // Author avatar monogram fallback (the Directory pattern —
                // avatar.ts hides the <img> on the 404 the serving lane
                // fails closed to; see site.css).
                string authorAvatarInitial = !string.IsNullOrWhiteSpace(a.AuthorDisplayName)
                    ? char.ToUpperInvariant(a.AuthorDisplayName.TrimStart()[0]).ToString()
                    : string.Empty;

                @* ADR 0183 — the announcement card (the feed card pattern,
                   ADR 0175): author header (44px avatar, name, date, scope and
                   pinned chips) -> title -> preview -> quiet actions. The body
                   is long by design (a pinned announcement can run to pages) —
                   the list shows only the first 250 characters; the full text
                   lives at the row's detail view (GET /announcements/{id}). *@
                <article class="airy-post-card kmb-ann-card@(a.Pinned ? " is-pinned" : "")">
                    <div class="airy-post-head">
                        <kw-avatar subject="@a.AuthorSubjectId" mono="@authorAvatarInitial"
                                  mono-hue="@AvatarHue.For(a.AuthorSubjectId)" />
                        <span class="airy-post-author">
                            <span class="name">@a.AuthorDisplayName</span>
                            <span class="when"><kw-dt dt="@a.Created" format="g"></kw-dt></span>
                        </span>
                        <span class="kmb-ann-chips">
                            @if (a.Pinned)
                            {
                                <span class="kmb-chip kmb-chip-pinned" title="@pinnedTip">
                                    <kw-l key="announcements.pinned_badge">pinned</kw-l>
                                </span>
                            }
                            <span class="kmb-chip">
                                @if (a.Scope == AnnouncementScope.Public)
                                {
                                    <kw-l key="announcements.scope_everyone">everyone</kw-l>
                                }
                                else if (a.CommunityDisplayName is not null)
                                {
                                    @a.CommunityDisplayName
                                }
                                else
                                {
                                    <kw-l key="announcements.scope_residents">residents</kw-l>
                                }
                            </span>
                        </span>
                    </div>
                    <h3 class="airy-post-title">
                        <a href="@Url.Action("Detail", "Announcement", new { id = a.Id })">@a.Title</a>
                    </h3>
                    <p class="airy-post-preview mb-0">
                        @MarkdownRenderer.PlainTextPreview(a.Body, 250)
                        <a href="@Url.Action("Detail", "Announcement", new { id = a.Id })"><kw-l key="announcements.read_more">Read more…</kw-l></a>
                    </p>
                    @{
                        int? commentCount = null;
                        if (Model.CommentCounts is not null)
                            commentCount = Model.CommentCounts.GetValueOrDefault(a.Id);
                    }
                    @if (canEdit || isGlobalAdmin || commentCount is not null)
                    {
                        @* Edit / Delete stay in different places (ADR 0017 edit
                           lane + the admin delete lane): Edit at the start of
                           the row, Delete at the end, so a misclick on one
                           can't hit the other. *@
                        <div class="airy-post-foot kmb-ann-actions">
                            @if (commentCount is { } cc)
                            {
                                @* ADR 0248 — links to the detail's comment section; shown only to a
                                   signed-in viewer when the admin comments toggle is on. *@
                                <a class="kmb-post-replies" href="@Url.Action("Detail", "Announcement", new { id = a.Id })#announcement-comments">
                                    <svg class="kmb-post-replies-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor"
                                         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                        <path d="M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z" />
                                    </svg>
                                    <span>@(cc == 0 ? cNone : (cc == 1 ? cOne : cOther).Replace("{0}", cc.ToString()))</span>
                                </a>
                            }
                            @if (canEdit)
                            {
                                <a class="link-quiet small text-decoration-none" href="/announcements/@a.Id/edit">
                                    <kw-l key="announcements.edit_button">Edit</kw-l>
                                </a>
                            }
                            @if (isGlobalAdmin)
                            {
                                <form method="post" action="/announcements/@a.Id/delete"
                                      data-confirm="@confirmDelete"
                                      class="ms-auto" style="margin:0; display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="link-quiet small text-danger text-decoration-none border-0 bg-transparent p-0">
                                        <kw-l key="announcements.delete">Delete</kw-l>
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </article>
            }

            @* M7 (ADR 0090 D5/D6) — the paged list's pager (F2 one-page
               no-render pin): the <c>_Pager</c> partial renders nothing when
               the VM field is null (a one-page surface). No filter form (D9)
               — the links carry ?page=N only. (The sort control now lives at
               the TOP of the list, above the items.) *@
            @if (Model.Pager is not null)
            {
                <partial name="_Pager" model="Model.Pager" />
            }
        </div>
    </div>
</div>
