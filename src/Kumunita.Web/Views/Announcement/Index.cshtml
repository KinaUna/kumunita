@model Kumunita.Web.Models.AnnouncementIndexViewModel
@using Kumunita.Core.Announcements
@{
    ViewData["Title"] = "Announcements";
    bool isGlobalAdmin = Kumunita.Web.Security.KumunitaPrincipal.IsGlobalAdmin(User);
    bool isModerator = User?.Claims.Any(c => c.Type == Kumunita.Core.Identity.ClaimTypes.Role && c.Value == Kumunita.Core.Identity.Roles.Moderator) ?? false;
    string? subjectId = (User?.Identity?.IsAuthenticated == true) ? Kumunita.Web.Security.KumunitaPrincipal.SubjectId(User) : null;
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <h1><kw-l key="announcements.index_title">Announcements</kw-l></h1>
        <p class="text-muted">
            <kw-l key="announcements.index_lede">Platform notices: public ones are visible to everyone (e.g. scheduled maintenance); resident-only ones are visible to all signed-in users (e.g. "help us with X" calls).</kw-l>
        </p>

        @if (TempData["info"] is string info)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold"><kw-l key="announcements.all">All announcements</kw-l></span>
                @if (isGlobalAdmin || isModerator || (User?.Claims.Any(c => c.Type == Kumunita.Core.Identity.ClaimTypes.Role && c.Value.StartsWith("moderator:")) ?? false))
                {
                    <a class="btn btn-sm btn-outline-primary" href="/announcements/new">
                        <kw-l key="announcements.new_button">New announcement</kw-l>
                    </a>
                }
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (Model.Announcements.Count == 0)
                    {
                        <li class="list-group-item text-muted">
                            <kw-l key="announcements.empty">No announcements yet.</kw-l>
                        </li>
                    }
                    @foreach (var a in Model.Announcements)
                    {
                        var badgeClass = a.Scope == AnnouncementScope.Public
                            ? "text-bg-secondary"
                            : "text-bg-primary";
                        // Edit affordance — mirrors the controller's CanEditAnnouncement
                        // (and the service's EnsureEditPermissionAsync gate at POST):
                        // Public → GlobalAdmin; flat "all residents" (Community, no
                        // target) → the author or a GlobalAdmin (a community moderator
                        // who did not author it is denied, ADR 0017); community-
                        // targeted → that community's moderator or a GlobalAdmin.
                        bool canEdit = (a.Scope == AnnouncementScope.Public && isGlobalAdmin)
                            || (a.Scope == AnnouncementScope.Community && a.CommunityId is null && (isGlobalAdmin || (subjectId is not null && a.AuthorSubjectId == subjectId)))
                            || (a.Scope == AnnouncementScope.Community && a.CommunityId is not null && (isGlobalAdmin || (User?.Claims.Any(c => c.Type == Kumunita.Core.Identity.ClaimTypes.Role && c.Value == Kumunita.Core.Identity.Roles.ModeratorComponent(a.CommunityId)) ?? false)));
                        // Author avatar monogram fallback (the Directory pattern —
                        // avatar.ts hides the <img> on the 404 the serving lane
                        // fails closed to; see site.css).
                        string authorAvatarInitial = !string.IsNullOrWhiteSpace(a.AuthorDisplayName)
                            ? char.ToUpperInvariant(a.AuthorDisplayName.TrimStart()[0]).ToString()
                            : string.Empty;

                        @* The body is long by design (a pinned announcement can
                           run to pages) — the list shows only the first 250
                           characters; the full text lives at the row's detail
                           view (GET /announcements/{id}). *@
                        <li class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="me-3">
                                    <h5 class="mb-1">
                                        <a href="@Url.Action("Detail", "Announcement", new { id = a.Id })" class="text-body">@a.Title</a>
                                    </h5>
                                    <div class="text-body">
                                        @(a.Body.Length > 250 ? a.Body[..250].TrimEnd() + "…" : a.Body)
                                        <a href="@Url.Action("Detail", "Announcement", new { id = a.Id })"><kw-l key="announcements.read_more">Read more…</kw-l></a>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 text-muted small mt-1">
                                        <span class="d-inline-flex align-items-center">
                                            <img class="avatar" src="/profile/avatar/@a.AuthorSubjectId" alt=""
                                                 data-avatar-fallback>
                                            <span class="avatar-mono" style="display:none;">@authorAvatarInitial</span>
                                        </span>
                                        <span>by @a.AuthorDisplayName — <kw-dt dt="@a.Created" format="ddd, MMM d yyyy"></kw-dt></span>
                                    </div>
                                </div>
                                <div class="d-flex flex-column align-items-end gap-2">
                                    <span class="badge @badgeClass">
                                        @if (a.Scope == AnnouncementScope.Public)
                                        {
                                            <kw-l key="announcements.scope_everyone">everyone</kw-l>
                                        }
                                        else if (a.CommunityDisplayName is not null)
                                        {
                                            @a.CommunityDisplayName
                                        }
                                        else
                                        {
                                            <kw-l key="announcements.scope_residents">residents</kw-l>
                                        }
                                    </span>
                                    @if (a.Pinned)
                                    {
                                        <span class="badge text-bg-warning" title="Shown as a banner at the top of every page">
                                            <kw-l key="announcements.pinned_badge">pinned</kw-l>
                                        </span>
                                    }
                                    @if (canEdit)
                                    {
                                        <a class="btn btn-sm btn-link p-0" href="/announcements/@a.Id/edit">
                                            <kw-l key="announcements.edit_button">Edit</kw-l>
                                        </a>
                                    }
                                    @if (isGlobalAdmin)
                                    {
                                        <form method="post" action="/announcements/@a.Id/delete"
                                              onsubmit="return confirm('Delete this announcement? This cannot be undone.');"
                                              style="margin:0; display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0">
                                                <kw-l key="announcements.delete">Delete</kw-l>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
