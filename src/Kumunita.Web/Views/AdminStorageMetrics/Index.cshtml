@model Kumunita.Web.Models.AdminStorageMetricsViewModel
@{
    ViewData["Title"] = "Admin — Storage";
}
@functions {
    @* A compact human byte formatter (IEC units) shared by the metric cards
       and the per-user table. A plain C# helper — no kw-l dependency. *@
    static string Bytes(long v)
    {
        string[] u = { "B", "KiB", "MiB", "GiB", "TiB", "PiB" };
        double n = v;
        int i = 0;
        while (n >= 1024 && i < u.Length - 1) { n /= 1024; i++; }
        return i == 0 ? $"{n:0} {u[i]}" : $"{n:0.##} {u[i]}";
    }

    @* M33 Trend sparkline (M33·10 — server-rendered, no JS / chart lib).
       Maps the window's TotalUsedBytes points (ascending) to a <polyline>
       points string in a 100×40 viewBox, normalised to the window's
       min/max (a flat window renders a flat mid line). One point per day
       present — gaps are simply not plotted (the M33-9 FACE). *@
    static string TrendPoints(IReadOnlyList<Kumunita.Core.Usage.StorageMetricsSample> pts)
    {
        if (pts.Count == 0) return "";
        if (pts.Count == 1) return "0,20 100,20";
        double[] vals = new double[pts.Count];
        double max = double.MinValue, min = double.MaxValue;
        for (int i = 0; i < pts.Count; i++)
        {
            double d = pts[i].TotalUsedBytes;
            vals[i] = d;
            if (d > max) max = d;
            if (d < min) min = d;
        }
        const double W = 100, H = 40, pad = 2;
        double range = max - min;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < vals.Length; i++)
        {
            double x = W * i / (vals.Length - 1);
            double norm = range > 0 ? (vals[i] - min) / range : 0.5;
            double y = H - pad - norm * (H - 2 * pad);
            if (i > 0) sb.Append(' ');
            sb.Append($"{x:0.##} {y:0.##}");
        }
        return sb.ToString();
    }
}

@* The /admin section sub-nav (the ADR 0062 nav-tabs idiom). This view sits in
   Views/AdminStorageMetrics/, so the shared partial — which lives in
   Views/Admin/ (the AdminController's own section) — must be referenced
   absolutely, the same shape as AdminAnalytics/Index.cshtml. *@
@await Html.PartialAsync("~/Views/Admin/_AdminNav.cshtml")

<h1>Storage</h1>
<p class="text-muted">
    A read-only view of the media byte store: how full the volume is, how much is
    resident content, and the space used per user. A point-in-time snapshot — no
    history, and no export in this version. Read-only: this page writes nothing.
</p>

@* The copy throughout is plain English: the admin shell's local convention
   (the /admin hub + Platform are mostly non-kw-l English), which keeps this
   view within M24's Web-only scope — no KnownTranslationKeys registration. *@

@* The four headline metrics (F1): total used, available, user-content used,
   as-of. Rendered as cards — the /admin hub's overview-card idiom. *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-4 fw-semibold">@Bytes(Model.TotalUsedBytes)</div>
                <div class="text-muted small">total used</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-4 fw-semibold">@Bytes(Model.AvailableBytes)</div>
                <div class="text-muted small">
                    @if (Model.PlatformLimitBytes > 0)
                    {
                        <span>available (platform limit @Bytes(Model.PlatformLimitBytes))</span>
                    }
                    else
                    {
                        <span>available</span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-4 fw-semibold">@Bytes(Model.UserContentUsedBytes)</div>
                <div class="text-muted small">user content</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-4 fw-semibold"><kw-dt dt="@Model.AsOf" format="g"></kw-dt></div>
                <div class="text-muted small">as of (UTC)</div>
            </div>
        </div>
    </div>
</div>

@* The aggregate counts (C-SM·2/4) — the context for the per-user table below.
   The single "unknown" bucket (files whose author was never captured) is a
   named row in that table (C-SM·5 / F5). *@
<p class="text-muted small mb-3">
    @Model.TotalUniqueFiles unique files across @Model.TotalDistinctUsers user(s).
    The per-user table below includes one "unknown / not captured" row for files
    whose author was never recorded.
</p>

@* The per-user table (F3/F4/F5) — paged, sorted descending by bytes used (the
   service orders it), one "unknown / not captured" bucket row when present.
   The created-by id is rendered raw: this is the operator's admin surface (the
   M13 analytics view likewise shows raw ids). *@
<h2 class="h5">Space used per user</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>User</th>
                <th class="text-end">Bytes</th>
                <th class="text-end">Files</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="3" class="text-muted">No user content captured yet.</td></tr>
            }
            @foreach (var r in Model.Items)
            {
                <tr>
                    <td class="text-break">
                        @if (string.IsNullOrEmpty(r.CreatedById))
                        {
                            <span class="text-muted fst-italic">unknown / not captured</span>
                        }
                        else
                        {
                            @r.CreatedById
                        }
                    </td>
                    <td class="text-end">@Bytes(r.Bytes)</td>
                    <td class="text-end">@r.FileCount</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* The M7 HasMore pager (C-SM·4 / F3). Only link to pages that exist: Prev when
   page &gt; 1, Next when HasMore is true. Plain interpolated hrefs with simple
   page arithmetic — no taghelper inside the attribute (the Razor attribute
   trap) and no @Model.X leaking literally. *@
<nav class="d-flex align-items-center gap-2 mt-2">
    <span class="text-muted small">Page @Model.Page</span>
    @if (Model.Page > 1)
    {
        <a class="btn btn-outline-primary btn-sm" href="/admin/storage?page=@(Model.Page - 1)">&larr; Prev</a>
    }
    @if (Model.HasMore)
    {
        <a class="btn btn-outline-primary btn-sm" href="/admin/storage?page=@(Model.Page + 1)">Next &rarr;</a>
    }
</nav>

@* ── M33 storage-metrics-history Trend section (M33·9 additive-only, M33·10) ──
   The over-time half the M24 point-in-time surface defers (ADR 0134 item 3).
   A per-day table (date · total used · free, ascending) + an inline <svg>
   sparkline (TotalUsedBytes over the window) + a window selector (30/90/180/
   365, the active one marked). No JS, no chart library — server-rendered
   (M33·10). The labels are the closed storage.trend.* kw-l set (U06 authors
   the values; this view references them, the kw-l TagHelper resolves them per
   request, the inner English text is the ADR 0015 D1 provider floor). *@
<h2 class="h5 mt-5"><kw-l key="storage.trend.title">Storage trend</kw-l></h2>

@* The window selector — four links, the active one (Model.WindowDays) marked
   via the btn-primary style rather than btn-outline (a plain class toggle, no
   kw-l dependency on the state). *@
<div class="d-flex align-items-center gap-2 mb-3">
    @{ int wd = Model.WindowDays; }
    @for (int w = 0; w < 4; w++)
    {
        int win = new[] { 30, 90, 180, 365 }[w];
        string key = "storage.trend.window." + win;
        string cls = (win == wd) ? "btn btn-primary btn-sm" : "btn btn-outline-secondary btn-sm";
        <a class="@cls" href="/admin/storage?window=@win"><kw-l key="@key">@win days</kw-l></a>
    }
</div>

@if (Model.History.Count == 0)
{
    @* M33-3 FACE — an empty history (a fresh instance, no samples captured
       yet) renders the empty message, not a blank and not an error. *@
    <p class="text-muted"><kw-l key="storage.trend.empty">No storage trend yet — the daily capture has not stored any samples for this window.</kw-l></p>
}
else
{
    @* The sparkline — an inline <svg> <polyline> over the window's
       TotalUsedBytes points (TrendPoints normalises to a 100×40 viewBox).
       preserveAspectRatio="none" lets it stretch to its container width. *@
    <div class="mb-3">
        <svg viewBox="0 0 100 40" preserveAspectRatio="none"
             class="d-block" style="width:100%;height:80px;background:#f8f9fa;">
            <polyline points="@TrendPoints(Model.History)"
                      fill="none" stroke="#0d6efd" stroke-width="1"
                      vector-effect="non-scaling-stroke" />
        </svg>
        <div class="text-muted small mt-1"><kw-l key="storage.trend.legend.used">Total used over window</kw-l></div>
    </div>

    @* The per-day table — one row per sample, ascending (the seam orders it);
       SampleDate via the kw-dt TagHelper (the request's locale); the bytes
       columns reuse the Bytes() helper above. *@
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th><kw-l key="storage.trend.col.date">Date</kw-l></th>
                    <th class="text-end"><kw-l key="storage.trend.col.used">Total used</kw-l></th>
                    <th class="text-end"><kw-l key="storage.trend.col.free">Free</kw-l></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.History)
                {
                    <tr>
                        <td><kw-dt dt="@s.SampleDate" format="d"></kw-dt></td>
                        <td class="text-end">@Bytes(s.TotalUsedBytes)</td>
                        <td class="text-end">@Bytes(s.FreeVolumeBytes)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
