@model IReadOnlyList<Kumunita.Web.Controllers.LanguagesController.LanguageRowViewModel>
@using Kumunita.Web.Security
@{
    ViewData["Title"] = "Languages";
    // ADR 0021 — the split surface: a GlobalAdmin sees the full catalog
    // (add / enable / reorder / set-default / remove) *and* the translation
    // editors; a Translator sees only the completeness view + the per-language
    // "UI strings" editor. isGlobalAdmin gates the catalog controls below (the
    // controller gates the same actions with [Authorize]).
    bool isGlobalAdmin = KumunitaPrincipal.IsGlobalAdmin(User);
}

<h1>Languages</h1>
<p class="text-muted">
    @if (isGlobalAdmin)
    {
        <text>
            Manage the languages this instance supports. Changes take effect on the
            next request — no rebuild, no restart.
        </text>
    }
    else
    {
        <text>
            Review the platform's translation coverage and update the UI strings.
            Changes take effect on the next request.
        </text>
    }
</p>

@if (TempData["info"] is string info)
{
    <div class="alert alert-success" role="alert">@info</div>
}
@if (TempData["error"] is string err)
{
    <div class="alert alert-danger" role="alert">@err</div>
}

@if (isGlobalAdmin)
{
    <!-- ── Add a language (GlobalAdmin-only, ADR 0021) ─────────────────────── -->
    <h2 class="mt-4">Add a language</h2>
    <form method="post" action="/admin/languages" class="row g-2 align-items-end mb-4">
        @Html.AntiForgeryToken()
        <div class="col-sm-3">
            <label for="code" class="form-label">Language code</label>
            <input type="text" class="form-control" name="code" id="code"
                   required placeholder="pl" maxlength="16" />
            <div class="form-text small">Short code, e.g. pl for Polish, no-NO for Norwegian.</div>
        </div>
        <div class="col-sm-4">
            <label for="nativeName" class="form-label">Native name</label>
            <input type="text" class="form-control" name="nativeName" id="nativeName"
                   required placeholder="Polski" maxlength="64" />
        </div>
        <div class="col-sm-3">
            <button type="submit" class="btn btn-primary">Add</button>
        </div>
    </form>
}

<!-- ── Existing languages ───────────────────────────────────────────────── -->
<h2>Supported languages</h2>

@if (isGlobalAdmin)
{
    @* Reorder form — all current codes in display order. (GlobalAdmin-only, ADR 0021) *@
    <form method="post" action="/admin/languages/reorder" class="mb-3">
        @Html.AntiForgeryToken()
        @for (var i = 0; i < Model.Count; i++)
        {
            <input type="hidden" name="codesInOrder" value="@Model[i].Code" />
        }
        <button type="submit" class="btn btn-outline-secondary btn-sm"
                title="Submit the current order (as shown below) as the new sort order">
            Reorder (confirm current order)
        </button>
        <span class="text-muted small ms-2">
            Drag-and-drop reordering is not available; the reorder form accepts the
            codes in the order they appear here. To change the order, the admin
            should submit the list in the desired sequence.
        </span>
    </form>
}

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Code</th>
                <th>Native name</th>
                <th>Enabled</th>
                <th>UI keys</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td><code>@row.Code</code></td>
                    <td>@row.NativeName</td>
                    <td>
                        @if (row.Enabled)
                        {
                            <span class="badge text-bg-success">enabled</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">disabled</span>
                        }
                    </td>
                    <td>
                        <span class="text-success small">@row.PresentKeys.Count present</span>
                        @if (row.MissingKeys.Count > 0)
                        {
                            <span class="text-warning small">· @row.MissingKeys.Count missing</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <div class="btn-group btn-group-sm" role="group">
                            @if (isGlobalAdmin)
                            {
                                @if (row.Enabled)
                                {
                                    <form method="post" action="/admin/languages/@row.Code/disable" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary">Disable</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="/admin/languages/@row.Code/enable" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary">Enable</button>
                                    </form>
                                }

                                <form method="post" action="/admin/languages/@row.Code/default" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-primary">Set default</button>
                                </form>
                            }

                            @* Translation editor — open to both GlobalAdmin and Translator (ADR 0021). *@
                            <a href="/admin/languages/@row.Code/translations"
                               class="btn btn-outline-info">UI strings</a>

                            @if (isGlobalAdmin)
                            {
                                <form method="post" action="/admin/languages/@row.Code" class="d-inline"
                                      data-confirm="Remove @row.Code? Its translation rows are retained and will be restored if the language is re-added.">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger">Remove</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
