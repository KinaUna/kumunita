@model Kumunita.Web.Controllers.LanguagesController.TranslationEditorViewModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@{
    ViewData["Title"] = $"UI strings — {Model.Code}";
    // The lede, the row-value aria-label, and the per-code strings (title /
    // th_value / value_aria) carry inlined values ({0}/{1}) — server-resolved
    // (the kw-l TagHelper does not interpolate), the ADR 0049 effective-language
    // chain.
    string? effLang = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    string editorTitleRaw = "UI strings for {0}";
    string editorLedeRaw = "The full list of strings the platform shows to its residents. Each row shows the key, its English reference text, and the current value in {0}. Saving a row adds or updates its translation — visible on the next request.";
    string thValueRaw = "Value in {0}";
    string valueAriaTemplate = "Value for {0} in {1}";
    string modeLabel = "Editor mode";
    if (Translation is not null)
    {
        editorTitleRaw = await Translation.GetAsync("translations.editor.title", effLang);
        editorLedeRaw = await Translation.GetAsync("translations.editor.lede", effLang);
        thValueRaw = await Translation.GetAsync("translations.editor.th_value", effLang);
        valueAriaTemplate = await Translation.GetAsync("translations.editor.value_aria", effLang);
        modeLabel = await Translation.GetAsync("translations.editor.mode_label", effLang);
    }
    var editorTitle = editorTitleRaw.Replace("{0}", Model.Code);
    var editorLede = editorLedeRaw.Replace("{0}", Model.Code);
    var thValue = thValueRaw.Replace("{0}", Model.Code);

    // M15 U05 (ADR 0116, D6) — the quiet mode toggle (two kw-l links, plain
    // <a>, no JS): each link points at the *other* mode of this same view —
    // one view, two modes (D6). The per-row editor below is the frozen
    // Single lane (byte-identical, C-M15·7); the batch form above it renders
    // only when the ?batch=true flag is set.
    var isBatch = Model.Mode == Kumunita.Web.Controllers.LanguagesController.TranslationEditorMode.Batch;
}

<p>
    <a href="/admin/languages" class="btn btn-outline-secondary btn-sm mb-3"><kw-l key="translations.editor.back">← Back to languages</kw-l></a>
</p>

<h1>@editorTitle</h1>

@* ── M15 U05 (ADR 0116, D6) — the quiet top toggle: two kw-l links (plain
   <a>, no JS) switching between the two modes of this same view. The
   current mode's link is styled as the active state (Bootstrap .active);
   the other mode is the link. The per-row editor below is the frozen lane
   (byte-identical, C-M15·7) — the toggle is additive markup above it. *@
<div class="d-inline-flex btn-group mb-3" role="group" aria-label="@modeLabel">
    <a href="/admin/languages/@Model.Code/translations"
       class="btn btn-sm @(isBatch ? "btn-outline-secondary" : "btn-secondary active")">
        <kw-l key="translations.bulk.mode_single">Edit one at a time</kw-l>
    </a>
    <a href="/admin/languages/@Model.Code/translations?batch=true"
       class="btn btn-sm @(isBatch ? "btn-secondary active" : "btn-outline-secondary")">
        <kw-l key="translations.bulk.mode_batch">Batch editing</kw-l>
    </a>
</div>

<p class="text-muted">
    @editorLede
</p>

@* ── M15 U05 (ADR 0116, D6) — the batch form (one view, two modes): the
   same closed key list (the Model.Rows loop, D1), one text input per key,
   one "Save all" button posting the save-all route → the U03
   SaveAllTranslationsAsync seam + the one translation.save_all audit row
   (C-M15·6). A blank input is a no-op (C-M15·4 — the service drops blank
   values; the form never erases a row). The kw-l labels are the U05
   translations.bulk.save_all key; the maxlength / aria-label idiom matches
   the per-row inputs below. Renders only in Batch mode — the per-row
   editor below stays byte-identical when the flag is absent (C-M15·7). *@
@if (isBatch)
{
    <div class="card mb-4">
        <div class="card-body">
            <form method="post" action="/admin/languages/@Model.Code/translations/save-all">
                @Html.AntiForgeryToken()
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th><kw-l key="translations.editor.th_key">Key</kw-l></th>
                                <th><kw-l key="translations.editor.th_en_reference">English reference</kw-l></th>
                                <th>@thValue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td class="text-nowrap"><code>@row.Key</code></td>
                                    <td>@row.EnReference</td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm"
                                               name="@row.Key" value="@row.CurrentValue" maxlength="512"
                                               aria-label="@valueAriaTemplate.Replace("{0}", row.Key).Replace("{1}", Model.Code)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <kw-l key="translations.bulk.save_all">Save all</kw-l>
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* ── M15 U04 (ADR 0116, D2/D4) — the bulk upload affordance ─────────────────
   Additive (C-M15·7: the per-row editor below stays byte-identical). The
   form posts to the `import` route (the IFormFile → TranslationBulkImporter
   → UpsertManyTranslationsAsync compose). A success is flashed via the
   _FlashToast partial (the TempData["info"] the route writes); a refusal is
   a 422 + TempData["error"] naming the first offending row (C-M15·3) — the
   same _FlashToast surface (the house convention, the Portability.cshtml
   precedent). The kw-l labels are the U04 `translations.bulk.import` +
   `translations.bulk.import_hint` keys; the en fallback is the registry
   floor (M·1). *@
<div class="card mb-4">
    <div class="card-body">
        <div class="fw-semibold mb-2"><kw-l key="translations.bulk.import">Upload translations (CSV)</kw-l></div>
        <small class="text-muted d-block mb-3">
            <kw-l key="translations.bulk.import_hint">Blank cells are skipped (they never erase a translation); a file with an unknown key or language is refused unchanged.</kw-l>
        </small>
        <form method="post" action="/admin/languages/@Model.Code/translations/import" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="row g-2 align-items-end">
                <div class="col-sm-8">
                    <input type="file" name="bundle" class="form-control" accept=".csv,text/csv" />
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-primary"><kw-l key="translations.bulk.import">Upload translations (CSV)</kw-l></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th><kw-l key="translations.editor.th_key">Key</kw-l></th>
                <th><kw-l key="translations.editor.th_en_reference">English reference</kw-l></th>
                <th>@thValue</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td class="text-nowrap"><code>@row.Key</code></td>
                    <td>@row.EnReference</td>
                    <td>
                        <form method="post" action="/admin/languages/@Model.Code/translations" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="key" value="@row.Key" />
                            <input type="text" class="form-control form-control-sm"
                                   name="text" value="@row.CurrentValue" maxlength="512"
                                   aria-label="@valueAriaTemplate.Replace("{0}", row.Key).Replace("{1}", Model.Code)" />
                            <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap"><kw-l key="common.save">Save</kw-l></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
