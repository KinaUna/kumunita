@model Kumunita.Web.Controllers.LanguagesController.PageEditorViewModel
@{
    ViewData["Title"] = $"Edit — {Model.Slug} ({Model.Code})";
}

<p>
    <a href="/admin/languages" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back to languages</a>
    <a href="/admin/languages/@Model.Code/translations" class="btn btn-outline-info btn-sm mb-3">UI strings</a>
</p>

<h1>Page: <code>@Model.Slug</code> — @Model.Code</h1>

@if (TempData["info"] is string info)
{
    <div class="alert alert-success" role="alert">@info</div>
}
@if (TempData["error"] is string err)
{
    <div class="alert alert-danger" role="alert">@err</div>
}

@if (!Model.HasSaved)
{
    <div class="alert alert-info" role="alert">
        No saved translation for this page in <strong>@Model.Code</strong> yet.
        Fill in the title and body below, then save.
    </div>
}

<!-- ── Static-page editor (SavePage) ────────────────────────────────────── -->
<form method="post" action="/admin/languages/@Model.Code/pages/@Model.Slug" class="mb-5">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" class="form-control" name="title" id="title"
               value="@Model.Title" maxlength="200" />
    </div>

    <div class="mb-3">
        <label for="body" class="form-label">Body (Markdown)</label>
        @* RE U06 — the toolbar + live preview split view (U04's canonical
           pattern, image ON — RC's static-page image lane is complete:
           SavePage populates ImageIds; the page serve branch is public).
           name="body" stays LOWERCASE (LanguagesController.SavePage binds
           it lowercase — do not normalize). font-monospace dropped: the
           split view is the source/preview affordance. The Image button
           (toolbar) is the single image path — the former rc-insert-image
           file-input block is removed as a redundant secondary affordance. *@
        <div class="rc-editor">
            <div class="rc-editor-toolbar" data-rich-editor>
                <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                <button type="button" class="rc-btn" data-md="link"><kw-l key="rc.editor.link">Link</kw-l></button>
                <button type="button" class="rc-btn" data-md="image"><kw-l key="rc.editor.image">Image</kw-l></button>
                <button type="button" class="rc-btn" data-md="attach"><kw-l key="rc.editor.attach">Attach file</kw-l></button>
                <partial name="_RichEditorToggle" />
            </div>
            <textarea class="form-control" name="body" id="body"
                      rows="16" style="min-height: 12rem;"
                      data-rich-editor>@Model.Body</textarea>
            <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
        </div>
        <div class="form-text small">
            Supports: headings (#), paragraphs, lists (-), **bold**, *italic*,
            `code`, [links](url), ![image](/content-image/…), fenced code blocks.
            Raw HTML is escaped.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save page</button>
</form>

@section Scripts {
    @* RE U06 — the rich editor (client/lib/rich-editor.ts, tsc-built —
       the toolbar + live preview pane above. Self-wires the .rc-editor
       surface; the image button reuses RC's CSRF-aware apiFetch upload.
       RE·3: no editor dependency. *@
    <script type="module" src="~/js/lib/rich-editor.js"></script>
}
