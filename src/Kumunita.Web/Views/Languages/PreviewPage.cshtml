@model Kumunita.Web.Controllers.LanguagesController.PageEditorViewModel
@{
    ViewData["Title"] = $"Edit — {Model.Slug} ({Model.Code})";
}

<p>
    <a href="/admin/languages" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back to languages</a>
    <a href="/admin/languages/@Model.Code/translations" class="btn btn-outline-info btn-sm mb-3">UI strings</a>
</p>

<h1>Page: <code>@Model.Slug</code> — @Model.Code</h1>

@if (TempData["info"] is string info)
{
    <div class="alert alert-success" role="alert">@info</div>
}
@if (TempData["error"] is string err)
{
    <div class="alert alert-danger" role="alert">@err</div>
}

@if (!Model.HasSaved)
{
    <div class="alert alert-info" role="alert">
        No saved translation for this page in <strong>@Model.Code</strong> yet.
        Fill in the title and body below, then save.
    </div>
}

<!-- ── Static-page editor (SavePage) ────────────────────────────────────── -->
<form method="post" action="/admin/languages/@Model.Code/pages/@Model.Slug" class="mb-5">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" class="form-control" name="title" id="title"
               value="@Model.Title" maxlength="200" />
    </div>

    <div class="mb-3">
        <label for="body" class="form-label">Body (Markdown)</label>
        <textarea class="form-control font-monospace" name="body" id="body"
                  rows="16" style="min-height: 12rem;" data-image-target>@Model.Body</textarea>
        <div class="rc-insert-image mt-2">
            <input type="file"
                   accept="image/jpeg,image/png,image/webp,image/gif"
                   data-insert-image />
            <span data-insert-image-error class="text-danger small d-block mt-1" style="min-height:1em;"></span>
        </div>
        <div class="form-text small">
            Supports: headings (#), paragraphs, lists (-), **bold**, *italic*,
            `code`, [links](url), ![image](/content-image/…), fenced code blocks.
            Raw HTML is escaped. Pick a photo to embed it in the body as a
            Markdown image link.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save page</button>
</form>

@section Scripts {
    @* RC U05 composer image control (client/lib/insert-image.ts, tsc-built —
       SECURITY.md §6: no inline <script>; self-wires the
       input[data-insert-image] + textarea[data-image-target] pair above.
       Upload is CSRF-aware via client/lib/api.ts + the layout's
       <meta name="anti-forgery-token"> (drift pause e, resolved U05). *@
    <script type="module" src="~/js/lib/insert-image.js"></script>
}
