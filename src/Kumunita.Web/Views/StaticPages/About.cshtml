@using Kumunita.Web
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.SiteContent.ISiteContentService SiteContentService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model Kumunita.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "About";
    // Landing-style page: opt out of the shared .container so sections
    // run full-bleed (see _Layout.cshtml and the .kmb-* rules in site.css).
    ViewData["FullBleed"] = true;

    // Effective-language resolution (ADR 0049 chain: cookie → Accept-Language
    // → instance default → en), the same seam the "What's new" toast partial
    // uses for its {v}-substituted strings. Used to resolve the changelog's
    // "show more" remaining-count label (the kw-l TagHelper does not
    // substitute {n}, so the value is resolved here and passed to the JS
    // module via data-whatsnew-label).
    var effLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);

    // The section aria-labels are server-resolved (the kw-l TagHelper can't wrap
    // an attribute). The closed set: the a11y.about_* short
    // names (the visible headings are long; screen readers prefer short names).
    string ariaFeatures   = await Translation.GetAsync("a11y.about_features", effLang);
    string ariaAudience   = await Translation.GetAsync("a11y.about_audience", effLang);
    string ariaPhilosophy = await Translation.GetAsync("a11y.about_philosophy", effLang);
    string ariaProject    = await Translation.GetAsync("a11y.about_project", effLang);
    string ariaWhatsNew   = await Translation.GetAsync("whatsnew.heading", effLang);
    string ariaContact    = await Translation.GetAsync("a11y.about_contact", effLang);

    // ADR 0157 — the SITE-2 hero-translation overlay (the ADR 0150 §D5 "future
    // SITE-2 translation lane"). When the effective language has a
    // SiteContentTranslation row, its About-hero field renders in place of the
    // singleton's value; a null / blank hero field falls back to the singleton
    // value, then to the in-code floor (SITE·3 / SITE·1: never a blank page).
    // Best-effort read: a missing seam or a read failure yields the singleton
    // value (the page always renders). A public landing-surface read (ADR 0150
    // D2) — never a decision, audited at the write only.
    Kumunita.Core.SiteContent.SiteContentTranslation? heroTrans = null;
    try {
        var siteTranslations = await SiteContentService.GetTranslationsAsync().ConfigureAwait(false);
        heroTrans = siteTranslations.FirstOrDefault(x =>
            System.String.Equals(x.LanguageCode, effLang, System.StringComparison.OrdinalIgnoreCase));
    }
    catch { heroTrans = null; }
    string AboutHeroEyebrow =
        !string.IsNullOrWhiteSpace(heroTrans?.AboutHeroEyebrow) ? heroTrans!.AboutHeroEyebrow!
        : Model.Site?.AboutHeroEyebrow ?? "Private by default";
    string AboutHeroLead =
        !string.IsNullOrWhiteSpace(heroTrans?.AboutHeroLead) ? heroTrans!.AboutHeroLead!
        : Model.Site?.AboutHeroLead ?? "One home for everything your neighborhood does — the feed, the groups, and the notes that deserve better than a group chat. Private, plain-language, and yours.";
}

<!-- ══════════ 1. Hero ══════════ -->
<section class="kmb-hero">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-12 col-lg-9">
                <div class="eyebrow">@AboutHeroEyebrow</div>
                <h1 class="display-5 mb-4">@Model.CommunityName</h1>
                <p class="kmb-hero-lead mx-auto mb-4" style="max-width: 42rem;">
                    @AboutHeroLead
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3 kmb-hero-actions">
                    <a asp-controller="Posts" asp-action="AllSections" class="btn btn-pill btn-primary">
                        <kw-l key="about.cta_feed">See the feed</kw-l>
                    </a>
                    <a href="/announcements" class="btn btn-pill btn-hero-ghost">
                        <kw-l key="about.cta_notes">Read the pinned notes</kw-l>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════ 2. Feature cards (floating over the dark band) ══════════ -->
@if (Model.Site?.AboutShowFeatures ?? true)
{
<section class="kmb-features" aria-label="@ariaFeatures">
    <div class="kmb-features-band">
        <div class="container">
            <div class="row g-4 justify-content-center">
                <div class="col-12 col-sm-8 col-md-4">
                    <div class="kmb-feat-card">
                        <div class="kmb-feat-icon mb-3" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7a8.5 8.5 0 1 1 16.1-3.8z"/>
                            </svg>
                        </div>
                        <h3 class="kmb-feat-title"><kw-l key="about.features.one.title">One feed for the street</kw-l></h3>
                        <p><kw-l key="about.features.one.body">Posts and threads from your blocks and lanes, in one quiet place — no algorithm, no noise.</kw-l></p>
                    </div>
                </div>
                <div class="col-12 col-sm-8 col-md-4">
                    <div class="kmb-feat-card">
                        <div class="kmb-feat-icon kmb-feat-icon-warm mb-3" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </div>
                        <h3 class="kmb-feat-title"><kw-l key="about.features.groups.title">Groups that fit</kw-l></h3>
                        <p><kw-l key="about.features.groups.body">Garden swap, book club, street watch — a group for whatever the neighbourhood already does.</kw-l></p>
                    </div>
                </div>
                <div class="col-12 col-sm-8 col-md-4">
                    <div class="kmb-feat-card">
                        <div class="kmb-feat-icon mb-3" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 17v5"/>
                                <path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1z"/>
                            </svg>
                        </div>
                        <h3 class="kmb-feat-title"><kw-l key="about.features.pinned.title">Pinned where it matters</kw-l></h3>
                        <p><kw-l key="about.features.pinned.body">Water cuts, roadworks, the new speed bumps — notes that stay put instead of scrolling away.</kw-l></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
}

<!-- ══════════ 4. Scope: built for a neighbourhood, at home anywhere ══════════ -->
@if (Model.Site?.AboutShowScope ?? true)
{
<section class="kmb-section" aria-label="@ariaAudience">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9">
                <div class="eyebrow"><kw-l key="platform.scope_eyebrow">For any group</kw-l></div>
                <h2 class="h3 mt-2"><kw-l key="platform.scope_heading">Built for a neighbourhood — at home anywhere</kw-l></h2>
                <p class="kmb-section-lead mt-3" style="max-width: 46rem;">
                    <kw-l key="platform.scope_body1">Kumunita was originally built for one street: a private, shared home for the people who live there. But the core idea is not tied to a street at all. It is a private home for one group of people who want to coordinate, share, and build trust together — a neighbourhood, a club, a sports team, a workplace, a volunteer body, or even the people behind a single event. What changes is only the name and the details.</kw-l>
                </p>
                <p class="kmb-section-lead mt-3" style="max-width: 46rem;">
                    <kw-l key="platform.scope_body2">Everything that makes it fit a street — the quiet feed, the groups, the audience-scoped posts, the moderation and its audit trail, the multilingual interface — works the same way for any of those. So adapting it is a matter of configuration: the community name, the components that stand in for 'Safety' and 'Social', the groups that fit your world. Not a redesign.</kw-l>
                </p>
            </div>
        </div>
    </div>
</section>
}

<!-- ══════════ 5. The philosophy: FIG ══════════ -->
@if (Model.Site?.AboutShowPhilosophy ?? true)
{
<section class="kmb-section kmb-section-tint-a" aria-label="@ariaPhilosophy">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9">
                <div class="eyebrow"><kw-l key="platform.fig_eyebrow">The philosophy</kw-l></div>
                <h2 class="h3 mt-2"><kw-l key="platform.fig_heading">The idea behind it: the Fractal Integration Guidelines</kw-l></h2>
                <p class="kmb-section-lead mt-3" style="max-width: 46rem;">
                    <kw-l key="platform.fig_body1">Kumunita is built on a small set of open guidelines we call the Fractal Integration Guidelines (FIG). Their central claim is that an integrated system is more than the sum of its parts, and that its quality is the quality of the linkage between those parts — a property no single part has on its own. A bag of features that never connect is just noise; the connections are where the value lives.</kw-l>
                </p>
                <p class="kmb-section-lead mt-3" style="max-width: 46rem;">
                    <kw-l key="platform.fig_body2">A neighbourhood is exactly such a system: many different people, households, and concerns, whose linkage — who knows whom, who can rely on whom, how a problem actually gets solved across people — is what produces a community. No single resident is a neighbourhood. Kumunita is the software that builds and holds that linkage.</kw-l>
                </p>
                <p class="kmb-section-lead mt-3" style="max-width: 46rem;">
                    <kw-l key="platform.fig_body3">So we develop Kumunita by the same rule we ask of it: quality is the quality of the linkage, not the count of the features. The guidelines repeat at every scale — a module, a feature, a community, the people who build it — which is why the whole project follows them, and why the philosophy is documented in the open.</kw-l>
                </p>
            </div>
        </div>
    </div>
</section>
}

<!-- ══════════ 6. Code, docs & links ══════════ -->
@if (Model.Site?.AboutShowProject ?? true)
{
<section class="kmb-section" aria-label="@ariaProject">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-12 col-lg-8">
                <div class="eyebrow"><kw-l key="about.project.eyebrow">Open source</kw-l></div>
                <h2 class="h3 mt-2"><kw-l key="about.project.heading">The code, the decisions, the design docs</kw-l></h2>
                <p class="kmb-section-lead mx-auto mt-3" style="max-width: 42rem;">
                    <kw-l key="about.project.lead">If you're curious how it works — or if you're about to host it for your neighbourhood — everything is public.</kw-l>
                </p>
            </div>
        </div>
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-5">
            @foreach (var link in RepositoryInfo.Links)
            {
                <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                   class="btn btn-pill btn-outline-primary btn-sm">
                    <kw-l key="@link.Key">@link.Label</kw-l>
                    <span aria-hidden="true">&#8599;</span>
                </a>
            }
        </div>
    </div>
</section>
}

<!-- ══════════ What's new (the VN lane, ADR 0110) ══════════ -->
@if (Model.Site?.AboutShowWhatsNew ?? true)
{
<section class="kmb-section" id="whats-new" aria-label="@ariaWhatsNew">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-12 col-lg-8">
                <div class="eyebrow"><kw-l key="whatsnew.eyebrow">What's new</kw-l></div>
                <h2 class="h3 mt-2"><kw-l key="whatsnew.heading">What's new, version by version</kw-l></h2>
                <p class="kmb-section-lead mx-auto mt-3" style="max-width: 42rem;">
                    <kw-l key="whatsnew.lead">Every release is dated and listed here — read what landed in each minor version of the platform you are using.</kw-l>
                </p>
            </div>
        </div>
        <div class="row justify-content-center mt-5">
            <div class="col-12 col-lg-9">
                @{ int _whi = 0; }
                <ol class="list-unstyled d-flex flex-column gap-4 mb-0" id="whatsnew-list">
                    @foreach (var v in WhatsNew.All)
                    {
                        bool _hidden = _whi >= 3;
                        <li class="kmb-whatsnew-entry border rounded p-3 p-md-4"
                            @if (_hidden) { <text>hidden</text> }>
                            <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
                                <span class="fw-semibold">
                                    <kw-l key="whatsnew.version">Version</kw-l>
                                    <span>@v.Version</span>
                                </span>
                                <time datetime="@v.Date" class="text-secondary">@v.Date</time>
                            </div>
                            <ul class="mb-0">
                                @foreach (var change in v.Changes)
                                {
                                    <li>@change</li>
                                }
                            </ul>
                        </li>
                        _whi++;
                    }
                </ol>
                @if (WhatsNew.All.Count > 3)
                {
                    // The "N earlier" label is resolved server-side (the kw-l
                    // TagHelper cannot substitute {n}), then the count is filled
                    // in with the same C# `.Replace` the toast partial uses for
                    // its {v} — so the button's initial text is already correct
                    // on first paint, and the JS module just refreshes it as
                    // the resident clicks.
                    var _remainingCount = WhatsNew.All.Count - 3;
                    var _remainingLabelRaw = Translation is null
                        ? null
                        : await Translation.GetAsync("whatsnew.show_more_remaining", effLang);
                    var _initialLabel = (string.IsNullOrWhiteSpace(_remainingLabelRaw) || _remainingLabelRaw == "whatsnew.show_more_remaining")
                        ? "Show the {n} earlier versions"
                        : _remainingLabelRaw;
                    <div class="text-center mt-4" id="whatsnew-more-wrap">
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm kmb-whatsnew-show-more"
                                data-whatsnew-batch-size="10"
                                data-whatsnew-label="@_initialLabel"
                                aria-label="@(_initialLabel.Replace("{n}", _remainingCount.ToString()))">
                            @(_initialLabel.Replace("{n}", _remainingCount.ToString()))
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
}

<!-- ══════════ 5. Contact CTA band ══════════ -->
@if (Model.Site?.AboutShowContactCta ?? true)
{
<section class="kmb-cta-band" aria-label="@ariaContact">
    <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-4">
        <div>
            <h2 class="h4 text-white fw-semibold mb-1">Questions, feedback, or a bug?</h2>
            @if (!string.IsNullOrWhiteSpace(Model.SupportEmail))
            {
                <p class="kmb-hero-lead mx-0 mb-0">
                    Write to <a href="mailto:@Model.SupportEmail">@Model.SupportEmail</a> —
                    a person reads it.
                </p>
            }
            else
            {
                <p class="kmb-hero-lead mx-0 mb-0">
                    Open an issue on the repository — a person reads that too.
                </p>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.SupportEmail))
        {
            <a href="mailto:@Model.SupportEmail" class="btn btn-pill btn-primary flex-shrink-0">
                Open a conversation
            </a>
        }
    </div>
</section>
}
