@using Kumunita.Web.Security
@model Kumunita.Web.Controllers.StaticPagesController.StaticPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="markdown">
    <h1>@Model.Title</h1>
    @Html.Raw(MarkdownRenderer.RenderHtml(Model.Body))
    <hr class="my-4" />
    <p class="text-muted small mb-0">
        <kw-l key="static.last_updated">Last updated:</kw-l> @Model.Updated.ToString("yyyy-MM-dd")
    </p>
</div>
