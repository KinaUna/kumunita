@using Kumunita.Web
@model Kumunita.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="kmb-section">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-12 kmb-hero">
                <div class="eyebrow"><kw-l key="home.eyebrow">Where this project stands</kw-l></div>
                <h1 class="mt-2 mb-3">@Model.CommunityName</h1>
                <p class="kmb-section-lead mx-auto text-white-50" style="max-width: 42rem;">
                    <kw-l key="home.lead">A private home for one neighbourhood — built in the open, one milestone at a time. This is the same list you'll find in the README, and the code behind every item is on the public repository.</kw-l>
                </p>
            </div>
        </div>

        <ul class="kmb-roadmap mt-5">
            @foreach (var m in Milestones.All)
            {
                <li>
                    <span class="flex-grow-1"><span class="kmb-milestone-id me-2">@m.Id</span>@m.Title</span>
                    <span class="badge rounded-pill @Milestones.BadgeClass(m.Status)">@Milestones.LabelFor(m.Status)</span>
                </li>
            }
        </ul>

        <div class="d-flex flex-wrap justify-content-center gap-2 mt-5">
            @foreach (var link in RepositoryInfo.Links)
            {
                <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                   class="btn btn-pill btn-outline-primary btn-sm">
                    @link.Label
                    <span aria-hidden="true">&#8599;</span>
                </a>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SupportEmail))
        {
            <p class="text-center small mt-4 mb-0">
                <kw-l key="home.support">Questions or feedback? Write to</kw-l>
                <a href="mailto:@Model.SupportEmail">@Model.SupportEmail</a>.
            </p>
        }
    </div>
</section>
