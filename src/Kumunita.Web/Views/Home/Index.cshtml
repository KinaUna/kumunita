@using Kumunita.Web
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@model Kumunita.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
    // Landing-style page: opt out of the shared .container so sections
    // run full-bleed (the About page's pattern, _Layout.cshtml + the .kmb-*
    // rules in site.css).
    ViewData["FullBleed"] = true;

    // Effective language code (ADR 0049 chain: cookie → Accept-Language →
    // instance default → en), the same seam the kw-l TagHelper resolves UI
    // strings in. Used to resolve the roadmap's show-more button labels
    // (kw-l can't substitute {n}, so the count is filled in with C# .Replace,
    // the same pattern the About page uses for its "N earlier versions").
    var effLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);

    // The two section aria-labels are server-resolved (the kw-l TagHelper can't
    // wrap an attribute); the a11y.* floor is the closed set (the short names
    // — screen readers prefer short over the visible heading wording).
    string ariaFeatures = await Translation.GetAsync("a11y.about_features", effLang);
    string ariaWhatsNew = await Translation.GetAsync("whatsnew.heading", effLang);
}

<!-- ══════════ 1. Intro: what Kumunita is and does ══════════ -->
<section class="kmb-hero">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-12 col-lg-9">
                <div class="eyebrow"><kw-l key="home.intro_eyebrow">A private home for one neighbourhood</kw-l></div>
                <h1 class="display-5 mb-4">@Model.CommunityName</h1>
                <p class="kmb-hero-lead mx-auto mb-3" style="max-width: 42rem;">
                    <kw-l key="home.intro_lead">One quiet place for everything your street does — the feed, the groups, and the notes that deserve better than a group chat. Private, plain-language, and yours.</kw-l>
                </p>
                <p class="kmb-hero-sub mx-auto mb-1" style="max-width: 42rem;">
                    <kw-l key="platform.scope_home">Kumunita started out as a home for one neighbourhood — but it is just as at home with a club, a team, or the people behind a big event. The neighbourhood is the default, not the limit.</kw-l>
                </p>
                <p class="kmb-hero-sub mx-auto mb-4" style="max-width: 42rem;">
                    <kw-l key="platform.fig_home">It is built on the Fractal Integration Guidelines (FIG): the idea that a group's real value lives in the links between its people and parts, not in the parts themselves. Kumunita is the software that builds and holds those links.</kw-l>
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3 kmb-hero-actions">
                    <a href="/about" class="btn btn-pill btn-hero-ghost">
                        <kw-l key="home.about_link">What it is &amp; how it works</kw-l>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════ 2. What Kumunita does (the three surfaces) ══════════ -->
<section class="kmb-features" aria-label="@ariaFeatures">
    <div class="kmb-features-band">
        <div class="container">
            <div class="row g-4 justify-content-center">
                <div class="col-12 col-sm-8 col-md-4">
                    <div class="kmb-feat-card">
                        <div class="kmb-feat-icon mb-3" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7a8.5 8.5 0 1 1 16.1-3.8z"/>
                            </svg>
                        </div>
                        <h3 class="kmb-feat-title"><kw-l key="home.feature_feed_title">One feed for the street</kw-l></h3>
                        <p><kw-l key="home.feature_feed_body">Posts and threads from your blocks and lanes, in one quiet place — no algorithm, no noise.</kw-l></p>
                    </div>
                </div>
                <div class="col-12 col-sm-8 col-md-4">
                    <div class="kmb-feat-card">
                        <div class="kmb-feat-icon kmb-feat-icon-warm mb-3" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </div>
                        <h3 class="kmb-feat-title"><kw-l key="home.feature_groups_title">Groups that fit</kw-l></h3>
                        <p><kw-l key="home.feature_groups_body">Garden swap, book club, street watch — a group for whatever the neighbourhood already does.</kw-l></p>
                    </div>
                </div>
                <div class="col-12 col-sm-8 col-md-4">
                    <div class="kmb-feat-card">
                        <div class="kmb-feat-icon mb-3" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 17v5"/>
                                <path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1z"/>
                            </svg>
                        </div>
                        <h3 class="kmb-feat-title"><kw-l key="home.feature_pinned_title">Pinned where it matters</kw-l></h3>
                        <p><kw-l key="home.feature_pinned_body">Water cuts, roadworks, the new speed bumps — notes that stay put instead of scrolling away.</kw-l></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ══════════ 3. What's new (signed-in visitors only) ══════════ -->
@if (Model.Feed is { } feed)
{
    <section class="kmb-section" aria-label="@ariaWhatsNew">
        <div class="container">
            <div class="row mb-4">
                <div>
                    <h2 class="h3"><kw-l key="home.feed_title">What's new around the street</kw-l></h2>
                </div>
            </div>

            @if (feed.IsEmpty)
            {
                <p class="text-secondary"><kw-l key="home.feed_empty">Nothing posted yet — be the first to start the conversation in the feed.</kw-l></p>
            }
            else
            {
                <div class="row g-4">
                    @if (feed.Posts.Count > 0)
                    {
                        <div class="col-12 col-lg-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h3 class="h6 text-uppercase text-secondary mb-0"><kw-l key="home.feed_posts">Posts</kw-l></h3>
                                <a href="/community" class="small text-decoration-none"><kw-l key="home.feed_view_all">View all</kw-l> →</a>
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var row in feed.Posts)
                                {
                                    string avatarInitial = !string.IsNullOrWhiteSpace(row.Author)
                                        ? char.ToUpperInvariant(row.Author.TrimStart()[0]).ToString()
                                        : string.Empty;
                                    <div class="list-group-item px-0">
                                        <a href="@row.Href" class="text-decoration-none">
                                            <span class="fw-semibold d-block mb-1">@row.Title
                                                @if (row.Badge is { } badge)
                                                {
                                                    <span class="badge text-bg-light ms-2 airy-post-chip" title="@badge">@badge</span>
                                                }
                                            </span>
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(row.Preview))
                                        {
                                            <p class="small text-secondary mb-2">@row.Preview</p>
                                        }
                                        <div class="d-flex align-items-center small text-secondary">
                                            @if (row.AuthorSubjectId is { } authorId && row.Author is not null)
                                            {
                                                <span class="d-inline-flex align-items-center me-1">
                                                    <img class="avatar" src="/profile/avatar/@authorId" alt=""
                                                         data-avatar-fallback>
                                                    <span class="avatar-mono" style="display:none;">@avatarInitial</span>
                                                </span>
                                                <span>@row.Author</span>
                                                <span class="ms-1">·</span>
                                            }
                                            @if (row.When is { } when)
                                            {
                                                <span><kw-dt dt="@when" format="g"></kw-dt></span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (feed.Announcements.Count > 0)
                    {
                        <div class="col-12 col-lg-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h3 class="h6 text-uppercase text-secondary mb-0"><kw-l key="home.feed_announcements">Announcements</kw-l></h3>
                                <a href="/announcements" class="small text-decoration-none"><kw-l key="home.feed_view_all">View all</kw-l> →</a>
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var row in feed.Announcements)
                                {
                                    <div class="list-group-item px-0">
                                        <a href="@row.Href" class="text-decoration-none">
                                            <span class="fw-semibold d-block mb-1">@row.Title
                                                @if (row.Badge is { } badge)
                                                {
                                                    <span class="badge text-bg-light ms-2" title="@badge">
                                                        @if (badge == Kumunita.Web.Controllers.HomeController.BadgePinned)
                                                        {
                                                            <kw-l key="home.feed_badge_pinned">Pinned</kw-l>
                                                        }
                                                        else
                                                        {
                                                            @badge
                                                        }
                                                    </span>
                                                }
                                            </span>
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(row.Preview))
                                        {
                                            <p class="small text-secondary mb-2">@row.Preview</p>
                                        }
                                        @if (row.When is { } when)
                                        {
                                            <div class="small text-secondary"><kw-dt dt="@when" format="g"></kw-dt></div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (feed.Pages.Count > 0)
                    {
                        <div class="col-12 col-lg-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h3 class="h6 text-uppercase text-secondary mb-0"><kw-l key="home.feed_pages">Pages</kw-l></h3>
                                <a href="/pages" class="small text-decoration-none"><kw-l key="home.feed_view_all">View all</kw-l> →</a>
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var row in feed.Pages)
                                {
                                    <div class="list-group-item px-0">
                                        <a href="@row.Href" class="text-decoration-none">
                                            <span class="fw-semibold d-block mb-1">@row.Title</span>
                                        </a>
                                        @if (row.When is { } when)
                                        {
                                            <div class="small text-secondary"><kw-dt dt="@when" format="g"></kw-dt></div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

<!-- ══════════ 4. The plan (where this project stands) ══════════ -->
<section class="kmb-section kmb-section-tint-a">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-12 col-lg-9">
                <div class="eyebrow"><kw-l key="home.eyebrow">Where this project stands</kw-l></div>
                <h2 class="h3 mt-2"><kw-l key="home.roadmap_heading">Built in the open, one milestone at a time</kw-l></h2>
                <p class="kmb-section-lead mx-auto mt-3" style="max-width: 42rem;">
                    <kw-l key="home.lead">A private home for one neighbourhood — built in the open, one milestone at a time. This is the same list you'll find in the README, and the code behind every item is on the public repository.</kw-l>
                </p>
            </div>
        </div>

        @* Roadmap disclosure window — the About-page "show more" pattern
           (VN lane, ADR 0110) extended to BOTH directions. The visible
           window is the last 3 finished milestones + the first 3 upcoming
           ones; everything before it is a hidden-earlier item, everything
           after a hidden-upcoming item (a JS-less visitor still sees the
           window, and the whole list stays in the markup for SEO +
           screen-reader users who expand a button). Each button resolves its
           localized "{n} …" label server-side (kw-l can't substitute {n}) and
           passes it to the client module via data-rm-label; the label's count
           is filled in here for first paint and refreshed by the JS as the
           resident clicks (batches of 10, data-rm-batch-size). *@
        @{
            var _rm = Milestones.All;
            int _n = _rm.Count;
            int _lastDone = -1;
            for (int _i = 0; _i < _n; _i++)
                if (_rm[_i].Status == Milestones.StatusDone) _lastDone = _i; else break;
            int _upcomingTotal = _n - (_lastDone + 1);
            int _windowStart = (_lastDone + 1) - Math.Min(3, _lastDone + 1);
            int _windowEnd = _lastDone + 1 + Math.Min(3, _upcomingTotal);
            int _earlierHidden = _windowStart;
            int _upcomingHidden = _n - _windowEnd;
            string _earlierRaw = (await Translation.GetAsync("home.roadmap.show_more_earlier", effLang)) ?? "";
            string _upcomingRaw = (await Translation.GetAsync("home.roadmap.show_more_upcoming", effLang)) ?? "";
            string _earlierLabel = (string.IsNullOrWhiteSpace(_earlierRaw) || _earlierRaw == "home.roadmap.show_more_earlier")
                ? "Show the {n} earlier milestones" : _earlierRaw;
            string _upcomingLabel = (string.IsNullOrWhiteSpace(_upcomingRaw) || _upcomingRaw == "home.roadmap.show_more_upcoming")
                ? "Show the {n} upcoming milestones" : _upcomingRaw;
            string _earlierText = _earlierLabel.Replace("{n}", _earlierHidden.ToString());
            string _upcomingText = _upcomingLabel.Replace("{n}", _upcomingHidden.ToString());
            // Localized status-badge labels (Done / In progress / Planned) — resolved
            // here because the kw-l TagHelper can't be called from the @for row body
            // the way the show-more labels are (the rows are a C# loop over an array,
            // so each badge is looked up in a small dictionary keyed on the raw status).
            static async Task<string> _ResolveBadge(string key, string fallback, Kumunita.Core.Localization.ITranslationProvider t, string lang)
            {
                var v = (await t.GetAsync(key, lang)) ?? "";
                return (string.IsNullOrWhiteSpace(v) || v == key) ? fallback : v;
            }
            string _badgeDone    = await _ResolveBadge("home.roadmap.status.done",    "Done",        Translation, effLang);
            string _badgeNext    = await _ResolveBadge("home.roadmap.status.next",    "In progress", Translation, effLang);
            string _badgePlanned = await _ResolveBadge("home.roadmap.status.planned", "Planned",     Translation, effLang);
            static string _StatusLabel(string s, string done, string next, string planned) => s switch
            {
                Milestones.StatusDone    => done,
                Milestones.StatusNext    => next,
                Milestones.StatusPlanned => planned,
                _                        => s,
            };
            // Precompute per-row attributes so the markup-level @for body is pure markup.
            string[] _rowAttr = new string[_n];
            string[] _rowHidden = new string[_n];
            for (int _ri = 0; _ri < _n; _ri++)
            {
                if (_ri < _windowStart)          { _rowAttr[_ri] = "earlier";  _rowHidden[_ri] = "hidden"; }
                else if (_ri >= _windowEnd)      { _rowAttr[_ri] = "upcoming"; _rowHidden[_ri] = "hidden"; }
                else                             { _rowAttr[_ri] = "visible";  _rowHidden[_ri] = ""; }
            }
        }
        <div class="mt-5">
            @if (_earlierHidden > 0)
            {
                <div class="text-center mb-3" id="roadmap-earlier-wrap">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm kmb-roadmap-show-more"
                            data-rm-batch-size="10"
                            data-rm-label="@_earlierLabel"
                            aria-label="@_earlierText">
                        @_earlierText
                    </button>
                </div>
            }

            <ul class="kmb-roadmap mb-0" id="roadmap-list">
                @for (int _ri = 0; _ri < _n; _ri++)
                {
                    var _m = _rm[_ri];
                    <li @_rowHidden[_ri] data-rm="@_rowAttr[_ri]">
                        <span class="flex-grow-1"><span class="kmb-milestone-id me-2">@_m.Id</span>@_m.Title</span>
                        <span class="badge rounded-pill @Milestones.BadgeClass(_m.Status)">@_StatusLabel(_m.Status, _badgeDone, _badgeNext, _badgePlanned)</span>
                    </li>
                }
            </ul>

            @if (_upcomingHidden > 0)
            {
                <div class="text-center mt-3" id="roadmap-upcoming-wrap">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm kmb-roadmap-show-more"
                            data-rm-batch-size="10"
                            data-rm-label="@_upcomingLabel"
                            aria-label="@_upcomingText">
                        @_upcomingText
                    </button>
                </div>
            }
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2 mt-5">
            @foreach (var link in RepositoryInfo.Links)
            {
                <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                   class="btn btn-pill btn-outline-primary btn-sm">
                    <kw-l key="@link.Key">@link.Label</kw-l>
                    <span aria-hidden="true">&#8599;</span>
                </a>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SupportEmail))
        {
            <p class="text-center small mt-4 mb-0">
                <kw-l key="home.support">Questions or feedback? Write to</kw-l>
                <a href="mailto:@Model.SupportEmail">@Model.SupportEmail</a>.
            </p>
        }
    </div>
</section>
