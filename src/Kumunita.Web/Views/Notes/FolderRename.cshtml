@model Kumunita.Core.PersonalNotes.FolderRow
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Rename folder";
}
@* M37 (ADR 0167 D6) — the rename-folder form (the folder tree is a personal
   tree, bounded in depth ≤ 2; the (OwnerId, ParentId, Name) unique index
   is the witness — a sibling already holding the new name under the same
   parent is a conflict the DB would reject on save; surfaced as
   InvalidOperationException, the Web layer maps to 400). The owner's own
   tree (C-M37·6 — a note cannot live in another resident's folder; a
   folder's OwnerId is the gate). A non-owner (a GlobalAdmin included) gets
   a non-leaky 404 (the controller's gate). The form pre-fills the
   folder's current name (the D6 "rename is a new revision" shape — the
   folder's Name is mutated in place, the Modified witness is the same
   as the note's D4 shape). *@
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <header class="airy-head">
            <div class="head-row">
                <div>
                    <h1><kw-l key="pn.folder.rename">Rename folder</kw-l></h1>
                </div>
            </div>
        </header>
        <form method="post" action="@($"/notes/folders/{Model.Id}/rename")">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label" for="folder-name">
                    <kw-l key="common.name">Name</kw-l>
                </label>
                <input class="form-control" id="folder-name" name="name" type="text"
                       maxlength="120" value="@Model.Name" required />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <kw-l key="common.save">Save</kw-l>
                </button>
                <a class="btn btn-secondary" href="/notes">
                    <kw-l key="common.cancel">Cancel</kw-l>
                </a>
            </div>
        </form>
    </div>
</div>
