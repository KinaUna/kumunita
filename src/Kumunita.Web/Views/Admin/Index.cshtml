@using Kumunita.Web.Security
@model Kumunita.Web.Models.AdminDashboardViewModel
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    var _closeLang = await Kumunita.Web.Security.EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    var ariaClose = Translation is null ? "Close" : await Translation.GetAsync("a11y.close", _closeLang);
}
@{
    ViewData["Title"] = "Admin";
}

@* The /admin section sub-nav (the ADR 0062 nav-tabs idiom): top of the
   page — the strip sits just under the navbar (the kmb-tab-under-navbar
   treatment, site.css). *@
@await Html.PartialAsync("_AdminNav.cshtml")

<h1><kw-l key="admin.title">Admin</kw-l></h1>
<p class="text-muted">
    <kw-l key="admin.hub.lede">One neighborhood, instance-wide: accounts, communities, platform settings, and the security surfaces. Pick a section below.</kw-l>
</p>

@* Overview cards — the counts at a glance. The numbers are the dashboard's job:
   a quick status read before drilling into a section. *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-3 fw-semibold">@Model.AccountsCount</div>
                <div class="text-muted small">accounts</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-3 fw-semibold @(Model.UnverifiedCount > 0 ? "text-warning" : "")">@Model.UnverifiedCount</div>
                <div class="text-muted small">unverified</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-3 fw-semibold @(Model.BlockedCount > 0 ? "text-danger" : "")">@Model.BlockedCount</div>
                <div class="text-muted small">blocked</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-3 fw-semibold">@Model.CommunitiesCount</div>
                <div class="text-muted small">communities (@Model.DisabledCommunityCount disabled)</div>
            </div>
        </div>
    </div>
</div>

@* The verify-queue shortcut — the safety valve for accounts that never
   completed email verification, still reachable in one click from the dashboard.
   Rendered only when there is something to verify (a dead form with no options
   is noise). The write lane (ManuallyVerify) is unchanged. *@
@if (Model.UnverifiedCount > 0)
{
    <form method="post" asp-controller="Admin" asp-action="ManuallyVerify"
          class="alert alert-info alert-dismissible fade show mb-4 d-flex align-items-center gap-3 flex-wrap">
        @Html.AntiForgeryToken()
        <span class="fw-semibold"><kw-l key="admin.hub.verify_heading">Verify an unverified account</kw-l></span>
        <span class="text-muted small">(@Model.UnverifiedCount waiting)</span>
        <div class="input-group input-group-sm ms-auto">
            <select class="form-select" name="subjectId" id="verifySubject" autocomplete="off">
                @foreach (var a in Model.Unverified)
                {
                    <option value="@a.SubjectId">@a.Email ?? a.DisplayName ?? a.SubjectId (unverified)</option>
                }
            </select>
            <button class="btn btn-primary btn-sm" type="submit"><kw-l key="admin.verify">Verify</kw-l></button>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@ariaClose"></button>
    </form>
}

@* Section cards — the four detail sections, each linking to its page. The
   copy is plain English (this admin view's local convention, as before the
   split — mostly non-kw-l English). *@
<div class="row g-3">
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/accounts">
            <div class="card-body">
                <div class="fw-semibold"><kw-l key="admin.hub.accounts_title">Accounts</kw-l></div>
                <small class="text-muted"><kw-l key="admin.hub.accounts_desc">The account list, the verify queue, and per-account roles, scope, and standing.</kw-l></small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/communities">
            <div class="card-body">
                <div class="fw-semibold"><kw-l key="admin.hub.communities_title">Communities</kw-l></div>
                <small class="text-muted"><kw-l key="admin.hub.communities_desc">Add, edit, enable/disable, and set the mandatory standing of the neighborhood's feeds.</kw-l></small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/platform">
            <div class="card-body">
                <div class="fw-semibold"><kw-l key="admin.hub.platform_title">Platform</kw-l></div>
                <small class="text-muted"><kw-l key="admin.hub.platform_desc">Languages, time zone, date & time format, sign-up, and the five shipped platform pages.</kw-l></small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/security">
            <div class="card-body">
                <div class="fw-semibold"><kw-l key="admin.hub.security_title">Security</kw-l></div>
                <small class="text-muted"><kw-l key="admin.hub.security_desc">The access audit log and the break-glass elevation path.</kw-l></small>
            </div>
        </a>
    </div>
    @* M24 (storage metrics) — the read-only byte-store overview: total used,
       available, user content, and the per-user table. The GlobalAdmin gate
       is on the /admin/storage controller (C-SM·6); the hub is itself
       GlobalAdmin-gated, so the card renders unconditionally like the other
       core sections above it. *@
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/storage">
            <div class="card-body">
                <div class="fw-semibold"><kw-l key="admin.hub.storage_title">Storage</kw-l></div>
                <small class="text-muted"><kw-l key="admin.hub.storage_desc">How full the byte store is, how much is resident content, and the space used per user. Read-only.</kw-l></small>
            </div>
        </a>
    </div>
    @* M25 (upload limits) — the storage SETTINGS surface: the per-file size
       cap, the per-user quota, and community usage. Distinct from the M24
       "Storage" metrics card above (a different route, /admin/storage/settings,
       so the two coexist). The GlobalAdmin gate is on the
       /admin/storage/settings controller (C-UP·1); the hub is itself
       GlobalAdmin-gated, so the card renders unconditionally like the others.
       Read-only in this milestone (the set-lane form lands in U6). *@
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/storage/settings">
            <div class="card-body">
                <div class="fw-semibold"><kw-l key="admin.hub.storage_settings_title">Storage settings</kw-l></div>
                <small class="text-muted"><kw-l key="admin.hub.storage_settings_desc">The community's upload limits — per-file size cap, per-user content quota, and total usage.</kw-l></small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/announcements/comments">
            <div class="card-body">
                <div class="fw-semibold"><kw-l key="admin.anncomments_title">Announcement comments</kw-l></div>
                <small class="text-muted"><kw-l key="admin.hub.anncomments_desc">Whether signed-in residents may comment on announcements.</kw-l></small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/messaging">
            <div class="card-body">
                <div class="fw-semibold"><kw-l key="admin.messaging_title">Direct messaging</kw-l></div>
                <small class="text-muted"><kw-l key="admin.hub.messaging_desc">Whether signed-in residents may open direct 1:1 conversations (off by default).</kw-l></small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/portability">
            <div class="card-body">
                <div class="fw-semibold"><kw-l key="admin.hub.portability_title">Portability</kw-l></div>
                <small class="text-muted"><kw-l key="admin.hub.portability_desc">Export the whole instance as one archive, or restore an archive into this instance.</kw-l></small>
            </div>
        </a>
    </div>
    @* ESC (ADR 0159) — the issue-escalation configuration surface:
       the operator endpoint + the token-gated inbound escalation.
       Sits on the /admin/escalation controller (GlobalAdmin-gated, the
       ErrorReportAdminController shape); the hub itself is GlobalAdmin-gated,
       so the card renders unconditionally like the other core sections. *@
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/escalation">
            <div class="card-body">
                <div class="fw-semibold"><kw-l key="admin.hub.escalation_title">Escalation</kw-l></div>
                <small class="text-muted"><kw-l key="admin.hub.escalation_desc">Configure the operator escalation endpoint and the tokens other platforms present to escalate issues to this instance.</kw-l></small>
            </div>
        </a>
    </div>
    @* M19 (ADR 0120, D6) — the guest accounts affordance. Hidden-not-disabled
       (the ADR 0050 rule): the link renders only for GlobalAdmin actors (a
       non-GlobalAdmin actor's /admin index renders no guest link). The
       controller gate ([Authorize(Roles = GlobalAdmin)]) is the authoritative
       boundary; this conditional is the UI-level "hidden, not just gated"
       shape (the admin.guests_title kw-l key, the U03 closed set). *@
    @if (KumunitaPrincipal.IsGlobalAdmin(User))
    {
        <div class="col-md-6 col-lg-4">
            <a class="card text-decoration-none" href="/admin/guests">
                <div class="card-body">
                    <div class="fw-semibold"><kw-l key="admin.guests_title">Guest accounts</kw-l></div>
                    <small class="text-muted"><kw-l key="admin.hub.guests_desc">Settle the bounded window and allowed surfaces for a guest (a limited, time-bounded standing outside the resident circle).</kw-l></small>
                </div>
            </a>
        </div>
    }
</div>
