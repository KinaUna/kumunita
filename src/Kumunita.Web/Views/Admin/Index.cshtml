@model Kumunita.Web.Models.AdminIndexViewModel
@using Kumunita.Core.Identity
@{
    ViewData["Title"] = "Admin";
}

<h1>Admin</h1>

@if (TempData["info"] is string info)
{
    <div class="alert alert-success">@info</div>
}
@if (TempData["error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<h2>Accounts</h2>
<p class="text-muted">
    @Model.Accounts.Count account(s), @Model.UnverifiedCount unverified.
</p>

<form method="post" asp-action="ManuallyVerify" id="verify-queue" class="mb-4">
    @Html.AntiForgeryToken()
    <label for="verifySubject" class="form-label">Verify an unverified account (safety valve)</label>
    <div class="input-group">
        <select class="form-select" name="subjectId" autocomplete="off">
            @foreach (var a in Model.Accounts.Where(a => !a.Verified))
            {
                <option value="@a.SubjectId">@a.Email ?? a.DisplayName ?? a.SubjectId (unverified)</option>
            }
        </select>
        <button class="btn btn-outline-primary" type="submit">Verify</button>
    </div>
    @if (Model.UnverifiedCount == 0)
    {
        <div class="text-muted small mt-1">No unverified accounts to verify.</div>
    }
</form>

<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Account</th>
                <th>Roles</th>
                <th>Scope</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Accounts)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@(a.DisplayName ?? a.Email ?? a.SubjectId)</div>
                        @if (a.Email is not null && a.DisplayName != a.Email)
                        {
                            <div class="text-muted small">@a.Email</div>
                        }
                        @if (!a.Verified)
                        {
                            <span class="badge text-bg-warning">unverified</span>
                        }
                    </td>
                    <td>
                        @foreach (var r in a.Roles)
                        {
                            <span class="badge text-bg-secondary">
                                @r
                                @if (r == Roles.Moderator)
                                {
                                    <span class="small">(@a.ComponentIds.Count component(s))</span>
                                }
                            </span>
                        }
                    </td>
                    <td>
                        @if (a.Roles.Contains(Roles.Moderator))
                        {
                            var names = Model.Components
                                .Where(c => a.ComponentIds.Contains(c.Id))
                                .Select(c => c.Name)
                                .ToList();
                            @string.Join(", ", names)
                        }
                    </td>
                    <td class="text-end">
                        <form method="post" asp-action="SetRole" class="d-inline-flex">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="targetSubjectId" value="@a.SubjectId" />

                            <label class="visually-hidden">Role</label>
                            <select name="role" class="form-select form-select-sm me-2">
                                <option value="@Roles.Member" selected="@(a.Roles.Count == 0 ? "selected" : null)">Member (no elevated role)</option>
                                <option value="@Roles.Moderator" selected="@(a.Roles.Contains(Roles.Moderator) ? "selected" : null)">Moderator</option>
                                <option value="@Roles.GlobalAdmin" selected="@(a.Roles.Contains(Roles.GlobalAdmin) ? "selected" : null)">GlobalAdmin</option>
                            </select>

                            @if (Model.Components.Any())
                            {
                                <span class="text-muted small ms-1 me-1">scope:</span>
                            }
                            @foreach (var c in Model.Components)
                            {
                                <label title="@c.Name" aria-label="@c.Name"
                                       style="cursor:pointer; vertical-align:middle; margin-right:.25rem;">
                                    @* checked="" is the null-conditional attribute idiom: renders the
                                       checked keyword when true, emits nothing when false *@
                                    <input type="checkbox" name="componentIds" value="@c.Id" class="d-none"
                                           checked="@(a.ComponentIds.Contains(c.Id) ? "checked" : null)" />
                                    <span class="badge text-bg-light border">@c.Name</span>
                                </label>
                            }

                            <button class="btn btn-sm btn-primary" type="submit">Set</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* The "scope" checkbox set is only meaningful when the selected role is Moderator; the
   Core SetRoleAsync ignores componentIds for non-Moderator targets (deletes them). *@

<h2 class="mt-5">Communities</h2>
<p class="text-muted">
    @Model.Communities.Count community(ies), @Model.DisabledCommunityCount disabled.
    Adding a community creates a new <code>/community/{id}</code> feed. Disabling one
    hides it from the feed but keeps its posts and assignments (re-enable to restore).
</p>

@* ── Add community ── *@
<form method="post" asp-action="AddCommunity" class="mb-4">
    @Html.AntiForgeryToken()
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label for="addName" class="form-label">Name</label>
            <input name="Name" id="addName" type="text" class="form-control" maxlength="100" required autocomplete="off" />
        </div>
        <div class="col-md-5">
            <label for="addDesc" class="form-label">Description (optional)</label>
            <input name="Description" id="addDesc" type="text" class="form-control" maxlength="500" autocomplete="off" />
        </div>
        <div class="col-md-3 text-end">
            <button class="btn btn-primary" type="submit">Add community</button>
        </div>
    </div>
</form>

@if (Model.Communities.Count == 0)
{
    <div class="text-muted small">No communities yet. Use the form above to add the first one.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Sort</th>
                    <th>Standing vis.</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Communities)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@c.Name</div>
                            @if (!string.IsNullOrWhiteSpace(c.Description))
                            {
                                <div class="text-muted small">@c.Description</div>
                            }
                        </td>
                        <td class="text-muted small">@c.SortOrder</td>
                        <td>
                            @if (c.ModeratorAccess)
                            {
                                <span class="badge text-bg-secondary">on</span>
                            }
                            else
                            {
                                <span class="text-muted small">off</span>
                            }
                        </td>
                        <td>
                            @if (c.Enabled)
                            {
                                <span class="badge text-bg-success">enabled</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">disabled</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="#" data-edit-toggle="#edit-@c.Id" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                            <form method="post" asp-action="ToggleCommunityEnabled" class="d-inline-flex">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="componentId" value="@c.Id" />
                                <input type="hidden" name="enabled" value="@(c.Enabled ? "false" : "true")" />
                                <button class="btn btn-sm @(c.Enabled ? "btn-outline-warning" : "btn-outline-success")"
                                        type="submit"
                                        title="@(c.Enabled ? "Hide from the feed — posts and assignments are kept." : "Restore this community to the feed.")">
                                    @(c.Enabled ? "Disable" : "Re-enable")
                                </button>
                            </form>
                        </td>
                    </tr>
                    @* Collapsed edit row *@
                    <tr class="edit-row" style="display:none" id="edit-@c.Id">
                        <td colspan="5" class="p-0">
                            <form method="post" asp-action="UpdateCommunity" class="p-3 border-top bg-light">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ComponentId" value="@c.Id" />
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="form-label small">Name</label>
                                        <input type="text" name="Name" value="@c.Name" class="form-control form-control-sm" maxlength="100" required />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label small">Description</label>
                                        <input type="text" name="Description" value="@c.Description" class="form-control form-control-sm" maxlength="500" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small">Sort order</label>
                                        <input type="number" name="SortOrder" value="@c.SortOrder" class="form-control form-control-sm" min="0" step="1" />
                                    </div>
                                </div>
                                <div class="mt-2 text-end">
                                    <button class="btn btn-sm btn-primary" type="submit">Save</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Minimal toggle script — no dependency on Bootstrap JS for the collapse *@
    <script>
        document.querySelectorAll('[data-edit-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                var row = document.querySelector(btn.getAttribute('data-edit-toggle'));
                if (row) row.style.display = row.style.display === 'none' ? '' : 'none';
            });
        });
    </script>
}
