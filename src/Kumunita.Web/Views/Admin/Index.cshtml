@using Kumunita.Web.Security
@model Kumunita.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin";
}

@* The /admin section sub-nav (the ADR 0062 nav-tabs idiom): top of the
   page — the strip sits just under the navbar (the kmb-tab-under-navbar
   treatment, site.css). *@
@await Html.PartialAsync("_AdminNav.cshtml")

<h1><kw-l key="admin.title">Admin</kw-l></h1>
<p class="text-muted">
    One neighborhood, instance-wide: accounts, communities, platform settings, and
    the security surfaces. Pick a section below.
</p>

@* Overview cards — the counts at a glance. The numbers are the dashboard's job:
   a quick status read before drilling into a section. *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-3 fw-semibold">@Model.AccountsCount</div>
                <div class="text-muted small">accounts</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-3 fw-semibold @(Model.UnverifiedCount > 0 ? "text-warning" : "")">@Model.UnverifiedCount</div>
                <div class="text-muted small">unverified</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-3 fw-semibold @(Model.BlockedCount > 0 ? "text-danger" : "")">@Model.BlockedCount</div>
                <div class="text-muted small">blocked</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-bg-light">
            <div class="card-body py-3">
                <div class="fs-3 fw-semibold">@Model.CommunitiesCount</div>
                <div class="text-muted small">communities (@Model.DisabledCommunityCount disabled)</div>
            </div>
        </div>
    </div>
</div>

@* The verify-queue shortcut — the safety valve for accounts that never
   completed email verification, still reachable in one click from the dashboard.
   Rendered only when there is something to verify (a dead form with no options
   is noise). The write lane (ManuallyVerify) is unchanged. *@
@if (Model.UnverifiedCount > 0)
{
    <form method="post" asp-controller="Admin" asp-action="ManuallyVerify"
          class="alert alert-info alert-dismissible fade show mb-4 d-flex align-items-center gap-3 flex-wrap">
        @Html.AntiForgeryToken()
        <span class="fw-semibold">Verify an unverified account</span>
        <span class="text-muted small">(@Model.UnverifiedCount waiting)</span>
        <div class="input-group input-group-sm ms-auto">
            <select class="form-select" name="subjectId" id="verifySubject" autocomplete="off">
                @foreach (var a in Model.Unverified)
                {
                    <option value="@a.SubjectId">@a.Email ?? a.DisplayName ?? a.SubjectId (unverified)</option>
                }
            </select>
            <button class="btn btn-primary btn-sm" type="submit"><kw-l key="admin.verify">Verify</kw-l></button>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </form>
}

@* Section cards — the four detail sections, each linking to its page. The
   copy is plain English (this admin view's local convention, as before the
   split — mostly non-kw-l English). *@
<div class="row g-3">
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/accounts">
            <div class="card-body">
                <div class="fw-semibold">Accounts</div>
                <small class="text-muted">The account list, the verify queue, and per-account roles, scope, and standing.</small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/communities">
            <div class="card-body">
                <div class="fw-semibold">Communities</div>
                <small class="text-muted">Add, edit, enable/disable, and set the mandatory standing of the neighborhood's feeds.</small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/platform">
            <div class="card-body">
                <div class="fw-semibold">Platform</div>
                <small class="text-muted">Languages, time zone, date &amp; time format, sign-up, and the five shipped platform pages.</small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/security">
            <div class="card-body">
                <div class="fw-semibold">Security</div>
                <small class="text-muted">The access audit log and the break-glass elevation path.</small>
            </div>
        </a>
    </div>
    @* M24 (storage metrics) — the read-only byte-store overview: total used,
       available, user content, and the per-user table. The GlobalAdmin gate
       is on the /admin/storage controller (C-SM·6); the hub is itself
       GlobalAdmin-gated, so the card renders unconditionally like the other
       core sections above it. *@
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/storage">
            <div class="card-body">
                <div class="fw-semibold">Storage</div>
                <small class="text-muted">How full the byte store is, how much is resident content, and the space used per user. Read-only.</small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/announcements/comments">
            <div class="card-body">
                <div class="fw-semibold">Announcement comments</div>
                <small class="text-muted">Whether signed-in residents may comment on announcements.</small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/messaging">
            <div class="card-body">
                <div class="fw-semibold">Direct messaging</div>
                <small class="text-muted">Whether signed-in residents may open direct 1:1 conversations (off by default).</small>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a class="card text-decoration-none" href="/admin/portability">
            <div class="card-body">
                <div class="fw-semibold">Portability</div>
                <small class="text-muted">Export the whole instance as one archive, or restore an archive into this instance.</small>
            </div>
        </a>
    </div>
    @* M19 (ADR 0120, D6) — the guest accounts affordance. Hidden-not-disabled
       (the ADR 0050 rule): the link renders only for GlobalAdmin actors (a
       non-GlobalAdmin actor's /admin index renders no guest link). The
       controller gate ([Authorize(Roles = GlobalAdmin)]) is the authoritative
       boundary; this conditional is the UI-level "hidden, not just gated"
       shape (the admin.guests_title kw-l key, the U03 closed set). *@
    @if (KumunitaPrincipal.IsGlobalAdmin(User))
    {
        <div class="col-md-6 col-lg-4">
            <a class="card text-decoration-none" href="/admin/guests">
                <div class="card-body">
                    <div class="fw-semibold"><kw-l key="admin.guests_title">Guest accounts</kw-l></div>
                    <small class="text-muted">Settle the bounded window and allowed surfaces for a guest (a limited, time-bounded standing outside the resident circle).</small>
                </div>
            </a>
        </div>
    }
</div>
