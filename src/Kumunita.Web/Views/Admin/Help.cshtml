@model Kumunita.Web.Controllers.AdminHelpController.HelpAdminViewModel
@{
    ViewData["Title"] = "Admin — Help pages";
}

@* The /admin section sub-nav (the ADR 0062 nav-tabs idiom): top of the
   page — the strip sits just under the navbar (the kmb-tab-under-navbar
   treatment, site.css). *@
@await Html.PartialAsync("_AdminNav.cshtml")

<h1>Help pages</h1>
<p class="text-muted">
    The platform help pages the platform ships with seeded text. Each one is
    flagged when the code carries newer text than what is stored here — apply a
    reset to bring a page (or every page) back to its seeded baseline.
</p>

@* A reset is destructive (it overwrites hand-edited text), so both the
   per-page and the all-pages forms sit behind an explicit confirm() — the
   admin must name the action twice (the click, then the confirm box). The
   flash toast (_FlashToast.cshtml) surfaces the TempData["info"]/["error"]
   the route writes on redirect. *@

@if (Model.PagesWithUpdates > 0)
{
    <div class="alert alert-warning" role="status">
        <span class="fw-semibold">@Model.PagesWithUpdates @(Model.PagesWithUpdates == 1 ? "page has" : "pages have")</span>
        newer shipped text. Reset the page(s) below to bring them back to the
        seeded baseline.
    </div>
}

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Page</th>
                <th class="text-end">Status</th>
                <th class="text-end">Reset</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Pages)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@p.Title</div>
                        <div class="text-muted small">/@p.Slug</div>
                    </td>
                    <td class="text-end">
                        @if (p.HasNewerShippedText)
                        {
                            <span class="badge text-bg-warning">Newer text shipped</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Up to date</span>
                        }
                    </td>
                    <td class="text-end">
                        <form method="post" action="/admin/help/reset"
                              class="d-inline"
                              onsubmit="return confirm('Reset &quot;@p.Title&quot; to its seeded text? This overwrites any hand-edited copy.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="pageId" value="@p.PageId" />
                            <button class="btn btn-outline-secondary btn-sm" type="submit">Reset</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* The batch lane — one confirm for the whole fleet. Distinct from the
   per-page form (a different route + no pageId), so both coexist on the page. *@
<div class="card border-danger">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <div class="me-auto">
            <div class="fw-semibold text-danger">Reset every seeded help page</div>
            <div class="text-muted small">
                Brings all @Model.Pages.Count seeded pages back to the seeded
                baseline, overwriting any hand-edited copy. This cannot be
                undone except by re-editing.
            </div>
        </div>
        <form method="post" action="/admin/help/reset-all"
              onsubmit="return confirm('Reset ALL @Model.Pages.Count seeded help pages to their seeded text? This overwrites every hand-edited copy.');">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger" type="submit">Reset all</button>
        </form>
    </div>
</div>
