@* The /admin section sub-nav (ADR 0062). A small nav-tabs strip shared by the
   five admin pages so an admin can jump between sections without scrolling back
   to the dashboard. The active tab is derived from the current action name (the
   AdminController owns all five GET actions; the audit / break-glass pages
   belong to the security section). *@
@{
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "Index";
    var inSecurity = action is "Audit" or "BreakGlass";
    var tabs = new (string Label, string Href)[]
    {
        ("Overview",    "/admin"),
        ("Accounts",    "/admin/accounts"),
        ("Communities", "/admin/communities"),
        ("Platform",    "/admin/platform"),
        ("Security",    "/admin/security"),
        ("Analytics",   "/admin/analytics"),
    };
    var activeLabel = inSecurity ? "Security" : action switch
    {
        "Accounts"    => "Accounts",
        "Communities" => "Communities",
        "Platform"    => "Platform",
        "Security"    => "Security",
        "Analytics"   => "Analytics",
        _             => "Overview",
    };
}
@* M30 (ADR 0153, M30·5) — the admin onboarding affordance: the dismissible
   banner (the _AdminOnboardingBanner partial, the M22 _OnboardingBanner's
   admin sibling). Rendered at the top of the admin sub-nav, before the
   nav-tabs, so it is visible on every /admin/* page (the _AdminNav scope).
   Rendered by the partial only when the signed-in actor is a GlobalAdmin AND
   AdminOnboarding.CompletedAt is null (the same GetAsync seam the
   AdminOnboardingController + /admin/onboarding view call — M30·5).
   Non-blocking (M30·5): it never gates sign-in; the close button is a
   client-side dismiss (onboarding-banner.js), and the only way to clear it
   for real is the explicit "mark as complete" POST (M30·4).

   The reference MUST keep the `.cshtml` extension: under a published
   precompiled-assembly deployment (Docker) the view lookup is by exact
   registered name, and the extension is part of it — the `~/.../X` form
   (no extension) only resolves via the file-based provider that `dotnet run`
   uses, so it 500s in the container. Matches every other `~/`-absolute
   reference here (e.g. `~/Views/Locale/_SettingsTabs.cshtml`,
   `~/Views/Admin/_AdminNav.cshtml`). *@
@await Html.PartialAsync("~/Views/Shared/_AdminOnboardingBanner.cshtml")
<ul class="nav nav-tabs kmb-tab-under-navbar mb-4" role="tablist">
    @foreach (var tab in tabs)
    {
        var isActive = tab.Label == activeLabel;
        <li class="nav-item" role="presentation">
            <a class="nav-link @(isActive ? "active" : string.Empty)" href="@tab.Href">@tab.Label</a>
        </li>
    }
</ul>
