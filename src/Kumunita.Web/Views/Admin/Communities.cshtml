@model Kumunita.Web.Models.AdminCommunitiesViewModel
@{
    ViewData["Title"] = "Admin — Communities";
}

@* The /admin section sub-nav (the ADR 0062 nav-tabs idiom): top of the
   page — the strip sits just under the navbar (the kmb-tab-under-navbar
   treatment, site.css). *@
@await Html.PartialAsync("_AdminNav.cshtml")

<h1>Communities</h1>
<p class="text-muted">
    @Model.Communities.Count community(ies), @Model.DisabledCommunityCount disabled.
    Adding a community creates a new <code>/community/{id}</code> feed. Disabling one
    hides it from the feed but keeps its posts and assignments (re-enable to restore).
</p>

@* ── Add community ── *@
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="post" asp-action="AddCommunity">
            @Html.AntiForgeryToken()
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label for="addName" class="form-label small mb-1"><kw-l key="common.name">Name</kw-l></label>
                    <input name="Name" id="addName" type="text" class="form-control form-control-sm" maxlength="100" required autocomplete="off" />
                </div>
                <div class="col-md-4">
                    <label for="addDesc" class="form-label small mb-1"><kw-l key="admin.community_description">Description (optional)</kw-l></label>
                    <input name="Description" id="addDesc" type="text" class="form-control form-control-sm" maxlength="500" autocomplete="off" />
                </div>
                <div class="col-md-2 d-flex align-items-center ps-2">
                    <input class="form-check-input" type="checkbox" id="addMandatory" name="Mandatory" value="true" />
                    <label class="form-check-label ms-1 small text-nowrap" for="addMandatory"
                           title="Everyone in the neighborhood is a member — no one can be removed or leave it."><kw-l key="admin.community_mandatory">Mandatory</kw-l></label>
                </div>
                <div class="col-md-3 text-end">
                    <button class="btn btn-primary btn-sm" type="submit"><kw-l key="admin.add_community">Add community</kw-l></button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Communities.Count == 0)
{
    <div class="text-muted small">No communities yet. Use the form above to add the first one.</div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model.Communities)
        {
            <div class="col-md-6">
                <div class="card @(c.Enabled ? "" : "border-warning")">
                    <div class="card-header py-2 d-flex align-items-center justify-content-between gap-2">
                        <div class="flex-grow-1">
                            <span class="fw-semibold">@c.Name</span>
                            @if (c.Enabled)
                            {
                                <span class="badge text-bg-success ms-2">enabled</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning ms-2">disabled</span>
                            }
                            @if (c.Mandatory)
                            {
                                <span class="badge text-bg-dark ms-1" title="Everyone in the neighborhood is a member — no one can be removed or leave it.">mandatory</span>
                            }
                            @if (c.ModeratorAccess)
                            {
                                <span class="badge text-bg-secondary ms-1" title="Standing moderator scope is ON for this community.">mod scope</span>
                            }
                        </div>
                        <a href="#" data-edit-toggle="#users-@c.Id" class="btn btn-sm btn-outline-secondary">Users</a>
                        <a href="#" data-edit-toggle="#edit-@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </div>
                    <div class="card-body py-2">
                        @if (!string.IsNullOrWhiteSpace(c.Description))
                        {
                            <div class="text-muted small">@c.Description</div>
                        }
                        else
                        {
                            <div class="text-muted small fst-italic">No description.</div>
                        }
                        <div class="text-muted small mt-1">Sort: @c.SortOrder</div>
                    </div>
                    <div class="card-footer py-2 border-0">
                        <div class="d-flex gap-2 flex-wrap">
                            @* ADR 0012 — the mandatory lane: GlobalAdmin only, never the moderator's. *@
                            <form method="post" asp-action="ToggleCommunityMandatory" class="d-inline-flex">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="componentId" value="@c.Id" />
                                <input type="hidden" name="mandatory" value="@(c.Mandatory ? "false" : "true")" />
                                <button class="btn btn-sm @(c.Mandatory ? "btn-outline-warning" : "btn-outline-secondary")"
                                        type="submit"
                                        title="@(c.Mandatory ? "Make optional — membership is explicit rows again." : "Make mandatory — everyone in the neighborhood becomes a member.")">
                                    @(c.Mandatory ? "Make optional" : "Make mandatory")
                                </button>
                            </form>
                            <form method="post" asp-action="ToggleCommunityEnabled" class="d-inline-flex">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="componentId" value="@c.Id" />
                                <input type="hidden" name="enabled" value="@(c.Enabled ? "false" : "true")" />
                                <button class="btn btn-sm @(c.Enabled ? "btn-outline-warning" : "btn-outline-success")"
                                        type="submit"
                                        title="@(c.Enabled ? "Hide from the feed — posts and assignments are kept." : "Restore this community to the feed.")">
                                    @(c.Enabled ? "Disable" : "Re-enable")
                                </button>
                            </form>
                        </div>
                    </div>
                    @* User management — the ADR 0012 per-community lanes from the
                       admin side (the inverse of the per-account "set of
                       communities" surface): the member list (each with a
                       "Make moderator" / "Un-moderate" toggle), a member
                       remove, and the add-picker (non-member accounts). *@
                    <div id="users-@c.Id" style="display:none" class="border-top bg-light">
                        <div class="p-3">
                            <h6 class="small mb-2">Members @(c.Mandatory ? "(mandatory — everyone in the neighborhood is a member; removal is not offered)" : "")</h6>
                            @if (c.Members.Count == 0)
                            {
                                <div class="text-muted small">No explicit members — add one below.</div>
                            }
                            <ul class="list-group mb-2">
                                @foreach (var m in c.Members)
                                {
                                    // The moderator lane's set-lane shape (ADR 0030, the
                                    // Manage-page pattern): the form submits the
                                    // target's *complete* desired role set + scope
                                    // set, computed here at render time from the
                                    // already-loaded member state — no database
                                    // read in the POST path.
                                    var baseRoles = m.Roles.Where(r => r != "Moderator").ToList();
                                    // Make-moderator: current roles + Moderator;
                                    // Un-moderate: current roles minus Moderator.
                                    var makeRoleNames  = m.IsModerator ? baseRoles : baseRoles.Append("Moderator").ToList();
                                    var unsetRoleNames = baseRoles;
                                    // Make-moderator: current scopes + this community;
                                    // Un-moderate: current scopes minus this community.
                                    var makeScopes  = m.ModeratorScopes.Contains(c.Id)
                                        ? m.ModeratorScopes.ToList()
                                        : m.ModeratorScopes.Append(c.Id).ToList();
                                    var unsetScopes = m.ModeratorScopes.Where(s => s != c.Id).ToList();
                                    <li class="list-group-item py-1 d-flex align-items-center justify-content-between gap-2">
                                        <span>
                                            @(m.DisplayName ?? m.UserId)
                                            @if (m.IsModerator)
                                            {
                                                <span class="badge text-bg-secondary">moderator</span>
                                            }
                                        </span>
                                        <span class="d-flex gap-1">
                                            @if (m.IsModerator)
                                            {
                                                <form method="post" asp-action="UnsetCommunityModerator" class="d-inline-flex">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="componentId" value="@c.Id" />
                                                    <input type="hidden" name="userId" value="@m.UserId" />
                                                    @foreach (var r in unsetRoleNames)
                                                    {
                                                        <input type="hidden" name="roleNames" value="@r" />
                                                    }
                                                    @foreach (var s in unsetScopes)
                                                    {
                                                        <input type="hidden" name="componentIds" value="@s" />
                                                    }
                                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Un-moderate</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" asp-action="SetCommunityModerator" class="d-inline-flex">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="componentId" value="@c.Id" />
                                                    <input type="hidden" name="userId" value="@m.UserId" />
                                                    @foreach (var r in makeRoleNames)
                                                    {
                                                        <input type="hidden" name="roleNames" value="@r" />
                                                    }
                                                    @foreach (var s in makeScopes)
                                                    {
                                                        <input type="hidden" name="componentIds" value="@s" />
                                                    }
                                                    <button class="btn btn-sm btn-outline-primary" type="submit">Make moderator</button>
                                                </form>
                                            }
                                            @if (!c.Mandatory)
                                            {
                                                <form method="post" asp-action="RemoveCommunityUser" class="d-inline-flex">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="componentId" value="@c.Id" />
                                                    <input type="hidden" name="userId" value="@m.UserId" />
                                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Remove @(m.DisplayName ?? m.UserId) from the community">Remove</button>
                                                </form>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>
                            @if (c.Candidates.Count > 0)
                            {
                                <form method="post" asp-action="AddCommunityUser" class="d-flex gap-2 align-items-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="componentId" value="@c.Id" />
                                    <div class="flex-grow-1">
                                        <label class="form-label small mb-1" for="add-user-@c.Id">Add a member</label>
                                        <select name="userId" id="add-user-@c.Id" class="form-select form-select-sm" required>
                                            <option value="" disabled selected>Pick a resident…</option>
                                            @foreach (var cand in c.Candidates)
                                            {
                                                <option value="@cand.UserId">@(cand.DisplayName ?? cand.UserId)</option>
                                            }
                                        </select>
                                    </div>
                                    <button class="btn btn-sm btn-primary" type="submit">Add</button>
                                </form>
                            }
                        </div>
                    </div>
                    @* Edit form — toggled by the Edit button in the card header; uses the
                       same data-edit-toggle mechanism as before (admin-edit-toggle.ts). *@
                    <div id="edit-@c.Id" style="display:none" class="border-top bg-light">
                        <div class="p-3">
                            <form method="post" asp-action="UpdateCommunity">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ComponentId" value="@c.Id" />
                                <div class="row g-2 align-items-end">
                                    <div class="col-4">
                                        <label class="form-label small mb-1">Name</label>
                                        <input type="text" name="Name" value="@c.Name" class="form-control form-control-sm" maxlength="100" required />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small mb-1">Description</label>
                                        <input type="text" name="Description" value="@c.Description" class="form-control form-control-sm" maxlength="500" />
                                    </div>
                                    <div class="col-2">
                                        <label class="form-label small mb-1">Sort</label>
                                        <input type="number" name="SortOrder" value="@c.SortOrder" class="form-control form-control-sm" min="0" step="1" />
                                    </div>
                                    <div class="col-2">
                                        <button class="btn btn-sm btn-primary w-100" type="submit">Save</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Edit toggle is handled by client/lib/admin-edit-toggle.js (loaded in
       _Layout.cshtml — SECURITY.md §6 no-inline-script rule). *@
}
