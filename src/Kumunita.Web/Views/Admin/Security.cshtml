@{
    ViewData["Title"] = "Admin — Security";
}

@* The /admin section sub-nav (the ADR 0062 nav-tabs idiom): top of the
   page — the strip sits just under the navbar (the kmb-tab-under-navbar
   treatment, site.css). *@
@await Html.PartialAsync("_AdminNav.cshtml")

<h1>Security</h1>
<p class="text-muted">
    The security surfaces — the always-on access-decision log and the one-time
    break-glass elevation path. Both are their own pages; this is the section hub.
</p>

<div class="list-group">
    <a asp-action="Audit" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Access audit log</div>
        <small class="text-muted">A record of who was allowed or denied access to restricted content, plus admin actions. Filter by actor, via, or outcome.</small>
    </a>
    <a asp-action="BreakGlass" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Break-glass</div>
        <small class="text-muted">The one-time elevation path for emergencies — consume an operator-written token to act with elevated standing for a bounded window.</small>
    </a>
</div>
