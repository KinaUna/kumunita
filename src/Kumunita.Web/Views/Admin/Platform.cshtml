@model Kumunita.Web.Models.AdminPlatformViewModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Admin — Platform";

    // ADR 0161 — the per-page translation surface (the /admin/platform
    // platform-pages table gains a translations ⋮ dropdown per page, the
    // posts/announcements pattern). The remove-translation form's data-confirm
    // (the ADR 0072 attribute idiom — confirm.js reads the attribute verbatim;
    // the kw-l TagHelper can't wrap an attribute) is resolved server-side; the
    // en floor is the server fallback (a null provider — a non-HTTP render —
    // degrades to en).
    string confirmRemoveTrans = "Remove this translation?";
    if (Translation is not null)
    {
        var effLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
        confirmRemoveTrans = await Translation.GetAsync("common.remove_translation_confirm", effLang);
    }

    // The per-page translation surface keyed by slug (a quick lookup for the
    // row loop below). A platform page with no Page doc (about) or no
    // translation data has no entry here — its row renders Preview / Edit only.
    var transBySlug = Model.PlatformPageTranslations.ToDictionary(
        p => p.Slug, StringComparer.OrdinalIgnoreCase);
}

@* The /admin section sub-nav (the ADR 0062 nav-tabs idiom): top of the
   page — the strip sits just under the navbar (the kmb-tab-under-navbar
   treatment, site.css). *@
@await Html.PartialAsync("_AdminNav.cshtml")

<h1>Platform</h1>
<p class="text-muted">
    Instance-wide management — the platform's languages and translated UI strings,
    the default time zone and date &amp; time format, the sign-up gate, the
    notification-flush cadence, the access audit log, and the break-glass
    elevation path.
</p>

@* Each surface is a list-group item with a title + one-line description, so an
   admin can tell what each one does without clicking. The copy is plain English —
   this view's local convention (the admin shell is mostly non-kw-l English). *@
<div class="list-group mb-4">
    <a href="/admin/languages" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Languages</div>
        <small class="text-muted">Which languages the platform supports, and the translated UI strings and static pages.</small>
    </a>
    <a href="/admin/timezone" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Time zone</div>
        <small class="text-muted">The platform-default time zone residents' timestamps fall back to when they set no preference.</small>
    </a>
    <a href="/admin/dateformat" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Date &amp; time format</div>
        <small class="text-muted">The platform-default date &amp; time format for residents' timestamps.</small>
    </a>
    <a href="/admin/signup" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Sign-up</div>
        <small class="text-muted">Whether new residents may create an account on their own — close it for invitation-only sign-up.</small>
    </a>
    @* ADR 0150 (SITE lane) — the /admin/site surface: the GlobalAdmin's edit
       page for the two landing surfaces (/home + /about) — the hero text and
       the show/hide toggles for each section. The row label is plain text
       (the admin view's local convention — mostly non-kw-l English, so an
       interpolated kw-l key would break the KwLRegistryConsistencyTests
       static key scan). *@
    <a href="/admin/site" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Site content</div>
        <small class="text-muted">Edit the landing surfaces' hero text and choose which sections are shown on the home and about pages.</small>
    </a>
    @* ADR 0152 (M29 — admin surface labels) — the /admin/labels surface: the
       GlobalAdmin's edit page for the 13 top-navigation surfaces' display
       labels (the nav item + that surface's page header). The row label is
       plain text (the admin view's local convention — mostly non-kw-l English,
       so an interpolated kw-l key would break the KwLRegistryConsistencyTests
       static key scan). *@
    <a href="/admin/labels" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Surface labels</div>
        <small class="text-muted">Rename the top-navigation surfaces (Home, Announcements, Community, Groups, and the "More" menu items) — the nav and each surface's page header follow the choice. A blank field keeps the default label.</small>
    </a>
    @* ADR 0164 (M35 — kiosk mode) — the /settings/kiosk surface (ADR 0164
       amendment): the per-resident playlist editor, moved out of /admin so
       any signed-in user configures their OWN /kiosk display (the ordered
       slide list + the two auto-cycle / auto-refresh cadences). The row label
       is plain text (the admin view's local convention — non-kw-l English).
       The display itself is /kiosk (signed-in). *@
    <a href="/settings/kiosk" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Kiosk display</div>
        <small class="text-muted">Every signed-in resident configures their own kiosk display at /settings/kiosk (the ordered list of views it cycles through and the two auto-cycle / auto-refresh cadences). The display is /kiosk (signed-in on the TV).</small>
    </a>
    <a href="/admin/help" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Help pages</div>
        <small class="text-muted">Reset the seeded platform help pages — per page, or every page at once — back to their shipped text.</small>
    </a>
    <a href="/admin/quiet" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Quiet-time cadence</div>
        <small class="text-muted">How often held notification emails are re-checked and delivered — residents set their own quiet window on /settings/quiet.</small>
    </a>
    <a asp-action="Audit" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Access audit log</div>
        <small class="text-muted">A record of who was allowed or denied access to restricted content, plus admin actions.</small>
    </a>
    <a asp-action="BreakGlass" class="list-group-item list-group-item-action">
        <div class="fw-semibold">Break-glass</div>
        <small class="text-muted">The one-time elevation path for emergencies.</small>
    </a>
    @* ADR 0138 — the sample-data surface (the change-password lock toggle),
       rendered only on a SampleData__Enabled instance (the "unreachable by
       construction" shape, ADR 0056 — a real deployment never carries the
       flag, so this row is absent there). The row label is plain text (the
       admin view's local convention — mostly non-kw-l English, so an
       interpolated kw-l key would break the KwLRegistryConsistencyTests
       static key scan). *@
    @if (Model.ShowSampleData)
    {
        <a href="/admin/sample" class="list-group-item list-group-item-action">
            <div class="fw-semibold">Sample data</div>
            <small class="text-muted">This instance runs the demo neighborhood. Lock the sample accounts out of changing their own password so visitors can test features without breaking the shared credentials.</small>
        </a>
    }
</div>

@* SP U03 (ADR 0043 D4) — the "Platform pages" affordance: the five shipped
   platform surfaces, each with a preview link (the route — always present)
   and, for the four Page-backed surfaces, an edit link (id-based,
   /pages/{id}/edit — only when the slug resolved to a page id; `about` is a
   view, not a seeded page (ADR 0043 D1), so it is preview-only). *@
<h2 class="h3">Platform pages</h2>
<p class="text-muted">
    The five pages a fresh instance ships with. "Preview" opens the page as
    residents see it; "Edit" opens the page editor (admins only). "About" is
    the product story — preview only.
</p>
@* ADR 0231 — below 576px palettes.css stacks each row into a card (kmb-stack-table). *@
<table class="table table-sm align-middle mb-4 kmb-stack-table">
    <thead>
        <tr>
            <th>Surface</th>
            <th>Route</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @* Row labels are plain text (the admin view's local convention — mostly
           non-kw-l English; an interpolated kw-l key would break the
           KwLRegistryConsistencyTests static key scan). The labels match the
           footer.platform.* registry values by design. *@
        @{
            var platformLabels = new Dictionary<string, string>
            {
                ["about"]   = "About",
                ["terms"]   = "Terms of use",
                ["help"]    = "Help",
                ["privacy"] = "Privacy",
                ["conduct"] = "Code of conduct",
            };
        }
        @foreach (var row in Model.PlatformPages)
        {
            // ADR 0161 — a platform page with translation data (a Page doc
            // resolved to a PageId) gets the translations ⋮ dropdown; about is
            // preview-only (no Page doc) so it has none.
            var pageTrans = transBySlug.TryGetValue(row.Slug, out var pt) ? pt : null;
            var langNames = pageTrans?.LangNames ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            string LangName(string code) => langNames.TryGetValue(code, out var n) ? n : code;
            <tr>
                <td class="fw-semibold">@(platformLabels.TryGetValue(row.Slug, out var label) ? label : row.Slug)</td>
                <td data-label="Route"><code>@row.Route</code></td>
                <td class="text-end d-inline-flex align-items-center gap-2 justify-content-end flex-wrap">
                    <a href="@row.Route" class="btn btn-sm btn-outline-secondary">Preview</a>
                    @if (row.PageId is not null)
                    {
                        <a href="/pages/@row.PageId/edit" class="btn btn-sm btn-outline-secondary">Edit</a>
                    }

                    @* ADR 0161 — the per-page translations dropdown (the
                       posts/announcements pattern): add / edit each open a
                       modal (the shared _PageTranslationModals partial, id-
                       prefixed by the slug); remove is a confirm form in the
                       menu. The service's write-lane re-check at POST is the
                       real gate (C3) — the /admin GlobalAdmin gate + the
                       PageController standing are the authority. *@
                    @if (pageTrans is not null
                        && (pageTrans.Translations.Count > 0 || pageTrans.MissingLanguages.Count > 0))
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false"
                                    aria-label="Translations for @(platformLabels.TryGetValue(row.Slug, out var tl) ? tl : row.Slug)">
                                <kw-l key="posts.translations_label">Translations</kw-l>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @foreach (var existing in pageTrans.Translations.OrderBy(x => x.LanguageCode))
                                {
                                    <li>
                                        <button type="button" class="dropdown-item text-dark"
                                                data-bs-toggle="modal"
                                                data-bs-target="@($"#{row.Slug}-trans-edit-{existing.LanguageCode}")">
                                            <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                        </button>
                                    </li>
                                }
                                @foreach (var lang in pageTrans.MissingLanguages)
                                {
                                    <li>
                                        <button type="button" class="dropdown-item text-dark"
                                                data-bs-toggle="modal"
                                                data-bs-target="@($"#{row.Slug}-trans-add-{lang.Code}")">
                                            <kw-l key="posts.translation_add">Add</kw-l> — <b>@LangName(lang.Code)</b>
                                        </button>
                                    </li>
                                }
                                @if (pageTrans.Translations.Count > 0)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    @foreach (var existing in pageTrans.Translations.OrderBy(x => x.LanguageCode))
                                    {
                                        <li>
                                            <form method="post" action="@($"/pages/{row.PageId}/translations/remove")"
                                                  data-confirm="@confirmRemoveTrans" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <kw-l key="posts.translation_remove">Remove</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                                </button>
                                            </form>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@* ADR 0161 — the per-page translation modals (the shared partial, one per
   Page-backed platform page, id-prefixed by the slug so the dropdown's
   data-bs-target references resolve). Only rendered when at least one page
   has a translation surface (a stored row or a candidate language). *@
@if (Model.PlatformPageTranslations.Any())
{
    foreach (var pageTrans in Model.PlatformPageTranslations)
    {
        <partial name="_PageTranslationModals" model="new Kumunita.Web.Models.PageTranslationModalsModel(
            pageTrans.Slug,
            pageTrans.PageId,
            pageTrans.Title,
            pageTrans.Translations,
            pageTrans.MissingLanguages,
            pageTrans.LangNames)" />
    }
}

@section Scripts {
    @* ADR 0161 — the rich editor (client/lib/rich-editor.ts, tsc-built) is
       needed by the per-page translation modals (each carries a .rc-editor
       block). bindRichEditor self-wires every .rc-editor on the page at
       module load, so the modals work without any extra wiring. *@
    <script type="module" src="~/js/lib/rich-editor.js"></script>
}
