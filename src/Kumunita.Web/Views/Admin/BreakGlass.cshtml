@model Kumunita.Web.Models.BreakGlassViewModel
@using Kumunita.Core.Authorization
@{
    ViewData["Title"] = "Admin — Break glass";
}

<h1><kw-l key="admin.breakglass_title">Break-glass</kw-l></h1>
<p class="text-muted">
    A break-glass elevation is set up by the <strong>operator outside the app</strong>,
    not by any button on this page. This page only <em>activates</em> the one-time
    code the operator has already set up. Using it is a one-time action: once you
    present the code it cannot be used again, and the elevation ends on its own at
    its expiry time.
</p>

@if (!Model.HasOverride)
{
    <div class="alert alert-secondary">
        No break-glass code has been set up for your account. Ask the operator to
        set one up before using this page.
    </div>
}
else
{
    <dl class="row">
        <dt class="col-sm-3"><kw-l key="admin.breakglass_granted">Granted at (UTC)</kw-l></dt>
        <dd class="col-sm-9">@(Model.GrantedAt?.ToString("u") ?? "—")</dd>
        <dt class="col-sm-3"><kw-l key="admin.breakglass_expires">Expires at (UTC)</kw-l></dt>
        <dd class="col-sm-9">@(Model.ExpiresAt?.ToString("u") ?? "—")</dd>
        <dt class="col-sm-3"><kw-l key="admin.breakglass_status">Status</kw-l></dt>
        <dd class="col-sm-9">
            @if (Model.Consumed)
            {
                <span class="badge text-bg-success"><kw-l key="admin.breakglass_consumed">consumed — elevation active until expiry</kw-l></span>
            }
            else
            {
                <span class="badge text-bg-warning"><kw-l key="admin.breakglass_presented">presented but not yet consumed</kw-l></span>
            }
        </dd>
    </dl>

    @if (!Model.Consumed)
    {
        <form method="post" asp-action="BreakGlass">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label" for="token"><kw-l key="admin.breakglass_token_label">One-time code (from the operator)</kw-l></label>
                <input type="text" class="form-control" id="token" name="token" autocomplete="off" required />
                <div class="form-text">
                    <kw-l key="admin.breakglass_token_hint">Using this code is a one-time action. It activates the elevation until its expiry.</kw-l>
                </div>
            </div>
            <button type="submit" class="btn btn-danger"><kw-l key="admin.breakglass_consume">Activate</kw-l></button>
        </form>
    }
    else
    {
        <p class="text-muted">
            Once activated, the elevation stays in effect until its own
            <em>expiry</em>; every privileged action taken under it is written
            to the audit log (see <a asp-action="Audit">the audit log</a>).
            This page will not let you activate the same code twice.
        </p>
    }
}
