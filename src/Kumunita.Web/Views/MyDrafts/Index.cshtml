@model Kumunita.Web.Models.MyDraftsViewModel
@using Kumunita.Core.Announcements
@using Kumunita.Web.Security
@{
    ViewData["Title"] = "My drafts";
    bool any = Model.Posts.Count > 0 || Model.Announcements.Count > 0 || Model.Events.Count > 0;
}

<div class="row justify-content-center">
    <div class="col-md-12 col-lg-12">
        <h1><kw-l key="my_drafts.title">My drafts</kw-l></h1>
        <p class="text-muted">
            <kw-l key="posts.save_as_draft_hint">A draft is saved but visible to no one — not even admins — until you publish it. You can find it under “My drafts”.</kw-l>
        </p>


        @if (!any)
        {
            @* R32 (IMPROVE-UX) — the house .kmb-empty idiom (title + body + one
               next action). The body is the existing my_drafts.empty sentence.
               This page has no New button (drafts are saved from the post /
               announcement / event composers elsewhere), so the one action is
               the community feed — the natural "start something to draft"
               destination (the R29 Directory/Index precedent). *@
            <div class="kmb-empty">
                <p class="kmb-empty-title"><kw-l key="my_drafts.empty_title">No drafts yet.</kw-l></p>
                <p class="kmb-empty-body">
                    <kw-l key="my_drafts.empty">You have no drafts.</kw-l>
                </p>
                <a class="btn btn-outline-secondary" href="/community"><kw-l key="about.cta_feed">See the feed</kw-l></a>
            </div>
        }

        @if (Model.Posts.Count > 0)
        {
            <h6 class="mt-4 fw-semibold"><kw-l key="search.section.posts">Posts</kw-l></h6>
            <ul class="list-group mb-4">
                @foreach (var p in Model.Posts)
                {
                    // The detail lane: a group-lane draft (non-empty ComponentId
                    // == the group id) links to /groups/{id}/posts/{postId}; a
                    // community draft (empty ComponentId) links to /posts/{id}.
                    string detailUrl = !string.IsNullOrEmpty(p.ComponentId)
                        ? $"/groups/{p.ComponentId}/posts/{p.Id}"
                        : $"/posts/{p.Id}";

                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <span class="badge bg-warning text-dark me-2">
                                <kw-l key="posts.draft_badge">Draft</kw-l>
                            </span>
                            <a href="@detailUrl">
                                @(string.IsNullOrWhiteSpace(p.Title) ? p.BodyPreview : p.Title)
                            </a>
                            @if (p.ComponentName is not null)
                            {
                                <span class="text-muted small ms-2">@p.ComponentName</span>
                            }
                        </div>
                        <a class="btn btn-sm btn-outline-primary text-nowrap" href="@detailUrl">
                            <kw-l key="posts.publish">Open</kw-l>
                        </a>
                    </li>
                }
            </ul>
        }

        @if (Model.Announcements.Count > 0)
        {
            <h6 class="mt-4 fw-semibold"><kw-l key="nav.announcements">Announcements</kw-l></h6>
            <ul class="list-group mb-4">
                @foreach (var a in Model.Announcements)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <span class="badge bg-warning text-dark me-2">
                                <kw-l key="posts.draft_badge">Draft</kw-l>
                            </span>
                            <a href="/announcements/@a.Id">
                                @(string.IsNullOrWhiteSpace(a.Title)
                                    ? MarkdownRenderer.PlainTextPreview(a.Body, 80)
                                    : a.Title)
                            </a>
                        </div>
                        <a class="btn btn-sm btn-outline-primary text-nowrap" href="/announcements/@a.Id">
                            <kw-l key="posts.publish">Open</kw-l>
                        </a>
                    </li>
                }
            </ul>
        }

        @* M4 (ADR 0054) — the actor's own draft events: the same author-only
           discoverability surface (ADR 0037); the detail lane offers Publish. *@
        @if (Model.Events.Count > 0)
        {
            <h6 class="mt-4 fw-semibold"><kw-l key="nav.events">Events</kw-l></h6>
            <ul class="list-group mb-4">
                @foreach (var ev in Model.Events)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <span class="badge bg-warning text-dark me-2">
                                <kw-l key="posts.draft_badge">Draft</kw-l>
                            </span>
                            <a href="/events/@ev.Id">
                                @(string.IsNullOrWhiteSpace(ev.Title)
                                    ? MarkdownRenderer.PlainTextPreview(ev.Body, 80)
                                    : ev.Title)
                            </a>
                        </div>
                        <a class="btn btn-sm btn-outline-primary text-nowrap" href="/events/@ev.Id">
                            <kw-l key="posts.publish">Open</kw-l>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>
