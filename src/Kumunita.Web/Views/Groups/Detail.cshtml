@using Kumunita.Web.Security
@model Kumunita.Web.Models.GroupDetailViewModel
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Bookmarks.IBookmarkService Bookmarks
@{
    ViewData["Title"] = Model.Name;
    // ADR 0227 — the viewer's bookmarked posts on this page: one batched personal
    // read (IBookmarkService.ListBookmarkedIdsAsync), never one query per card.
    // Best-effort: a failed read degrades to "no bookmarks" rather than blanking the feed.
    IReadOnlySet<string> _bookmarkedIds = new HashSet<string>();
    var _feedReturnUrl = Context.Request.Path + Context.Request.QueryString;
    try
    {
        var _viewer = KumunitaPrincipal.SubjectId(User);
        if (!string.IsNullOrEmpty(_viewer))
            _bookmarkedIds = await Bookmarks.ListBookmarkedIdsAsync(_viewer, "post", Model.GroupPosts.Select(x => x.Id).ToList());
    }
    catch
    {
        // keep the empty set
    }

    // Render-time localization of the description + filter placeholders (the
    // <kw-l> TagHelper always emits a <kw-l> element, so it can't sit inside a
    // placeholder="..." attribute — resolve server-side, the _GrantPickers /
    // Profile/Edit pattern; M·5/M·8, ADR 0049).
    var _kwL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    var descPlaceholder = await Translation.GetAsync("groups.desc_placeholder", _kwL);

    // The delete-group + remove-translation forms' data-confirms (the ADR 0072
    // attribute idiom — the confirm.js seam reads the attribute verbatim; the
    // kw-l TagHelper can't wrap an attribute). The en floor is the server
    // fallback (a null provider — a non-HTTP render — degrades to en).
    string confirmDeleteGroup   = "Delete this group? This removes the group, its members, and its pending invitations, and cannot be undone.";
    string confirmRemoveTrans   = "Remove this translation?";
    // The actions menu's accessible name is a template with a {0} slot (the
    // group's name) — server-resolved (the kw-l TagHelper can't wrap an
    // attribute, and can't substitute). The en floor is the server fallback
    // (a null provider — a non-HTTP render — degrades to en).
    string ariaActionsFor = "Actions for {0}";
    if (Translation is not null)
    {
        confirmDeleteGroup = await Translation.GetAsync("groups.confirm_delete", _kwL);
        confirmRemoveTrans = await Translation.GetAsync("common.remove_translation_confirm", _kwL);
        ariaActionsFor     = await Translation.GetAsync("a11y.actions_for", _kwL);
    }
    var ariaClose = Translation is null ? "Close" : await Translation.GetAsync("a11y.close", _kwL);
    var filterNamePlaceholder = Translation is null
        ? Kumunita.Core.Localization.KnownTranslationKeys.EnValues["common.filter_name"]
        : await Translation.GetAsync("common.filter_name", _kwL);

    // The add / remove member routes each carry the same [FromForm] subjectId —
    // the route distinguishes the two (the plan's U10 line 152 pin). The
    // owner id the write seam takes (`addedBy` / `removedBy`) is the *actor's*
    // subject (minted from the signed-in principal by the controller), never a
    // form field (ADR 0003 SoD by structural identity — a form-bound owner id
    // would defeat M1's Via: Owner / Admin derivation).
    var addHref  = Url.Action(nameof(Kumunita.Web.Controllers.GroupsController.AddMember),  new { id = Model.GroupId });

    // The management lanes (add / remove / invite) are all owner ∪
    // GlobalAdmin (C-M2·3, extended to the add lane by ADR 0007); the
    // routes' TryResolveOwnerSurface gates are the real SoD walls — the
    // forms are just not offered to plain members here, same m2b
    // invite-lane pattern. The SELF-leave lane (ADR 0008) is the one
    // member-wide exception: a non-owner member's own row carries the
    // Leave form below, the owner's own row carries none (the owner
    // cannot leave their group at all).
    var canManage = Model.IsOwner || KumunitaPrincipal.IsGlobalAdmin(User);

    // The actor's own subject (KumunitaPrincipal.SubjectId — the same
    // single identity source the controller mints addedBy/removedBy/...
    // from; the leave lane's target is always this value on the server
    // side). Used per-row in the member list: the self-row carries the
    // Leave button (ADR 0008), the owner's self-row carries none
    // (the owner cannot leave their own group).
    var subject = KumunitaPrincipal.SubjectId(User);

    // ADR 0026 — translation helpers (mirrors the ADR 0022 post-detail
    // helpers): the enabled-catalog language set with its HasTranslation
    // flag, the set the "add a translation" form offers, and a code→
    // native-name resolver for the chips (never blank — falls back to the
    // code itself).
    var langNames = Model.Languages.ToDictionary(l => l.Code, l => l.NativeName);
    var missingLanguages = Model.Languages.Where(l => !l.HasTranslation).ToList();
    string LangName(string code) => langNames.TryGetValue(code, out var n) ? n : code;

    // ADR 0083 — the active tab, from the ?tab= query string (the server-
    // rendered deep link each nav-tabs <a> points at; the page reloads per
    // tab, no client JS). Defaults to "feed". "settings" is only reachable
    // for owner ∪ GlobalAdmin (canManage) — a plain member who types
    // ?tab=settings falls back to feed (the read never 404s; the route's
    // SoD gate is the real wall, the tab just isn't offered).
    var requestedTab = ViewContext.HttpContext?.Request.Query["tab"].ToString().Trim();
    var activeTab = requestedTab switch
    {
        "members"              => "members",
        "settings" when canManage => "settings",
        _                      => "feed",
    };
    string TabHref(string name) => Url.Action(nameof(Kumunita.Web.Controllers.GroupsController.Detail), new { id = Model.GroupId, tab = name })!;
}

<div class="row justify-content-center">
    <div class="col-md-12 col-lg-12 kmb-group-page">
        @*
            ADR 0083 — the tab bar (the _ProjectsTabs.cshtml Bootstrap nav-tabs
            idiom, ADR 0062). Three tabs:
            · Feed — the membership-scoped posts (ADR 0013).
            · Members — the member list + the owner's invite / add lanes (m2b).
            · Settings — About (description edit) + Privacy (ADR 0010) +
              Translations (ADR 0026); owner ∪ GlobalAdmin only (canManage).
            The active tab is derived server-side from ?tab= (the deep link),
            so a link to /groups/{id}?tab=settings lands on Settings.

            The bar is the first thing in the content column (above the back
            link) so it sits just under the navbar (the kmb-tab-under-navbar
            treatment, site.css) — consistent with the other section tab
            strips. *@
        <ul class="nav nav-tabs kmb-tab-under-navbar mb-4" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link @(activeTab == "feed" ? "active" : string.Empty)"
                   href="@TabHref("feed")">
                    <svg class="kmb-nav-icon kmb-icon" width="16" height="16" aria-hidden="true"><use href="#kmb-i-community"/></svg><kw-l key="groups.tab.feed">Feed</kw-l>
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link @(activeTab == "members" ? "active" : string.Empty)"
                   href="@TabHref("members")">
                    <svg class="kmb-nav-icon kmb-icon" width="16" height="16" aria-hidden="true"><use href="#kmb-i-groups"/></svg><kw-l key="groups.tab.members">Members</kw-l>
                </a>
            </li>
            @if (canManage)
            {
                <li class="nav-item" role="presentation">
                    <a class="nav-link @(activeTab == "settings" ? "active" : string.Empty)"
                       href="@TabHref("settings")">
                        <svg class="kmb-nav-icon kmb-icon" width="16" height="16" aria-hidden="true"><use href="#kmb-i-settings"/></svg><kw-l key="groups.tab.settings">Settings</kw-l>
                    </a>
                </li>
            }
        </ul>

        <p><a class="text-muted" href="@Url.Action("Index", "Groups")"><kw-l key="groups.back_all">← All groups</kw-l></a></p>

        @* 2026-10-25 page-level notes lane (ADR 0167 amendment) — a note about
           this group's page itself (the /groups/{id} detail) — distinct from
           a note about a specific group post. The _NoteButton partial renders
           its own d-flex wrapper (the M37 bookmark/note convention), so it
           sits right-aligned below the back link. Signed-in residents only. *>
        <div class="mb-2">
            @{ var _pn = ("page-group", Model.GroupId, $"/groups/{Model.GroupId}"); }
            <partial name="_NoteButton" model="@_pn" />
        </div>

        @* ADR 0082 — the group's action surface: one ⋮ dropdown (the
           ADR 0069 / 0071 todo/board idiom). The Groups context has no
           group-level Edit / Delete lane (the ADR 0007 / 0010 / 0026
           surface — description edit, privacy toggle, translation
           lanes live in the Settings tab, member lanes in the Members
           tab) so the menu holds the translation Edit / Add / Remove
           items only, gated on Model.CanTranslate. Translation add /
           edit open a Bootstrap modal (the ADR 0071 "Add subtask"
           shape); translation remove is a confirm form in the menu.
           The service's write-lane re-check at POST is the real gate. *@
        @* ADR 0186 — the group header card: the monogram tile from the
           Groups list (ADR 0177), the name, the owner line with chips, and
           the description. *@
        <div class="kmb-group-head">
        <div class="d-flex align-items-start gap-3 mb-2">
            <span class="avatar-mono airy-group-mono kmb-group-mono" data-hue="@AvatarHue.For(Model.GroupId)" aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.Name) ? "?" : char.ToUpperInvariant(Model.Name.TrimStart()[0]).ToString())</span>
            <h1 class="mb-0 flex-grow-1">@Model.Name</h1>
            @if (Model.CanTranslate)
            {
                <div class="dropdown">
                    <button class="btn btn-sm action-glyph-btn dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="@(ariaActionsFor.Replace("{0}", string.IsNullOrWhiteSpace(Model.Name) ? "group" : Model.Name))">⋮</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach (var existing in Model.GroupTranslations.OrderBy(x => x.LanguageCode))
                        {
                            <li>
                                <button type="button" class="dropdown-item text-dark"
                                        data-bs-toggle="modal"
                                        data-bs-target="@($"#group-trans-edit-{existing.LanguageCode}")">
                                    <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                </button>
                            </li>
                        }
                        @foreach (var lang in missingLanguages)
                        {
                            <li>
                                <button type="button" class="dropdown-item text-dark"
                                        data-bs-toggle="modal"
                                        data-bs-target="@($"#group-trans-add-{lang.Code}")">
                                    <kw-l key="posts.translation_add">Add</kw-l> — <b>@LangName(lang.Code)</b>
                                </button>
                            </li>
                        }
                        @if (Model.GroupTranslations.Count > 0)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            @foreach (var existing in Model.GroupTranslations.OrderBy(x => x.LanguageCode))
                            {
                                <li>
                                    <form method="post" action="@($"/groups/{Model.GroupId}/translations/remove")"
                                          data-confirm="@confirmRemoveTrans" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                        <button type="submit" class="dropdown-item text-danger">
                                            <kw-l key="posts.translation_remove">Remove</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                        </button>
                                    </form>
                                </li>
                            }
                        }
                    </ul>
                </div>

                @* IMPROVE-CODE C11 — the translation Edit / Add modals
                   extracted into the _GroupTranslationModals partial (the
                   markup is unchanged; the modals' view-locals are threaded
                   via Model). *@
                var _gtmModel = new Kumunita.Web.Models.GroupTranslationModalsModel(Model, LangName, ariaClose);
                <partial name="_GroupTranslationModals" model="_gtmModel" />
            }
        </div>

        <p class="kmb-group-owner">
            <kw-l key="groups.owned_by">Owned by</kw-l> <strong>@Model.OwnerDisplayName</strong>
            @if (Model.IsOwner)
            {
                <span class="kmb-chip kmb-chip-pinned"><kw-l key="groups.you_own">You own this group</kw-l></span>
            }
            @if (Model.IsPrivate)
            {
                <span class="kmb-chip kmb-chip-draft"><kw-l key="groups.private_chip">Private</kw-l></span>
            }
        </p>

        @*
            ADR 0009 — the group's description (the M1 Group.Description field,
            resident-facing since ADR 0009): rendered for everyone who reaches
            the detail (owner ∪ member gate) when it holds one. The *edit* form
            moved to the Settings tab (ADR 0083); the read stays in the header
            (the group's blurb, like a profile's bio). The tab bar moved to the
            top of the column (under the navbar) so the blurb now reads above
            the tab panes, not above the bar.
        *@
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="kmb-group-desc">@Model.Description</p>
        }
        </div>

        <div class="tab-content">

            @* ── Feed (the posts, ADR 0013) ──────────────────────────────────── *@
            <div class="tab-pane fade @(activeTab == "feed" ? "show active" : string.Empty)" id="tab-feed" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    @* not extracted: the Posts tab (heading, sort, empty-state, the post-card @foreach,
                       pager) is a single-use group surface — the same card shape is inlined once here,
                       not repeated across views or independently touched — so it stays inline. The
                       Members + translation-modals blocks DID extract (they are independently touched). *@
                    <h2 class="mb-0"><kw-l key="groups.posts_heading">Posts</kw-l></h2>
                    @if (Model.CanPost)
                    {
                        <a class="btn btn-primary" href="@($"/groups/{Model.GroupId}/posts/new")"><kw-l key="groups.new_post">New post</kw-l></a>
                    }
                </div>

                @* The shared sort control (the _Sort partial) sits at the TOP
                   of the section — above the list — so the sort options are
                   the first thing the viewer sees (it renders nothing when
                   the VM field is null, the no-sort pin). *@
                @if (Model.SortPosts is not null)
                {
                    <partial name="_Sort" model="Model.SortPosts" />
                }
                @if (Model.GroupPosts.Count == 0)
                {
                    @* R33 (IMPROVE-UX) — the house .kmb-empty idiom (title +
                       body + one next action). The "New post" action is offered
                       only in the CanPost branch (a body-only survivor for the
                       non-can branch — the viewer has no post to write here). *@
                    <div class="kmb-empty kmb-group-empty">
                        <p class="kmb-empty-title"><kw-l key="groups.posts_empty_title">No posts yet.</kw-l></p>
                        <p class="kmb-empty-body">
                            @if (Model.CanPost)
                            {
                                <text><kw-l key="groups.posts_empty_can">No posts yet. Write the first one — it will be visible to the current members.</kw-l></text>
                            }
                            else
                            {
                                <text><kw-l key="groups.posts_empty">No posts here yet.</kw-l></text>
                            }
                        </p>
                        @if (Model.CanPost)
                        {
                            <a class="btn btn-primary" href="@($"/groups/{Model.GroupId}/posts/new")"><kw-l key="groups.new_post">New post</kw-l></a>
                        }
                    </div>
                }
                else
                {
                    <div class="airy-feed">
                        @foreach (var p in Model.GroupPosts)
                        {
                            string authorAvatarInitial = !string.IsNullOrWhiteSpace(p.AuthorDisplayName)
                                ? char.ToUpperInvariant(p.AuthorDisplayName.TrimStart()[0]).ToString()
                                : string.Empty;
                            @* ADR 0186 — the feed card (ADR 0175) for a group post. *@
                            <div class="airy-post-card">
                                <div class="airy-post-head">
                                    <kw-avatar subject="@p.AuthorSubjectId" mono="@authorAvatarInitial"
                                              mono-hue="@AvatarHue.For(p.AuthorSubjectId)" />
                                    <span class="airy-post-author">
                                        <span class="name">@p.AuthorDisplayName</span>
                                        <span class="when"><kw-dt dt="@p.Created" format="g"></kw-dt></span>
                                    </span>
                                </div>
                                <div class="airy-post-title">
                                    <a href="@($"/groups/{Model.GroupId}/posts/{p.Id}")">
                                        @(!string.IsNullOrWhiteSpace(p.Title) ? p.Title : (p.BodyPreview.Length <= 60 ? p.BodyPreview : p.BodyPreview[..60] + "…"))
                                    </a>
                                </div>
                                <p class="airy-post-preview mb-0">@p.BodyPreview</p>
                                <partial name="_PostCardFoot" model="@(new PostCardFootModel($"/groups/{Model.GroupId}/posts/{p.Id}#replies", p.ReplyCount, p.Id, _bookmarkedIds.Contains(p.Id), _feedReturnUrl))" />
                            </div>
                        }
                    </div>

                    @* M7 (ADR 0090 D2) — the "N in this group; M shown to you"
                       hidden-count hint is removed (C-M7·7: the candidate count
                       is never viewer-facing). *@
                    @* M7 (ADR 0090 D5) — the group-posts section pager (F2
                       one-page no-render pin): the <c>_Pager</c> partial renders
                       nothing when the VM field is null. (The sort control now
                       lives at the TOP of the section, above the list.) *@
                    @if (Model.PagerPosts is not null)
                    {
                        <partial name="_Pager" model="Model.PagerPosts" />
                    }
                }

                @* ── Events (ADR 0089 — the M4 event surface's group lane) ── *@
                <hr class="my-4" />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="mb-0"><kw-l key="groups.events_heading">Events</kw-l></h2>
                    @if (Model.CanCreateEvent)
                    {
                        <a class="btn btn-primary" href="@($"/groups/{Model.GroupId}/events/new")"><kw-l key="groups.new_event">New event</kw-l></a>
                    }
                </div>

                @* The shared sort control (the _Sort partial) sits at the TOP
                   of the section — above the list — so the sort options are
                   the first thing the viewer sees (it renders nothing when
                   the VM field is null, the no-sort pin). *@
                @if (Model.SortEvents is not null)
                {
                    <partial name="_Sort" model="Model.SortEvents" />
                }
                @if (Model.GroupEvents.Count == 0)
                {
                    @* R33 (IMPROVE-UX) — the house .kmb-empty idiom (title +
                       body + one next action). The "New event" action is offered
                       only in the CanCreateEvent branch (a body-only survivor
                       for the non-can branch — the viewer has no event to plan
                       here). *@
                    <div class="kmb-empty kmb-group-empty">
                        <p class="kmb-empty-title"><kw-l key="groups.events_empty_title">No events yet.</kw-l></p>
                        <p class="kmb-empty-body">
                            @if (Model.CanCreateEvent)
                            {
                                <text><kw-l key="groups.events_empty_can">No events yet. Plan the first one — it will be visible to the current members.</kw-l></text>
                            }
                            else
                            {
                                <text><kw-l key="groups.events_empty">No events here yet.</kw-l></text>
                            }
                        </p>
                        @if (Model.CanCreateEvent)
                        {
                            <a class="btn btn-primary" href="@($"/groups/{Model.GroupId}/events/new")"><kw-l key="groups.new_event">New event</kw-l></a>
                        }
                    </div>
                }
                else
                {
                    <div class="airy-feed">
                        @foreach (var e in Model.GroupEvents)
                        {
                            string authorAvatarInitial = !string.IsNullOrWhiteSpace(e.AuthorDisplayName)
                                ? char.ToUpperInvariant(e.AuthorDisplayName.TrimStart()[0]).ToString()
                                : string.Empty;
                            @* ADR 0186 — event card: organiser header, the start time
                               as the "when" line, then title and preview. *@
                            <div class="airy-post-card">
                                <div class="airy-post-head">
                                    <kw-avatar subject="@e.AuthorSubjectId" mono="@authorAvatarInitial"
                                              mono-hue="@AvatarHue.For(e.AuthorSubjectId)" />
                                    <span class="airy-post-author">
                                        <span class="name">@e.AuthorDisplayName</span>
                                        <span class="when"><kw-dt dt="@e.Start" format="g"></kw-dt></span>
                                    </span>
                                </div>
                                <div class="airy-post-title">
                                    <a href="@($"/groups/{Model.GroupId}/events/{e.Id}")">
                                        @(!string.IsNullOrWhiteSpace(e.Title) ? e.Title : (e.BodyPreview.Length <= 60 ? e.BodyPreview : e.BodyPreview[..60] + "…"))
                                    </a>
                                </div>
                                <p class="airy-post-preview mb-0">@e.BodyPreview</p>
                            </div>
                        }
                    </div>

                    @* M7 (ADR 0090 D2) — the "N in this group; M shown to you"
                       hidden-count hint is removed (C-M7·7: the candidate count
                       is never viewer-facing). *@
                    @* M7 (ADR 0090 D5) — the group-events section pager (F2
                       one-page no-render pin): the <c>_Pager</c> partial renders
                       nothing when the VM field is null. (The sort control now
                       lives at the TOP of the section, above the list.) *@
                    @if (Model.PagerEvents is not null)
                    {
                        <partial name="_Pager" model="Model.PagerEvents" />
                    }
                }
            </div>

            @* IMPROVE-CODE C11 — the Members tab (the member list + the
               pending invitations + the pending join-request review + the
               owner's invite lane + the add-member lane) extracted into
               the _GroupMembers partial (the markup is unchanged; the
               tab's view-locals are threaded via Model; activeTab via
               ViewData["ActiveTab"]). *@
            @{ ViewData["ActiveTab"] = activeTab; }
            @{ var _gmModel = new Kumunita.Web.Models.GroupMembersModel(Model, canManage, subject, filterNamePlaceholder, addHref!); }
            <partial name="_GroupMembers" model="_gmModel" />

            @* ── Settings (About + Privacy + Translations; canManage only) ──── *@
            @if (canManage)
            {
                <div class="tab-pane fade @(activeTab == "settings" ? "show active" : string.Empty)" id="tab-settings" role="tabpanel">
                    @*
                        ADR 0009 — the group's description *edit* form (owner ∪
                        GlobalAdmin; the route's TryResolveOwnerSurface gate is
                        the real SoD wall — a plain member never sees it). The
                        read lives in the header above; only the form is here.
                    *@
                    <h2 class="h4"><kw-l key="groups.about_heading">About this group</kw-l></h2>
                    <form method="post" action="@Url.Action("UpdateDescription", "Groups", new { id = Model.GroupId })">
                        @Html.AntiForgeryToken()
                        <label class="form-label" for="description"><kw-l key="groups.about_desc_label">Description (optional)</kw-l></label>
                        <textarea class="form-control" id="description" name="description" rows="3" maxlength="500"
                                  placeholder="@descPlaceholder">@Model.Description</textarea>
                        <div class="form-text mt-1"><kw-l key="groups.about_desc_clear_hint">Leave blank to clear the description.</kw-l></div>
                        <button type="submit" class="btn btn-primary mt-2"><kw-l key="groups.about_desc_save">Save description</kw-l></button>
                    </form>

                    @*
                        ADR 0010 — the group's privacy (public ↔ private). Same
                        standing as the description edit lane (owner ∪ GlobalAdmin).
                    *@
                    <h2 class="h4 mt-4"><kw-l key="groups.privacy_heading">Privacy</kw-l></h2>
                    <form method="post" action="@Url.Action("UpdatePrivacy", "Groups", new { id = Model.GroupId })">
                        @Html.AntiForgeryToken()
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isPrivate"
                                   name="isPrivate" value="true" @(Model.IsPrivate ? "checked" : "") />
                            <label class="form-check-label" for="isPrivate"><kw-l key="groups.private_label">Private group</kw-l></label>
                        </div>
                        <div class="form-text mt-1">
                            <kw-l key="groups.private_hint">A private group (e.g. a family) is hidden from everyone else; only the people you add as members can see and use it. Clear the box to make the group public again.</kw-l>
                        </div>
                        <button type="submit" class="btn btn-primary mt-2"><kw-l key="common.save">Save</kw-l></button>
                    </form>

                    @*
                        ADR 0026 — group name/description translations (the
                        ADR 0082 surface: read-only chips + per-translation
                        detail; the Edit / Add / Remove lanes moved to the
                        header ⋮ dropdown, the ADR 0069 / 0071 todo/board
                        idiom, with the ADR 0071 Bootstrap modal shape).
                    *@
                    @if (Model.GroupTranslations.Count > 0)
                    {
                        <div class="mt-4 border-top pt-3">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <span class="text-muted small fw-semibold">
                                    <kw-l key="groups.translations_label">Translations</kw-l>
                                </span>
                                @foreach (var t in Model.GroupTranslations.OrderBy(x => x.LanguageCode))
                                {
                                    <span class="kmb-chip">@LangName(t.LanguageCode)</span>
                                }
                            </div>

                            @foreach (var t in Model.GroupTranslations.OrderBy(x => x.LanguageCode))
                            {
                                <details class="mb-1">
                                    <summary class="btn btn-sm btn-link p-0 text-decoration-none">@LangName(t.LanguageCode)</summary>
                                    <div class="ms-2">
                                        @if (!string.IsNullOrWhiteSpace(t.Name))
                                        {
                                            <h5 class="mt-1">@t.Name</h5>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(t.Description))
                                        {
                                            <p class="mb-0">@t.Description</p>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    }

                    @*
                        ADR 0093 — the group's delete (owner ∪ GlobalAdmin, the
                        TryResolveOwnerSurface gate is the real SoD wall; a plain
                        member never sees this form). Hard delete — the group, its
                        membership, and its invitations are removed; group-scoped
                        posts / events / translations are left in place and become
                        unreachable (the group lane is membership-only, ADR 0013).
                        The confirm is the declarative data-confirm contract
                        (client/lib/confirm.ts, SECURITY.md §6). The route redirects
                        to the /groups list (the actor is out of the owner ∪ member
                        projection on the next read — the ADR 0008 LeaveGroup
                        redirect shape).
                    *@
                    <div class="mt-4 border-top pt-3">
                        <h2 class="h4"><kw-l key="groups.danger_heading">Danger zone</kw-l></h2>
                        <p class="text-muted">
                            <kw-l key="groups.danger_delete_hint">Deleting the group removes it, its members, and any pending invitations. This cannot be undone.</kw-l>
                        </p>
                        <form method="post" action="@Url.Action("DeleteGroup", "Groups", new { id = Model.GroupId })"
                              data-confirm="@confirmDeleteGroup"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">
                                <kw-l key="groups.danger_delete_button">Delete this group</kw-l>
                            </button>
                        </form>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
