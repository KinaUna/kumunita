@model Kumunita.Web.Models.GroupPostComposeViewModel
@{
    ViewData["Title"] = "Edit group post";
    // The group's id and the post's id are the route's {id}/{postId} — this
    // view is reached via GET /groups/{id}/posts/{postId}/edit (ADR 0016,
    // the author-only group-post edit lane) and by the paired POST's failure
    // re-render. The form carries **only** title + body (the group lane has
    // no audience slot — G·8: the membership is the audience proxy — and no
    // component picker — G·2 lane exclusivity); the group's id is never a
    // form field (a form-bound group id would be a lane-bypass hole; the
    // controller reads it from the route).
    string groupId = (string?)ViewContext.RouteData.Values["id"] ?? string.Empty;
    string editPostId = (string?)ViewContext.RouteData.Values["postId"] ?? string.Empty;
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <p><a class="text-muted" href="@($"/groups/{groupId}/posts/{editPostId}")">&larr; <kw-l key="groups.edit_back">back to the post</kw-l></a></p>

        <h1><kw-l key="groups.edit_title">Edit your post</kw-l></h1>
        <p class="text-muted">
            You are editing your own post. Only you can edit it — the group
            membership decides who can <i>see</i> it, but only its author can
            change it. The group this post appears in is fixed; only the
            title and body below are editable.
        </p>

        @if (TempData["info"] is string info)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="post" action="@($"/groups/{groupId}/posts/{editPostId}/edit")">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="title" style="font-weight:600;">
                            Title
                        </label>
                        <input class="form-control" type="text" id="title" name="Title"
                               maxlength="120" value="@Model.Title"
                               placeholder="optional" />
                        <div class="text-muted small mt-1">
                            A short headline (≤ 120 chars). Leave blank for a
                            body-only post — the list will show your first line
                            of the body instead.
                        </div>
                    </div>

                    <div>
                        <label class="form-label" for="body" style="font-weight:600;">
                            Body
                        </label>
                        <textarea class="form-control" id="body" name="Body" rows="6" required
                                  placeholder="…">@Model.Body</textarea>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><kw-l key="groups.edit_submit">Save changes</kw-l></button>
                <a class="btn btn-outline-secondary" href="@($"/groups/{groupId}/posts/{editPostId}")">Cancel</a>
            </div>
        </form>
    </div>
</div>
