@model Kumunita.Web.Models.GroupEventComposeViewModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    ViewData["Title"] = "New event";
    // The group's id is the route's {id} — this view is reached via
    // GET /groups/{id}/events/new (the standalone composer page, ADR 0089)
    // and by the paired POST's failure re-render. The form never carries the
    // group's id as a field (a form-bound group id would be a lane-bypass
    // hole; the controller mints GroupEventDraft.GroupId from the route —
    // ADR 0089, GE·3).
    string groupId = (string?)ViewContext.RouteData.Values["id"] ?? string.Empty;
    var _kwL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    var optionalPlaceholder = await Translation.GetAsync("common.optional", _kwL);
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <p><a class="text-muted" href="@($"/groups/{groupId}")">&larr; <kw-l key="groups.new_back">back to the group</kw-l></a></p>

        <h1><kw-l key="groups.new_event_title">Event for this group</kw-l></h1>
        <p class="text-muted">
            <kw-l key="groups.new_event_lead">Your event will be visible to the current members of this group only.</kw-l>
        </p>

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <ul class="mb-0">
                    @foreach (var msg in ViewData.ModelState
                        .SelectMany(kvp => kvp.Value?.Errors ?? [])
                        .Select(e => e.ErrorMessage))
                    {
                        <li>@msg</li>
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="post" action="@($"/groups/{groupId}/events")">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="title" style="font-weight:600;">
                            <kw-l key="common.title">Title</kw-l>
                        </label>
                        <input class="form-control" type="text" id="title" name="Title"
                               maxlength="120" value="@Model.Title"
                               placeholder="@optionalPlaceholder" />
                        <div class="text-muted small mt-1">
                            <kw-l key="posts.title_hint">A short headline (up to 120 characters). Leave blank for a body-only entry — the list will show your first line of the body instead.</kw-l>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col">
                            <label class="form-label" for="start" style="font-weight:600;"><kw-l key="events.start">Start</kw-l></label>
                            <input class="form-control" type="datetime-local" id="start" name="Start" required
                                   value="@Model.Start.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="col">
                            <label class="form-label" for="end" style="font-weight:600;"><kw-l key="events.end">End</kw-l></label>
                            <input class="form-control" type="datetime-local" id="end" name="End" required
                                   value="@Model.End.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </div>
                    <div class="text-muted small mb-3">
                        <kw-l key="events.time_hint">The time the event runs. Shown to viewers in their own timezone.</kw-l>
                    </div>

                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-sm-5">
                            <label class="form-label" for="location" style="font-weight:600;"><kw-l key="events.location">Location</kw-l></label>
                            <input class="form-control" type="text" id="location" name="Location"
                                   placeholder="@optionalPlaceholder" value="@Model.Location" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label" for="capacity" style="font-weight:600;"><kw-l key="events.capacity">Capacity</kw-l></label>
                            <input class="form-control" type="number" min="1" id="capacity" name="Capacity"
                                   placeholder="@optionalPlaceholder" value="@Model.Capacity" />
                        </div>
                        <div class="col-sm-3">
                            <label class="form-label" for="color" style="font-weight:600;"><kw-l key="events.color">Color</kw-l></label>
                            <input class="form-control form-control-color" type="color" id="color" name="Color"
                                   value="@(Model.Color ?? "#4f8f84")" />
                        </div>
                    </div>
                    <div class="text-muted small">
                        <kw-l key="events.location_hint">Location, capacity, and color are display details only — they do not limit who can RSVP.</kw-l>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="body" style="font-weight:600;">
                        <kw-l key="common.body">Body</kw-l>
                    </label>
                    <div class="rc-editor">
                        <div class="rc-editor-toolbar" data-rich-editor>
                            <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                            <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                            <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                            <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                            <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                            <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                            <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                            <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                            <partial name="_RichEditorToggle" />
                        </div>
                        <textarea class="form-control" id="body" name="Body" rows="6" required
                                  placeholder="…" data-rich-editor>@Model.Body</textarea>
                        <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="language" style="font-weight:600;">
                        <kw-l key="common.language">Language</kw-l>
                    </label>
                    <select class="form-control" id="language" name="LanguageCode">
                        @foreach (var (languageCode, nativeName) in Model.Languages)
                        {
                            <option value="@languageCode" selected="@(languageCode == Model.LanguageCode ? "selected" : null)">
                                @nativeName
                            </option>
                        }
                    </select>
                    <div class="text-muted small mt-2">
                        <kw-l key="posts.language_hint">The language you're writing this event in. This is only a tag — it is not translated — and it keeps the text findable later.</kw-l>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><kw-l key="groups.new_event_submit">Add event to group</kw-l></button>
                <a class="btn btn-outline-secondary" href="@($"/groups/{groupId}")"><kw-l key="common.cancel">Cancel</kw-l></a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @* The rich editor (the toolbar + live preview pane; self-wires the
       .rc-editor surface, RE·3 — no editor dependency). *@
    <script type="module" src="~/js/lib/rich-editor.js"></script>
}
