@model Kumunita.Web.Models.GroupPostComposeViewModel
@{
    ViewData["Title"] = "Post to group";
    // The group's id is the route's {id} — this view is reached via
    // GET /groups/{id}/posts/new (the standalone composer page) and by
    // the paired POST's failure re-render. The form never carries the
    // group's id as a field (a form-bound group id would be a lane-bypass
    // hole; the controller mints GroupPostDraft.GroupId from the route —
    // ADR 0013, G·3).
    string groupId = (string?)ViewContext.RouteData.Values["id"] ?? string.Empty;
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <p><a class="text-muted" href="@($"/groups/{groupId}")">&larr; <kw-l key="groups.new_back">back to the group</kw-l></a></p>

        <h1><kw-l key="groups.new_title">Post to this group</kw-l></h1>
        <p class="text-muted">
            Your post will be visible to the current members of this group only —
            membership is the single access decision on this channel.
        </p>

        @if (TempData["info"] is string info)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="post" action="@($"/groups/{groupId}/posts")">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="title" style="font-weight:600;">
                            Title
                        </label>
                        <input class="form-control" type="text" id="title" name="Title"
                               maxlength="120" value="@Model.Title"
                               placeholder="optional" />
                        <div class="text-muted small mt-1">
                            A short headline (≤ 120 chars). Leave blank for a
                            body-only post — the list will show your first line
                            of the body instead.
                        </div>
                    </div>

                    <div>
                        <label class="form-label" for="body" style="font-weight:600;">
                            Body
                        </label>
                        <textarea class="form-control" id="body" name="Body" rows="6" required
                                  placeholder="…" data-image-target>@Model.Body</textarea>
                        <div class="rc-insert-image mt-2">
                            <input type="file"
                                   accept="image/jpeg,image/png,image/webp,image/gif"
                                   data-insert-image />
                            <span data-insert-image-error class="text-danger small d-block mt-1" style="min-height:1em;"></span>
                        </div>
                        <div class="text-muted small mt-1">
                            Pick a photo to embed it in the body as a Markdown
                            image link. The image is attached to this post.
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <label class="form-label" for="language" style="font-weight:600;">
                        Language
                    </label>
                    <select class="form-control" id="language" name="LanguageCode">
                        @foreach (var (languageCode, nativeName) in Model.Languages)
                        {
                            <option value="@languageCode" selected="@(languageCode == Model.LanguageCode ? "selected" : null)">
                                @nativeName
                            </option>
                        }
                    </select>
                    <div class="text-muted small mt-2">
                        The language you're writing this post in. This is only a
                        tag — it is not translated — and it keeps the text
                        findable later and lets a reader add their own language
                        version if they want.
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><kw-l key="groups.new_submit">Post to group</kw-l></button>
                <a class="btn btn-outline-secondary" href="@($"/groups/{groupId}")">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @* RC U05 composer image control (client/lib/insert-image.ts, tsc-built —
       SECURITY.md §6: no inline <script>; self-wires the
       input[data-insert-image] + textarea[data-image-target] pair above.
       Upload is CSRF-aware via client/lib/api.ts + the layout's
       <meta name="anti-forgery-token"> (drift pause e, resolved U05). *@
    <script type="module" src="~/js/lib/insert-image.js"></script>
}
