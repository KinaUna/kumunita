@using Kumunita.Web.Security
@model Kumunita.Web.Models.GroupMembersModel
@* IMPROVE-CODE C11 — extracted from Groups/Detail.cshtml (the Members tab:
   the member list with the self-row / owner-row lane, ADR 0008; the pending
   invitations; the pending join-request review, ADR 0094; the owner's invite
   lane, m2b; and the owner ∪ GlobalAdmin's add-member lane, C-M2·3 / ADR 0007).
   The markup is unchanged — the tab's view-locals (canManage / subject /
   filterNamePlaceholder / addHref) are now carried on the model. *@
<div class="tab-pane fade @(ViewContext.ViewData["ActiveTab"] as string == "members" ? "show active" : string.Empty)" id="tab-members" role="tabpanel">
    <h2><kw-l key="groups.members_heading">Members</kw-l></h2>
    @if (Model.Model.Members.Count == 0)
    {
        <p class="text-muted"><kw-l key="groups.members_empty">No members yet.</kw-l></p>
    }
    else
    {
        <ul class="kmb-member-list">
            @foreach (var m in Model.Model.Members)
            {
                @*
                    Per-row action (ADR 0008):
                    · owner ∪ GlobalAdmin sees Remove — except on
                      the OWNER'S OWN row (the owner cannot leave
                      their own group; ownerSelfRow is the only row
                      they lose the button on, so removing OTHERS
                      stays intact);
                    · a non-owner member sees Leave on their OWN
                      row (the self-lane POST /groups/{id}/leave —
                      the route mints the target from the signed-in
                      principal, no form field), and nothing on
                      anyone else's row;
                    · what is offered is exactly what the route
                      accepts (the m2b invite-lane pattern: forms
                      are presentation, the controller gates keep
                      the SoD).
                *@
                var ownerSelfRow = Model.Model.IsOwner && m.SubjectId == Model.Model.OwnerSubjectId;
                var isSelfRow = m.SubjectId == Model.Subject;

                <li class="kmb-member-row"
                    id="@($"member-{m.SubjectId}")">
                    <span class="kmb-member-name">
                        <kw-avatar subject="@m.SubjectId" mono="@(string.IsNullOrWhiteSpace(m.DisplayName) ? string.Empty : char.ToUpperInvariant(m.DisplayName.TrimStart()[0]).ToString())"
                                  mono-hue="@AvatarHue.For(m.SubjectId)" />
                        <span>@m.DisplayName</span>
                    </span>
                    @if (Model.CanManage && !ownerSelfRow && !isSelfRow)
                    {
                        <form method="post" action="@Url.Action("RemoveMember", "Groups", new { id = Model.Model.GroupId })">
                            @Html.AntiForgeryToken()
                            <input name="subjectId" type="hidden" value="@m.SubjectId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <kw-l key="common.remove">Remove</kw-l>
                            </button>
                        </form>
                    }
                    else if (isSelfRow && !ownerSelfRow)
                    {
                        <form method="post" action="@Url.Action("LeaveGroup", "Groups", new { id = Model.Model.GroupId })">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                <kw-l key="groups.member_leave">Leave</kw-l>
                            </button>
                        </form>
                    }
                </li>
            }
        </ul>
    }

    @*
        m2b — the owner's invite lane (C-M2b·1: owner ∪ GlobalAdmin).
        Pending invitations (with cancel links) render whenever the
        group holds any; both blocks are owner-visible (the route
        gate is the real SoD wall — a plain member's POST 404s, the
        form just isn't offered to them here).
    *@
    @if (Model.Model.IsOwner && Model.Model.PendingInvitations.Count > 0)
    {
        <h2 class="mt-4"><kw-l key="groups.pending_invitations_heading">Pending invitations</kw-l></h2>
        <ul class="kmb-member-list mb-3">
            @foreach (var p in Model.Model.PendingInvitations)
            {
                <li class="kmb-member-row">
                    <span>@p.DisplayName</span>
                    <form method="post"
                          action="@Url.Action("CancelInvitation", "Groups", new { id = Model.Model.GroupId, subjectId = p.SubjectId })">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-warning"><kw-l key="groups.invite_cancel">Cancel invite</kw-l></button>
                    </form>
                </li>
            }
        </ul>
    }

    @*
        ADR 0094 — the owner ∪ GlobalAdmin's join-request review
        surface (Model.PendingJoinRequests). A resident's
        self-initiated request to join this (public) group: approve
        lands the membership (C4) / decline leaves the requester
        out. Offered to canManage (the route's TryResolveOwnerSurface
        gate is the real SoD wall — a plain member's POST 404s).
    *@
    @if (Model.CanManage && Model.Model.PendingJoinRequests.Count > 0)
    {
        <h2 class="mt-4">
            <kw-l key="groups.join_requests_pending_heading">Pending join requests</kw-l>
            <span class="kmb-chip">@Model.Model.PendingJoinRequests.Count</span>
        </h2>
        <ul class="kmb-member-list mb-3">
            @foreach (var p in Model.Model.PendingJoinRequests)
            {
                <li class="kmb-member-row">
                    <span>@p.DisplayName</span>
                    <span class="d-inline-flex gap-2">
                        <form method="post"
                              action="@Url.Action("ApproveJoinRequest", "Groups", new { id = Model.Model.GroupId, subjectId = p.SubjectId })">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-primary"><kw-l key="groups.join_approve">Approve</kw-l></button>
                        </form>
                        <form method="post"
                              action="@Url.Action("DeclineJoinRequest", "Groups", new { id = Model.Model.GroupId, subjectId = p.SubjectId })">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary"><kw-l key="groups.join_decline">Decline</kw-l></button>
                        </form>
                    </span>
                </li>
            }
        </ul>
    }

    @if (Model.Model.IsOwner)
    {
        <h2 class="mt-4"><kw-l key="groups.invite_heading">Invite a resident</kw-l></h2>
        @if (Model.Model.ResidentCandidates.Count > 0)
        {
            <form method="post"
                  action="@Url.Action("InviteMember", "Groups", new { id = Model.Model.GroupId })"
                  class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-sm-8">
                    <label class="visually-hidden" for="invite-filter"><kw-l key="groups.filter_residents_label">Filter residents</kw-l></label>
                    <input type="text" class="form-control" id="invite-filter"
                           data-name-filter="invite-subjectId"
                           placeholder="@Model.FilterNamePlaceholder" autocomplete="off" />
                    <label class="visually-hidden" for="invite-subjectId"><kw-l key="groups.resident_label">Resident</kw-l></label>
                    <select id="invite-subjectId" name="subjectId" class="form-select mt-2" required>
                        @foreach (var r in Model.Model.ResidentCandidates)
                        {
                            <option value="@r.SubjectId">@r.DisplayName</option>
                        }
                    </select>
                    <div class="text-muted small">
                        <kw-l key="groups.invite_note">They get an invitation on their Groups page to accept or decline.</kw-l>
                    </div>
                </div>
                <div class="col-sm-auto align-self-end">
                    <button type="submit" class="btn btn-primary"><kw-l key="groups.invite_submit">Invite</kw-l></button>
                </div>
            </form>
            @* Name filter handled by client/lib/name-filter.js
               (loaded in _Layout.cshtml — SECURITY.md §6). *@
        }
        else
        {
            <p class="text-muted"><kw-l key="groups.all_members_already">Every resident is already a member of this group.</kw-l></p>
        }
    }

    @*
        The add-member form — offered to owner ∪ GlobalAdmin only
        (C-M2·3 extended per ADR 0007; the route's owner-surface
        gate is the real SoD wall, a plain member's POST 404s —
        same pattern as the invite lane above).
    *@
    @if (Model.CanManage)
    {
        <h2 class="mt-4"><kw-l key="groups.add_member_heading">Add a member</kw-l></h2>
        @if (Model.Model.ResidentCandidates.Count > 0)
        {
            <form method="post" action="@Model.AddHref" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-sm-8">
                    <label class="visually-hidden" for="add-member-filter"><kw-l key="groups.filter_residents_label">Filter residents</kw-l></label>
                    <input type="text" class="form-control" id="add-member-filter"
                           data-name-filter="add-subjectId"
                           placeholder="@Model.FilterNamePlaceholder" autocomplete="off" />
                    <label class="visually-hidden" for="add-subjectId"><kw-l key="groups.resident_label">Resident</kw-l></label>
                    <select id="add-subjectId" name="subjectId" class="form-select mt-2" required>
                        @foreach (var r in Model.Model.ResidentCandidates)
                        {
                            <option value="@r.SubjectId">@r.DisplayName</option>
                        }
                    </select>
                    <div class="text-muted small">
                        <kw-l key="groups.add_member_note">They are added to the group immediately (no invitation).</kw-l>
                    </div>
                </div>
                <div class="col-sm-auto align-self-end">
                    <button type="submit" class="btn btn-primary"><kw-l key="common.add">Add</kw-l></button>
                </div>
            </form>
            @* Name filter handled by client/lib/name-filter.js
               (loaded in _Layout.cshtml — SECURITY.md §6). *@
        }
        else
        {
            <p class="text-muted"><kw-l key="groups.all_members_already">Every resident is already a member of this group.</kw-l></p>
        }
    }
</div>
