@model Kumunita.Web.Models.GroupListViewModel
@{
    ViewData["Title"] = "Groups";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <h1>Groups</h1>
        <p class="text-muted">The communities you own or belong to.</p>

        @if (TempData["info"] is string info)
        {
            <div class="alert alert-success" role="alert">@info</div>
        }
        @if (TempData["error"] is string err)
        {
            <div class="alert alert-danger" role="alert">@err</div>
        }

        @if (Model.Groups.Count == 0)
        {
            <div class="alert alert-info">
                No groups yet. <a href="@Url.Action("Create", "Groups")">Create one</a>
                to organize residents (e.g. "Building 4", "Volunteers", "Bike owners").
            </div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var g in Model.Groups)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between">
                        <span>@g.Name</span>
                        <span class="text-muted">
                            @g.MemberCount
                            member@(g.MemberCount == 1 ? "" : "s")
                        </span>
                    </li>
                }
            </ul>
        }

        <p class="mt-3">
            <a href="@Url.Action("Create", "Groups")" class="btn btn-primary">Create a group</a>
        </p>
    </div>
</div>
