@model Kumunita.Web.Models.GroupListViewModel
@{
    ViewData["Title"] = "Groups";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <header class="airy-head">
            <div class="head-row">
                <div>
                    <h1><kw-l key="groups.title">Groups</kw-l></h1>
                    <p class="lede"><kw-l key="groups.lead">The communities you own or belong to.</kw-l></p>
                </div>
            </div>
        </header>

        @*
            m2b — "Your invitations" card: the actor's OWN pending group
            invitations (GroupListViewModel.Invitations). The invitee cannot
            reach the group detail (owner ∪ member gate) until accepting, so
            the group's name is rendered from the list-side projection, and
            the two cards (accept / decline) post to the self-lane routes.
        *@
        @if (Model.Invitations.Count > 0)
        {
            <section class="airy-invite">
                <h2>
                    <kw-l key="groups.invitations">Invitations</kw-l>
                    <span class="badge bg-warning text-dark">@Model.Invitations.Count <kw-l key="groups.invitations_pending">pending</kw-l></span>
                </h2>
                @foreach (var inv in Model.Invitations)
                {
                    <div class="airy-invite-row">
                        <span class="name">@inv.GroupName</span>
                        <span class="by"><kw-l key="groups.invited_by">Invited by</kw-l> @inv.InvitedByDisplayName</span>
                        <span class="row-actions">
                            <form method="post"
                                  action="@Url.Action("AcceptInvitation", "Groups", new { id = inv.GroupId })">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-primary"><kw-l key="groups.invite_accept">Accept</kw-l></button>
                            </form>
                            <form method="post"
                                  action="@Url.Action("DeclineInvitation", "Groups", new { id = inv.GroupId })">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary"><kw-l key="groups.invite_decline">Decline</kw-l></button>
                            </form>
                        </span>
                    </div>
                }
            </section>
        }

        @*
            ADR 0094 — "Your join requests" card: the actor's OWN pending
            join requests (GroupListViewModel.MyJoinRequests). The requester
            initiated each one, so the row carries only the group's name —
            and the single affordance is a Withdraw (the self-lane route).
        *@
        @if (Model.MyJoinRequests.Count > 0)
        {
            <section class="airy-invite">
                <h2>
                    <kw-l key="groups.join_requests">Join requests</kw-l>
                    <span class="badge bg-secondary">@Model.MyJoinRequests.Count <kw-l key="groups.join_requests_pending">pending</kw-l></span>
                </h2>
                @foreach (var req in Model.MyJoinRequests)
                {
                    <div class="airy-invite-row">
                        <span class="name">@req.GroupName</span>
                        <span class="by"><kw-l key="groups.join_requests_note">Waiting for the group owner.</kw-l></span>
                        <span class="row-actions">
                            <form method="post"
                                  action="@Url.Action("WithdrawJoinRequest", "Groups", new { id = req.GroupId })">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary"><kw-l key="groups.join_withdraw">Withdraw</kw-l></button>
                            </form>
                        </span>
                    </div>
                }
            </section>
        }

        @if (Model.Groups.Count == 0)
        {
            <div class="alert alert-info">
                <kw-l key="groups.empty">No groups yet.</kw-l>
                <a href="@Url.Action("Create", "Groups")">Create one</a>
                to organize residents (e.g. "Building 4", "Volunteers", "Bike owners").
            </div>
        }
        else
        {
            <div class="airy-group-grid">
                @foreach (var g in Model.Groups)
                {
                    <div class="airy-group-card">
                        <span class="gname">
                            <a href="@Url.Action("Detail", "Groups", new { id = g.Id })">@g.Name</a>
                        </span>
                        <span class="gcount">
                            @g.MemberCount
                            member@(g.MemberCount == 1 ? "" : "s")
                        </span>
                    </div>
                }
            </div>
        }

        @*
            ADR 0094 — "Other public groups": public groups the actor is NOT
            yet a member of (GroupListViewModel.PublicGroups), each with a
            "Request to join" button (the self-lane route). The group name is
            not a link to the detail: the actor cannot reach the detail
            (owner ∪ member gate) until the request is approved.
        *@
        @if (Model.PublicGroups.Count > 0)
        {
            <h2 class="mt-4">
                <kw-l key="groups.other_public">Other public groups</kw-l>
            </h2>
            <div class="airy-group-grid">
                @foreach (var g in Model.PublicGroups)
                {
                    <div class="airy-group-card">
                        <span class="gname">@g.Name</span>
                        <span class="gcount">
                            @g.MemberCount
                            member@(g.MemberCount == 1 ? "" : "s")
                        </span>
                        <span class="row-actions">
                            <form method="post"
                                  action="@Url.Action("RequestToJoin", "Groups", new { id = g.Id })">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-primary"><kw-l key="groups.request_join">Request to join</kw-l></button>
                            </form>
                        </span>
                    </div>
                }
            </div>
        }

        <p class="mt-3 mb-0">
            <a href="@Url.Action("Create", "Groups")" class="btn btn-primary"><kw-l key="groups.create">Create a group</kw-l></a>
        </p>
    </div>
</div>
