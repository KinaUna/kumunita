@model Kumunita.Web.Models.EventIndexViewModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Events";
    var effLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
    string ariaTimeRange = await Translation.GetAsync("a11y.event_time_range", effLang);
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        @* The Events / Calendar tab strip (the _ProjectsTabs.cshtml idiom):
           the feed and the calendar are both first-class entry points. *@
        <partial name="_EventsTabs" />

        <header class="airy-head">
            <div class="head-row">
                <div>
                    <h1><kw-l key="events.title">Events</kw-l></h1>
                    <p class="lede">
                        <kw-l key="events.lede">Upcoming events around the neighborhood — see what's on, and RSVP.</kw-l>
                    </p>
                </div>
                @* M12 (ADR 0112, U04) — the "Calendar feed (iCal)" affordance:
                   a plain link to the lane-2 subscription (GET /events.ics,
                   U03). Quiet, beside the New event action (the head-row
                   idiom); flex-wrap (the head-row's own rule) lets it wrap
                   below at 360 px without a CSS change (M10 re-check). *@
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <a class="btn btn-outline-secondary" href="/events.ics"><kw-l key="events.ics.feed">Calendar feed (iCal)</kw-l></a>
                    <a class="btn btn-outline-primary" href="/events/new"><kw-l key="events.new_event">New event</kw-l></a>
                </div>
            </div>
        </header>

        @* ADR 0109 (EV-PAST) — Upcoming / Past toggle + the community filter
           form, placed below the feed list. *@
        @{
            string FeedToggleHref(bool showPast)
            {
                var href = showPast ? "/events?past=true" : "/events";
                if (Model.CurrentComponentId is not null)
                    href += (showPast ? "&" : "?") + "componentId=" + Uri.EscapeDataString(Model.CurrentComponentId);
                return href;
            }
        }

        @if (Model.MyEvents.Count > 0)
        {
            @* The "your upcoming events" list is capped at 5 visible rows:
               overflow rows render with the native `hidden` attribute (a
               JS-less visitor still sees the first 5 + the whole list stays
               in the markup for screen-reader users), and the button below
               reveals the rest in batches via the mine-more.js module — the
               About whatsnew / home roadmap disclosure idiom. The localized
               "{n} …" label is resolved server-side (kw-l can't substitute
               {n}) with the en floor as the in-code fallback. (The About
               whatsnew pattern: plain C# statements, incl. `await`, live
               directly in the @if body — a nested @{} block is illegal here.) *@
            int _mineVisible = 5;
            int _mineHidden = Math.Max(0, Model.MyEvents.Count - _mineVisible);
            string _mineLabelRaw = await Translation.GetAsync("events.mine.show_more", effLang);
            string _mineLabel = (string.IsNullOrWhiteSpace(_mineLabelRaw) || _mineLabelRaw == "events.mine.show_more")
                ? "Show the {n} more events" : _mineLabelRaw;
            <section class="mb-4">
                <h2 class="h5 mb-1"><kw-l key="events.mine.title">Your upcoming events</kw-l></h2>
                <p class="text-muted small mb-3"><kw-l key="events.mine.hint">Events you've RSVPed to or organized.</kw-l></p>
                <div class="airy-ann-list" id="events-mine-list">
                    @for (int _mi = 0; _mi < Model.MyEvents.Count; _mi++)
                    {
                        var row = Model.MyEvents[_mi];
                        <div class="airy-ann-row" @(_mi >= _mineVisible ? "hidden" : null)>
                            <div>
                                <h3 class="airy-ann-title">
                                    <a href="@Url.Action("Detail", "Event", new { id = row.Id })">@row.Title</a>
                                </h3>
                                <div class="text-muted small mb-1">
                                    @row.AuthorDisplayName — <kw-dt dt="@row.Start" format="g"></kw-dt>
                                    @if (row.ComponentDisplayName is not null)
                                    {
                                        <span class="badge text-bg-light border ms-2">@row.ComponentDisplayName</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(row.Location))
                                {
                                    <div class="mb-1">@row.Location</div>
                                }
                                <p class="mb-1">@MarkdownRenderer.PlainTextPreview(row.Body, 250)</p>
                            </div>
                        </div>
                    }
                </div>
                @if (_mineHidden > 0)
                {
                    <div class="text-center mt-3" id="events-mine-more-wrap">
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm kmb-events-mine-show-more"
                                data-mine-batch-size="5"
                                data-mine-label="@_mineLabel"
                                aria-label="@(_mineLabel.Replace("{n}", _mineHidden.ToString()))">
                            @(_mineLabel.Replace("{n}", _mineHidden.ToString()))
                        </button>
                    </div>
                }
            </section>
        }

        <div class="airy-ann-list">
            @* The shared sort control (the _Sort partial) sits at the TOP of
               the feed — above the list — so the sort options are the first
               thing the viewer sees (it renders nothing when the VM field is
               null, the no-sort pin). *@
            @if (Model.Sort is not null)
            {
                <partial name="_Sort" model="Model.Sort" />
            }
            @if (Model.Events.Count == 0)
            {
                @if (Model.Past)
                {
                    <div class="p-4 text-muted"><kw-l key="events.past_empty">No past events yet.</kw-l></div>
                }
                else
                {
                    <div class="p-4 text-muted"><kw-l key="events.empty">No upcoming events yet.</kw-l></div>
                }
            }
            @foreach (var row in Model.Events)
            {
                <div class="airy-ann-row">
                    <div>
                        <h3 class="airy-ann-title">
                            <a href="@Url.Action("Detail", "Event", new { id = row.Id })">@row.Title</a>
                        </h3>
                        <div class="text-muted small mb-1">
                            @row.AuthorDisplayName — <kw-dt dt="@row.Start" format="g"></kw-dt>
                            @if (row.ComponentDisplayName is not null)
                            {
                                <span class="badge text-bg-light border ms-2">@row.ComponentDisplayName</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(row.Location))
                        {
                            <div class="mb-1">@row.Location</div>
                        }
                        <p class="mb-1">@MarkdownRenderer.PlainTextPreview(row.Body, 250)</p>
                    </div>
                </div>
            }

            @* M7 (ADR 0090 D5) — the event feed's shared pager (F2 one-page
               no-render pin): the <c>_Pager</c> partial renders nothing when the
               VM field is null (a one-page feed). (The sort control now lives
               at the TOP of the feed, above the list.) *@
            @if (Model.Pager is not null)
            {
                <partial name="_Pager" model="Model.Pager" />
            }
        </div>

        @* ADR 0109 (EV-PAST) — the "Past" option: an Upcoming / Past toggle on
           the feed surface (the calendar's events-view-toggle idiom). The links
           are plain GETs that carry the current community filter (?componentId)
           so the selection survives the switch; the server re-renders and the
           authorization re-runs per request (C-M3·2 — past is a selector, never
           an access input). Placed below the feed list. *@
        <div class="btn-group btn-group-sm mt-4 events-feed-toggle" role="group" aria-label="@ariaTimeRange">
            <a class="btn btn-outline-secondary @(!Model.Past ? "active" : null)" href="@FeedToggleHref(false)" aria-pressed="@(!Model.Past ? "true" : "false")"><kw-l key="events.upcoming">Upcoming</kw-l></a>
            <a class="btn btn-outline-secondary @(Model.Past ? "active" : null)" href="@FeedToggleHref(true)" aria-pressed="@(Model.Past ? "true" : "false")"><kw-l key="events.past">Past</kw-l></a>
        </div>

        @if (Model.Components.Count > 0)
        {
            <form method="get" action="/events" class="mt-4 mb-0">
                <div class="d-flex gap-2 align-items-end">
                    <div>
                        <label class="form-label" for="component-filter" style="font-weight:600;"><kw-l key="nav.community">Community</kw-l></label>
                        <select class="form-select" id="component-filter" name="componentId">
                            <option value=""><kw-l key="events.all_communities">All communities</kw-l></option>
                            @foreach (var (id, name) in Model.Components)
                            {
                                <option value="@id" selected="@(id == Model.CurrentComponentId ? "selected" : null)">@name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-outline-secondary"><kw-l key="common.filter">Filter</kw-l></button>
                </div>
            </form>
        }

    </div>
</div>
