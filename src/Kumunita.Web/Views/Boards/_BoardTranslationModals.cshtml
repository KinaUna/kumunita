@model Kumunita.Web.Models.BoardTranslationModalsModel
@using Kumunita.Web.Models
@using Kumunita.Core.Projects

@* IMPROVE-CODE C11 — the board's translation add / edit modals (extracted
   from BoardDetail.cshtml; the served markup is unchanged). Mirrors the to-do
   / project translation lanes (ADR 0082 / 0088); the only difference is the
   <c>BoardTranslation</c> row type + the board's own translation routes. *@

@if (Model.CanTranslate)
{
    @foreach (var existing in (Model.Translations ?? []).OrderBy(x => x.LanguageCode))
    {
        <div class="modal fade" id="@($"board-trans-edit-{existing.LanguageCode}")" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" action="@($"/projects/boards/{Model.BoardId}/translations/update")"
                          id="@($"board-trans-edit-form-{existing.LanguageCode}")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                        <div class="modal-header">
                            <h5 class="modal-title" id="@($"board-trans-edit-label-{existing.LanguageCode}")">
                                <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@Model.LangName(existing.LanguageCode)</b>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Model.AriaClose"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label" for="@($"board-trans-edit-title-{existing.LanguageCode}")">
                                    <kw-l key="posts.translation_title_label">Title</kw-l> <span class="text-muted">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                </label>
                                <input class="form-control" type="text" name="title"
                                       id="@($"board-trans-edit-title-{existing.LanguageCode}")"
                                       maxlength="120" value="@existing.Title" />
                            </div>
                            <div>
                                <label class="form-label" for="@($"board-trans-edit-body-{existing.LanguageCode}")">
                                    <kw-l key="posts.translation_body_label">Body</kw-l>
                                </label>
                                <textarea class="form-control" name="body" rows="4"
                                          id="@($"board-trans-edit-body-{existing.LanguageCode}")"
                                          placeholder="…">@existing.Body</textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <kw-l key="common.cancel">Cancel</kw-l>
                            </button>
                            <button type="submit" class="btn btn-primary" form="@($"board-trans-edit-form-{existing.LanguageCode}")">
                                <kw-l key="posts.translation_save">Save translation</kw-l>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    @foreach (var lang in (Model.Languages ?? []).Where(l => (Model.Translations ?? []).All(x => !string.Equals(x.LanguageCode, l.Code, StringComparison.OrdinalIgnoreCase))))
    {
        <div class="modal fade" id="@($"board-trans-add-{lang.Code}")" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" action="@($"/projects/boards/{Model.BoardId}/translations")"
                          id="@($"board-trans-add-form-{lang.Code}")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="languageCode" value="@lang.Code" />
                        <div class="modal-header">
                            <h5 class="modal-title" id="@($"board-trans-add-label-{lang.Code}")">
                                <kw-l key="posts.translation_add">Add</kw-l> — <b>@Model.LangName(lang.Code)</b>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Model.AriaClose"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label" for="@($"board-trans-add-title-{lang.Code}")">
                                    <kw-l key="posts.translation_title_label">Title</kw-l> <span class="text-muted">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                </label>
                                <input class="form-control" type="text" name="title"
                                       id="@($"board-trans-add-title-{lang.Code}")"
                                       maxlength="120" value="@Model.BoardTitle" />
                            </div>
                            <div>
                                <label class="form-label" for="@($"board-trans-add-body-{lang.Code}")">
                                    <kw-l key="posts.translation_body_label">Body</kw-l>
                                </label>
                                <div class="rc-editor">
                                    <div class="rc-editor-toolbar" data-rich-editor data-rich-editor-no-image>
                                        <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                        <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                        <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                        <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                        <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                        <partial name="_RichEditorToggle" />
                                    </div>
                                    <textarea class="form-control" name="body" id="@($"board-trans-add-body-{lang.Code}")" data-rich-editor></textarea>
                                    <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <kw-l key="common.cancel">Cancel</kw-l>
                            </button>
                            <button type="submit" class="btn btn-primary" form="@($"board-trans-add-form-{lang.Code}")">
                                <kw-l key="posts.translation_save">Save translation</kw-l>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
