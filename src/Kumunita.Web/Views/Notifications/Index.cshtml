@model Kumunita.Web.Models.NotificationsInboxViewModel
@using Kumunita.Core.Notifications
@{
    ViewData["Title"] = "Notifications";
    int unread = Model.Notifications.Count(n => n.ReadAt is null);
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <header class="airy-head">
            <div class="head-row">
                <h1><kw-l key="notifications.inbox">Notifications</kw-l></h1>
                <div class="d-flex gap-2 flex-wrap">
                    @* The preferences editor page (U07 ships the view; the route
                       is U05's pinned GET /notifications/preferences). *@
                    <a class="btn btn-outline-secondary" href="/notifications/preferences">
                        <kw-l key="notifications.preferences">Preferences</kw-l>
                    </a>
                    @* U05's POST /notifications/mark-all-read
                       ([ValidateAntiForgeryToken] — the token is the gate).
                       The exact route path is the §6.4 pin (not a
                       convention-resolved name), so the action is the
                       literal path string. *@
                    @if (unread > 0)
                    {
                        <form method="post" action="/notifications/mark-all-read" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary">
                                <kw-l key="notifications.mark_all_read">Mark all as read</kw-l>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </header>

        @if (Model.Count == 0)
        {
            @* The empty state — the M3 posts-feed precedent (alert alert-info
               + a single kw-l string). *@
            <div class="alert alert-info">
                <kw-l key="notifications.empty">Nothing yet — things that happen to you will show up here.</kw-l>
            </div>
        }
        else
        {
            @* The flat, newest-first list (C-M6·8 — the 50-row cap is the
               service's; this view renders exactly what it handed over).
               Row shape per the U06 pin: a kind badge (the
               notifications.kind.{kind} key), the stored body (already in
               the recipient's language, D6), the kw-dt timestamp
               (ADR 0019/0020), and text-muted when ReadAt != null. *@
            <ul class="list-group">
                @foreach (var n in Model.Notifications)
                {
                    <li class="list-group-item p-3 @(n.ReadAt is null ? "border-start border-4 border-primary" : "text-muted")">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @* The kind badge — a dynamic kw-l key
                               (notifications.kind.{kind}); the key set is
                               U07's deliverable (a missing key renders its
                               en floor, never a blank — the TagHelper
                               contract). *@
                            <span class="badge text-bg-light text-dark">
                                <kw-l key="notifications.kind.@n.Kind">@n.Kind</kw-l>
                            </span>
                            <span class="ms-auto small"><kw-dt dt="@n.Created" format="g"></kw-dt></span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(n.Subject))
                        {
                            <p class="mt-2 mb-1 fw-semibold">@n.Subject</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(n.Body))
                        {
                            @* Platform-resolved text with the UGC snippet —
                               rendered as stored (never re-wrapped: the kw-l
                               TagHelper is platform-copy-only, M·3). *@
                            <p class="mb-0">@n.Body</p>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>
