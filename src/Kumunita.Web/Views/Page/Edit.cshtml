@model Kumunita.Web.Models.PageComposeViewModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    var _kwL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    ViewData["Title"] = await Translation.GetAsync("pages.form.edit_title", _kwL);
}
<partial name="_PageForm" model="Model" />

@* ADR 0041 — the composer's client-side scripts (rich editor + grant-picker
   sync + the visibility-block toggling). Declared here in the VIEW file, not
   inside the _PageForm partial: a `@section` declared in a partial is a known
   Razor gotcha and can be silently dropped by the layout's RenderSectionAsync,
   which left the #page-individual-block toggle listener unattached (the
   "select Individual, block stays hidden" bug). *@
@section Scripts {
    <partial name="_PageFormScripts" />
}
