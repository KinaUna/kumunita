@model Kumunita.Web.Models.PageComposeViewModel
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    // The composer / edit form body (one form, one editor — the ADR 0039 §3.8
    // "one editor, one renderer" pin). Shared between New.cshtml and
    // Edit.cshtml: the only difference is the form action, derived from
    // Model.PageId (null ⇒ create at /pages/new; set ⇒ edit at /pages/{id}/edit).
    bool isEdit   = Model.PageId is not null;
    string action = isEdit ? $"/pages/{Model.PageId}/edit" : "/pages/new";
    string[] modes = { "Any", "All" };
    var _kwL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);

    // The reset form's data-confirm (the ADR 0072 attribute idiom — the
    // confirm.js seam reads the attribute verbatim; the kw-l TagHelper can't
    // wrap an attribute). The en floor is the server fallback (a null provider
    // — a non-HTTP render — degrades to en).
    string confirmReset = "Reset this page to the seeded text? Any edits you made to the body (English) and to its German / French / Danish translations will be overwritten with the seeded baseline. The rest of the page (audience, parent, etc.) is untouched.";
    if (Translation is not null)
    {
        confirmReset = await Translation.GetAsync("pages.reset_confirm", _kwL);
    }
    var topUser = Translation is null
        ? "Top level — this becomes a new top-level blog page"
        : await Translation.GetAsync("pages.form.parent_top_user", _kwL);
    var topSystem = Translation is null
        ? "Top level — a top-level system page"
        : await Translation.GetAsync("pages.form.parent_top_system", _kwL);
    var tagsExample = Translation is null
        ? Kumunita.Core.Localization.KnownTranslationKeys.EnValues["tags.pages_example"]
        : await Translation.GetAsync("tags.pages_example", _kwL);
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <h1>@if (isEdit) { <kw-l key="pages.form.edit_title">Edit page</kw-l> } else { <kw-l key="pages.form.new_title">New page</kw-l> }</h1>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var entry in ViewData.ModelState)
                    {
                        @foreach (var error in entry.Value.Errors)
                        {
                            <li>@if (string.IsNullOrEmpty(error.ErrorMessage)) { <kw-l key="pages.form.invalid_value">Invalid value.</kw-l> } else { <text>@error.ErrorMessage</text> }</li>
                        }
                    }
                </ul>
            </div>
        }

        <form id="page-form" method="post" action="@action">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Kind" value="@Model.Kind" />

            <div class="card mb-4 kmb-form-section">
                <div class="card-body">
                    <h2 class="kmb-form-section-title"><kw-l key="form.section_details">Details</kw-l></h2>
                    @* ADR 0040 — the page kind (System = a platform page under the
                    `system/` root; User = a blog page under the actor's own
                    `blog/…` root) is set server-side by the controller from the
                    caller's standing (an admin opens a system page, a resident
                    opens their blog page) and round-trips unchanged so the POST
                    writes the right PageKind. It is NOT a user choice — a resident
                    cannot author a system page (the service denies it, C3) and a
                    blog page is always the actor's own. *@
                    <div class="kmb-form-field">
                        <label class="form-label" for="title" style="font-weight:600;"><kw-l key="common.title">Title</kw-l></label>
                        <input class="form-control" type="text" id="title" name="Title"
                               maxlength="120" required value="@(Model.Title)" />
                        <div class="text-muted small mt-1">
                            <kw-l key="pages.form.title_hint">The page's title — the slug (its URL leaf) is derived from this.</kw-l>
                        </div>
                    </div>
                    <div class="kmb-form-field">
                        <label class="form-label" for="body" style="font-weight:600;"><kw-l key="common.body">Body</kw-l></label>
                        <div class="rc-editor">
                            <div class="rc-editor-toolbar" data-rich-editor>
                                <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                                <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                                <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                                <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                                <partial name="_RichEditorToggle" />
                            </div>
                            <textarea class="form-control" id="body" name="Body" rows="16"
                                      style="min-height: 12rem;"
                                      data-rich-editor>@Model.Body</textarea>
                            <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                        </div>
                        <div class="text-muted small mt-1">
                            <kw-l key="pages.form.body_hint">Optional — a folder node may have no body. Written in Markdown via the visual editor (the same one posts and announcements use).</kw-l>
                        </div>
                    </div>
                    @* TG U8 — the composer tag field, **blog pages only** (C-TG·6, D6):
                    `Page.TagIds` is non-empty only on `PageKind.User` pages — a
                    `PageKind.System` page **refuses** a non-empty set (the
                    `PageService` write-lane refusal landed in U4), so its composer
                    must **not** render the field at all (the `System`-page refusal
                    branch, C-TG·6). `Model.Kind` is the ADR 0040 page-kind
                    discriminator the form already uses (the "system namespace is
                    not available to blog pages" branch above). The field is the
                    same free-text + autocomplete as the post composers —
                    `data-tag-suggest` is self-wired by client/lib/tag-suggest.ts
                    (tsc-only, no editor dependency — RE·3); the filter + ≤ 10 cap
                    are server-side via POST /api/tags/suggest (C-TG·2 / C-TG·4). *@
                    @if (Model.Kind == "User")
                    {
                        <div class="kmb-form-field">
                            <label class="form-label" for="tags" style="font-weight:600;"><kw-l key="nav.tags">Tags</kw-l></label>
                            <input class="form-control" type="text" id="tags"
                                   data-tag-suggest
                                   maxlength="64"
                               placeholder="@tagsExample" />
                            <div class="text-muted small mt-1">
                                <kw-l key="tag.input.hint">Type to search existing tags, or start a new one — it attaches to this post.</kw-l>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-4 kmb-form-section">
                <div class="card-body">
                    <h2 class="kmb-form-section-title"><kw-l key="form.section_organization">Organization</kw-l></h2>
                    <div class="kmb-form-field">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label" for="parent" style="font-weight:600;"><kw-l key="pages.form.parent_label">Parent page</kw-l></label>
                                <select class="form-control" id="parent" name="ParentId">
                                    <option value="">@(Model.Kind == "User" ? topUser : topSystem)</option>
                                    @foreach (var (id, label) in Model.ParentPages)
                                    {
                                        <option value="@id" selected="@(id == Model.ParentId ? "selected" : null)">@label</option>
                                    }
                                </select>
                                <div class="text-muted small mt-1">
                                    @if (Model.Kind == "User")
                                    {
                                        <kw-l key="pages.form.parent_hint_user">A blog page may nest under your own blog pages only (or be a top-level blog page). The system namespace is not available to blog pages.</kw-l>
                                    }
                                    else
                                    {
                                        <kw-l key="pages.form.parent_hint_system">A system page may nest under another system page only (e.g. system/about). Blog pages cannot nest under a system page.</kw-l>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="language" style="font-weight:600;"><kw-l key="common.language">Language</kw-l></label>
                                <select class="form-control" id="language" name="LanguageCode">
                                    @foreach (var (languageCode, native) in Model.Languages)
                                    {
                                        <option value="@languageCode" selected="@(languageCode == Model.LanguageCode ? "selected" : null)">@native</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4 kmb-form-section">
                <div class="card-body">
                    <h2 class="kmb-form-section-title"><kw-l key="form.section_publishing">Publishing</kw-l></h2>
                    <div class="kmb-form-field">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox"
                                   name="IsPublic" id="is-public" value="true"
                                   @(Model.IsPublic ? "checked" : null) />
                            <label class="form-check-label fw-semibold" for="is-public">
                                <kw-l key="pages.form.public_label">Public — visible to everyone (including visitors who aren't signed in)</kw-l>
                            </label>
                            <div class="text-muted small ms-4">
                                <kw-l key="pages.form.public_hint">Off by default. When off, choose a scope below (all residents, a specific community, or individual grants).</kw-l>
                            </div>
                        </div>
                        @* ADR 0041 — the scope dropdown (hidden when Public is on) *@
                        <div id="page-scope-block" class="@(Model.IsPublic ? "d-none" : null)">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label" for="scope" style="font-weight:600;"><kw-l key="pages.form.scope_label">Who can see this page</kw-l></label>
                                    <select class="form-control" id="scope" name="Scope">
                                        <option value="AllResidents"
                                                selected="@(Model.Scope == "AllResidents" ? "selected" : null)">
                                            All residents
                                        </option>
                                        @foreach (var (id, name) in Model.Components)
                                        {
                                            <option value="@id"
                                                    selected="@(Model.Scope == id ? "selected" : null)">
                                                @name
                                            </option>
                                        }
                                        <option value="Individual"
                                                selected="@(Model.Scope == "Individual" ? "selected" : null)">
                                            Individual access
                                        </option>
                                    </select>
                                    <div class="text-muted small mt-1">
                                        <kw-l key="pages.form.scope_hint">All residents — every signed-in resident (default). A community — only members of that community. Individual access — explicit user/group grants.</kw-l>
                                    </div>
                                </div>
                                @* ADR 0040 — MountPoint is a *system-page* concept *@
                                @if (Model.Kind != "User")
                                {
                                    <div class="col-md-6">
                                        <label class="form-label" for="mount" style="font-weight:600;"><kw-l key="pages.form.mount_label">Mount point (optional)</kw-l></label>
                                        <input class="form-control" type="text" id="mount" name="MountPoint"
                                               maxlength="64" value="@(Model.MountPoint)"
                                               placeholder="footer/community · help/account" />
                                    </div>
                                }
                            </div>
                        </div>
                        @* ADR 0041 — the detailed editor is shown ONLY when
                           Scope = "Individual" AND IsPublic is off *@
                        <div id="page-individual-block" class="@(Model.IsPublic || Model.Scope != "Individual" ? "d-none" : null)">
                            <hr class="my-3" />
                            <div class="form-label" style="font-weight:600;"><kw-l key="pages.form.audience_heading">Audience — who can see this page</kw-l></div>
                            @foreach (var m in modes)
                            {
                                var checkedMark = string.Equals(Model.Audience?.Mode, m, StringComparison.OrdinalIgnoreCase) ? "checked" : null;
                                <div class="form-check" style="margin-left:0.5rem;">
                                    <input class="form-check-input" type="radio"
                                           name="Audience.Mode" id="@($"aud-mode-{m}")"
                                           value="@m" @checkedMark required />
                                    <label class="form-check-label" for="@($"aud-mode-{m}")">
                                        @m
                                        @if (m == "Any")
                                        {
                                            @(" — ")<kw-l key="events.audience_mode_any">a viewer matches if they're on any of the picks</kw-l>
                                        }
                                        else
                                        {
                                            @(" — ")<kw-l key="events.audience_mode_all">a viewer must be on every pick — an empty list denies everyone</kw-l>
                                        }
                                    </label>
                                </div>
                            }
                            <partial name="_GrantPickers" model="@(new GrantPickersModel
                            {
                                EditorName = "Audience",
                                Editor     = Model.Audience
                                            ?? new AudienceEditorModel { Mode = "Any", Grants = string.Empty },
                                Users      = (ViewData["Audience_Users"]  as List<GrantOption>) ?? new List<GrantOption>(),
                                Groups     = (ViewData["Audience_Groups"] as List<GrantOption>) ?? new List<GrantOption>(),
                            })" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    @if (isEdit) { <kw-l key="pages.form.submit_save">Save changes</kw-l> } else { <kw-l key="pages.form.submit_create">Create page</kw-l> }
                </button>
                <a class="btn btn-outline-secondary" href="/pages"><kw-l key="common.cancel">Cancel</kw-l></a>
            </div>
        </form>

        @* ADR 0058 — the "Reset to seeded text" button: edit lane only, and only
           when this page's slug is one of the seeded platform pages / guides
           (Model.CanReset, derived server-side from the seed registries). It
           overwrites the en body + the de/fr/da translations with the seeded
           baseline (destructive — the confirm() is the guard). It is a
           SIBLING form, rendered AFTER the main form closes: a nested <form>
           is invalid HTML (the browser auto-closes the outer form at the inner
           <form> tag, which strands the outer form's anti-forgery token outside
           the form and breaks the Save button's submission). *@
        @if (isEdit && Model.CanReset)
        {
            <form class="d-inline mt-2" method="post"
                  action="/pages/@Model.PageId/reset-seeded"
                  data-confirm="@confirmReset">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    <kw-l key="pages.resetSeeded">Reset to seeded text</kw-l>
                </button>
            </form>
        }
    </div>
</div>
