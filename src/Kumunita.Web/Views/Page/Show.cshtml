@model Kumunita.Web.Models.PageShowViewModel
@using Kumunita.Web.Security
@using Kumunita.Web.Views.Shared
@inject Kumunita.Core.Localization.ILocalizationService Localization
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Title) ? "Page" : Model.Title;

    // The remove-translation + delete-page forms' data-confirms (the ADR 0072
    // attribute idiom — the confirm.js seam reads the attribute verbatim; the
    // kw-l TagHelper can't wrap an attribute). The en floor is the server
    // fallback (a null provider — a non-HTTP render — degrades to en).
    string confirmRemoveTrans = "Remove this translation?";
    string confirmDeletePage  = "Delete this page?";
    // The actions menu's accessible name is a template with a {0} slot (the
    // page's title) — server-resolved (the kw-l TagHelper can't wrap an
    // attribute, and can't substitute). The en floor is the server fallback
    // (a null provider — a non-HTTP render — degrades to en).
    string ariaActionsFor = "Actions for {0}";
    string ariaBreadcrumb = "Breadcrumb";
    if (Translation is not null)
    {
        var effLang = await EffectiveLanguageCode.ResolveAsync(HttpContextAccessor.HttpContext?.Request, Localization, Translation);
        confirmRemoveTrans = await Translation.GetAsync("common.remove_translation_confirm", effLang);
        confirmDeletePage  = await Translation.GetAsync("pages.delete_confirm", effLang);
        ariaActionsFor     = await Translation.GetAsync("a11y.actions_for", effLang);
        ariaBreadcrumb     = await Translation.GetAsync("a11y.breadcrumb", effLang);
    }

    // Hierarchy navigation (the parent / sibling / child aids):
    //   · Breadcrumb — the ancestor chain, root-first. Each entry is a
    //     link; the current page is the active (non-link) item. Rendered
    //     only when the page has at least one ancestor (a root page has no
    //     breadcrumb — the "← Back to the pages" link above is its home).
    //   · SubPages — the page's direct children (one level down). Rendered
    //     only when the list is non-empty (a leaf page has none, so the
    //     section is omitted — no empty card).
    // Both are read projections (the controller already ran the C6
    // CanSeeAsync(Read) aggregate + the author-only draft gate over the
    // sub-pages; the breadcrumb is the page's own ancestor chain, which
    // the caller can already read — visiting an ancestor is the page's
    // own Read decision, the same split the current page passed).

    // ADR 0027 chip-swap (TD): the authored-in language is the first
    // default-visible variant; each added translation is a hidden variant;
    // the chip row is a selector that swaps them.
    var langNames = Model.Languages.ToDictionary(l => l.Code, l => l.NativeName);
    string LangName(string code) => langNames.TryGetValue(code, out var n) ? n : code;

    // ADR 0049 — the default-visible variant: the viewer's current language
    // (Model.DefaultVariant, resolved by the controller) when a translation
    // row in that language exists; otherwise the authored-in variant (the
    // ADR 0027 floor). When DefaultVariant is null (e.g. no provider) the
    // authored-in variant is always default-visible.
    var originalCode = Model.OriginalLanguageCode;
    bool originalHidden = Model.DefaultVariant is not null
        && Model.Translations.Any(t => String.Equals(t.LanguageCode, Model.DefaultVariant, StringComparison.OrdinalIgnoreCase));

    // ADR 0029 — the "add a translation" candidate list (U06): the enabled
    // catalog languages that have no stored PageTranslation row yet AND are
    // not the page's authored-in language (the ADR 0027 "candidate list
    // excludes the item's own language" rule — Languages already carries the
    // HasTranslation flag). Offered only when Model.CanTranslate is set (a
    // standing-holder: GlobalAdmin / Translator on any page, or — since ADR
    // 0161 — the author of a blog page; a community Moderator has no
    // translation standing).
    var missingLanguages = Model.Languages
        .Where(l => !l.HasTranslation && l.Code != originalCode).ToList();

    // ADR 0084 — the subscribe button's kw-l key + class (pre-resolved into
    // locals so the tag-helper attribute can use a simple identifier, not a
    // ternary with embedded string literals).
    var subscribeKey = Model.Subscribed ? "pages.unsubscribe" : "pages.subscribe";
    var subscribeClass = Model.Subscribed ? "btn-outline-primary" : "btn-primary";
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        @* M17 (ADR 0118) + M37 (ADR 0167) — the bookmark toggle and the
           personal-note button, on ONE right-aligned row at the TOP of the
           parent column (just below the nav bar, to the right), OUTSIDE the
           main card. Each partial still carries its own d-flex wrapper + the
           bootstrap modal, so they only need to be side-by-side here. D2 /
           C-M17·2 pin holds: the label is static per render — this view does
           not load the owner's bookmark list to decide it. *@
        <div class="d-flex justify-content-end gap-2 mb-2">
            @{ var _bm = ("page", Model.Id, Model.Path); }
            <partial name="_BookmarkButton" model="@_bm" />
            @{ var _pn = ("page", Model.Id, Model.Path); }
            <partial name="_NoteButton" model="@_pn" />
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
            <a href="/pages" class="btn btn-link p-0">
                <kw-l key="pages.back">← Back to the pages</kw-l>
            </a>
            @* Hierarchy navigation — the breadcrumb (parent half). Rendered
               only when the page has at least one visible ancestor (a root
               page has no breadcrumb; the "← Back to the pages" link above
               is its home). The current page is the active (non-link) item;
               each ancestor is a link. The chain is display-only: the
               controller already passed the current page's Read decision,
               and visiting an ancestor resolves through its own Read
               decision (the same page-specific 404/403 split the current
               page passed). Siblings are surfaced when the resident visits
               the parent (the parent's SubPages list). *@
            @if (Model.Breadcrumb.Count > 0)
            {
                <span class="text-muted" aria-hidden="true">·</span>
                <nav aria-label="@ariaBreadcrumb" class="min-w-0">
                    <ol class="breadcrumb small mb-0">
                        @foreach (var crumb in Model.Breadcrumb)
                        {
                            <li class="breadcrumb-item"><a href="@crumb.Href">@crumb.Title</a></li>
                        }
                        <li class="breadcrumb-item active" aria-current="page">
                            @(string.IsNullOrWhiteSpace(Model.Title)
                                ? "Untitled page"
                                : Model.Title)
                        </li>
                    </ol>
                </nav>
            }
        </div>

        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            @* ADR 0037 — draft surface: visible to the author only. *@
            @if (Model.IsDraft && Model.IsAuthor)
            {
                <span class="kmb-chip kmb-chip-draft" title="Only you can see this — it is not yet public">
                    <kw-l key="posts.draft_badge">Draft</kw-l>
                </span>
                <form class="d-inline" method="post" action="/pages/@Model.Id/publish">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-success">
                        <kw-l key="posts.publish">Publish</kw-l>
                    </button>
                </form>
            }

            @if (Model.CommunityDisplayName is not null)
            {
                <span class="kmb-chip" title="Scoped to a community">
                    @Model.CommunityDisplayName
                </span>
            }

            @if (Model.AuthorDisplayName is not null)
            {
                <span class="text-muted small">
                    <kw-l key="pages.by">by</kw-l> <b>@Model.AuthorDisplayName</b>
                </span>
            }

            @* ADR 0084 — the page's subscribe/unsubscribe toggle (the
               page.child kind): subscribing to a page means "notify me when
               a new page is added under it". Shown to every signed-in
               viewer (a personal write — no standing required; the
               RecipientId is the whole access story); anonymous viewers
               have no RecipientId, so no toggle. The button reflects the
               current effective state (opt-IN default: disabled until
               subscribed) and POSTs to the flip lane *@
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <div class="ms-auto d-inline-flex align-items-center gap-2">
                    <form class="d-inline" method="post" action="/pages/@Model.Id/subscribe">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="@($"btn btn-sm {subscribeClass}")">
                            <kw-l key="@subscribeKey">
                                @(Model.Subscribed ? "Unsubscribe from updates" : "Subscribe to updates")
                            </kw-l>
                        </button>
                    </form>
                </div>
            }

                @* ADR 0071 modal shape — translation edit / add. The rich editor
                   is self-wired at module load (class-based, no dependency on the
                   containing element) so it works inside a modal. The modals are
                   now the shared _PageTranslationModals partial (ADR 0161) — the
                   same ones the /admin/platform platform-pages table renders —
                   rendered here with the "pg" id prefix so the dropdown's
                   data-bs-target references (the pg-trans-edit-/add-… ids) resolve. *@
                @if (Model.CanTranslate)
                {
                    var pgTransModals = new Kumunita.Web.Models.PageTranslationModalsModel(
                        "pg",
                        Model.Id,
                        Model.Title,
                        Model.Translations,
                        missingLanguages,
                        langNames);
                    <partial name="_PageTranslationModals" model="pgTransModals" />
                }
        </div>

        <div class="card kmb-detail-card">
            <div class="card-body">
                <div data-td-group="page">
                    @* Title row — the title (the shared fallback heading,
                       td-variant-shared) on the left; the ⋮ actions dropdown
                       (ADR 0082) on the right, INSIDE the card — the
                       community-posts (Posts/Detail) idiom, so the action
                       surface sits to the right of the title rather than in the
                       badge row above it. The dropdown is NOT a .td-variant, so
                       it stays put on a translation swap. The dedicated
                       per-translation titles render in their own
                       .td-variant-title blocks in this row. *@
                    <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
                        <div class="min-w-0">
                            @* Authored-in title — the SHARED FALLBACK heading
                               (td-variant-shared). Default-visible unless ADR 0049
                               auto-selects a translation of it into the viewer's
                               language (originalHidden); it also stays the heading
                               for any translation that has no title of its own.
                               The swap + return path (ADR 0027) are unchanged
                               either way. *@
                            <div class="td-variant td-variant-shared" data-td-variant="@Model.OriginalLanguageCode"
                                 @(originalHidden ? Html.Raw(" style=\"display:none\"") : Html.Raw(""))>
                                <h1 class="mb-1">
                                    @if (string.IsNullOrWhiteSpace(Model.Title))
                                    {
                                        <span class="text-body-tertiary"><kw-l key="pages.untitled">Untitled page</kw-l></span>
                                    }
                                    else
                                    {
                                        @Model.Title
                                    }
                                </h1>
                            </div>
                            @* One dedicated title per user-added translation
                               (only when it has one) — td-variant-title, shown in
                               place of the shared heading for that language; the
                               matching one shows first if ADR 0049 selects it over
                               the original. A translation with no title has NO
                               dedicated container — the shared heading stays. *@
                            @foreach (var t in Model.Translations.OrderBy(x => x.LanguageCode))
                            {
                                if (!string.IsNullOrWhiteSpace(t.Title))
                                {
                                    bool tDefault = String.Equals(t.LanguageCode, Model.DefaultVariant, StringComparison.OrdinalIgnoreCase);
                                    <div class="td-variant td-variant-title" data-td-variant="@t.LanguageCode"
                                         @(tDefault ? Html.Raw("") : Html.Raw(" style=\"display:none\""))>
                                        <h1 class="mb-1">@t.Title</h1>
                                    </div>
                                }
                            }
                        </div>

                        @* The action surface (ADR 0082) — one ⋮ dropdown (the
                           ADR 0069 / 0071 todo/board idiom), INSIDE the card on
                           the title row. Edit + Delete inline in the menu;
                           translation add / edit each open a Bootstrap modal;
                           translation remove is a confirm form inside the menu.
                           The service's write-lane re-check at POST is the real
                           gate; the same standing rules (CanEdit, CanTranslate)
                           are the only gates. *@
                        @if (Model.CanEdit || Model.CanTranslate)
                        {
                            <div class="dropdown flex-shrink-0">
                                <button class="btn btn-sm action-glyph-btn dropdown-toggle" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false"
                                        aria-label="@(ariaActionsFor.Replace("{0}", Model.Title))">⋮</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (Model.CanEdit)
                                    {
                                        <li>
                                            <a class="dropdown-item text-dark" href="/pages/@Model.Id/edit">
                                                <kw-l key="announcements.edit_button">Edit</kw-l>
                                            </a>
                                        </li>
                                    }

                                    @if (Model.CanTranslate)
                                    {
                                        @foreach (var existing in Model.Translations.OrderBy(x => x.LanguageCode))
                                        {
                                            <li>
                                                <button type="button" class="dropdown-item text-dark"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="@($"#pg-trans-edit-{existing.LanguageCode}")">
                                                    <kw-l key="posts.translation_edit">Edit</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                                </button>
                                            </li>
                                        }
                                        @foreach (var lang in missingLanguages)
                                        {
                                            <li>
                                                <button type="button" class="dropdown-item text-dark"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="@($"#pg-trans-add-{lang.Code}")">
                                                    <kw-l key="posts.translation_add">Add</kw-l> — <b>@LangName(lang.Code)</b>
                                                </button>
                                            </li>
                                        }
                                        @if (Model.Translations.Count > 0)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            @foreach (var existing in Model.Translations.OrderBy(x => x.LanguageCode))
                                            {
                                                <li>
                                                    <form method="post" action="@($"/pages/{Model.Id}/translations/remove")"
                                                          data-confirm="@confirmRemoveTrans" style="margin:0;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <kw-l key="posts.translation_remove">Remove</kw-l> — <b>@LangName(existing.LanguageCode)</b>
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        }
                                    }

                                    @if (Model.CanEdit)
                                    {
                                        @if (Model.CanTranslate && Model.Translations.Count > 0)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                        }
                                        <li>
                                            <form method="post" action="/pages/@Model.Id/delete"
                                                  data-confirm="@confirmDeletePage" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <kw-l key="pages.delete">Delete</kw-l>
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    @* Original variant's body (default-visible unless ADR 0049
                       auto-selects a translation of it into the viewer's
                       language — originalHidden — in which case the matching
                       dedicated title + body below show instead). The title now
                       lives in the title row above as td-variant-shared. *@
                    <div class="td-variant" data-td-variant="@Model.OriginalLanguageCode"
                         @(originalHidden ? Html.Raw(" style=\"display:none\"") : Html.Raw(""))>
                        <div class="mb-3 rc-body"><partial name="_MentionRenderer" model="new MentionBodyModel(Model.Body, Model.AuthorSubjectId ?? string.Empty)" /></div>
                    </div>

                    @* One body per stored translation — the viewer's-language one
                       is default-visible when it matches Model.DefaultVariant
                       (ADR 0049), otherwise hidden. The translation's TITLE is no
                       longer here — it lives on the title row above as a
                       dedicated td-variant-title, so the swap JS hides the shared
                       fallback heading in its place (the Posts/Detail idiom). *@
                    @foreach (var t in Model.Translations.OrderBy(x => x.LanguageCode))
                    {
                        bool tDefault = String.Equals(t.LanguageCode, Model.DefaultVariant, StringComparison.OrdinalIgnoreCase);
                        <div class="td-variant" data-td-variant="@t.LanguageCode"
                             @(tDefault ? Html.Raw("") : Html.Raw(" style=\"display:none\""))>
                            <div class="mb-3 rc-body"><partial name="_MentionRenderer" model="new MentionBodyModel(t.Body, Model.AuthorSubjectId ?? string.Empty)" /></div>
                        </div>
                    }

                    @* The chip row — a selector. The original chip is always present. *@
                    <div class="mb-3 border-top pt-3">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="text-muted small fw-semibold">
                                <kw-l key="posts.translations_label">Translations</kw-l>
                            </span>
                            <button type="button" class="kmb-chip kmb-chip-btn"
                                    data-translation-chip data-td-group="page"
                                    data-td-variant="@Model.OriginalLanguageCode"
                                    aria-pressed="@(originalHidden ? "false" : "true")">
                                @LangName(Model.OriginalLanguageCode)
                            </button>
                            @foreach (var t in Model.Translations.OrderBy(x => x.LanguageCode))
                            {
                                <button type="button" class="kmb-chip kmb-chip-btn"
                                        data-translation-chip data-td-group="page"
                                        data-td-variant="@t.LanguageCode"
                                        aria-pressed="@(String.Equals(t.LanguageCode, Model.DefaultVariant, StringComparison.OrdinalIgnoreCase) && originalHidden ? "true" : "false")">
                                    @LangName(t.LanguageCode)
                                </button>
                            }
                        </div>

                        @* ADR 0082 — the translation add / edit / remove lanes
                           are now in the ⋮ dropdown above (modals for add/edit,
                           confirm form for remove). The chip row above is the
                           *selector* — it stays. *@
                    </div>
                </div>
            </div>
        </div>

        @* Hierarchy navigation — the sub-pages (child half). Rendered only
           when the page has at least one visible direct child (a leaf page
           has none, so the section is omitted — no empty card). Each child
           is a link to its own page; the draft badge is shown only for a
           child the viewer authored (a non-author never sees a draft child
           at all — it is filtered out by the controller's C6
           CanSeeAsync(Read) aggregate + author-only draft gate). The list
           is display-only: the controller already ran the read filter, and
           visiting a child resolves through its own Read decision (the
           same page-specific 404/403 split). The list is the direct-
           children level only (one level down); deeper descendants are
           reached by clicking into the child. *@
        @if (Model.SubPages.Count > 0)
        {
            <section class="mt-4" aria-label="Sub-pages">
                <h2 class="h5 mb-2 mt-1 kmb-section-title">
                    <kw-l key="pages.children">Sub-pages</kw-l>
                    <span class="text-muted fw-normal small ms-2" aria-hidden="true">
                        · @Model.SubPages.Count
                    </span>
                </h2>
                <ul class="airy-page-list list-unstyled mb-0">
                    @foreach (var child in Model.SubPages)
                    {
                        <li style="--kmb-page-depth: 1">
                            <a href="@child.Href">@child.Title</a>
                            @if (child.IsDraft)
                            {
                                <span class="kmb-chip kmb-chip-draft ms-2" title="Only you can see this — it is not yet published">
                                    <kw-l key="posts.draft_badge">Draft</kw-l>
                                </span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
</div>

@section Scripts {
    @* ADR 0082 — the rich editor (client/lib/rich-editor.ts, tsc-built) is
       now also needed on this view: the ⋮ dropdown's translation modals
       each carry a .rc-editor block (the ADR 0031 surface). bindRichEditor
       self-wires every .rc-editor on the page at module load, so the
       modals work without any extra wiring. *@
    <script type="module" src="~/js/lib/rich-editor.js"></script>
}
