@model Kumunita.Web.Models.PageShowViewModel
@using Kumunita.Web.Security
@using Kumunita.Core.Pages
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Title) ? "Page" : Model.Title;

    // ADR 0027 chip-swap (TD): the authored-in language is the first
    // default-visible variant; each added translation is a hidden variant;
    // the chip row is a selector that swaps them.
    var langNames = Model.Languages.ToDictionary(l => l.Code, l => l.NativeName);
    string LangName(string code) => langNames.TryGetValue(code, out var n) ? n : code;

    // ADR 0049 — the default-visible variant: the viewer's current language
    // (Model.DefaultVariant, resolved by the controller) when a translation
    // row in that language exists; otherwise the authored-in variant (the
    // ADR 0027 floor). When DefaultVariant is null (e.g. no provider) the
    // authored-in variant is always default-visible.
    var originalCode = Model.OriginalLanguageCode;
    bool originalHidden = Model.DefaultVariant is not null
        && Model.Translations.Any(t => String.Equals(t.LanguageCode, Model.DefaultVariant, StringComparison.OrdinalIgnoreCase));

    // ADR 0029 — the "add a translation" candidate list (U06): the enabled
    // catalog languages that have no stored PageTranslation row yet AND are
    // not the page's authored-in language (the ADR 0027 "candidate list
    // excludes the item's own language" rule — Languages already carries the
    // HasTranslation flag). Offered only when Model.CanTranslate is set (a
    // standing-holder: GlobalAdmin / Translator / a community Moderator of
    // the page's scope).
    var missingLanguages = Model.Languages
        .Where(l => !l.HasTranslation && l.Code != originalCode).ToList();
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <p>
            <a href="/pages" class="btn btn-link p-0">
                <kw-l key="pages.back">← Back to the pages</kw-l>
            </a>
        </p>

        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            @* ADR 0037 — draft surface: visible to the author only. *@
            @if (Model.IsDraft && Model.IsAuthor)
            {
                <span class="badge text-bg-warning" title="Only you can see this — it is not yet public">
                    <kw-l key="posts.draft_badge">Draft</kw-l>
                </span>
                <form class="d-inline" method="post" action="/pages/@Model.Id/publish">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-success">
                        <kw-l key="posts.publish">Publish</kw-l>
                    </button>
                </form>
            }

            @if (Model.CommunityDisplayName is not null)
            {
                <span class="badge text-bg-primary" title="Scoped to a community">
                    @Model.CommunityDisplayName
                </span>
            }

            @if (Model.AuthorDisplayName is not null)
            {
                <span class="text-muted small">
                    <kw-l key="pages.by">by</kw-l> <b>@Model.AuthorDisplayName</b>
                </span>
            }

            @if (Model.CanEdit)
            {
                <div class="ms-auto d-flex gap-1">
                    <a class="btn btn-sm btn-outline-primary" href="/pages/@Model.Id/edit">
                        <kw-l key="announcements.edit_button">Edit</kw-l>
                    </a>
                    <form class="d-inline" method="post" action="/pages/@Model.Id/delete"
                          data-confirm="Delete this page?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <kw-l key="pages.delete">Delete</kw-l>
                        </button>
                    </form>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-body">
                <div data-td-group="page">
                    @* Original variant — hidden when the viewer's language has a translation (ADR 0049). *@
                    <div class="td-variant" data-td-variant="@Model.OriginalLanguageCode"
                         @(originalHidden ? Html.Raw(" style=\"display:none\"") : Html.Raw(""))>
                        <h1 class="mb-1">
                            @if (string.IsNullOrWhiteSpace(Model.Title))
                            {
                                <span class="text-body-tertiary"><kw-l key="pages.untitled">Untitled page</kw-l></span>
                            }
                            else
                            {
                                @Model.Title
                            }
                        </h1>
                        <div class="mb-3 rc-body">@Html.Raw(MarkdownRenderer.RenderHtml(Model.Body))</div>
                    </div>

                    @* One variant per stored translation — the viewer's-language one is
                       default-visible when it matches Model.DefaultVariant (ADR 0049),
                       otherwise hidden. *@
                    @foreach (var t in Model.Translations.OrderBy(x => x.LanguageCode))
                    {
                        bool tDefault = String.Equals(t.LanguageCode, Model.DefaultVariant, StringComparison.OrdinalIgnoreCase);
                        <div class="td-variant" data-td-variant="@t.LanguageCode"
                             @(tDefault ? Html.Raw("") : Html.Raw(" style=\"display:none\""))>
                            @if (!string.IsNullOrWhiteSpace(t.Title))
                            {
                                <h1 class="mb-1">@t.Title</h1>
                            }
                            <div class="mb-3 rc-body">@Html.Raw(MarkdownRenderer.RenderHtml(t.Body))</div>
                        </div>
                    }

                    @* The chip row — a selector. The original chip is always present. *@
                    <div class="mb-3 border-top pt-3">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="text-muted small fw-semibold">
                                <kw-l key="posts.translations_label">Translations</kw-l>
                            </span>
                            <button type="button" class="badge text-bg-light border"
                                    data-translation-chip data-td-group="page"
                                    data-td-variant="@Model.OriginalLanguageCode">
                                @LangName(Model.OriginalLanguageCode)
                            </button>
                            @foreach (var t in Model.Translations.OrderBy(x => x.LanguageCode))
                            {
                                <button type="button" class="badge text-bg-light border"
                                        data-translation-chip data-td-group="page"
                                        data-td-variant="@t.LanguageCode">
                                    @LangName(t.LanguageCode)
                                </button>
                            }
                        </div>

                        @* ADR 0048 — edit + remove lane for the page's
                           existing translations. Pre-filled from the existing
                           row; the add lane below is unchanged. The standing
                           gate (Model.CanTranslate) is the same for both. *@
                        @if (Model.CanTranslate)
                        {
                            @foreach (var existing in Model.Translations.OrderBy(x => x.LanguageCode))
                            {
                                <details class="mb-1">
                                    <summary class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <kw-l key="posts.translation_edit">Edit</kw-l> <b>@LangName(existing.LanguageCode)</b>
                                    </summary>
                                    <div class="ms-2">
                                        <form method="post" action="@($"/pages/{Model.Id}/translations/update")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                            <label class="form-label small">
                                                @LangName(existing.LanguageCode) <kw-l key="posts.translation_title_label">title</kw-l>
                                                <span class="text-muted">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                            </label>
                                            <input class="form-control form-control-sm mb-2" name="title"
                                                   value="@existing.Title" />
                                            <label class="form-label small">
                                                <kw-l key="posts.translation_body_label">Body</kw-l>
                                            </label>
                                            <textarea class="form-control form-control-sm mb-2" name="body" rows="3" required>@existing.Body</textarea>
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <kw-l key="posts.translation_save">Save translation</kw-l>
                                            </button>
                                        </form>
                                        <form method="post" action="@($"/pages/{Model.Id}/translations/remove")"
                                              class="mt-2" data-confirm="Remove this translation?">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="languageCode" value="@existing.LanguageCode" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <kw-l key="posts.translation_remove">Remove</kw-l> <b>@LangName(existing.LanguageCode)</b>
                                            </button>
                                        </form>
                                    </div>
                                </details>
                            }

                            @* ADR 0029 — the "add a translation" lane (U06): one
                               form per supported language that has no translation
                               yet, offered only to a standing-holder (GlobalAdmin /
                               Translator / a community Moderator of the page's
                               scope). The authored-in language + any already-
                               translated code are excluded (missingLanguages, the
                               ADR 0027 "candidate list excludes the item's own
                               language" rule). *@
                            @foreach (var lang in missingLanguages)
                            {
                                <details class="mb-1">
                                    <summary class="btn btn-sm btn-link p-0 text-decoration-none">
                                        <kw-l key="posts.translation_add">Add</kw-l> <b>@LangName(lang.Code)</b>
                                    </summary>
                                    <form class="ms-2" method="post"
                                          action="@($"/pages/{Model.Id}/translations")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="languageCode" value="@lang.Code" />
                                        <label class="form-label small" for="pg-t-title">
                                            @LangName(lang.Code) <kw-l key="posts.translation_title_label">title</kw-l>
                                            <span class="text-muted">(<kw-l key="posts.translation_optional">optional</kw-l>)</span>
                                        </label>
                                        <input class="form-control form-control-sm mb-2" id="pg-t-title"
                                               name="title" value="@Model.Title" />
                                        <label class="form-label small" for="pg-t-body">
                                            <kw-l key="posts.translation_body_label">Body</kw-l>
                                        </label>
                                        @* The single bindRichEditor surface (ADR 0031) + RC
                                           image / ATT attachment idiom — the page body's authoring
                                           surface is complete (the U04 composer reuses the same
                                           textarea[data-rich-editor] shape). *@
                                        <div class="rc-editor">
                                            <div class="rc-editor-toolbar" data-rich-editor>
                                                <button type="button" class="rc-btn" data-md="bold"><kw-l key="rc.editor.bold">B</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="italic"><kw-l key="rc.editor.italic">I</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="code"><kw-l key="rc.editor.code">C</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="h1"><kw-l key="rc.editor.h1">H1</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="h2"><kw-l key="rc.editor.h2">H2</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="h3"><kw-l key="rc.editor.h3">H3</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="ul"><kw-l key="rc.editor.list">•</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="ol"><kw-l key="rc.editor.olist">1.</kw-l></button>
                                                <button type="button" class="rc-btn" data-md="link"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="visually-hidden"><kw-l key="rc.editor.link">Link</kw-l></span></button>
                                                <button type="button" class="rc-btn" data-md="image"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg><span class="visually-hidden"><kw-l key="rc.editor.image">Image</kw-l></span></button>
                                                <button type="button" class="rc-btn" data-md="attach"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg><span class="visually-hidden"><kw-l key="rc.editor.attach">Attach file</kw-l></span></button>
                                                <partial name="_RichEditorToggle" />
                                            </div>
                                            <textarea class="form-control form-control-sm mb-2" id="pg-t-body"
                                                      name="body" rows="3" required placeholder="…" data-rich-editor></textarea>
                                            <div class="rc-editor-pane rc-body" aria-live="polite" data-rich-editor-preview></div>
                                        </div>
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            <kw-l key="posts.translation_save">Save translation</kw-l>
                                        </button>
                                    </form>
                                </details>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
