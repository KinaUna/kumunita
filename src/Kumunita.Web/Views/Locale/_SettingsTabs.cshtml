@* The /settings section sub-nav (the _EventsTabs.cshtml Bootstrap nav-tabs idiom,
   ADR 0062 / ADR 0080). Four tabs — Language (now also the home of the email &
   notification language section, folded in 2026-09-30), Time zone, Date & time
   format, and Children — so a resident can jump between sections without
   scrolling. The active tab is derived from the current controller + action:
   LocaleController owns the three settings GET actions (Index, SettingsTimezone,
   SettingsDateFormat) and GuardianController owns the Children page. Active
   detection is controller-aware because the Children page's action is also named
   "Index" (GuardianController.Index), so the action name alone is ambiguous. *@
@{
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "Locale";
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "Index";
    var tabs = new (string LabelKey, string Label, string Href)[]
    {
        ("locale.language_heading", "Language",         "/settings/language"),
        ("settings.timezone_title", "Time zone",        "/settings/timezone"),
        ("settings.dateformat_title", "Date & time format", "/settings/dateformat"),
        ("nav.children",            "Children",         "/me/children"),
    };
    var activeLabel = controller == "Guardian"
        ? "Children"
        : action switch
        {
            "SettingsTimezone"   => "Time zone",
            "SettingsDateFormat" => "Date & time format",
            _                    => "Language",
        };
}
<ul class="nav nav-tabs mb-4" role="tablist">
    @foreach (var tab in tabs)
    {
        var isActive = tab.Label == activeLabel;
        <li class="nav-item" role="presentation">
            <a class="nav-link @(isActive ? "active" : string.Empty)" href="@tab.Href">
                <kw-l key="@tab.LabelKey">@tab.Label</kw-l>
            </a>
        </li>
    }
</ul>
