@* The /settings section sub-nav (the _EventsTabs.cshtml Bootstrap nav-tabs idiom,
   ADR 0062 / ADR 0080). Six tabs — Language (now also the home of the email &
   notification language section, folded in 2026-09-30), Time zone, Date & time
   format, Quiet hours (M20, ADR 0121 D7), Children (ADR 0028, moved here from
   the account dropdown 2026-09-30), and Change password (ADR 0138, moved here
   from the account dropdown 2026-10-04) — so a resident can jump between
   sections without scrolling. The active tab is derived from the current
   controller + action: LocaleController owns the four settings GET actions
   (Index, SettingsTimezone, SettingsDateFormat, SettingsQuiet),
   GuardianController owns the Children page, and AccountController owns the
   ChangePassword page. Active detection is controller-aware because both the
   Children and Language tabs' actions are named "Index", so the action name
   alone is ambiguous. *@
@{
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? "Locale";
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "Index";
    var tabs = new (string LabelKey, string Label, string Href)[]
    {
        ("locale.language_heading",  "Language",          "/settings/language"),
        ("settings.timezone_title",  "Time zone",         "/settings/timezone"),
        ("settings.dateformat_title","Date & time format","/settings/dateformat"),
        ("settings.pagesize_title",  "Items per page",    "/settings/pagesize"),
        ("settings.home_title",      "Home page",         "/settings/home"),
        ("settings.quiet.title",     "Quiet hours",       "/settings/quiet"),
        ("settings.messaging.title", "Messaging",         "/settings/messaging"),
        ("nav.children",             "Children",          "/me/children"),
        ("nav.change_password",      "Change password",   "/account/password"),
        ("nav.delete_account",       "Delete account",    "/account/delete"),
    };
    var activeLabel = (controller, action) switch
    {
        ("Guardian", _)                   => "Children",
        ("Account",  "ChangePassword")    => "Change password",
        ("Account",  "Delete")            => "Delete account",
        ("Locale",   "SettingsTimezone")  => "Time zone",
        ("Locale",   "SettingsDateFormat")=> "Date & time format",
        ("Locale",   "SettingsPageSize")  => "Items per page",
        ("Locale",   "SettingsHome")      => "Home page",
        ("Locale",   "SettingsQuiet")     => "Quiet hours",
        ("MessagingSettings", "Index")    => "Messaging",
        _                                 => "Language",
    };
}
<ul class="nav nav-tabs kmb-tab-under-navbar mb-4" role="tablist">
    @foreach (var tab in tabs)
    {
        var isActive = tab.Label == activeLabel;
        <li class="nav-item" role="presentation">
            <a class="nav-link @(isActive ? "active" : string.Empty)" href="@tab.Href">
                <kw-l key="@tab.LabelKey">@tab.Label</kw-l>
            </a>
        </li>
    }
</ul>
@* M10 U03 (ADR 0107 D5/D10) — the PWA install affordance's label source:
   hidden, server-rendered, and the `pwa.install` key's label resolved here
   (the kw-l chain), so the client never resolves a key (the repo's
   no-client-side-kw-l rule — the data-ie-label-* / _RichEditorToggle
   pattern). pwa-install.ts looks for this anchor at module-load time:
   present → it clones the label into a fixed-position button when the
   browser fires beforeinstallprompt; absent (every non-settings page) →
   the module is a clean no-op and the button never appears. *@
<a id="pwa-install" class="btn btn-outline-primary btn-sm d-none" href="#" aria-hidden="true"><kw-l key="pwa.install">Install app</kw-l></a>
