@model Kumunita.Web.Controllers.AdminSiteController.AdminSiteViewModel
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@using Kumunita.Web.Security
@{
    var _aL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    var _actionsLabel = Translation is null ? "Translation actions" : await Translation.GetAsync("admin.site.translation_actions", _aL);
    var _removeConfirm = Translation is null ? "Remove this translation?" : await Translation.GetAsync("admin.site.remove_confirm", _aL);
}
@{
    var _closeLang = await Kumunita.Web.Security.EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    var ariaClose = Translation is null ? "Close" : await Translation.GetAsync("a11y.close", _closeLang);
}
@{
    ViewData["Title"] = "Admin — Site content";
}

<div class="mb-2"><a href="/admin" class="btn btn-link p-0">&larr; <kw-l key="nav.admin">Admin</kw-l></a></div>

<h1 class="mt-2"><kw-l key="admin.platform.site_title">Site content</kw-l></h1>

<p class="text-muted">
    <kw-l key="admin.site.lede">The copy and sections of the two landing surfaces — the home page (/) and the about page (/about). Change the hero text, or hide a section on either page. Save each page separately; saving one does not touch the other.</kw-l></p>

<h2 class="h5 mt-4"><kw-l key="admin.site.appearance">Appearance</kw-l></h2>
<p class="text-muted">
    <kw-l key="admin.site.appearance_desc">The platform's default colour palette. Members see it until they pick their own from the account menu, and it helps people who belong to several platforms tell this one apart. Light/dark mode stays each member's choice.</kw-l></p>
<form method="post" action="/admin/site/save-palette">
    @Html.AntiForgeryToken()
    @* ADR 0225 — two selectable cards instead of a <select> (a native option can't show a
       swatch). Same posted field (DefaultPalette), so the controller and its tests are
       unchanged; the preview is decorative (aria-hidden), the label text names the choice. *@
    <fieldset class="mb-3">
        <legend class="form-label fs-6"><kw-l key="admin.site.default_palette">Default palette</kw-l></legend>
        <div class="kmb-pal-choices">
            @foreach (var pal in Kumunita.Web.Security.PaletteCookie.All)
            {
                var isEmber = pal == Kumunita.Web.Security.PaletteCookie.Ember;
                <label class="kmb-pal-choice" for="@($"DefaultPalette-{pal}")">
                    <input class="form-check-input kmb-pal-radio" type="radio" name="DefaultPalette"
                           id="@($"DefaultPalette-{pal}")" value="@pal"
                           checked="@(Model.Appearance.DefaultPalette == pal)" />
                    <span class="kmb-pal-preview kmb-pal-preview--@pal" aria-hidden="true">
                        <span class="kmb-pal-half kmb-pal-half--light">
                            <span class="kmb-pal-card"><span class="kmb-pal-line"></span><span class="kmb-pal-line kmb-pal-line--accent"></span><span class="kmb-pal-btn"></span></span>
                        </span>
                        <span class="kmb-pal-half kmb-pal-half--dark">
                            <span class="kmb-pal-card"><span class="kmb-pal-line"></span><span class="kmb-pal-line kmb-pal-line--accent"></span><span class="kmb-pal-btn"></span></span>
                        </span>
                    </span>
                    <span class="kmb-pal-text">
                        <span class="fw-semibold">@(isEmber ? "Ember" : "Forest")</span>
                        <span class="text-muted small">@(isEmber ? "warm charcoal and amber" : "green")</span>
                    </span>
                </label>
            }
        </div>
        <div class="form-text"><kw-l key="admin.site.palette_hint">Each card shows the palette in light (left) and dark (right).</kw-l></div>
    </fieldset>
    <button type="submit" class="btn btn-primary"><kw-l key="admin.site.save_appearance">Save appearance</kw-l></button>
</form>

<hr />

<h2 class="h5 mt-4"><kw-l key="admin.site.home_heading">Home page (/)</kw-l></h2>
<p class="text-muted">
    <kw-l key="admin.site.home_desc">The hero eyebrow and lead, and which of the home page's sections are shown. A hidden section is removed from the page entirely — visitors and screen readers never see it.</kw-l></p>

<form method="post" action="/admin/site/save-home">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label for="HomeHeroEyebrow" class="form-label"><kw-l key="admin.site.hero_eyebrow">Hero eyebrow</kw-l></label>
        <input class="form-control" type="text" name="HomeHeroEyebrow" id="HomeHeroEyebrow" value="@Model.Home.HomeHeroEyebrow" />
    </div>
    <div class="mb-3">
        <label for="HomeHeroLead" class="form-label"><kw-l key="admin.site.hero_lead">Hero lead</kw-l></label>
        <textarea class="form-control" name="HomeHeroLead" id="HomeHeroLead" rows="3">@Model.Home.HomeHeroLead</textarea>
    </div>
    <div class="mb-3">
        <label for="HomeHeroSub1" class="form-label"><kw-l key="admin.site.hero_scope_line">Hero sub — scope line</kw-l></label>
        <textarea class="form-control" name="HomeHeroSub1" id="HomeHeroSub1" rows="2">@Model.Home.HomeHeroSub1</textarea>
        <span class="form-text text-muted"><kw-l key="admin.site.hero_scope_hint">The first supporting line under the hero lead ("Kumunita started out as…").</kw-l></span>
    </div>
    <div class="mb-3">
        <label for="HomeHeroSub2" class="form-label"><kw-l key="admin.site.hero_fig_line">Hero sub — FIG line</kw-l></label>
        <textarea class="form-control" name="HomeHeroSub2" id="HomeHeroSub2" rows="2">@Model.Home.HomeHeroSub2</textarea>
        <span class="form-text text-muted"><kw-l key="admin.site.hero_fig_hint">The second supporting line under the hero lead ("It is built on the Fractal Integration Guidelines…").</kw-l></span>
    </div>
    @* The checkboxes use the repo's proven convention (the
       AdminGuestsController / LocaleController shape): a single checkbox
       value="true" with NO hidden "false" fallback, bound to a bool that
       defaults to false when absent. A checked box posts "true"; an unchecked
       box posts nothing → the bool is false. (The old "checkbox + hidden
       false" dual-value pattern was the only one in the codebase and was the
       source of the de-selected-checkboxes bug.) *@
    <div class="mb-3">
        <label for="HomeShowAboutButton" class="form-label d-block">"What it is &amp; how it works" button</label>
        <input class="form-check-input" type="checkbox" name="HomeShowAboutButton" id="HomeShowAboutButton" value="true" @(Model.Home.HomeShowAboutButton ? "checked" : null) />
        <span class="form-text text-muted"><kw-l key="admin.site.show_about_link">Show the hero's link to the about page.</kw-l></span>
    </div>
    <div class="mb-3">
        <label for="HomeShowFeatures" class="form-label d-block"><kw-l key="admin.site.intro_sections">Intro sections</kw-l></label>
        <input class="form-check-input" type="checkbox" name="HomeShowFeatures" id="HomeShowFeatures" value="true" @(Model.Home.HomeShowFeatures ? "checked" : null) />
        <span class="form-text text-muted"><kw-l key="admin.site.show_hero_cards">Show the hero band and the feature cards together. Hiding them also hides the hero's eyebrow and lead.</kw-l></span>
    </div>
    <div class="mb-3">
        <label for="HomeShowRoadmap" class="form-label d-block">"The plan" section</label>
        <input class="form-check-input" type="checkbox" name="HomeShowRoadmap" id="HomeShowRoadmap" value="true" @(Model.Home.HomeShowRoadmap ? "checked" : null) />
        <span class="form-text text-muted"><kw-l key="admin.site.show_roadmap">Show the roadmap of what the platform ships next.</kw-l></span>
    </div>
    <button type="submit" class="btn btn-primary"><kw-l key="admin.site.save_home">Save home page</kw-l></button>
</form>

<hr />

<h2 class="h5 mt-4"><kw-l key="admin.site.about_heading">About page (/about)</kw-l></h2>
<p class="text-muted">
    <kw-l key="admin.site.about_desc">The hero eyebrow and lead, and which of the about page's sections are shown. A hidden section is removed from the page entirely.</kw-l></p>

<form method="post" action="/admin/site/save-about">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label for="AboutHeroEyebrow" class="form-label"><kw-l key="admin.site.hero_eyebrow">Hero eyebrow</kw-l></label>
        <input class="form-control" type="text" name="AboutHeroEyebrow" id="AboutHeroEyebrow" value="@Model.About.AboutHeroEyebrow" />
    </div>
    <div class="mb-3">
        <label for="AboutHeroLead" class="form-label"><kw-l key="admin.site.hero_lead">Hero lead</kw-l></label>
        <textarea class="form-control" name="AboutHeroLead" id="AboutHeroLead" rows="3">@Model.About.AboutHeroLead</textarea>
    </div>
    <div class="mb-3">
        <label for="AboutShowFeatures" class="form-label d-block"><kw-l key="admin.site.feature_cards">Feature cards</kw-l></label>
        <input class="form-check-input" type="checkbox" name="AboutShowFeatures" id="AboutShowFeatures" value="true" @(Model.About.AboutShowFeatures ? "checked" : null) />
        <span class="form-text text-muted"><kw-l key="admin.site.show_feature_cards">Show the three cards describing what the platform is.</kw-l></span>
    </div>
    <div class="mb-3">
        <label for="AboutShowScope" class="form-label d-block"><kw-l key="admin.site.scope_band">Scope band</kw-l></label>
        <input class="form-check-input" type="checkbox" name="AboutShowScope" id="AboutShowScope" value="true" @(Model.About.AboutShowScope ? "checked" : null) />
        <span class="form-text text-muted"><kw-l key="admin.site.show_scope_band">Show the "one neighborhood" scope band.</kw-l></span>
    </div>
    <div class="mb-3">
        <label for="AboutShowPhilosophy" class="form-label d-block"><kw-l key="admin.site.philosophy_band">Philosophy band</kw-l></label>
        <input class="form-check-input" type="checkbox" name="AboutShowPhilosophy" id="AboutShowPhilosophy" value="true" @(Model.About.AboutShowPhilosophy ? "checked" : null) />
        <span class="form-text text-muted"><kw-l key="admin.site.show_philosophy_band">Show the FIG-philosophy band (Fair, Invisible, Generous).</kw-l></span>
    </div>
    <div class="mb-3">
        <label for="AboutShowProject" class="form-label d-block"><kw-l key="admin.site.code_docs_band">Code & docs band</kw-l></label>
        <input class="form-check-input" type="checkbox" name="AboutShowProject" id="AboutShowProject" value="true" @(Model.About.AboutShowProject ? "checked" : null) />
        <span class="form-text text-muted"><kw-l key="admin.site.show_code_docs">Show the links to the project's code and documentation.</kw-l></span>
    </div>
    <div class="mb-3">
        <label for="AboutShowWhatsNew" class="form-label d-block">"What's new" changelog</label>
        <input class="form-check-input" type="checkbox" name="AboutShowWhatsNew" id="AboutShowWhatsNew" value="true" @(Model.About.AboutShowWhatsNew ? "checked" : null) />
        <span class="form-text text-muted"><kw-l key="admin.site.show_recent_changes">Show the list of recent changes.</kw-l></span>
    </div>
    <div class="mb-3">
        <label for="AboutShowContactCta" class="form-label d-block"><kw-l key="admin.site.contact_band">Contact band</kw-l></label>
        <input class="form-check-input" type="checkbox" name="AboutShowContactCta" id="AboutShowContactCta" value="true" @(Model.About.AboutShowContactCta ? "checked" : null) />
        <span class="form-text text-muted"><kw-l key="admin.site.show_contact">Show the "something missing?" contact call-to-action.</kw-l></span>
    </div>
    <button type="submit" class="btn btn-primary"><kw-l key="admin.site.save_about">Save about page</kw-l></button>
