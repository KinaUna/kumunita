@model Kumunita.Web.Controllers.AdminSiteController.AdminSiteViewModel
@{
    ViewData["Title"] = "Admin — Site content";
}

<a href="/admin" class="text-muted small">&larr; <kw-l key="nav.admin">Admin</kw-l></a>

<h1 class="mt-2">Site content</h1>

<p class="text-muted">
    The copy and sections of the two landing surfaces — the home page
    (<code>/</code>) and the about page (<code>/about</code>). Change the
    hero text, or hide a section on either page. Save each page separately;
    saving one does not touch the other.
</p>

@if (TempData["info"] is string info)
{
    <div class="alert alert-info">@info</div>
}
@if (TempData["error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<h2 class="h5 mt-4">Home page (<code>/</code>)</h2>
<p class="text-muted">
    The hero eyebrow and lead, and which of the home page's sections are
    shown. A hidden section is removed from the page entirely — visitors
    and screen readers never see it.
</p>

<form method="post" action="/admin/site/save-home">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label for="HomeHeroEyebrow" class="form-label">Hero eyebrow</label>
        <input class="form-control" type="text" name="HomeHeroEyebrow" id="HomeHeroEyebrow" value="@Model.Home.HomeHeroEyebrow" />
    </div>
    <div class="mb-3">
        <label for="HomeHeroLead" class="form-label">Hero lead</label>
        <textarea class="form-control" name="HomeHeroLead" id="HomeHeroLead" rows="3">@Model.Home.HomeHeroLead</textarea>
    </div>
    <div class="mb-3">
        <label for="HomeHeroSub1" class="form-label">Hero sub — scope line</label>
        <textarea class="form-control" name="HomeHeroSub1" id="HomeHeroSub1" rows="2">@Model.Home.HomeHeroSub1</textarea>
        <span class="form-text text-muted">The first supporting line under the hero lead ("Kumunita started out as…").</span>
    </div>
    <div class="mb-3">
        <label for="HomeHeroSub2" class="form-label">Hero sub — FIG line</label>
        <textarea class="form-control" name="HomeHeroSub2" id="HomeHeroSub2" rows="2">@Model.Home.HomeHeroSub2</textarea>
        <span class="form-text text-muted">The second supporting line under the hero lead ("It is built on the Fractal Integration Guidelines…").</span>
    </div>
    @* The checkboxes use the repo's proven convention (the
       AdminGuestsController / LocaleController shape): a single checkbox
       value="true" with NO hidden "false" fallback, bound to a bool that
       defaults to false when absent. A checked box posts "true"; an unchecked
       box posts nothing → the bool is false. (The old "checkbox + hidden
       false" dual-value pattern was the only one in the codebase and was the
       source of the de-selected-checkboxes bug.) *@
    <div class="mb-3">
        <label for="HomeShowAboutButton" class="form-label d-block">"What it is &amp; how it works" button</label>
        <input class="form-check-input" type="checkbox" name="HomeShowAboutButton" id="HomeShowAboutButton" value="true" @checked(Model.Home.HomeShowAboutButton) />
        <span class="form-text text-muted">Show the hero's link to the about page.</span>
    </div>
    <div class="mb-3">
        <label for="HomeShowFeatures" class="form-label d-block">Intro sections</label>
        <input class="form-check-input" type="checkbox" name="HomeShowFeatures" id="HomeShowFeatures" value="true" @checked(Model.Home.HomeShowFeatures) />
        <span class="form-text text-muted">Show the hero band and the feature cards together. Hiding them also hides the hero's eyebrow and lead.</span>
    </div>
    <div class="mb-3">
        <label for="HomeShowRoadmap" class="form-label d-block">"The plan" section</label>
        <input class="form-check-input" type="checkbox" name="HomeShowRoadmap" id="HomeShowRoadmap" value="true" @checked(Model.Home.HomeShowRoadmap) />
        <span class="form-text text-muted">Show the roadmap of what the platform ships next.</span>
    </div>
    <button type="submit" class="btn btn-primary">Save home page</button>
</form>

<hr />

<h2 class="h5 mt-4">About page (<code>/about</code>)</h2>
<p class="text-muted">
    The hero eyebrow and lead, and which of the about page's sections are
    shown. A hidden section is removed from the page entirely.
</p>

<form method="post" action="/admin/site/save-about">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label for="AboutHeroEyebrow" class="form-label">Hero eyebrow</label>
        <input class="form-control" type="text" name="AboutHeroEyebrow" id="AboutHeroEyebrow" value="@Model.About.AboutHeroEyebrow" />
    </div>
    <div class="mb-3">
        <label for="AboutHeroLead" class="form-label">Hero lead</label>
        <textarea class="form-control" name="AboutHeroLead" id="AboutHeroLead" rows="3">@Model.About.AboutHeroLead</textarea>
    </div>
    <div class="mb-3">
        <label for="AboutShowFeatures" class="form-label d-block">Feature cards</label>
        <input class="form-check-input" type="checkbox" name="AboutShowFeatures" id="AboutShowFeatures" value="true" @checked(Model.About.AboutShowFeatures) />
        <span class="form-text text-muted">Show the three cards describing what the platform is.</span>
    </div>
    <div class="mb-3">
        <label for="AboutShowScope" class="form-label d-block">Scope band</label>
        <input class="form-check-input" type="checkbox" name="AboutShowScope" id="AboutShowScope" value="true" @checked(Model.About.AboutShowScope) />
        <span class="form-text text-muted">Show the "one neighborhood" scope band.</span>
    </div>
    <div class="mb-3">
        <label for="AboutShowPhilosophy" class="form-label d-block">Philosophy band</label>
        <input class="form-check-input" type="checkbox" name="AboutShowPhilosophy" id="AboutShowPhilosophy" value="true" @checked(Model.About.AboutShowPhilosophy) />
        <span class="form-text text-muted">Show the FIG-philosophy band (Fair, Invisible, Generous).</span>
    </div>
    <div class="mb-3">
        <label for="AboutShowProject" class="form-label d-block">Code &amp; docs band</label>
        <input class="form-check-input" type="checkbox" name="AboutShowProject" id="AboutShowProject" value="true" @checked(Model.About.AboutShowProject) />
        <span class="form-text text-muted">Show the links to the project's code and documentation.</span>
    </div>
    <div class="mb-3">
        <label for="AboutShowWhatsNew" class="form-label d-block">"What's new" changelog</label>
        <input class="form-check-input" type="checkbox" name="AboutShowWhatsNew" id="AboutShowWhatsNew" value="true" @checked(Model.About.AboutShowWhatsNew) />
        <span class="form-text text-muted">Show the list of recent changes.</span>
    </div>
    <div class="mb-3">
        <label for="AboutShowContactCta" class="form-label d-block">Contact band</label>
        <input class="form-check-input" type="checkbox" name="AboutShowContactCta" id="AboutShowContactCta" value="true" @checked(Model.About.AboutShowContactCta) />
        <span class="form-text text-muted">Show the "something missing?" contact call-to-action.</span>
    </div>
    <button type="submit" class="btn btn-primary">Save about page</button>
</form>

<hr />

@* ADR 0157 — the SITE-2 hero-translation section (the ADR 0150 §D5 "future
   SITE-2 translation lane"). The two heroes' eyebrow + lead (home + about)
   are translated into a resident's language and shown on / and /about when
   that language is active; the singleton's value is the fallback for any
   hero field left blank on a translation row. Mirrors the post-translation
   lane (ADR 0022 / ADR 0048) — add a language, edit the existing row for a
   language, or remove it. Only enabled languages are offered. *@
<h2 class="h5 mt-4">Hero text translations</h2>
<p class="text-muted">
    Translate the two heroes' eyebrow and lead — and the home hero's two
    supporting lines — into a resident's language. Use the language chips to
    preview each version, and the ⋮ menu to add a translation (if a language is
    missing), edit one (if it exists), or remove it. A resident reading the
    site in that language sees the translated text on <code>/</code> and
    <code>/about</code>; any field left blank falls back to the English text
    saved above.
</p>

@{
    // The set of enabled languages that already have a translation row (the
    // "existing translations") and the candidate list for "add a translation"
    // (the enabled languages that do not — the ADR 0022 / ADR 0027
    // missing-languages shape). The default (English) chip is the singleton's
    // own values; one chip + one preview per translation. The swap JS
    // (client/lib/translation-swap.ts, loaded in _Layout) flips the
    // .td-variant containers by data-td-variant — the same mechanism the
    // posts/announcements detail surface uses.
    var existing = Model.Translations.OrderBy(t => t.LanguageCode).ToList();
    var addable = Model.Languages.Where(l => !l.HasTranslation).ToList();
    const string DefaultLang = "en";
    string LangName(string code) =>
        Model.Languages.FirstOrDefault(l => l.Code.Equals(code, System.StringComparison.OrdinalIgnoreCase))?.NativeName ?? code;
}

<div data-td-group="site-hero" class="card">
    <div class="card-header d-flex justify-content-between align-items-center gap-2">
        <span class="fw-semibold">Hero preview</span>
        @* The ⋮ action surface (the posts/announcements ADR 0082 shape): add a
           translation (per missing enabled language), edit (per existing
           row), remove (per existing row). Edit / add each open a Bootstrap
           modal; remove is a confirm form in the menu. *@
        <div class="dropdown">
            <button class="btn btn-sm action-glyph-btn dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false" aria-label="Translation actions">⋮</button>
            <ul class="dropdown-menu dropdown-menu-end">
                @foreach (var lang in addable)
                {
                    <li>
                        <button type="button" class="dropdown-item text-dark"
                                data-bs-toggle="modal" data-bs-target="@($"#site-trans-add-{lang.Code}")">
                            Add — <b>@LangName(lang.Code)</b>
                        </button>
                    </li>
                }
                @foreach (var t in existing)
                {
                    <li>
                        <button type="button" class="dropdown-item text-dark"
                                data-bs-toggle="modal" data-bs-target="@($"#site-trans-edit-{t.LanguageCode}")">
                            Edit — <b>@LangName(t.LanguageCode)</b>
                        </button>
                    </li>
                }
                @if (existing.Count > 0)
                {
                    <li><hr class="dropdown-divider" /></li>
                    @foreach (var t in existing)
                    {
                        <li>
                            <form method="post" action="/admin/site/translations/remove"
                                  data-confirm="Remove this translation?" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="languageCode" value="@t.LanguageCode" />
                                <button type="submit" class="dropdown-item text-danger">
                                    Remove — <b>@LangName(t.LanguageCode)</b>
                                </button>
                            </form>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="card-body">
        @* Chip row — the language selector (default + one per translation).
           The swap JS (translation-swap.ts) shows the matching .td-variant
           and hides the rest. With JS off the default stays visible and every
           variant is present in the DOM (progressive enhancement). *@
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="text-muted small fw-semibold">Language</span>
            <button type="button" class="badge text-bg-light border"
                    data-translation-chip data-td-group="site-hero" data-td-variant="@DefaultLang">
                @LangName(DefaultLang)
            </button>
            @foreach (var t in existing)
            {
                <button type="button" class="badge text-bg-light border"
                        data-translation-chip data-td-group="site-hero" data-td-variant="@t.LanguageCode">
                    @LangName(t.LanguageCode)
                </button>
            }
        </div>

        @* Default (English) variant — the singleton's own hero text. Each
           field renders as a label + value; a blank value shows the fallback
           placeholder. Razor HTML-encodes @value, so resident-supplied text is
           XSS-safe. *@
        <div class="td-variant" data-td-variant="@DefaultLang">
            <div class="d-flex flex-column gap-2">
                @* Inline field renderer: label above, value below; a blank value
                   shows the "(falls back to the English text saved above)"
                   placeholder in italics. *@
                <div>
                    <div class="text-muted small">Home hero — eyebrow</div>
                    <div class="@(string.IsNullOrWhiteSpace(Model.Home.HomeHeroEyebrow) ? "text-muted fst-italic" : "") mt-0">
                        @(!string.IsNullOrWhiteSpace(Model.Home.HomeHeroEyebrow) ? Model.Home.HomeHeroEyebrow : "(falls back to the English text saved above)")
                    </div>
                </div>
                <div>
                    <div class="text-muted small">Home hero — lead</div>
                    <div class="@(string.IsNullOrWhiteSpace(Model.Home.HomeHeroLead) ? "text-muted fst-italic" : "") mt-0">
                        @(!string.IsNullOrWhiteSpace(Model.Home.HomeHeroLead) ? Model.Home.HomeHeroLead : "(falls back to the English text saved above)")
                    </div>
                </div>
                <div>
                    <div class="text-muted small">Home hero — scope line</div>
                    <div class="@(string.IsNullOrWhiteSpace(Model.Home.HomeHeroSub1) ? "text-muted fst-italic" : "") mt-0">
                        @(!string.IsNullOrWhiteSpace(Model.Home.HomeHeroSub1) ? Model.Home.HomeHeroSub1 : "(falls back to the English text saved above)")
                    </div>
                </div>
                <div>
                    <div class="text-muted small">Home hero — FIG line</div>
                    <div class="@(string.IsNullOrWhiteSpace(Model.Home.HomeHeroSub2) ? "text-muted fst-italic" : "") mt-0">
                        @(!string.IsNullOrWhiteSpace(Model.Home.HomeHeroSub2) ? Model.Home.HomeHeroSub2 : "(falls back to the English text saved above)")
                    </div>
                </div>
                <div>
                    <div class="text-muted small">About hero — eyebrow</div>
                    <div class="@(string.IsNullOrWhiteSpace(Model.About.AboutHeroEyebrow) ? "text-muted fst-italic" : "") mt-0">
                        @(!string.IsNullOrWhiteSpace(Model.About.AboutHeroEyebrow) ? Model.About.AboutHeroEyebrow : "(falls back to the English text saved above)")
                    </div>
                </div>
                <div>
                    <div class="text-muted small">About hero — lead</div>
                    <div class="@(string.IsNullOrWhiteSpace(Model.About.AboutHeroLead) ? "text-muted fst-italic" : "") mt-0">
                        @(!string.IsNullOrWhiteSpace(Model.About.AboutHeroLead) ? Model.About.AboutHeroLead : "(falls back to the English text saved above)")
                    </div>
                </div>
            </div>
        </div>

        @* One preview variant per translation (a blank field falls back to the
           English text). Hidden by default; the chip row / swap JS reveals
           them. *@
        @foreach (var t in existing)
        {
            <div class="td-variant" data-td-variant="@t.LanguageCode" style="display:none;">
                <div class="d-flex flex-column gap-2">
                    <div>
                        <div class="text-muted small">Home hero — eyebrow</div>
                        <div class="@(string.IsNullOrWhiteSpace(t.HomeHeroEyebrow) ? "text-muted fst-italic" : "") mt-0">
                            @(!string.IsNullOrWhiteSpace(t.HomeHeroEyebrow) ? t.HomeHeroEyebrow : "(falls back to the English text saved above)")
                        </div>
                    </div>
                    <div>
                        <div class="text-muted small">Home hero — lead</div>
                        <div class="@(string.IsNullOrWhiteSpace(t.HomeHeroLead) ? "text-muted fst-italic" : "") mt-0">
                            @(!string.IsNullOrWhiteSpace(t.HomeHeroLead) ? t.HomeHeroLead : "(falls back to the English text saved above)")
                        </div>
                    </div>
                    <div>
                        <div class="text-muted small">Home hero — scope line</div>
                        <div class="@(string.IsNullOrWhiteSpace(t.HomeHeroSub1) ? "text-muted fst-italic" : "") mt-0">
                            @(!string.IsNullOrWhiteSpace(t.HomeHeroSub1) ? t.HomeHeroSub1 : "(falls back to the English text saved above)")
                        </div>
                    </div>
                    <div>
                        <div class="text-muted small">Home hero — FIG line</div>
                        <div class="@(string.IsNullOrWhiteSpace(t.HomeHeroSub2) ? "text-muted fst-italic" : "") mt-0">
                            @(!string.IsNullOrWhiteSpace(t.HomeHeroSub2) ? t.HomeHeroSub2 : "(falls back to the English text saved above)")
                        </div>
                    </div>
                    <div>
                        <div class="text-muted small">About hero — eyebrow</div>
                        <div class="@(string.IsNullOrWhiteSpace(t.AboutHeroEyebrow) ? "text-muted fst-italic" : "") mt-0">
                            @(!string.IsNullOrWhiteSpace(t.AboutHeroEyebrow) ? t.AboutHeroEyebrow : "(falls back to the English text saved above)")
                        </div>
                    </div>
                    <div>
                        <div class="text-muted small">About hero — lead</div>
                        <div class="@(string.IsNullOrWhiteSpace(t.AboutHeroLead) ? "text-muted fst-italic" : "") mt-0">
                            @(!string.IsNullOrWhiteSpace(t.AboutHeroLead) ? t.AboutHeroLead : "(falls back to the English text saved above)")
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* The translation modals (referenced by the ⋮ dropdown above), one add modal
   per missing language + one edit modal per existing row. Each posts to the
   matching write lane; the six hero fields are optional (a blank one keeps
   the English text). The add modal is pre-filled with the English values as a
   starting point (the posts add-modal prefill shape). *@
@foreach (var lang in addable)
{
    <div class="modal fade" id="@($"site-trans-add-{lang.Code}")" tabindex="-1"
         aria-labelledby="@($"site-trans-add-label-{lang.Code}")" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" action="/admin/site/translations"
                      id="@($"site-trans-add-form-{lang.Code}")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="languageCode" value="@lang.Code" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="@($"site-trans-add-label-{lang.Code}")">
                            Add — <b>@LangName(lang.Code)</b>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @* Six hero fields, each optional (a blank one falls back
                           to the English text). Prefilled from the English
                           singleton as a starting point. *@
                        <label class="form-label">Home hero — eyebrow <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control mb-3" name="homeHeroEyebrow" rows="2">@Model.Home.HomeHeroEyebrow</textarea>
                        <label class="form-label">Home hero — lead <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control mb-3" name="homeHeroLead" rows="3">@Model.Home.HomeHeroLead</textarea>
                        <label class="form-label">Home hero — scope line <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control mb-3" name="homeHeroSub1" rows="2">@Model.Home.HomeHeroSub1</textarea>
                        <label class="form-label">Home hero — FIG line <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control mb-3" name="homeHeroSub2" rows="2">@Model.Home.HomeHeroSub2</textarea>
                        <label class="form-label">About hero — eyebrow <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control mb-3" name="aboutHeroEyebrow" rows="2">@Model.About.AboutHeroEyebrow</textarea>
                        <label class="form-label">About hero — lead <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control" name="aboutHeroLead" rows="3">@Model.About.AboutHeroLead</textarea>
                        <p class="form-text text-muted mt-2 mb-0">
                            Leave a field blank to keep that hero in the English text
                            saved above. At least one field is required.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" form="@($"site-trans-add-form-{lang.Code}")">Add translation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@foreach (var t in existing)
{
    <div class="modal fade" id="@($"site-trans-edit-{t.LanguageCode}")" tabindex="-1"
         aria-labelledby="@($"site-trans-edit-label-{t.LanguageCode}")" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" action="/admin/site/translations/update"
                      id="@($"site-trans-edit-form-{t.LanguageCode}")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="languageCode" value="@t.LanguageCode" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="@($"site-trans-edit-label-{t.LanguageCode}")">
                            Edit — <b>@LangName(t.LanguageCode)</b>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @* Six hero fields, each optional (a blank one clears that
                           override → the English text is the fallback again).
                           Pre-filled from the existing row. *@
                        <label class="form-label">Home hero — eyebrow <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control mb-3" name="homeHeroEyebrow" rows="2">@t.HomeHeroEyebrow</textarea>
                        <label class="form-label">Home hero — lead <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control mb-3" name="homeHeroLead" rows="3">@t.HomeHeroLead</textarea>
                        <label class="form-label">Home hero — scope line <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control mb-3" name="homeHeroSub1" rows="2">@t.HomeHeroSub1</textarea>
                        <label class="form-label">Home hero — FIG line <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control mb-3" name="homeHeroSub2" rows="2">@t.HomeHeroSub2</textarea>
                        <label class="form-label">About hero — eyebrow <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control mb-3" name="aboutHeroEyebrow" rows="2">@t.AboutHeroEyebrow</textarea>
                        <label class="form-label">About hero — lead <span class="text-muted small">(optional)</span></label>
                        <textarea class="form-control" name="aboutHeroLead" rows="3">@t.AboutHeroLead</textarea>
                        <p class="form-text text-muted mt-2 mb-0">
                            Leave a field blank to revert that hero to the English
                            text saved above. At least one field is required.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" form="@($"site-trans-edit-form-{t.LanguageCode}")">Save translation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
