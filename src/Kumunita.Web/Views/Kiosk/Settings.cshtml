@model Kumunita.Web.Models.KioskSettingsViewModel
@using Kumunita.Core.Kiosk
@using Kumunita.Web.Security
@inject Kumunita.Core.Localization.ITranslationProvider Translation
@inject Kumunita.Core.Localization.ILocalizationService Localization
@{
    var _kwL = await EffectiveLanguageCode.ResolveAsync(ViewContext.HttpContext?.Request, Localization, Translation);
    // Attribute / option texts and the client strings can't use the kw-l
    // TagHelper — resolved here, English floor when there is no provider.
    async Task<string> Tr(string key, string en) => Translation is null ? en : await Translation.GetAsync(key, _kwL);
    ViewData["Title"] = await Tr("kiosk.settings.page_title", "Kiosk settings");

    var ariaDisplayMode = await Tr("kiosk.settings.display_mode", "Display mode");
    var typeNone        = await Tr("kiosk.settings.type_none", "Choose a type…");
    var itemPlaceholder = await Tr("kiosk.settings.item_placeholder", "Search, or pick from the list");
    var itemUnavailable = await Tr("kiosk.settings.item_unavailable", "The item you picked is no longer available.");
    var calendarAll     = await Tr("kiosk.settings.calendar_all", "All communities");
    var entryHeading    = await Tr("kiosk.settings.entry_heading", "Entry {0}");
    var moveUp          = await Tr("kiosk.settings.move_up", "Move up");
    var moveDown        = await Tr("kiosk.settings.move_down", "Move down");
    var removeEntry     = await Tr("kiosk.settings.remove_entry", "Remove");
    var colType         = await Tr("kiosk.settings.col_type", "Type");
    var colItem         = await Tr("kiosk.settings.col_item", "Item");
    var colView         = await Tr("kiosk.settings.col_view", "View");
    var colDuration     = await Tr("kiosk.settings.col_duration", "Duration (seconds)");
    var colScroll       = await Tr("kiosk.settings.col_scroll", "If it doesn't fit");
    var colLabel        = await Tr("kiosk.settings.col_label", "Label (optional)");
    var showComments    = await Tr("kiosk.settings.show_comments", "Show comments");

    // The closed type set (ADR 0285 D1), in the order the dropdown offers it.
    var types = new (KioskItemType Type, string Label)[]
    {
        (KioskItemType.Board,         await Tr("kiosk.settings.type_board", "Kanban board")),
        (KioskItemType.Todo,          await Tr("kiosk.settings.type_todo", "To-do")),
        (KioskItemType.Project,       await Tr("kiosk.settings.type_project", "Project")),
        (KioskItemType.Calendar,      await Tr("kiosk.settings.type_calendar", "Calendar")),
        (KioskItemType.Event,         await Tr("kiosk.settings.type_event", "Event")),
        (KioskItemType.Page,          await Tr("kiosk.settings.type_page", "Page")),
        (KioskItemType.Announcement,  await Tr("kiosk.settings.type_announcement", "Announcement")),
        (KioskItemType.CommunityPost, await Tr("kiosk.settings.type_community_post", "Community post")),
        (KioskItemType.GroupPost,     await Tr("kiosk.settings.type_group_post", "Group post")),
    };
    var boardViews = new (KioskBoardView View, string Label)[]
    {
        (KioskBoardView.Board, await Tr("kiosk.settings.board_view_board", "Board")),
        (KioskBoardView.List,  await Tr("kiosk.settings.board_view_list", "List of to-dos")),
    };
    var calendarViews = new (string View, string Label)[]
    {
        ("day",   await Tr("kiosk.settings.cal_day", "Day")),
        ("week",  await Tr("kiosk.settings.cal_week", "Week")),
        ("month", await Tr("kiosk.settings.cal_month", "Month")),
    };
    var scrolls = new (KioskScrollBehavior Scroll, string Label)[]
    {
        (KioskScrollBehavior.None, await Tr("kiosk.settings.scroll_none", "No scrolling")),
        (KioskScrollBehavior.Auto, await Tr("kiosk.settings.scroll_auto", "Scroll automatically")),
    };

    // One editor row. `index` is the row's form index (a placeholder in the
    // <template>; kiosk-settings.ts renumbers the rows in DOM order before
    // submit). `row` is null for the template / a new row.
    async Task EntryRow(string index, Kumunita.Web.Models.KioskEntryEditorRow? row, int duration)
    {
        var e = row?.Entry;
        var type = e?.Type;
        var itemText = row is null ? string.Empty
            : type == KioskItemType.Calendar && string.IsNullOrEmpty(e!.ItemId) ? calendarAll
            : row.ItemTitle ?? string.Empty;
        var unavailable = row is not null && !row.ItemVisible;
        var pickerId = "kiosk-item-" + index;
        <li class="kmb-kiosk-entry" data-kiosk-entry data-type="@(type?.ToString() ?? "")">
            <div class="kmb-kiosk-entry-head">
                <span class="kmb-kiosk-entry-number" data-kiosk-number aria-hidden="true"></span>
                <div class="kmb-kiosk-entry-actions" data-kiosk-actions hidden>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-kiosk-move="up" aria-label="@moveUp" title="@moveUp">↑</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-kiosk-move="down" aria-label="@moveDown" title="@moveDown">↓</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-kiosk-remove>@removeEntry</button>
                </div>
            </div>
            <div class="kmb-kiosk-entry-grid">
                <div class="kmb-kiosk-field">
                    <label class="form-label" for="kiosk-type-@index">@colType</label>
                    <select class="form-select" id="kiosk-type-@index" name="Entries[@index].Type" data-kiosk-type>
                        <option value="" selected="@(type is null ? "selected" : null)">@typeNone</option>
                        @foreach (var (t, label) in types)
                        {
                            <option value="@t" selected="@(type == t ? "selected" : null)">@label</option>
                        }
                    </select>
                </div>

                <div class="kmb-kiosk-field kmb-kiosk-field-item" data-kiosk-picker>
                    <label class="form-label" for="@pickerId">@colItem</label>
                    <input type="hidden" name="Entries[@index].ItemId" value="@(e?.ItemId ?? "")" data-kiosk-item-id />
                    <input type="hidden" name="Entries[@index].GroupId" value="@(e?.GroupId ?? "")" data-kiosk-group-id />
                    <input type="text" class="form-control @(unavailable ? "is-invalid" : null)" id="@pickerId"
                           value="@itemText" placeholder="@itemPlaceholder" autocomplete="off"
                           role="combobox" aria-autocomplete="list" aria-expanded="false"
                           aria-controls="@(pickerId)-list" data-kiosk-search
                           data-kiosk-selected="@itemText" disabled="@(type is null ? "disabled" : null)" />
                    <ul class="kmb-kiosk-picker-list" id="@(pickerId)-list" role="listbox" data-kiosk-list hidden></ul>
                    @if (unavailable)
                    {
                        <div class="invalid-feedback d-block">@itemUnavailable</div>
                    }
                </div>

                <div class="kmb-kiosk-field" data-kiosk-show-for="Board">
                    <label class="form-label" for="kiosk-board-view-@index">@colView</label>
                    <select class="form-select" id="kiosk-board-view-@index" name="Entries[@index].BoardView">
                        @foreach (var (v, label) in boardViews)
                        {
                            <option value="@v" selected="@((e?.BoardView ?? KioskBoardView.Board) == v ? "selected" : null)">@label</option>
                        }
                    </select>
                </div>

                <div class="kmb-kiosk-field" data-kiosk-show-for="Calendar">
                    <label class="form-label" for="kiosk-cal-view-@index">@colView</label>
                    <select class="form-select" id="kiosk-cal-view-@index" name="Entries[@index].CalendarView">
                        @foreach (var (v, label) in calendarViews)
                        {
                            <option value="@v" selected="@((e?.CalendarView ?? "week") == v ? "selected" : null)">@label</option>
                        }
                    </select>
                </div>

                <div class="kmb-kiosk-field kmb-kiosk-field-narrow">
                    <label class="form-label" for="kiosk-duration-@index">@colDuration</label>
                    <input type="number" class="form-control" id="kiosk-duration-@index" name="Entries[@index].DurationSeconds"
                           min="5" max="3600" step="1" value="@(e?.DurationSeconds ?? duration)" data-kiosk-duration />
                </div>

                <div class="kmb-kiosk-field">
                    <label class="form-label" for="kiosk-scroll-@index">@colScroll</label>
                    <select class="form-select" id="kiosk-scroll-@index" name="Entries[@index].Scroll">
                        @foreach (var (sc, label) in scrolls)
                        {
                            <option value="@sc" selected="@((e?.Scroll ?? KioskScrollBehavior.None) == sc ? "selected" : null)">@label</option>
                        }
                    </select>
                </div>

                <div class="kmb-kiosk-field kmb-kiosk-field-check" data-kiosk-show-for="Todo Event Announcement CommunityPost GroupPost">
                    <div class="form-check form-switch">
                        <input type="hidden" name="Entries[@index].ShowComments" value="false" />
                        <input class="form-check-input" type="checkbox" role="switch" id="kiosk-comments-@index"
                               name="Entries[@index].ShowComments" value="true" checked="@(e?.ShowComments == true ? "checked" : null)" />
                        <label class="form-check-label" for="kiosk-comments-@index">@showComments</label>
                    </div>
                </div>

                <div class="kmb-kiosk-field kmb-kiosk-field-wide">
                    <label class="form-label" for="kiosk-label-@index">@colLabel</label>
                    <input type="text" class="form-control" id="kiosk-label-@index" name="Entries[@index].Label"
                           value="@(e?.Label ?? "")" maxlength="120" />
                </div>
            </div>
        </li>
    }
}
@*
  The /settings/kiosk per-resident playlist editor (ADR 0164 amendment;
  reworked by ADR 0285). Display settings (display mode, default duration,
  refresh interval, scroll speed) + an ordered entry list. Each entry: an
  item type, the item (a search box with suggestions — kiosk-settings.ts asks
  GET /settings/kiosk/items, which only offers items the resident can see),
  the board / calendar view where it applies, the duration, the scroll
  behaviour, the comments switch (types with comments / RSVPs) and an
  optional label. kiosk-settings.ts adds, removes, reorders and renumbers the
  rows; the controller reads Entries[i].* in index order. Without scripts the
  stored rows still render and save, but rows can't be added and the item
  search does not run. No new AccessAction / Decide() branch (M35·1 / M35·3).
*@
<style>
  /* ADR 0285 — the playlist editor rows (scoped to this page). */
  .kmb-kiosk-entries { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .75rem; }
  .kmb-kiosk-entry { border: 1px solid var(--kmb-border); border-radius: var(--kmb-radius, 12px); padding: .75rem 1rem 1rem; background: var(--kmb-surface); }
  .kmb-kiosk-entry-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .5rem; min-height: 2rem; }
  .kmb-kiosk-entry-number { font-weight: 600; color: var(--kmb-ink-soft); }
  .kmb-kiosk-entry-actions { display: flex; gap: .25rem; }
  .kmb-kiosk-entry-actions[hidden] { display: none; }
  .kmb-kiosk-entry-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: .75rem 1rem; align-items: end; }
  .kmb-kiosk-field-item, .kmb-kiosk-field-wide { grid-column: span 2; }
  .kmb-kiosk-field-check { align-self: center; padding-top: 1.5rem; }
  .kmb-kiosk-field[hidden] { display: none; }
  .kmb-kiosk-field-item { position: relative; }
  .kmb-kiosk-picker-list { position: absolute; z-index: 20; left: 0; right: 0; top: 100%; margin: 2px 0 0; padding: .25rem 0; list-style: none; max-height: 16rem; overflow: auto; background: var(--kmb-surface); border: 1px solid var(--kmb-control-border, var(--kmb-border)); border-radius: var(--kmb-radius-input, 8px); box-shadow: 0 6px 16px rgba(0,0,0,.18); }
  .kmb-kiosk-picker-list[hidden] { display: none; }
  .kmb-kiosk-picker-list li { padding: .4rem .75rem; cursor: pointer; }
  .kmb-kiosk-picker-list li[aria-selected="true"], .kmb-kiosk-picker-list li:hover { background: var(--kmb-tint-a, rgba(0,0,0,.06)); }
  .kmb-kiosk-picker-list .kmb-kiosk-picker-sub { display: block; font-size: .8rem; color: var(--kmb-muted); }
  .kmb-kiosk-picker-list .kmb-kiosk-picker-note { cursor: default; color: var(--kmb-muted); }
  @@media (max-width: 575.98px) { .kmb-kiosk-field-item, .kmb-kiosk-field-wide { grid-column: auto; } }
</style>

@await Html.PartialAsync("~/Views/Locale/_SettingsTabs.cshtml")

<h1>
    <kw-l key="kiosk.settings.title">Kiosk display</kw-l>
</h1>
<p class="text-muted">
    <kw-l key="kiosk.settings.intro">Choose what your kiosk display shows. Add an entry, pick its type and the item, and set how long it stays on screen and whether it scrolls when it doesn't fit. Entries play from top to bottom. This is your playlist; it only shapes your own kiosk. Then use “Preview the kiosk” below to see it run.</kw-l>
</p>

<form method="post" action="/settings/kiosk" id="kiosk-settings-form">
    @Html.AntiForgeryToken()

    @* ── The display settings (display-only, never an access input — M35·4) ── *@
    <div class="card mb-4 kmb-form-section">
    <div class="card-body">
    <h2 class="kmb-form-section-title"><kw-l key="kiosk.settings.display_heading">Display</kw-l></h2>
    <div class="row g-3">
        <div class="col-sm-6 col-lg-3">
            <label for="DisplayMode" class="form-label">
                <kw-l key="kiosk.settings.display_mode">Display mode</kw-l>
            </label>
            <select class="form-select" id="DisplayMode" name="DisplayMode" aria-label="@ariaDisplayMode">
                <option value="FullPage" selected="@(Model.DisplayMode == KioskDisplayMode.FullPage ? "selected" : null)">
                    <kw-l key="kiosk.settings.display_mode.full_page">Full page (fill the browser window)</kw-l>
                </option>
                <option value="FullScreen" selected="@(Model.DisplayMode == KioskDisplayMode.FullScreen ? "selected" : null)">
                    <kw-l key="kiosk.settings.display_mode.full_screen">Full screen (the whole monitor)</kw-l>
                </option>
            </select>
            <div class="form-text">
                <kw-l key="kiosk.settings.display_mode.hint">Full page fills your browser window; full screen also hides the browser's tabs and address bar (a user gesture is needed to enter it).</kw-l>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <label for="DefaultDurationSeconds" class="form-label">
                <kw-l key="kiosk.settings.default_duration">Default duration for new entries (seconds)</kw-l>
            </label>
            <input type="number" min="5" max="3600" step="1" class="form-control"
                   id="DefaultDurationSeconds" name="DefaultDurationSeconds"
                   value="@Model.DefaultDurationSeconds" />
            <div class="form-text"><kw-l key="kiosk.settings.default_duration_hint">New entries start with this duration (5–3600 seconds). Default 30.</kw-l></div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <label for="RefreshIntervalSeconds" class="form-label">
                <kw-l key="kiosk.settings.refresh_interval">Refresh content every (seconds)</kw-l>
            </label>
            <input type="number" min="2" step="1" class="form-control"
                   id="RefreshIntervalSeconds" name="RefreshIntervalSeconds"
                   value="@Model.RefreshIntervalSeconds" />
            <div class="form-text"><kw-l key="kiosk.settings.refresh_interval_hint">How often the kiosk checks the slide on screen for changes (seconds, at least 2). Default 10.</kw-l></div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <label for="ScrollSpeed" class="form-label">
                <kw-l key="kiosk.settings.scroll_speed">Scroll speed</kw-l>
            </label>
            <select class="form-select" id="ScrollSpeed" name="ScrollSpeed">
                <option value="Slow" selected="@(Model.ScrollSpeed == KioskScrollSpeed.Slow ? "selected" : null)"><kw-l key="kiosk.settings.scroll_speed_slow">Slow</kw-l></option>
                <option value="Medium" selected="@(Model.ScrollSpeed == KioskScrollSpeed.Medium ? "selected" : null)"><kw-l key="kiosk.settings.scroll_speed_medium">Medium</kw-l></option>
                <option value="Fast" selected="@(Model.ScrollSpeed == KioskScrollSpeed.Fast ? "selected" : null)"><kw-l key="kiosk.settings.scroll_speed_fast">Fast</kw-l></option>
            </select>
            <div class="form-text"><kw-l key="kiosk.settings.scroll_speed_hint">How fast entries set to scroll automatically move down the page.</kw-l></div>
        </div>
    </div>
    </div>
    </div>

    @* ── The playlist (top to bottom = play order) ── *@
    <div class="card mb-4 kmb-form-section">
    <div class="card-body">
    <h2 class="kmb-form-section-title"><kw-l key="kiosk.settings.playlist_heading">Playlist (top to bottom)</kw-l></h2>

    <div id="kiosk-entries-editor"
         data-items-url="/settings/kiosk/items"
         data-entry-heading="@entryHeading"
         data-calendar-all="@calendarAll"
         data-str-searching="@(await Tr("kiosk.settings.item_searching", "Searching…"))"
         data-str-no-results="@(await Tr("kiosk.settings.item_no_results", "Nothing found."))"
         data-str-error="@(await Tr("kiosk.settings.item_error", "Could not load items. Try again."))">

        <p class="text-muted mb-3" data-kiosk-empty hidden="@(Model.Entries.Count > 0 ? "hidden" : null)">
            <kw-l key="kiosk.settings.empty">No entries yet. Use “Add entry” to put something on your kiosk.</kw-l>
        </p>

        <ol class="kmb-kiosk-entries" data-kiosk-entries>
            @for (var i = 0; i < Model.Entries.Count; i++)
            {
                await EntryRow(i.ToString(System.Globalization.CultureInfo.InvariantCulture), Model.Entries[i], Model.DefaultDurationSeconds);
            }
        </ol>

        <template data-kiosk-template>
            @{ await EntryRow("__i__", null, Model.DefaultDurationSeconds); }
        </template>

        <button type="button" class="btn btn-outline-secondary mt-3" data-kiosk-add hidden>
            + <kw-l key="kiosk.settings.add_entry">Add entry</kw-l>
        </button>
    </div>

    <p class="text-muted small mt-3 mb-0">
        <kw-l key="kiosk.settings.tip">With automatic scrolling, an entry stays on screen until it has scrolled to the end, even if that takes longer than its duration. If it reaches the end sooner, it scrolls back to the top for the rest of its time.</kw-l>
    </p>
    </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary"><kw-l key="kiosk.settings.save">Save playlist</kw-l></button>
        <a class="btn btn-link ms-2" href="/kiosk" target="_blank" rel="noopener"><kw-l key="kiosk.settings.preview">Preview the kiosk</kw-l></a>
    </div>
</form>

@*
  ADR 0302 (IMPROVE-UX R18) — the shared kiosk link lifecycle. A new section
  on the same page; the personal-kiosk settings above are untouched (ADR 0302
  D5). The resident creates a link (the raw token is shown once in a read-only
  input — the row stores only the SHA-256 hash, so there is no "show again"),
  sees their active links with "last used", and revokes them (terminal, no
  undo — the R15 state machine). The revoke uses the data-confirm idiom
  (confirm.ts). The /kiosk?link=<token> URL is assembled client-side by
  kiosk-settings.ts (the R16 middleware parses it) so the token never rides a
  server-rendered URL.
*@
<div class="card mb-4 kmb-form-section" id="kiosk-shared-links">
<div class="card-body">
<h2 class="kmb-form-section-title"><kw-l key="kiosk.settings.shared_heading">Shared link</kw-l></h2>
<p class="text-muted">
    <kw-l key="kiosk.settings.shared_intro">A shared link lets anyone who has it watch your kiosk display without signing in. Only items visible to the whole community are shown (private items are skipped). The link is revocable; once revoked it cannot be restored.</kw-l>
</p>

@* ── Copy-once reveal (shown exactly once, right after creation — ADR 0302 D2) ── *@
@if (Model.SharedLinkToken is not null)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2" id="kiosk-link-token-reveal" data-kiosk-link-token="@Model.SharedLinkToken">
        <div class="me-2 flex-grow-1">
            <kw-l key="kiosk.settings.link_created">Your shared link is ready. Copy it now — it will not be shown again.</kw-l>
        </div>
        <input type="text" class="form-control form-control-sm w-auto" id="kiosk-link-token" readonly
               value="@Model.SharedLinkToken" aria-label="@await Tr("kiosk.settings.token_label", "Shared link")" />
        <button type="button" class="btn btn-sm btn-outline-secondary" data-kiosk-copy-token id="kiosk-link-copy">
            <kw-l key="kiosk.settings.copy">Copy</kw-l>
        </button>
    </div>
}

@* ── Create link button ── *@
<form method="post" action="/settings/kiosk/link" class="d-inline" id="kiosk-link-create-form">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-primary">
        + <kw-l key="kiosk.settings.create_link">Create link</kw-l>
    </button>
</form>

@* ── Active links list ── *@
@if (Model.SharedLinks.Count > 0)
{
    <table class="table table-sm mt-3 mb-0">
        <thead>
            <tr>
                <th scope="col"><kw-l key="kiosk.settings.col_created">Created</kw-l></th>
                <th scope="col"><kw-l key="kiosk.settings.col_last_used">Last used</kw-l></th>
                <th scope="col" class="text-end"><kw-l key="kiosk.settings.col_actions">Actions</kw-l></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var link in Model.SharedLinks)
        {
            var createdFmt = link.CreatedAt.ToLocalTime().ToString("MMM d, yyyy", System.Globalization.CultureInfo.CurrentCulture);
            var lastUsedFmt = link.LastUsedAt is null
                ? await Tr("kiosk.settings.never_used", "Never")
                : link.LastUsedAt.Value.ToLocalTime().ToString("MMM d, yyyy HH:mm", System.Globalization.CultureInfo.CurrentCulture);
            var shortId = link.Id.Length > 8 ? link.Id[^8..] : link.Id;
            <tr id="kiosk-link-@link.Id" data-link-id="@link.Id">
                <td>@createdFmt <span class="text-muted small">(#@shortId)</span></td>
                <td>@lastUsedFmt</td>
                <td class="text-end">
                    <form method="post" action="/settings/kiosk/link/revoke" class="d-inline"
                          data-confirm="@await Tr("kiosk.settings.revoke_confirm", "Revoke this shared link? It will stop working immediately and cannot be undone.")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="linkId" value="@link.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" data-kiosk-revoke>
                            <kw-l key="kiosk.settings.revoke">Revoke</kw-l>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </table>
}
else
{
    <p class="text-muted mt-3 mb-0">
        <kw-l key="kiosk.settings.shared_empty">No shared links yet. Use "Create link" to make one for a wall screen or shared display.</kw-l>
    </p>
}
</div>
</div>

@section Scripts {
    <script type="module" src="~/js/lib/kiosk-settings.js"></script>
}
