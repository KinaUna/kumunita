@using Kumunita.Web.Security
@model OnboardingViewModel
@{
    ViewData["Title"] = "Onboarding";
    // The closed onboarding.* kw-l key set (D7) is the ONLY user-visible copy
    // on this surface — every label goes through <kw-l> by key (the
    // LocalizeTagHelper floor, ADR 0015 D1). No inline English, no 16th key.
    //
    // The "set / not set" state per step is a *decorative* glyph (✓ / a
    // neutral dash), aria-hidden — a symbol, not a translatable string, so it
    // stays inside the closed 15-key set (the register's D7 lock) while still
    // giving the resident a "set / not set" hint off the owner-scope Has* read
    // (D4/D5, C-M22·5). The step label + the "go to this setting" link are the
    // two localized strings per card.
}

<h1><kw-l key="onboarding.title">Set up your account</kw-l></h1>
<p class="text-muted">
    <kw-l key="onboarding.intro">A quick guided tour of the few things that make Kumunita work for you. Everything links into the setting that already owns it — you can finish in a minute or come back any time.</kw-l>
</p>

@* A step card: the localized label + a decorative set/not-set marker + the
   "open this setting" button. The button (client/lib/onboarding-modal.ts)
   opens the step's surface in the shared _OnboardingModal (the M35 kiosk
   "frame the surface's own route" idiom) at the step's index; the modal's
   Previous / Next buttons then walk the remaining steps in order, so the
   walk-through is a clean linear process (no "back button, lost context").
   The walk-through links into the surface that owns each field (D3) — it
   never re-implements a write (C-M22·4). *@
@{
    // The step → "set" hint mapping (the owner-scope read the step links into,
    // the design-doc §6 table). The step list itself is the closed
    // OnboardingViewModel.ClosedSteps (the modal partial iterates the same
    // list, so the main-page order and the modal's Previous / Next order agree).
    bool SetFor(OnboardingStep step) => step.Key switch
    {
        "displayname" => Model.HasDisplayName,
        "avatar"      => Model.HasAvatar,
        "language"    => !string.IsNullOrWhiteSpace(Model.UiLanguageCode),
        "timezone"    => Model.HasTimezone,
        "dateformat"  => Model.HasDateFormat,
        "email"       => Model.HasEmailLanguage,
        "contact"     => Model.HasDisplayName,
        "messaging"   => Model.HasMessaging,
        _             => false,
    };
}
<ol class="list-group kmb-onboarding-steps">
    @for (var i = 0; i < Model.Steps.Count; i++)
    {
        var step = Model.Steps[i];
        bool set = SetFor(step);
        <li class="list-group-item d-flex align-items-center gap-2">
            @* Decorative set/not-set marker (✓ when the frozen read seam the
               step links into is set, a neutral dash otherwise). A symbol —
               not a translatable string — so it carries no kw-l key and
               stays inside the closed 15-key set (D7). *@
            <span class="badge @(set ? "text-bg-success" : "text-bg-light") me-1"
                  aria-hidden="true">
                @(set ? "✓" : "–")
            </span>
            <span class="me-auto me-2">
                <kw-l key="@step.LabelKey"></kw-l>
            </span>
            @* The "open this setting" button: opens the shared modal at this
               step (the onboarding-modal.ts module reads data-ob-index). It
               is a <button>, not an <a>, so it carries no navigation — the
               modal is the navigation. The label is the closed
               onboarding.visit key (the M22 D7 set). *@
            <button type="button" class="btn btn-sm btn-outline-primary text-nowrap kmb-onb-open"
                    data-ob-index="@i">
                <kw-l key="onboarding.visit">Go to this setting</kw-l>
            </button>
        </li>
    }
</ol>

@* The finish/skip actions (D4): the ONE write is CompleteOnboardingAsync
   (U01's lane, C-M22·3/C-M22·4); both forms POST to that single lane —
   finish and skip route to the same stamp (§1.a-C2). Non-blocking (D5):
   these are the explicit actions; nothing here gates sign-in. *@
<div class="d-flex flex-wrap gap-2 mt-3 kmb-onboarding-actions">
    <form method="post" action="/onboarding/finish">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary"><kw-l key="onboarding.finish">I'm all set — finish setup</kw-l></button>
    </form>
    <form method="post" action="/onboarding/skip">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary"><kw-l key="onboarding.skip">Skip for now</kw-l></button>
    </form>
</div>

@* The SHARED onboarding modal (the M22/M30 rework): one Bootstrap modal the
   step buttons above open, iframing the current step's surface (the M35
   kiosk idiom) with Previous / Next navigation across the closed step set.
   The partial renders the modal + the .kmb-onb-step-meta list (from the
   SAME Model.Steps the list above iterates, so the order agrees) + loads
   client/lib/onboarding-modal.js. The modal body is the surface's own page —
   its form, anti-forgery token, and save lane all work unmodified. *@
@await Html.PartialAsync("_OnboardingModal", Model.Steps)
