{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "client",
    "outDir": "wwwroot/js",
    "strict": true,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["client/**/*.ts"]
}
