<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- M1 step 7: durable side effects
         handler + scheduled job framework; WolverineFx.Marten gives us the
         transactional outbox integration (`IntegrateWithWolverine()`) that
         ARCHITECTURE.md §6.1 relies on ("a failed SMTP connection can never roll
         back a domain write") — the outbox row + the domain write commit atomically
         in the same Postgres transaction.
         Version pin: 6.33.0 is the current pairing (WolverineFx.Marten 6.33 pulls
         WolverineFx >= 6.33 via WolverineFx.RDBMS, so the two are locked together;
         6.32/6.33 was the pairing in the Critter-Stack `versions.md` snapshot, but
         the transitive graph forces both to 6.33 as of 2026-09).
         Note: the prior convention ("Wolverine is a *Web* package") was intentionally
         broken by M1 step 7 (plan U1/U2) — `Kumunita.Core` now also references
         WolverineFx 6.33.0 directly for the transactional-outbox `IMessageContext`
         enqueue. Both projects pin the same version (R4: no skew). See
         docs/plans-milestones/done/plan-m1-step-7-outbox-email-c3.md. -->
    <PackageReference Include="WolverineFx" Version="6.50.2" />
    <PackageReference Include="WolverineFx.Marten" Version="6.50.2" />
    <!-- Wolverine 6.33 no longer ships the runtime compiler (IAssemblyGenerator/Roslyn)
         in the core package. This reference auto-registers it so TypeLoadMode.Dynamic
         handlers (OutboxEmail, Fault<>, AuditPurge) compile at startup — see
         wolverinefx.net/guide/codegen.html. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.50.2" />
    <!-- F10 (OBS-02, U2) — the ONE <PackageReference> ADD the plan explicitly allows
         (pin §7). Error-tracker seam (pin §2): OFF-by-DEFAULT Sentry capture, gated
         on the owner's SENTRY_DSN (the builder-phase guard in Program.cs is the no-op
         path — the UseSentry call is not executed until the DSN is set). The version
         is F10.U2's judgment call (pin §7 / F10.U1 open item (c)): 6.12.1 is the
         latest-stable Sentry.AspNetCore and ships a net10.0 TFM (verified against
         the 6.12.1 nuspec). -->
    <PackageReference Include="Sentry.AspNetCore" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kumunita.Core\Kumunita.Core.csproj" />
  </ItemGroup>

  <!-- TypeScript.MSBuild compiles the .ts under client/ into wwwroot/js (untracked
       build output) via RunTscCompile on CoreCompileDependsOn, but the SDK's
       DefineStaticWebAssets *task* runs from the ResolveProjectStaticWebAssets
       target during reference resolution — before CoreCompile. Since
       a non-incremental `dotnet build` runs Clean first (whose CleanTypeScriptOutputs
       deletes wwwroot/js), a solution build can define the static assets while the
       emitted files are absent and fail with "No file exists for the asset ...
       wwwroot/js/lib/api.js". Ensure tsc has emitted before any target that
       defines/generates the static-web-assets manifest. (BeforeTargets must name
       real MSBuild *targets* — DefineStaticWebAssets is only a task, so hooking
       it directly matches nothing.) -->
  <Target Name="EmitTypeScriptBeforeStaticWebAssets" BeforeTargets="ResolveProjectStaticWebAssets;GenerateStaticWebAssetsManifest;GenerateComputedBuildStaticWebAssets;StaticWebAssetsPrepareForRun" DependsOnTargets="RunTscCompile" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
