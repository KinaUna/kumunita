{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "File": {
      "Directory": "logs",
      "RetentionDays": 14
    }
  },
  "Kumunita": {
    "Sessions": {
      "TouchIntervalSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
