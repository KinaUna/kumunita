<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Marten" Version="9.31.2" />
    <!-- Raw parameterised SQL on the hand-rolled mt."AdminOverride" table
         (ConsumeBreakGlassAsync, the break-glass consume write). Matches the Npgsql
         10.0.x the rest of the tree (Web, Core.Tests) already pins; makes the
         direct ADO.NET surface explicit instead of relying on Marten's transitive pull. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <!-- EF Core's Npgsql provider. Needed in Core (not just Web): the Identity schema's
         EF Core migrations live next to AppDbContext in this assembly (ADR 0004 —
         "standard EF Core migrations, applied at startup"), and the generated migration
         C# references the provider's builder types. Runtime-only: SchemaBootstrap calls
         Database.MigrateAsync() at boot in ALL environments; Web's Program.cs already
         pins the same 10.0.3. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Explicit for AddKumunitaCore's public API (IServiceCollection); Bootstrap's DI
         usings previously flowed transitively. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <!-- M1 step 7 (C3 fix, plan-m1-step-7-outbox-email-c3.md):
          Core now carries the *enqueue* half of the durable OutboxEmail
          pipeline. The prior convention — "Wolverine is a Web package" — is
          intentionally broken here: the transactional-outbox guarantee
          (docs/wolverine/marten-integration-outbox.md) requires the enqueue
          to happen inside the caller's own Marten transaction, and the only
          API that does that is the per-scope, handler-context primitive
          `Wolverine.IMessageContext` (NOT the host-level `IMessageBus`, which
          asserts the host has started — see the AuditPurgeTick comment at
          Program.cs:324). U2 rewires `OutboxEmailStager` to resolve
          `IMessageContext` and call its `PublishAsync<T>(T) -> ValueTask`
          (see src/Kumunita.Core/Identity/U1PinnedApiProbe.cs for the exact
          compile-pinned surface; the `EnqueueAsync` name hinted in the plan
          text does NOT exist on IMessageContext in 6.33.0, verified by the
          compiler's CS1061 verdict during U1).

          The four "Wolverine is a Web package" comment sites U5 will
          reconcile are:
            1. this file (the block above the WolverineFx reference)
            2. src/Kumunita.Core/Identity/IMailerStage.cs (lines 12-21)
            3. src/Kumunita.Core/DependencyInjection.cs (the IMailerStage
               registration block)
            4. src/Kumunita.Web/Kumunita.Web.csproj (lines 19-21)

          Version pin: 6.33.0, byte-for-byte identical to the reference in
          Kumunita.Web.csproj (R4 — do not let a transitive bump drift one
          of them; WolverineFx.Marten 6.33 pulls WolverineFx >= 6.33 so the
          two stay locked together as they already are in Web). -->
    <PackageReference Include="WolverineFx" Version="6.33.0" />
    <!-- EF Core design-time: lets `dotnet ef migrations add ...` discover AppDbContext
          without booting the Web host (the DesignTimeDbContextFactory seam). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
