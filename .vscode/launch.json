{
  "version": "2.0.0",
  "configurations": [
    {
      "name": "Kumunita.Web (http)",
      "type": "dotnet",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Kumunita.Web/bin/Debug/net10.0/Kumunita.Web.dll",
      "cwd": "${workspaceFolder}/src/Kumunita.Web",
      "launchBrowser": true,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
